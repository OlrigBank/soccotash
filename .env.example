# Local Docker Compose settings. Copy this file to .env and keep .env out of Git.
POSTGRES_DB=soccotash
POSTGRES_USER=soccotash
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# The Olrig Bank comparison site runs beside Soccotash, which remains on 8080.
OLRIGBANK_PORT=8081
# Existing Docker network owned by the Soccotash stack.
SOCCOTASH_DOCKER_NETWORK=soccotash_default
# Existing PostgreSQL container used by backup-db.bash and restore-db.bash.
SOCCOTASH_DATABASE_CONTAINER=soccotash-database-1
CALENDAR_SYNC_TOKEN=replace-with-a-long-random-value

# Each variable may contain one URL or multiple URLs separated by commas or new lines.
AIRBNB_MAIN_HOUSE_ICAL_URLS=https://www.airbnb.com/calendar/ical/REPLACE.ics?s=REPLACE
AIRBNB_COTTAGE_ICAL_URLS=https://www.airbnb.com/calendar/ical/REPLACE.ics?s=REPLACE

# Booking-offer email delivery used by the site container.
EMAIL_PROVIDER=smtp
BOOKING_EMAIL_FROM="Olrig Bank <olrig.bank@gmail.com>"
BOOKING_EMAIL_REPLY_TO=olrig.bank@gmail.com
# Receives direct notifications when a customer accepts or declines an offer.
BOOKING_ADMIN_EMAIL=olrig.bank@gmail.com
BOOKING_EMAIL_BCC=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=olrig.bank@gmail.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Alternative when EMAIL_PROVIDER=resend:
RESEND_API_KEY=

# Optional Meta WhatsApp Business Platform notifications. These stay disabled
# unless every required value is configured. Never commit real credentials.
WHATSAPP_PROVIDER=meta
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-the-meta-phone-number-id
WHATSAPP_APP_SECRET=replace-with-the-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-value
WHATSAPP_TEMPLATE_BOOKING_UPDATE=olrig_booking_update_v1
WHATSAPP_TEMPLATE_LANGUAGE=en_GB

# Private Booker links remain valid through this many days after departure.
# Missing or invalid values fall back to 90; accepted values are 1–3650.
BOOKING_ACCESS_EXPIRY_DAYS_AFTER_DEPARTURE=90

# Optional Umami analytics. Tracking stays disabled when the website ID is blank.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
