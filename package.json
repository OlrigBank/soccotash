{
  "name": "olrigbank-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "check": "npm --prefix site run check",
    "generate:booking-lifecycle-docs": "npm --prefix site run generate:booking-lifecycle-docs",
    "check:booking-lifecycle-docs": "npm --prefix site run check:booking-lifecycle-docs",
    "reviews:rename": "npm --prefix site run reviews:rename --",
    "reviews:generate-public": "npm --prefix site run reviews:generate-public",
    "test:reviews": "npm --prefix site run test:reviews",
    "test:booking-lifecycle": "npm --prefix site run test:booking-lifecycle",
    "test:live-smoke": "playwright test --config=playwright.live-smoke.config.ts",
    "test:live-smoke:headed": "playwright test --config=playwright.live-smoke.config.ts --headed",
    "show:live-smoke-report": "playwright show-report playwright-report/live-smoke",
    "test:booking-regression": "playwright test --config=playwright.booking-regression.config.ts",
    "test:airbnb-admin-ui": "playwright test --config=playwright.airbnb-admin.config.ts",
    "test:booking-regression:headed": "playwright test --config=playwright.booking-regression.config.ts --headed",
    "show:booking-regression-report": "playwright show-report playwright-report/booking-regression",
    "test:planner-regression": "playwright test --config=playwright.planner-regression.config.ts",
    "test:planner-regression:headed": "playwright test --config=playwright.planner-regression.config.ts --headed",
    "show:planner-regression-report": "playwright show-report playwright-report/planner-regression",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f site",
    "docker:sync": "docker compose --profile tools run --rm calendar-sync",
    "docker:report": "docker compose --profile tools run --rm booking-report",
    "docker:backup": "./backup-db.bash",
    "docker:isolated:up": "docker compose --env-file .env.agent2 -f compose.yaml -f compose.isolated.yaml up --build -d",
    "docker:isolated:down": "docker compose --env-file .env.agent2 -f compose.yaml -f compose.isolated.yaml down",
    "docker:isolated:logs": "docker compose --env-file .env.agent2 -f compose.yaml -f compose.isolated.yaml logs -f site",
    "docker:isolated:sync": "docker compose --env-file .env.agent2 -f compose.yaml -f compose.isolated.yaml --profile tools run --rm calendar-sync",
    "docker:isolated:report": "docker compose --env-file .env.agent2 -f compose.yaml -f compose.isolated.yaml --profile tools run --rm booking-report",
    "docker:isolated:backup": "SOCCOTASH_DATABASE_CONTAINER=olrigbank2-database-1 ./backup-db.bash",
    "docker:isolated:restore": "COMPOSE_FILE=compose.yaml:compose.isolated.yaml COMPOSE_ENV_FILES=.env.agent2 SOCCOTASH_DATABASE_CONTAINER=olrigbank2-database-1 ./restore-db.bash"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "pg": "^8.22.0"
  }
}
