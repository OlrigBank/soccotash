{
  "name": "olrigbank-web-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "start": "node ./dist/server/entry.mjs",
    "db:migrate": "node ./scripts/migrate.mjs",
    "sync:calendars": "node ./scripts/sync-calendars.mjs",
    "process:notification-fallbacks": "node ./scripts/process-notification-fallbacks.mjs",
    "process:inbound-whatsapp-replies": "node ./scripts/process-inbound-whatsapp-replies.mjs",
    "booking:report": "node ./scripts/booking-report.mjs",
    "admin:create": "node ./scripts/create-admin.mjs",
    "generate:booking-lifecycle-docs": "node --experimental-strip-types ./scripts/generate-booking-lifecycle-docs.ts",
    "check:booking-lifecycle-docs": "node --experimental-strip-types ./scripts/generate-booking-lifecycle-docs.ts --check",
    "generate:local-guide-baseline": "node --experimental-strip-types ./scripts/generate-local-guide-baseline.ts",
    "check:local-guide-baseline": "node --experimental-strip-types ./scripts/generate-local-guide-baseline.ts --check",
    "generate:local-guide-migration": "node --experimental-strip-types ./scripts/generate-local-guide-data-migration.ts",
    "check:local-guide-migration": "node --experimental-strip-types ./scripts/generate-local-guide-data-migration.ts --check",
    "verify:public-release": "node ./scripts/verify-public-release.mjs",
    "local-guide:export": "node --experimental-strip-types ./scripts/export-local-guide.mjs",
    "local-guide:restore": "node --experimental-strip-types ./scripts/restore-local-guide.mjs",
    "reviews:rename": "node ./scripts/rename-airbnb-reviews.mjs",
    "test:reviews": "node ./tests/reviews/rename-airbnb-reviews.test.mjs",
    "test:booking-lifecycle": "node --experimental-strip-types --test ./tests/booking-lifecycle/*.test.ts",
    "test:booking-integration": "node --experimental-strip-types --test --test-concurrency=1 ./tests/integration/*.test.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.20.0",
    "astro": "^7.0.6",
    "node-ical": "^0.25.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3"
  }
}
