---
import type { PublicReview, PublicReviewSummary } from '../lib/public-reviews';

interface Props {
  reviews: PublicReview[];
  summary: PublicReviewSummary;
}

const { reviews, summary } = Astro.props;
const total = reviews.length;
const showDots = total <= 10;

function excerpt(quote: string, maximum = 230) {
  if (quote.length <= maximum) return { text: quote, truncated: false };
  const endings = [...quote.matchAll(/[.!?](?:[”’"])?(?=\s|$)/gu)];
  const preferred = endings.filter((match) => (match.index ?? 0) + match[0].length <= maximum).at(-1);
  const boundary = preferred ?? endings[0];
  if (!boundary) return { text: quote, truncated: false };
  const end = (boundary.index ?? 0) + boundary[0].length;
  return { text: quote.slice(0, end), truncated: end < quote.length };
}
---

<section id="guest-reviews" class="review-section" aria-labelledby="guest-reviews-heading">
  <div class="review-section__heading">
    <p class="review-section__eyebrow">Guest book</p>
    <h2 id="guest-reviews-heading">What our guests say</h2>
    <p>Recent stays at Olrig Bank and the Cottage, shared by our Airbnb guests.</p>
  </div>

  <div class="review-section__panels">
  {
    total === 0 ? (
      <p class="review-carousel review-carousel--empty">Guest reviews will be added here soon.</p>
    ) : (
      <div
        class="review-carousel"
        data-review-carousel
        data-total={total}
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Guest reviews"
      >
        <div class="review-carousel__slides">
          {reviews.map((review, index) => {
            const preview = excerpt(review.quote);
            const fullId = `review-${index + 1}-full`;
            return (
            <article
              class="review-carousel__slide"
              data-review-slide
              data-index={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${total}`}
            >
              <p
                class:list={['review-carousel__rating', review.rating < 5 && 'review-carousel__rating--below-five']}
                aria-label={`${review.rating} out of 5 stars`}
              >
                <span class="review-carousel__filled-stars" aria-hidden="true">{'★'.repeat(review.rating)}</span>
                <span class="review-carousel__empty-stars" aria-hidden="true">{'☆'.repeat(5 - review.rating)}</span>
              </p>
              <blockquote>
                <span data-review-preview>“{preview.text}”</span>
                {preview.truncated ? <span id={fullId} data-review-full hidden>“{review.quote}”</span> : null}
                {preview.truncated ? (
                  <button type="button" data-review-more aria-expanded="false" aria-controls={fullId}>More…</button>
                ) : null}
              </blockquote>
              <p class="review-carousel__attribution">
                <span aria-hidden="true">— </span><strong>{review.reviewer.displayName}</strong>, {review.stay.nights}-night
                stay <span aria-hidden="true">·</span> {review.stay.month} {review.stay.year}
              </p>
              <p class="review-carousel__listing">{review.listing.displayName}</p>
              <p class="review-carousel__source">{review.source.displayName}</p>
            </article>
            );
          })}
        </div>

        <div class="review-carousel__navigation">
          <button type="button" data-review-previous aria-label="Show previous review" disabled>
            <span aria-hidden="true">←</span>
          </button>
          <p class="review-carousel__count" data-review-count aria-live="polite" aria-atomic="true">
            1 of {total}
          </p>
          <button type="button" data-review-next aria-label="Show next review" disabled={total === 1}>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        {showDots ? (
          <div class="review-carousel__pagination" aria-label="Choose a review">
            {reviews.map((_, index) => (
              <button
                type="button"
                data-review-dot
                data-index={index}
                aria-label={`Show review ${index + 1} of ${total}`}
                aria-current={index === 0 ? 'true' : undefined}
              >
                <span aria-hidden="true" />
              </button>
            ))}
          </div>
        ) : null}
      </div>
    )
  }

    <aside class="review-summary" aria-labelledby="review-summary-heading">
      <div class="review-summary__intro">
        <p class="review-summary__eyebrow">At a glance</p>
        <h3 id="review-summary-heading">The details guests notice</h3>
        <p>Average category scores from {summary.reviewCount} Airbnb guest reviews.</p>
      </div>
      <p class="review-summary__overall" aria-label={`${summary.overallScore.toFixed(2)} out of ${summary.scale} overall`}>
        <strong>{summary.overallScore.toFixed(2)}</strong>
        <span><span aria-hidden="true">★</span> Overall rating</span>
      </p>
      <dl class="review-summary__scores">
        {summary.categories.map((category) => (
          <div class="review-summary__score">
            <dt>{category.displayName}</dt>
            <dd>
              <strong>{category.score.toFixed(2)}</strong><span> / {summary.scale}</span>
              <span class="review-summary__track" aria-hidden="true">
                <span style={`--score: ${(category.score / summary.scale) * 100}%`} />
              </span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="review-summary__source">{summary.source.displayName}</p>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-carousel]').forEach((carousel) => {
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-review-slide]')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-review-dot]')];
    const previous = carousel.querySelector<HTMLButtonElement>('[data-review-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-review-next]');
    const count = carousel.querySelector<HTMLElement>('[data-review-count]');
    let current = 0;
    let pointerStart: { x: number; y: number; id: number } | undefined;

    const show = (index: number) => {
      carousel.querySelectorAll<HTMLButtonElement>('[data-review-more]').forEach((button) => {
        const slide = button.closest<HTMLElement>('[data-review-slide]');
        const preview = slide?.querySelector<HTMLElement>('[data-review-preview]');
        const full = slide?.querySelector<HTMLElement>('[data-review-full]');
        button.setAttribute('aria-expanded', 'false');
        button.textContent = 'More…';
        if (preview) preview.hidden = false;
        if (full) full.hidden = true;
      });
      current = Math.max(0, Math.min(index, slides.length - 1));
      slides.forEach((slide, slideIndex) => slide.setAttribute('aria-hidden', String(slideIndex !== current)));
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (previous) previous.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
      if (count) count.textContent = `${current + 1} of ${slides.length}`;
    };

    previous?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot) => dot.addEventListener('click', () => show(Number(dot.dataset.index))));
    carousel.querySelectorAll<HTMLButtonElement>('[data-review-more]').forEach((button) => {
      button.addEventListener('click', () => {
        const slide = button.closest<HTMLElement>('[data-review-slide]');
        const preview = slide?.querySelector<HTMLElement>('[data-review-preview]');
        const full = slide?.querySelector<HTMLElement>('[data-review-full]');
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        button.textContent = expanded ? 'More…' : 'Less';
        if (preview) preview.hidden = !expanded;
        if (full) full.hidden = expanded;
      });
    });
    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
    carousel.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary) return;
      pointerStart = { x: event.clientX, y: event.clientY, id: event.pointerId };
    });
    carousel.addEventListener('pointerup', (event) => {
      if (!pointerStart || pointerStart.id !== event.pointerId) return;
      const horizontal = event.clientX - pointerStart.x;
      const vertical = event.clientY - pointerStart.y;
      pointerStart = undefined;
      if (Math.abs(horizontal) < 50 || Math.abs(horizontal) <= Math.abs(vertical)) return;
      show(current + (horizontal < 0 ? 1 : -1));
    });
    carousel.addEventListener('pointercancel', () => {
      pointerStart = undefined;
    });
    show(0);
  });
</script>

<style>
  .review-section {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    scroll-margin-top: 6rem;
  }

  .review-section__heading {
    max-width: 44rem;
  }

  .review-section__heading h2,
  .review-section__heading p {
    margin: 0;
  }

  .review-section__heading h2 {
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    line-height: 1.08;
  }

  .review-section__heading > p:last-child {
    margin-top: 0.55rem;
    color: var(--muted);
  }

  .review-section__eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .review-carousel {
    overflow: hidden;
    padding: clamp(1.25rem, 5vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: linear-gradient(135deg, #fffaf2 0%, #f2e9dc 100%);
    box-shadow: var(--shadow);
    outline: none;
    touch-action: pan-y;
  }

  .review-section__panels {
    display: grid;
    gap: 1rem;
  }

  .review-summary {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--accent-dark);
    color: white;
    box-shadow: var(--shadow);
  }

  .review-summary__eyebrow,
  .review-summary__intro h3,
  .review-summary__intro p,
  .review-summary__source,
  .review-summary__scores,
  .review-summary__scores dd {
    margin: 0;
  }

  .review-summary__eyebrow {
    color: #e8c995;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .review-summary__intro h3 {
    margin-top: 0.35rem;
    color: inherit;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.45rem, 4vw, 2rem);
    line-height: 1.1;
  }

  .review-summary__intro > p:last-child {
    margin-top: 0.55rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.92rem;
  }

  .review-summary__scores {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }

  .review-summary__overall {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin: 1.15rem 0 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .review-summary__overall strong {
    color: #e8c995;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.25rem, 6vw, 3.2rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .review-summary__overall > span {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }

  .review-summary__score {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.25rem 1rem;
  }

  .review-summary__score dt {
    font-weight: 700;
  }

  .review-summary__score dd {
    display: contents;
  }

  .review-summary__score dd > strong {
    grid-column: 2;
    grid-row: 1;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }

  .review-summary__score dd > span:first-of-type {
    display: none;
  }

  .review-summary__track {
    grid-column: 1 / -1;
    overflow: hidden;
    height: 0.35rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .review-summary__track > span {
    display: block;
    width: var(--score);
    height: 100%;
    border-radius: inherit;
    background: #e8c995;
  }

  .review-summary__source {
    margin-top: auto;
    padding-top: 1.35rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .review-carousel:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 55%, white);
    outline-offset: 3px;
  }

  .review-carousel__slides {
    display: grid;
  }

  .review-carousel__slide {
    grid-area: 1 / 1;
    align-self: start;
    max-width: 52rem;
    margin: 0 auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(0.75rem);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .review-carousel__slide[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .review-carousel__rating {
    margin: 0;
    color: #9c5c08;
    font-size: clamp(1.25rem, 4vw, 1.65rem);
    letter-spacing: 0.12em;
  }

  .review-carousel__rating--below-five .review-carousel__filled-stars {
    color: var(--ink);
  }

  .review-carousel__rating--below-five .review-carousel__empty-stars {
    color: var(--muted);
  }

  .review-carousel blockquote {
    margin: 0.85rem 0 0;
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .review-carousel blockquote button {
    display: inline;
    margin-left: 0.35rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.78em;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }

  .review-carousel__attribution {
    margin: 1.15rem 0 0;
  }

  .review-carousel__listing,
  .review-carousel__source {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .review-carousel__source {
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .review-carousel__navigation {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
    max-width: 34rem;
    margin: 1.6rem auto 0;
  }

  .review-carousel__navigation > button {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: white;
    font-size: 1.15rem;
    cursor: pointer;
  }

  .review-carousel__navigation > button:disabled {
    border-color: var(--line);
    background: transparent;
    color: var(--muted);
    cursor: default;
    opacity: 0.65;
  }

  .review-carousel__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .review-carousel__pagination button {
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: 0;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .review-carousel__pagination span {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
  }

  .review-carousel__pagination button[aria-current='true'] span {
    background: var(--accent);
    transform: scale(1.18);
  }

  .review-carousel__count {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .review-carousel--empty {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-carousel__slide {
      transition: none;
    }
  }

  @media (min-width: 900px) {
    .review-section__panels {
      grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.75fr);
      align-items: stretch;
    }
  }
</style>
