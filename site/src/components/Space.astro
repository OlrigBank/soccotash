---
import type { CollectionEntry } from 'astro:content';

interface Props {
  space: CollectionEntry<'spaces'>;
  displayTitle?: string;
}

const { space, displayTitle = space.data.title } = Astro.props;
const primaryImage = space.data.image || space.data.gallery?.[0];
---

<article class="space-card">
  {primaryImage ? <img src={primaryImage} alt={displayTitle} loading="lazy" /> : null}
  <div class="space-card-content">
    <h3>{displayTitle}</h3>
  </div>
</article>
