---
import type { AiProposalDiff,AiProposalRecord } from '../lib/planner/ai-proposals.ts';
const {record,diff,endpoint,currentRevision}=Astro.props as {record:AiProposalRecord;diff:AiProposalDiff;endpoint:string;currentRevision:number};const selectable=[...diff.additions,...diff.changes,...diff.moves,...diff.removals];
---
<article><header class="hero"><p class="eyebrow">External AI proposal · guest decision</p><h1>{record.summary}</h1><p>Submitted {new Date(record.submittedAt).toLocaleString('en-GB')} from revision {record.sourceRevision}. Current comparison: {diff.stale?'outdated':'current'}.</p></header>{diff.stale&&<aside class="pricing-message is-error" role="alert">The plan has changed since this proposal was prepared. Review conflicts carefully.</aside>}
{[['Added',diff.additions],['Changed',diff.changes],['Moved',diff.moves],['Removed',diff.removals]].map(([label,entries])=><section class="booking-panel"><h2>{label} ({(entries as any[]).length})</h2>{(entries as any[]).length===0?<p>None.</p>:<ul>{(entries as any[]).map(operation=><li><strong>{operation.item?.title??operation.before?.title}</strong>{operation.changes&&<pre>{JSON.stringify(operation.changes,null,2)}</pre>}{operation.targetDayId&&<p>Target day: {operation.targetDayId}</p>}</li>)}</ul>}</section>)}
<section class="booking-panel"><h2>Conflicts ({diff.conflicts.length})</h2>{diff.conflicts.length===0?<p>None detected.</p>:<ul>{diff.conflicts.map(conflict=><li><strong>{conflict.reason}</strong> <code>{conflict.operation.op}</code></li>)}</ul>}</section><aside class="booking-panel"><strong>{record.status==='pending'?'No changes have been applied.':`Proposal ${record.status.replace('_',' ')}.`}</strong></aside>
{record.status==='pending'&&<section class="booking-panel"><h2>Decide proposal</h2><form data-accept-proposal>{selectable.map(operation=><label class="planner-wide"><input type="checkbox" name="selected" value={operation.operationIndex} checked/> Accept operation {operation.operationIndex+1}<textarea name={`replacement-${operation.operationIndex}`} data-original={JSON.stringify(record.proposal.operations[operation.operationIndex])} rows="6">{JSON.stringify(record.proposal.operations[operation.operationIndex],null,2)}</textarea></label>)}<button class="button" type="submit" disabled={selectable.length===0}>Apply selected operations</button></form><form data-reject-proposal><label>Reason<textarea name="reason" required maxlength="1000"></textarea></label><button class="button button--secondary" type="submit">Reject proposal</button></form><p data-decision-status role="status"></p></section>}
</article>
<script is:inline define:vars={{endpoint,currentRevision,proposalId:record.id}}>
const send=async body=>{const response=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...body,proposalId,expectedRevision:currentRevision})});const data=await response.json();if(!response.ok)throw new Error(data.error||'Decision failed.');location.reload()};document.querySelector('[data-accept-proposal]')?.addEventListener('submit',async event=>{event.preventDefault();try{const form=event.currentTarget;const selections=[...form.querySelectorAll('[name=selected]:checked')].map(box=>{const field=form.querySelector(`[name="replacement-${box.value}"]`);const replacement=JSON.parse(field.value);return JSON.stringify(replacement)===field.dataset.original?{operationIndex:Number(box.value)}:{operationIndex:Number(box.value),replacement}});await send({action:'acceptAiProposal',selections})}catch(error){document.querySelector('[data-decision-status]').textContent=error.message}});document.querySelector('[data-reject-proposal]')?.addEventListener('submit',async event=>{event.preventDefault();try{await send({action:'rejectAiProposal',reason:new FormData(event.currentTarget).get('reason')})}catch(error){document.querySelector('[data-decision-status]').textContent=error.message}})
</script>
