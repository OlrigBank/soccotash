---
import BookerVerification from './BookerVerification.astro';
import CompactBookingPanel from './CompactBookingPanel.astro';
---
<section class="booking-panel" data-booking-calendar>
  <ol class="booking-progress" aria-label="Booking request progress">
    <li class="is-current" data-progress-step="1" aria-current="step"><span>1</span><strong>Check your stay</strong></li>
    <li data-progress-step="2"><span>2</span><strong>Collect Booker detail</strong></li>
    <li data-progress-step="3"><span>3</span><strong>Review and send request</strong></li>
  </ol>
  <div data-stay-editor>
  <CompactBookingPanel source="booking" requestPage={true} quickCheck={true} autoSelectProperty={true} heading="Check your stay" idPrefix="request-stay" />
  <p class="booking-note">Check the total, then choose Book to enter your details. Your request does not confirm a booking or take payment.</p>
  </div>
  <section class="booking-stay-summary" data-stay-summary hidden aria-label="Your stay">
    <p data-stay-summary-text></p>
    <p data-stay-check-status role="status" aria-live="polite"></p>
    <button class="button" type="button" data-edit-stay>Edit stay</button>
    <button class="button" type="button" data-retry-stay hidden>Retry stay check</button>
  </section>
  <form class="booking-form" data-booking-form id="booking-request-details" tabindex="-1" aria-label="Booking request">
    <fieldset class="booking-step booking-contact" data-booking-contact data-booking-step="2" hidden disabled>
      <legend><span>Step 2</span> Collect Booker detail</legend>
      <p class="booking-step-intro">Tell us who is making the request and how you would like us to reply.</p>
      <div class="booking-field">
        <label for="guest-name">Booker name</label>
        <input id="guest-name" name="name" autocomplete="name" minlength="2" maxlength="120" required />
      </div>
      <p class="booking-field-wide">We will send a verification code when you finish entering your contact details.</p>
      <div class="booking-field">
        <label for="guest-email">Booker email</label>
        <input id="guest-email" name="email" type="email" autocomplete="email" maxlength="254" />
      </div>
      <div class="booking-field">
        <label for="guest-telephone">Mobile number</label>
        <input id="guest-telephone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" maxlength="80" aria-describedby="whatsapp-consent-help" />
      </div>
      <BookerVerification />
      <div class="booking-field booking-field-wide">
        <label class="booking-consent" for="whatsapp-consent">
          <input id="whatsapp-consent" name="whatsappConsent" type="checkbox" value="yes" />
          <span>Yes, Olrig Bank may send transactional WhatsApp messages about this booking and its payments. I can withdraw consent at any time. Email or my private booking page will remain available.</span>
        </label>
        <p id="whatsapp-consent-help" class="booking-note">Provide at least an email address or a telephone number. WhatsApp remains optional; if selected, enter a telephone number with its country code (for example, +44).</p>
      </div>
    <div class="booking-field booking-field-wide" data-pet-details hidden>
      <p><strong>Tell us about each pet</strong></p>
      <p class="booking-note">Species is required. Breed and size are optional. Identify a service animal separately below.</p>
      <div data-pet-detail-rows></div>
    </div>
      <div class="booking-field booking-field-wide">
        <label for="guest-promo-code">Promo code (optional)</label>
        <input id="guest-promo-code" name="promoCode" maxlength="80" aria-describedby="promo-code-help" />
        <p id="promo-code-help" class="booking-note">Promo code requires review. No discount has been applied to this total.</p>
      </div>
      <div class="booking-field booking-field-wide">
        <label for="guest-message">Message to Olrig Bank (optional)</label>
        <textarea id="guest-message" name="message" rows="4" maxlength="2000"></textarea>
      </div>
      <button class="button" type="button" data-continue-review disabled>Continue to review</button>
    </fieldset>
    <fieldset class="booking-step" data-booking-review hidden>
      <legend><span>Step 3</span> Review and send request</legend>
      <div class="booking-submit-review" data-booking-submit-review tabindex="-1"></div>
      <dl class="booking-answers" data-booking-answers></dl>
      <button class="button" type="button" data-edit-details>Edit details</button>
      <button class="button" type="submit" data-submit-booking>Request booking</button>
    </fieldset>
    <p class="booking-status" data-booking-status role="status" aria-live="polite"></p>
    <button class="button" type="button" data-review-stay hidden>Review your stay</button>
  </form>
</section>
<script>
  import type { BookingPanelElement, BookingPanelState, PanelQuote } from '../lib/booking/booking-panel';
  const root = document.querySelector<HTMLElement>('[data-booking-calendar]');
  const panel = root?.querySelector<BookingPanelElement>('[data-compact-booking-panel]');
  const form = root?.querySelector<HTMLFormElement>('[data-booking-form]');
  const contact = root?.querySelector<HTMLFieldSetElement>('[data-booking-contact]');
  const status = root?.querySelector<HTMLElement>('[data-booking-status]');
  const submitButton = root?.querySelector<HTMLButtonElement>('[data-submit-booking]');
  const submitReview = root?.querySelector<HTMLElement>('[data-booking-submit-review]');
  const reviewButton = root?.querySelector<HTMLButtonElement>('[data-review-stay]');
  const telephone = form?.querySelector<HTMLInputElement>('[name="telephone"]');
  const email = form?.querySelector<HTMLInputElement>('[name="email"]');
  const whatsappConsent = form?.querySelector<HTMLInputElement>('[name="whatsappConsent"]');
  const petDetails = root?.querySelector<HTMLElement>('[data-pet-details]');
  const petDetailRows = root?.querySelector<HTMLElement>('[data-pet-detail-rows]');
  const isVerified = () => root?.querySelector<HTMLElement>('[data-booker-verification]')?.dataset.verified === 'true';
  const submissionId = crypto.randomUUID();
  root?.addEventListener('booker-verification-change', () => { updateCheck(); if (!isVerified() && activeStep === 3) setProgress(2); });
  let reviewedState: BookingPanelState | null = null;
  let submitting = false;
  let activeStep = 1;
  let initialEntryHandled = false;
  const stayEditor = root?.querySelector<HTMLElement>('[data-stay-editor]');
  const staySummary = root?.querySelector<HTMLElement>('[data-stay-summary]');
  const staySummaryText = root?.querySelector<HTMLElement>('[data-stay-summary-text]');
  const checkStatus = root?.querySelector<HTMLElement>('[data-stay-check-status]');
  const retryStay = root?.querySelector<HTMLButtonElement>('[data-retry-stay]');
  const review = root?.querySelector<HTMLFieldSetElement>('[data-booking-review]');
  const answers = root?.querySelector<HTMLElement>('[data-booking-answers]');
  const continueReview = root?.querySelector<HTMLButtonElement>('[data-continue-review]');
  const money = (pence: number) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(pence / 100);

  const dateLabel = (value: string) => {
    const parsed = new Date(`${value}T00:00:00Z`);
    return Number.isNaN(parsed.getTime()) ? value : new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(parsed);
  };
  const partyLabel = (selection: BookingPanelState['selection']) => [
    `${selection.adults} adult${selection.adults === 1 ? '' : 's'}`,
    selection.children ? `${selection.children} child${selection.children === 1 ? '' : 'ren'}` : '',
    selection.infants ? `${selection.infants} infant${selection.infants === 1 ? '' : 's'}` : '',
    selection.pets ? `${selection.pets} pet${selection.pets === 1 ? '' : 's'}` : '',
  ].filter(Boolean).join(', ');

  function setProgress(step: number) {
    activeStep = step;
    if (stayEditor) stayEditor.hidden = step !== 1;
    if (staySummary) staySummary.hidden = step === 1;
    if (contact) contact.hidden = step !== 2;
    if (review) review.hidden = step !== 3;
    root?.querySelectorAll<HTMLElement>('[data-progress-step]').forEach((item) => {
      const current = Number(item.dataset.progressStep);
      item.classList.toggle('is-current', current === step);
      item.classList.toggle('is-complete', current < step);
      if (current === step) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
    });
  }

  function renderPetDetails() {
    if (!petDetails || !petDetailRows) return;
    const count = Math.max(0, Number(panel?.bookingPanel?.getState().selection.pets || 0));
    petDetails.hidden = count === 0;
    const previous = [...petDetailRows.querySelectorAll<HTMLElement>('[data-pet-row]')].map((row) => ({ species: row.querySelector<HTMLSelectElement>('[data-pet-species]')?.value || 'dog', otherSpecies: row.querySelector<HTMLInputElement>('[data-pet-other]')?.value || '', breed: row.querySelector<HTMLInputElement>('[data-pet-breed]')?.value || '', size: row.querySelector<HTMLSelectElement>('[data-pet-size]')?.value || '', serviceAnimal: row.querySelector<HTMLInputElement>('[data-pet-service]')?.checked || false }));
    petDetailRows.replaceChildren();
    for (let index = 0; index < count; index += 1) {
      const saved = previous[index] || { species: 'dog', otherSpecies: '', breed: '', size: '', serviceAnimal: false };
      const row = document.createElement('fieldset'); row.dataset.petRow = String(index); row.className = 'booking-pet-detail';
      row.innerHTML = `<legend>Pet ${index + 1}</legend><label>Species<select data-pet-species required><option value="dog">Dog</option><option value="cat">Cat</option><option value="other">Other</option></select></label><label data-pet-other-label hidden>Other species<input data-pet-other maxlength="80"></label><label>Breed (optional)<input data-pet-breed maxlength="80"></label><label>Size (optional)<select data-pet-size><option value="">Not specified</option><option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option></select></label><label class="booking-consent"><input type="checkbox" data-pet-service><span>This pet is a service animal</span></label>`;
      const species = row.querySelector<HTMLSelectElement>('[data-pet-species]')!; const other = row.querySelector<HTMLInputElement>('[data-pet-other]')!; const otherLabel = row.querySelector<HTMLElement>('[data-pet-other-label]')!;
      species.value = saved.species; other.value = saved.otherSpecies; row.querySelector<HTMLInputElement>('[data-pet-breed]')!.value = saved.breed; row.querySelector<HTMLSelectElement>('[data-pet-size]')!.value = saved.size; row.querySelector<HTMLInputElement>('[data-pet-service]')!.checked = saved.serviceAnimal;
      const toggleOther = () => { otherLabel.hidden = species.value !== 'other'; other.required = species.value === 'other'; if (species.value !== 'other') other.value = ''; }; species.addEventListener('change', toggleOther); toggleOther(); petDetailRows.append(row);
    }
  }


  function renderReview(state: BookingPanelState) {
    if (!submitReview) return;
    submitReview.replaceChildren();
    const summary = document.createElement('p');
    const { selection, quote } = state;
    const stay = panel?.querySelector<HTMLSelectElement>('[name="propertyId"]')?.selectedOptions[0]?.textContent || 'Your stay';
    summary.textContent = `${stay} · ${dateLabel(selection.arrival)} – ${dateLabel(selection.departure)} · ${partyLabel(selection)}`;
    const total = document.createElement('strong');
    total.textContent = quote?.pricingAvailable ? `Total: ${money(Number(quote.guestTotalPence || 0))}`
      : quote?.estimatedPricing ? `Estimated total: ${money(Number(quote.estimatedPricing.guestTotalPence || 0))}. This request requires review before an offer can be made.`
      : 'Price to be agreed. This request requires review before an offer can be made.';
    submitReview.append(summary, total);
    const nextStep = document.createElement('p');
    const promoCode = String(new FormData(form!).get('promoCode') || '').trim();
    nextStep.textContent = promoCode ? 'Promo code requires review. No discount has been applied to this total.'
      : quote?.reviewReason || (quote?.automaticOffer ? 'Send your request to receive an offer at this total. You can then accept or decline it.' : 'This request requires review before an offer can be made.');
    submitReview.append(nextStep);
    if (quote?.lines?.length) {
      const details = document.createElement('details');
      const heading = document.createElement('summary'); heading.textContent = 'Price details';
      const list = document.createElement('dl');
      for (const line of quote.lines) {
        const term = document.createElement('dt'); term.textContent = [line.label, line.detail].filter(Boolean).join(' — ');
        const amount = document.createElement('dd'); amount.textContent = money(Number(line.amountPence || 0));
        list.append(term, amount);
      }
      details.append(heading, list); submitReview.append(details);
    }
    submitReview.hidden = false;
  }

  function focusForm() {
    form?.focus({ preventScroll: true });
    form?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  }

  function updateCheck() {
    const state = panel?.bookingPanel?.getState();
    const check = panel?.bookingPanel?.getCheckState();
    if (!state || !check) return;
    if (staySummaryText) {
      const selection = state.selection;
      const stay = panel?.querySelector<HTMLSelectElement>('[name="propertyId"]')?.selectedOptions[0]?.textContent || 'Your stay';
      staySummaryText.textContent = `${stay} · ${dateLabel(selection.arrival)} – ${dateLabel(selection.departure)} · ${partyLabel(selection)} · ${state.quote?.pricingAvailable ? `Total: ${money(Number(state.quote.guestTotalPence || 0))}` : state.quote?.estimatedPricing ? `Estimated total: ${money(Number(state.quote.estimatedPricing.guestTotalPence || 0))}` : 'Price to be agreed'}`;
    }
    if (checkStatus) checkStatus.textContent = check.checking ? 'Checking the latest availability and price…'
      : check.error || (state.quote ? state.quote.pricingAvailable
        ? `Total: ${money(Number(state.quote.guestTotalPence || 0))}. ${state.quote.reviewReason || 'Send your request to receive an offer at this total.'}`
        : 'This request requires review before an offer can be made.' : 'Check your stay before continuing to review.');
    if (retryStay) retryStay.hidden = !check.error || check.checking;
    if (continueReview) continueReview.disabled = !state.quote || check.checking || !isVerified();
    if (!initialEntryHandled && check.initialContinuation) {
      initialEntryHandled = true;
      if (contact) contact.disabled = false;
      renderPetDetails();
      setProgress(2);
      // Keep the progress and stay summary visible on entry; do not steal typing focus.
    }
  }

  function continueRequest(state: BookingPanelState) {
    if (!contact || !form || !state.quote || submitting) return;
    renderPetDetails();
    contact.disabled = false;
    if (status) status.textContent = '';
    if (reviewButton) reviewButton.hidden = true;
    setProgress(2);
    updateCheck();
    focusForm();
  }
  panel?.addEventListener('booking-panel-continue', (event) => continueRequest((event as CustomEvent<BookingPanelState>).detail));
  panel?.addEventListener('booking-panel-check', updateCheck);
  panel?.addEventListener('booking-panel-invalidated', () => {
    reviewedState = null;
    if (submitButton) submitButton.disabled = true;
    if (continueReview) continueReview.disabled = true;
    if (activeStep === 3 && !submitting) setProgress(2);
    updateCheck();
  });
  function editStay() {
    if (submitting) return;
    reviewedState = null;
    if (status) status.textContent = '';
    if (reviewButton) reviewButton.hidden = true;
    setProgress(1);
    panel?.querySelector<HTMLSelectElement>('[name="propertyId"]')?.focus();
    panel?.scrollIntoView({ block: 'start' });
  }
  root?.querySelector('[data-edit-stay]')?.addEventListener('click', editStay);
  reviewButton?.addEventListener('click', editStay);
  retryStay?.addEventListener('click', () => panel?.bookingPanel?.check());
  root?.querySelector('[data-edit-details]')?.addEventListener('click', () => {
    if (submitting) return;
    reviewedState = null;
    setProgress(2); focusForm();
  });
  function validateDetails() {
    if (email) email.setCustomValidity(!email.value.trim() && !telephone?.value.trim() ? 'Provide an email address or a telephone number.' : '');
    return Boolean(form?.reportValidity());
  }
  function renderAnswers() {
    if (!form || !answers) return;
    answers.replaceChildren();
    const add = (label: string, value: string) => {
      const term = document.createElement('dt'); term.textContent = label;
      const description = document.createElement('dd'); description.textContent = value;
      answers.append(term, description);
    };
    const data = new FormData(form);
    add('Booker name', String(data.get('name') || ''));
    add('Booker email', String(data.get('email') || 'Not supplied'));
    add('Mobile number', String(data.get('telephone') || 'Not supplied'));
    add('WhatsApp messages', whatsappConsent?.checked ? 'Consent given' : 'Not requested');
    for (const [index, row] of [...form.querySelectorAll<HTMLElement>('[data-pet-row]')].entries()) {
      const value = (selector: string) => row.querySelector<HTMLInputElement | HTMLSelectElement>(selector)?.value || '';
      add(`Pet ${index + 1}`, [value('[data-pet-species]') === 'other' ? value('[data-pet-other]') : value('[data-pet-species]'), value('[data-pet-breed]'), value('[data-pet-size]'), row.querySelector<HTMLInputElement>('[data-pet-service]')?.checked ? 'Service animal' : ''].filter(Boolean).join(' · '));
    }
    const promoCode = String(data.get('promoCode') || '').trim();
    add('Promo code', promoCode ? `${promoCode} — Promo code requires review. No discount has been applied to this total.` : 'Not supplied');
    add('Message to Olrig Bank', String(data.get('message') || '').trim() || 'Not supplied');
  }
  continueReview?.addEventListener('click', () => {
    const state = panel?.bookingPanel?.getState();
    if (submitting || !state?.quote || !isVerified() || !validateDetails()) return;
    reviewedState = state;
    renderReview(state); renderAnswers();
    if (submitButton) submitButton.disabled = false;
    if (status) status.textContent = '';
    setProgress(3); focusForm();
  });
  // Component scripts may initialise in either order.
  updateCheck();
  whatsappConsent?.addEventListener('change', () => {
    if (telephone) telephone.required = Boolean(whatsappConsent.checked);
  });
  for (const input of [email, telephone]) input?.addEventListener('input', () => email?.setCustomValidity(''));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !contact || submitting) return;
    if (activeStep !== 3) { continueReview?.click(); return; }
    const currentState = panel?.bookingPanel?.getState();
    if (!reviewedState?.quote || !currentState?.quote || JSON.stringify(reviewedState) !== JSON.stringify(currentState)) {
      status.textContent = 'Check your stay and choose Book before sending your request.';
      if (reviewButton) reviewButton.hidden = false;
      return;
    }
    if (email && !email.value.trim() && !telephone?.value.trim()) email.setCustomValidity('Provide an email address or a telephone number.');
    if (!isVerified()) { setProgress(2); status.textContent = 'Verify your contact before submitting.'; return; }
    if (!form.checkValidity()) { setProgress(2); validateDetails(); return; }
    const data = new FormData(form);
    const state = reviewedState;
    const quote = state.quote!;
    const payload = {
      submissionId,
      ...Object.fromEntries(data.entries()),
      ...state.selection,
      petDetails: [...form.querySelectorAll<HTMLElement>('[data-pet-row]')].map((row) => ({
        species: row.querySelector<HTMLSelectElement>('[data-pet-species]')?.value,
        otherSpecies: row.querySelector<HTMLInputElement>('[data-pet-other]')?.value,
        breed: row.querySelector<HTMLInputElement>('[data-pet-breed]')?.value,
        size: row.querySelector<HTMLSelectElement>('[data-pet-size]')?.value,
        serviceAnimal: row.querySelector<HTMLInputElement>('[data-pet-service]')?.checked,
      })),
      reviewedPricing: quote.pricingAvailable ? {
        pricingAvailable: true, planId: quote.plan?.id, planVersion: quote.plan?.version, guestTotalPence: quote.guestTotalPence,
      } : { pricingAvailable: false },
    };
    submitting = true;
    let returnToStay = false;
    contact.disabled = true;
    panel?.setAttribute('inert', '');
    if (review) review.disabled = true;
    if (staySummary) staySummary.inert = true;
    status.textContent = 'Rechecking the price and creating your private booking page…';
    try {
      const response = await fetch('/api/provisional-bookings/', {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
      });
      const body = await response.json();
      if (!response.ok) {
        if (body.verificationRequired) { root?.querySelector('[data-booker-verification]')?.dispatchEvent(new Event('booker-verification-required')); setProgress(2); status.textContent = body.error; return; }
        if (response.status === 409 && body.quote && typeof body.quote === 'object') {
          panel?.bookingPanel?.setQuote(body.quote as PanelQuote);
          reviewedState = panel?.bookingPanel?.getState() || null;
          if (reviewedState) renderReview(reviewedState);
          setProgress(3);
          status.textContent = body.error || 'The provisional price changed. Review the updated total and submit again.';
          submitReview?.scrollIntoView({ block: 'center' });
          submitReview?.setAttribute('tabindex', '-1'); submitReview?.focus({ preventScroll: true });
        } else {
          if (response.status === 409 || response.status === 422) {
            panel?.bookingPanel?.invalidate();
            setProgress(1);
            returnToStay = true;
            if (reviewButton) reviewButton.hidden = false;
          }
          status.textContent = body.error || 'The request could not be saved. Please try again.';
        }
        return;
      }
      const managePath = typeof body.managePath === 'string' ? body.managePath : '';
      if (!/^\/booking\/manage\/[0-9a-f-]{36}\/$/.test(managePath)) {
        status.textContent = 'The request was saved, but its private page could not be opened. Please contact Olrig Bank before making another request.';
        reviewedState = null;
        return;
      }
      window.olrigAnalytics?.track('booking_requested', { property: state.selection.propertyId, pricing_available: quote.pricingAvailable === true });
      window.location.assign(managePath);
    } catch {
      status.textContent = 'The request could not be saved. Please try again.';
    } finally {
      submitting = false;
      contact.disabled = false;
      panel?.removeAttribute('inert');
      if (review) review.disabled = false;
      if (staySummary) staySummary.inert = false;
      if (submitButton) submitButton.disabled = !reviewedState;
      if (returnToStay) {
        panel?.querySelector<HTMLSelectElement>('[name="propertyId"]')?.focus();
        panel?.scrollIntoView({ block: 'start' });
      }
    }
  });
</script>
<style>
  .booking-progress { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  [data-stay-editor][hidden], [data-stay-summary][hidden], [data-booking-contact][hidden], [data-booking-review][hidden], [data-retry-stay][hidden] { display: none; }
  .booking-stay-summary { padding: 1rem; border: 1px solid var(--border, #c5cdc7); border-radius: 1rem; margin-block: 1rem; }
  .booking-stay-summary p { overflow-wrap: anywhere; }
  .booking-answers { grid-column: 1 / -1; margin: 0; }
  .booking-answers :global(dt) { font-weight: 700; margin-top: 1rem; }
  .booking-answers :global(dd) { margin: 0.25rem 0 0; overflow-wrap: anywhere; white-space: pre-wrap; }
  .booking-submit-review { grid-column: 1 / -1; overflow-wrap: anywhere; }
  .booking-progress strong { overflow-wrap: anywhere; }
  @media (max-width: 480px) { .booking-progress { gap: 0.5rem; } .booking-progress li { padding: 0.65rem; } }
  .booking-field[hidden] { display: none; }
  .booking-field :global(label.booking-consent) { display: flex; align-items: flex-start; gap: 0.75rem; font-weight: 400; }
  .booking-field :global(.booking-consent input[type='checkbox']) { flex: 0 0 1.4rem; width: 1.4rem; min-height: 1.4rem; margin-top: 0.2rem; padding: 0; }
  .booking-submit-review { display: block; }
  .booking-submit-review :global(p) { margin-top: 0; }
  #booking-request-details { scroll-margin-top: 1rem; }
  #booking-request-details:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  [data-review-stay][hidden] { display: none; }
</style>
