---
import { getProperties } from '../lib/booking/config';

interface Props {
  propertyId?: string;
  source?: 'homepage' | 'listing' | 'public' | 'booking';
  requestPage?: boolean;
  quickCheck?: boolean;
  heading?: string;
  idPrefix?: string;
  submitLabel?: string;
  autoSelectProperty?: boolean;
  mobileDock?: boolean;
  defaultAdults?: number;
}

const {
  propertyId,
  requestPage = false,
  source = propertyId ? 'listing' : 'homepage',
  heading = 'Plan your stay',
  idPrefix = `compact-booking-${source}`,
  submitLabel = 'Quick Check',
  autoSelectProperty = false,
  mobileDock = false,
  defaultAdults = 2,
  quickCheck = autoSelectProperty,
} = Astro.props;
const properties = getProperties();
const fixedProperty = propertyId ? properties.find((property) => property.id === propertyId) : undefined;
const fixedBespoke = fixedProperty?.id === 'bespoke-arrangement';

if (propertyId && !fixedProperty) {
  throw new Error(`Unknown compact booking property: ${propertyId}`);
}

---

<section
  class:list={['compact-booking-panel', mobileDock && 'compact-booking-panel--mobile-dock']}
  data-compact-booking-panel
  data-request-page={requestPage ? 'true' : undefined}
  data-mobile-dock={mobileDock ? 'true' : undefined}
  data-source={source}
  data-listing-property={fixedProperty?.id}
  data-submit-label={submitLabel}
  data-auto-select-property={autoSelectProperty ? 'true' : undefined}
  data-properties={quickCheck ? JSON.stringify(properties.map(({ id, name, listingSlug, minimumNights, maximumGuests }) => ({ id, name, listingSlug, minimumNights, maximumGuests }))) : undefined}
  aria-labelledby={heading ? `${idPrefix}-heading` : undefined}
  aria-label={heading ? undefined : 'Quick Check'}
>
  {heading ? <div class="compact-booking-panel__heading">
    {quickCheck ? null : <p class="eyebrow">{fixedBespoke ? 'Begin an enquiry' : 'Check a stay'}</p>}
    <h2 id={`${idPrefix}-heading`}>{heading}</h2>
  </div> : null}

  <noscript><p><a href={fixedProperty ? `/book/?propertyId=${fixedProperty.id}` : '/book/'}>Continue to the full request form</a></p></noscript>

  <form id={`${idPrefix}-form`} class="compact-booking-form" data-compact-booking-form>
    {quickCheck ? null : fixedProperty ? (
      <div class="compact-booking-field compact-booking-field--property">
        <span>Stay arrangement</span>
        <strong>{fixedProperty.name}</strong>
        <input type="hidden" name="propertyId" value={fixedProperty.id} data-minimum-nights={fixedProperty.minimumNights} />
      </div>
    ) : (
      <label class="compact-booking-field compact-booking-field--property" for={`${idPrefix}-property`}>
        <span>Stay arrangement</span>
        <select id={`${idPrefix}-property`} name="propertyId" required>
          {properties.map((property) => (
            <option value={property.id} data-minimum-nights={property.minimumNights}>{property.name}</option>
          ))}
        </select>
      </label>
    )}

    <div class="compact-booking-date-picker">
    {quickCheck ? (
      <button class="compact-booking-date-trigger" type="button" data-compact-date-trigger aria-controls={`${idPrefix}-calendar`} aria-expanded="false">
        <span><small>Check-in</small><strong data-compact-arrival-label>Add date</strong></span>
        <span><small>Check-out</small><strong data-compact-departure-label>Add date</strong></span>
        <input id={`${idPrefix}-arrival`} name="arrival" type="hidden" required />
        <input id={`${idPrefix}-departure`} name="departure" type="hidden" required />
      </button>
    ) : (
      <>
        <label class="compact-booking-field" for={`${idPrefix}-arrival`}>
          <span>Arrival</span>
          <input id={`${idPrefix}-arrival`} name="arrival" type="date" required aria-controls={`${idPrefix}-calendar`} aria-expanded="false" />
        </label>
        <label class="compact-booking-field" for={`${idPrefix}-departure`}>
          <span>Departure</span>
          <input id={`${idPrefix}-departure`} name="departure" type="date" required aria-controls={`${idPrefix}-calendar`} aria-expanded="false" />
        </label>
      </>
    )}
    <fieldset
      id={`${idPrefix}-calendar`}
      class="compact-date-calendar"
      data-compact-date-calendar
      data-compact-mobile-dialog={mobileDock ? 'true' : undefined}
      aria-labelledby={mobileDock ? `${idPrefix}-calendar-title` : undefined}
    >
      <legend id={`${idPrefix}-calendar-title`}>Choose arrival and departure</legend>
      {mobileDock ? (
        <div class="compact-sheet__header">
          <strong aria-hidden="true">Choose arrival and departure</strong>
          <button class="compact-sheet__close" type="button" data-compact-sheet-close="date" aria-label="Close date selection">×</button>
        </div>
      ) : null}
      <div class="compact-date-calendar__toolbar">
        <button type="button" data-compact-calendar-previous aria-label="Show previous month">←</button>
        <strong data-compact-calendar-heading>Availability calendar</strong>
        <button type="button" data-compact-calendar-next aria-label="Show next month">→</button>
      </div>
      <p data-compact-calendar-message role="status" aria-live="polite">Choose your arrival date, then your departure date.</p>
      <p data-compact-calendar-availability role="status" aria-live="polite"></p>
      <button type="button" data-compact-calendar-retry hidden>Retry availability</button>
      <div class="compact-date-calendar__months" data-compact-calendar-months></div>
      <p class="compact-date-calendar__legend" data-compact-calendar-legend hidden>Available · ▨ Unavailable · Outlined dates: selected arrival and departure</p>
    </fieldset>
    </div>
    {quickCheck ? (
      <details class="compact-guests" data-compact-guests>
        <summary><span>Guests</span><strong data-compact-guests-summary>{defaultAdults} {defaultAdults === 1 ? 'adult' : 'adults'}</strong></summary>
        <div
          class="compact-guests__popover"
          role="group"
          data-compact-mobile-dialog={mobileDock ? 'true' : undefined}
          aria-label={mobileDock ? 'Choose guests' : undefined}
        >
          {mobileDock ? (
            <button class="compact-sheet__close" type="button" data-compact-sheet-close="guests" aria-label="Close guest selection">×</button>
          ) : null}
          {[
            ['adults', 'Adults', 'Ages 13+ on arrival', 1, defaultAdults],
            ['children', 'Children', 'Ages 2–12 on arrival', 0, 0],
            ['infants', 'Infants', 'Under 2 on arrival', 0, 0],
            ['pets', 'Pets', '', 0, 0],
          ].map(([name, label, help, minimum, value]) => (
            <div class="compact-guests__row">
              <span><strong>{label}</strong>{help ? <small>{help}</small> : null}</span>
              <div>
                <button type="button" data-compact-guest-adjust={name} data-direction="-1" aria-label={`Remove ${String(label).toLowerCase()}`}>−</button>
                <input id={`${idPrefix}-${name}`} name={String(name)} type="number" min={Number(minimum)} value={Number(value)} required readonly aria-label={String(label)} />
                <button type="button" data-compact-guest-adjust={name} data-direction="1" aria-label={`Add ${String(label).toLowerCase()}`}>+</button>
              </div>
            </div>
          ))}
          <button class="button compact-guests__done" type="button" data-compact-guests-done>Done</button>
        </div>
      </details>
    ) : (
      <>
        <label class="compact-booking-field" for={`${idPrefix}-adults`}><span>Adults <small>13+</small></span><input id={`${idPrefix}-adults`} name="adults" type="number" min="1" value={defaultAdults} required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-children`}><span>Children <small>2–12</small></span><input id={`${idPrefix}-children`} name="children" type="number" min="0" value="0" required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-infants`}><span>Infants <small>Under 2</small></span><input id={`${idPrefix}-infants`} name="infants" type="number" min="0" value="0" required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-pets`}><span>Pets</span><input id={`${idPrefix}-pets`} name="pets" type="number" min="0" value="0" required /></label>
      </>
    )}

    {quickCheck ? (
      <>
        <div class="compact-booking-field compact-booking-quick-result" data-compact-quick-total hidden>
          <span>Total</span>
          <strong data-compact-quick-total-value></strong>
        </div>
        <div class="compact-booking-field compact-booking-quick-result compact-booking-stay" data-compact-quick-stay>
          {requestPage ? (
            <><label for={`${idPrefix}-stay`}>Stay</label>
            <select id={`${idPrefix}-stay`} name="propertyId" aria-label="Stay">
              <option value="">Find a suitable stay</option>
              {properties.map((stay) => <option value={stay.id}>{stay.name.replace(/\s+\(max \d+ guests\)$/i, '')}</option>)}
            </select></>
          ) : (<>
          <input type="hidden" name="propertyId" value={fixedProperty?.id || ''} />
          <details data-compact-stay-menu>
            <summary><span>Stay</span><strong data-compact-stay-name>{fixedProperty?.name.replace(/\s+\(max \d+ guests\)$/i, '') || 'Find a suitable stay'}</strong></summary>
            <ul class="compact-stay-options" aria-label="Choose a stay">
              {properties.map((stay) => (
                <li><a href={`/listings/${stay.listingSlug}/`} data-compact-stay-link={stay.id}>
                  {stay.name.replace(/\s+\(max \d+ guests\)$/i, '')}
                </a></li>
              ))}
            </ul>
          </details>
          </>)}
        </div>
      </>
    ) : null}

    <div class="compact-booking-panel__action">
      <button class="button" type="submit" data-compact-booking-submit>
        {fixedBespoke ? 'Start a bespoke request' : submitLabel}
      </button>
    </div>
    <p class="compact-booking-panel__quick-message" data-compact-quick-message role="status" aria-live="polite"></p>

  </form>

  <div
    class="compact-booking-response"
    role="group"
    data-compact-booking-response
    aria-label="Quick Check result"
  >
    {autoSelectProperty ? (
      <div class="compact-booking-recommendation" data-compact-booking-recommendation>
        {!quickCheck ? <input type="hidden" name="propertyId" value="" form={`${idPrefix}-form`} /> : null}
        <section class="compact-booking-result" data-compact-booking-result hidden aria-live="polite"></section>
      </div>
    ) : null}
    <p class="compact-booking-panel__bespoke" data-compact-booking-bespoke hidden={!fixedBespoke}>
      Tell us your preferred dates and party. This does not reserve or block the dates. Accommodation, availability and price require review.
    </p>
    <p id={`${idPrefix}-status`} class="compact-booking-panel__status" data-compact-booking-status role="status" aria-live="polite"></p>
    {autoSelectProperty ? null : <section class="compact-booking-result" data-compact-booking-result hidden aria-live="polite"></section>}
  </div>
  {mobileDock ? <button class="compact-sheet-backdrop" type="button" data-compact-sheet-backdrop aria-label="Close open Quick Check panel" hidden></button> : null}
</section>

<script>
  import { nightIsBlocked, rangeIsBlocked } from '../lib/booking/booking-panel';
  import type { PanelQuote as QuoteResponse, BookingPanelElement, AvailabilityBlock } from '../lib/booking/booking-panel';

  const money = (pence: number, currency = 'GBP') => new Intl.NumberFormat('en-GB', {
    style: 'currency', currency,
  }).format(pence / 100);

  const today = () => new Date().toISOString().slice(0, 10);

  document.querySelectorAll<BookingPanelElement>('[data-compact-booking-panel]').forEach((panel) => {
    const form = panel.querySelector<HTMLFormElement>('[data-compact-booking-form]');
    const property = panel.querySelector<HTMLSelectElement | HTMLInputElement>('[name="propertyId"]');
    const arrival = panel.querySelector<HTMLInputElement>('[name="arrival"]');
    const departure = panel.querySelector<HTMLInputElement>('[name="departure"]');
    const submit = panel.querySelector<HTMLButtonElement>('[data-compact-booking-submit]');
    const action = panel.querySelector<HTMLElement>('.compact-booking-panel__action');
    const status = panel.querySelector<HTMLElement>('[data-compact-booking-status]');
    const result = panel.querySelector<HTMLElement>('[data-compact-booking-result]');
    const bespokeMessage = panel.querySelector<HTMLElement>('[data-compact-booking-bespoke]');
    const calendar = panel.querySelector<HTMLElement>('[data-compact-date-calendar]');
    const calendarHeading = panel.querySelector<HTMLElement>('[data-compact-calendar-heading]');
    const calendarMessage = panel.querySelector<HTMLElement>('[data-compact-calendar-message]');
    const calendarDays = panel.querySelector<HTMLElement>('[data-compact-calendar-months]');
    const calendarAvailability = panel.querySelector<HTMLElement>('[data-compact-calendar-availability]')!;
    const calendarRetry = panel.querySelector<HTMLButtonElement>('[data-compact-calendar-retry]')!;
    const calendarLegend = panel.querySelector<HTMLElement>('[data-compact-calendar-legend]')!;
    const requestPage = panel.dataset.requestPage === 'true';
    let checkedQuote: QuoteResponse | null = null;
    let initialContinuation = false;
    let checking = false;
    let checkError = '';
    const notifyCheck = () => panel.dispatchEvent(new CustomEvent('booking-panel-check'));

    const calendarPrevious = panel.querySelector<HTMLButtonElement>('[data-compact-calendar-previous]');
    const calendarNext = panel.querySelector<HTMLButtonElement>('[data-compact-calendar-next]');
    const recommendation = panel.querySelector<HTMLElement>('[data-compact-booking-recommendation]');
    const stayMenu = panel.querySelector<HTMLDetailsElement>('[data-compact-stay-menu]');
    const stayName = panel.querySelector<HTMLElement>('[data-compact-stay-name]');
    const quickTotal = panel.querySelector<HTMLElement>('[data-compact-quick-total]');
    const quickTotalValue = panel.querySelector<HTMLElement>('[data-compact-quick-total-value]');
    const quickMessage = panel.querySelector<HTMLElement>('[data-compact-quick-message]');
    const sheetBackdrop = panel.querySelector<HTMLButtonElement>('[data-compact-sheet-backdrop]');
    const mobileQuery = matchMedia('(max-width: 699px)');
    let mobileDock = panel.dataset.mobileDock === 'true' && mobileQuery.matches;
    const syncResponsiveMode = () => {
      mobileDock = panel.dataset.mobileDock === 'true' && mobileQuery.matches;
      panel.querySelectorAll<HTMLElement>('[data-compact-mobile-dialog]').forEach((dialog) => {
        if (mobileDock) {
          dialog.setAttribute('role', 'dialog');
          dialog.setAttribute('aria-modal', 'true');
        } else {
          if (dialog.tagName === 'DIV') dialog.setAttribute('role', 'group');
          else dialog.removeAttribute('role');
          dialog.removeAttribute('aria-modal');
        }
      });
    };

    syncResponsiveMode();
    let checkedHref = '';
    let inputRevision = 0;
    const suggestedStay = panel.dataset.autoSelectProperty === 'true';
    const configured = JSON.parse(panel.dataset.properties || '[]') as Array<{
      id: string; name: string; listingSlug: string; minimumNights: number; maximumGuests: number;
    }>;
    let initialising = true;
    const dateTrigger = panel.querySelector<HTMLButtonElement>('[data-compact-date-trigger]');
    const arrivalLabel = panel.querySelector<HTMLElement>('[data-compact-arrival-label]');
    const departureLabel = panel.querySelector<HTMLElement>('[data-compact-departure-label]');
    const guests = panel.querySelector<HTMLDetailsElement>('[data-compact-guests]');
    const guestsSummary = panel.querySelector<HTMLElement>('[data-compact-guests-summary]');
    type MobileSheet = 'date' | 'guests';
    let activeMobileSheet: MobileSheet | null = null;
    let activeMobileTrigger: HTMLElement | null = null;
    let dateSnapshot = { arrival: '', departure: '' };
    let guestSnapshot: Record<string, string> = {};
    if (!form || !property || !arrival || !departure || !submit || !status || !result || !bespokeMessage
      || !calendar || !calendarHeading || !calendarMessage || !calendarDays || !calendarPrevious || !calendarNext) return;

    arrival.min = today();
    departure.min = today();
    arrival.readOnly = true;
    departure.readOnly = true;
    panel.classList.add('compact-booking-panel--calendar-ready');

    const setCalendarOpen = (open: boolean) => {
      panel.classList.toggle('compact-booking-panel--calendar-open', open);
      arrival.setAttribute('aria-expanded', String(open));
      departure.setAttribute('aria-expanded', String(open));
      dateTrigger?.setAttribute('aria-expanded', String(open));
    };

    const parseDate = (value: string) => new Date(`${value}T00:00:00.000Z`);
    const dateIso = (date: Date) => date.toISOString().slice(0, 10);
    const addDays = (value: string, days: number) => {
      const date = parseDate(value);
      date.setUTCDate(date.getUTCDate() + days);
      return dateIso(date);
    };
    const monthStart = (value: string) => {
      const date = parseDate(value);
      return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1));
    };
    const addMonths = (date: Date, months: number) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
    const firstMonth = monthStart(today());
    let calendarMonth = firstMonth;
    let calendarBlocks: AvailabilityBlock[] = [];
    let calendarRevision = 0;
    let calendarLoading = false;
    let calendarFailed = false;
    let calendarProperty = '';
    let availabilityFrom = '';
    let availabilityTo = '';
    const hasCalendarStay = () => Boolean(property.value && property.value !== 'bespoke-arrangement');
    const calendarReady = () => !hasCalendarStay() || (!calendarLoading && !calendarFailed && calendarProperty === property.value);
    const canDepart = (value: string) => Boolean(arrival.value && !departure.value
      && value >= addDays(arrival.value, minimumNights())
      && !rangeIsBlocked(calendarBlocks, arrival.value, value));
    const loadCalendar = async () => {
      const revision = ++calendarRevision;
      calendarBlocks = [];
      calendarProperty = property.value;
      calendarFailed = false;
      calendarRetry.hidden = true;
      calendarLegend.hidden = !hasCalendarStay();
      if (!hasCalendarStay()) {
        calendarLoading = false;
        calendarAvailability.textContent = property.value === 'bespoke-arrangement'
          ? 'Preferred dates only. Availability requires review.'
          : 'Choose a stay to see its unavailable dates.';
        renderCalendar();
        return;
      }
      const visibleFrom = dateIso(calendarMonth);
      const visibleTo = dateIso(addMonths(calendarMonth, 2));
      availabilityFrom = arrival.value && arrival.value < visibleFrom ? arrival.value : visibleFrom;
      availabilityTo = departure.value && departure.value > visibleTo ? departure.value : visibleTo;
      calendarLoading = true;
      calendarAvailability.textContent = 'Loading current availability…';
      renderCalendar();
      try {
        const params = new URLSearchParams({ property: property.value, from: availabilityFrom, to: availabilityTo });
        const response = await fetch(`/api/availability/?${params}`);
        const body = await response.json();
        if (revision !== calendarRevision) return;
        if (!response.ok || !Array.isArray(body.blocks) || body.blocks.some((block: AvailabilityBlock) =>
          !block || !/^\d{4}-\d{2}-\d{2}$/.test(block.startsOn) || !/^\d{4}-\d{2}-\d{2}$/.test(block.endsOn))) {
          throw new Error('Availability could not be loaded.');
        }
        calendarBlocks = body.blocks.map((block: AvailabilityBlock) => ({ startsOn: block.startsOn, endsOn: block.endsOn }));
        calendarAvailability.textContent = body.refreshWarning
          ? `Stored availability is shown. ${body.refreshWarning}`
          : 'Unavailable dates include current reservations and booking holds.';
        if (arrival.value && departure.value && rangeIsBlocked(calendarBlocks, arrival.value, departure.value)) {
          clearResult();
          calendarAvailability.textContent += ' Your selected dates are no longer available. Choose another stay or date range.';
        }
      } catch {
        if (revision !== calendarRevision) return;
        calendarFailed = true;
        calendarRetry.hidden = false;
        calendarAvailability.textContent = 'Availability could not be loaded. Retry to choose dates for this stay.';
      } finally {
        if (revision === calendarRevision) {
          calendarLoading = false;
          renderCalendar();
        }
      }
    };
    const monthLabel = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const dayLabel = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const shortDateLabel = (value: string) => {
      const date = parseDate(value);
      return [
        String(date.getUTCDate()).padStart(2, '0'),
        String(date.getUTCMonth() + 1).padStart(2, '0'),
        String(date.getUTCFullYear()).slice(-2),
      ].join('/');
    };
    const updateDateLabels = () => {
      if (arrivalLabel) arrivalLabel.textContent = arrival.value ? shortDateLabel(arrival.value) : 'Add date';
      if (departureLabel) departureLabel.textContent = departure.value ? shortDateLabel(departure.value) : 'Add date';
    };

    const guestInputs = () => ['adults', 'children', 'infants', 'pets']
      .map((name) => form.elements.namedItem(name))
      .filter((input): input is HTMLInputElement => input instanceof HTMLInputElement);

    const closeMobileSheet = (commit = false) => {
      if (!mobileDock || !activeMobileSheet) return;
      const closingSheet = activeMobileSheet;
      const returnTarget = activeMobileTrigger;
      activeMobileSheet = null;
      activeMobileTrigger = null;
      delete panel.dataset.openSheet;
      if (sheetBackdrop) sheetBackdrop.hidden = true;
      if (closingSheet === 'date') {
        if (!commit) {
          const changed = arrival.value !== dateSnapshot.arrival || departure.value !== dateSnapshot.departure;
          arrival.value = dateSnapshot.arrival;
          departure.value = dateSnapshot.departure;
          if (changed) rememberSelection();
          updateDateLabels();
          renderCalendar();
        }
        setCalendarOpen(false);
      }
      if (closingSheet === 'guests') {
        if (!commit) {
          const changed = guestInputs().some((input) => input.value !== guestSnapshot[input.name]);
          for (const input of guestInputs()) input.value = guestSnapshot[input.name] ?? input.value;
          updateGuestsSummary();
          if (changed) clearResult();
        }
        if (guests) guests.open = false;
      }
      returnTarget?.focus({ preventScroll: true });
    };

    const openMobileSheet = (sheet: MobileSheet, trigger: HTMLElement | null) => {
      if (!mobileDock) return;
      if (activeMobileSheet && activeMobileSheet !== sheet) closeMobileSheet(false);
      if (activeMobileSheet !== sheet) {
        if (sheet === 'date') dateSnapshot = { arrival: arrival.value, departure: departure.value };
        if (sheet === 'guests') {
          guestSnapshot = Object.fromEntries(guestInputs().map((input) => [input.name, input.value]));
        }
      }
      activeMobileSheet = sheet;
      activeMobileTrigger = trigger;
      panel.dataset.openSheet = sheet;
      if (sheetBackdrop) sheetBackdrop.hidden = false;
      queueMicrotask(() => panel.querySelector<HTMLButtonElement>(`[data-compact-sheet-close="${sheet}"]`)?.focus({ preventScroll: true }));
    };

    const minimumNights = () => configured.find((stay) => stay.id === property.value)?.minimumNights || Number(
      property instanceof HTMLSelectElement
        ? property.selectedOptions[0]?.dataset.minimumNights
        : property.dataset.minimumNights,
    ) || 1;
    const openCalendar = () => {
      if (stayMenu) stayMenu.open = false;
      if (guests?.open) guests.open = false;
      openMobileSheet('date', dateTrigger || departure);
      const selectedDate = arrival.value || today();
      calendarMonth = monthStart(selectedDate);
      if (calendarMonth < firstMonth) calendarMonth = firstMonth;
      calendarMessage.textContent = arrival.value && departure.value
        ? `${dayLabel.format(parseDate(arrival.value))} to ${dayLabel.format(parseDate(departure.value))} selected. Choose a new arrival date to change the stay.`
        : arrival.value
          ? `Arrival: ${dayLabel.format(parseDate(arrival.value))}. Now choose your departure date.`
          : 'Choose your arrival date, then your departure date.';
      setCalendarOpen(true);
      void loadCalendar();
    };
    const renderCalendar = () => {
      const focusedDate = document.activeElement instanceof HTMLElement && calendarDays.contains(document.activeElement)
        ? document.activeElement.dataset.date : undefined;
      calendarHeading.textContent = 'Availability calendar';
      calendarDays.replaceChildren();
      calendarDays.setAttribute('aria-busy', String(calendarLoading));
      for (let monthOffset = 0; monthOffset < 2; monthOffset += 1) {
        const month = addMonths(calendarMonth, monthOffset);
        const section = document.createElement('section');
        section.className = 'compact-date-calendar__month';
        const heading = document.createElement('h3');
        heading.textContent = monthLabel.format(month);
        const weekdays = document.createElement('div');
        weekdays.className = 'compact-date-calendar__weekdays';
        weekdays.setAttribute('aria-hidden', 'true');
        for (const label of ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']) {
          const day = document.createElement('span'); day.textContent = label; weekdays.append(day);
        }
        const days = document.createElement('div');
        days.className = 'compact-date-calendar__days';
        days.dataset.compactCalendarDays = '';
        const offset = (month.getUTCDay() + 6) % 7;
        for (let index = 0; index < offset; index += 1) {
          const spacer = document.createElement('span');
          spacer.className = 'compact-date-calendar__spacer';
          spacer.setAttribute('aria-hidden', 'true');
          days.append(spacer);
        }
        const daysInMonth = new Date(Date.UTC(month.getUTCFullYear(), month.getUTCMonth() + 1, 0)).getUTCDate();
        for (let day = 1; day <= daysInMonth; day += 1) {
          const value = dateIso(new Date(Date.UTC(month.getUTCFullYear(), month.getUTCMonth(), day)));
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(day);
          button.dataset.date = value;
          const blocked = hasCalendarStay() && nightIsBlocked(calendarBlocks, value);
          const departureOnly = blocked && canDepart(value);
          const selectedArrival = value === arrival.value;
          const selectedDeparture = value === departure.value;
          const inRange = Boolean(arrival.value && departure.value && arrival.value < value && value < departure.value);
          button.disabled = value < today() || !calendarReady() || (blocked && !departureOnly);
          if (selectedArrival) button.classList.add('is-arrival');
          if (selectedDeparture) button.classList.add('is-departure');
          if (inRange) button.classList.add('is-in-range');
          if (blocked) button.classList.add('is-unavailable');
          button.setAttribute('aria-pressed', String(selectedArrival || selectedDeparture));
          const availability = value < today() ? 'past date' : !hasCalendarStay() ? 'availability not checked'
            : !calendarReady() ? 'availability unknown' : blocked ? departureOnly ? 'unavailable for arrival, available as departure' : 'unavailable' : 'available';
          button.setAttribute('aria-label', `${dayLabel.format(parseDate(value))}, ${availability}${selectedArrival ? ', selected arrival' : selectedDeparture ? ', selected departure' : inRange ? ', selected stay' : ''}`);
          button.addEventListener('click', () => selectDate(value));
          days.append(button);
        }
        section.append(heading, weekdays, days);
        calendarDays.append(section);
      }
      calendarPrevious.disabled = calendarMonth <= firstMonth;
      calendarNext.disabled = calendarMonth >= addMonths(firstMonth, 22);
      // The shell intentionally uses overflow-x:hidden as a Chromium repaint
      // workaround. Keep a floating calendar within its vertical extent so it
      // cannot create a second page scroller on short pages such as /book/.
      if (!mobileDock && panel.classList.contains('compact-booking-panel--calendar-open')) {
        const shell = panel.closest<HTMLElement>('.mobile-first-shell');
        const space = shell ? shell.getBoundingClientRect().bottom - calendar.getBoundingClientRect().top - 16 : innerHeight;
        calendar.style.maxHeight = `${Math.max(160, Math.min(innerHeight * 0.75, space))}px`;
      } else calendar.style.removeProperty('max-height');
      if (focusedDate) calendarDays.querySelector<HTMLButtonElement>(`[data-date="${focusedDate}"]:not(:disabled)`)?.focus({ preventScroll: true });
    };
    const selectDate = (value: string) => {
      if (!calendarReady()) return;
      const choosingDeparture = Boolean(arrival.value && !departure.value && value > arrival.value);
      if (hasCalendarStay() && (choosingDeparture
        ? rangeIsBlocked(calendarBlocks, arrival.value, value)
        : nightIsBlocked(calendarBlocks, value))) {
        calendarMessage.textContent = 'Those dates include unavailable nights. Choose a different date range.';
        return;
      }
      clearResult();
      if (!arrival.value || departure.value || value <= arrival.value) {
        arrival.value = value;
        departure.value = '';
        departure.min = addDays(value, minimumNights());
        calendarMessage.textContent = `Arrival: ${dayLabel.format(parseDate(value))}. Now choose your departure date.`;
      } else {
        const earliestDeparture = addDays(arrival.value, minimumNights());
        if (value < earliestDeparture) {
          calendarMessage.textContent = `This stay needs at least ${minimumNights()} ${minimumNights() === 1 ? 'night' : 'nights'}. Choose a later departure date.`;
          return;
        }
        departure.value = value;
        calendarMessage.textContent = `${dayLabel.format(parseDate(arrival.value))} to ${dayLabel.format(parseDate(value))} selected.`;
      }
      updateDateLabels();
      renderCalendar();
      rememberSelection();
      if (departure.value) {
        if (mobileDock) closeMobileSheet(true);
        else {
          setCalendarOpen(false);
          (dateTrigger || departure).focus({ preventScroll: true });
        }
      } else {
        calendarDays.querySelector<HTMLButtonElement>(`[data-date="${value}"]`)?.focus({ preventScroll: true });
      }
    };
    calendarPrevious.addEventListener('click', () => {
      calendarMonth = addMonths(calendarMonth, -1);
      if (calendarMonth < firstMonth) calendarMonth = firstMonth;
      void loadCalendar();
    });
    calendarNext.addEventListener('click', () => {
      calendarMonth = addMonths(calendarMonth, 1);
      void loadCalendar();
    });
    calendarRetry.addEventListener('click', () => void loadCalendar());
    for (const input of [arrival, departure]) {
      input.addEventListener('click', openCalendar);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openCalendar();
        }
      });
    }
    dateTrigger?.addEventListener('click', openCalendar);
    const updateGuestsSummary = () => {
      if (!guestsSummary) return;
      const count = (name: string) => Number(form.elements.namedItem(name) instanceof HTMLInputElement
        ? (form.elements.namedItem(name) as HTMLInputElement).value : 0);
      const adults = count('adults');
      const parts = [`${adults} ${adults === 1 ? 'adult' : 'adults'}`];
      const children = count('children');
      const infants = count('infants');
      const pets = count('pets');
      if (children) parts.push(`${children} ${children === 1 ? 'child' : 'children'}`);
      if (infants) parts.push(`${infants} ${infants === 1 ? 'infant' : 'infants'}`);
      if (pets) parts.push(`${pets} ${pets === 1 ? 'pet' : 'pets'}`);
      guestsSummary.textContent = parts.join(', ');
    };
    const prepopulateFromQuery = (params = new URLSearchParams(window.location.search)) => {
      const queryArrival = params.get('arrival');
      const queryDeparture = params.get('departure');
      const validDate = (value: string | null): value is string => Boolean(value && /^\d{4}-\d{2}-\d{2}$/.test(value) && Number.isFinite(parseDate(value).getTime()) && dateIso(parseDate(value)) === value);
      if (validDate(queryArrival) && queryArrival >= today()) arrival.value = queryArrival;
      if (validDate(queryDeparture) && arrival.value && queryDeparture > arrival.value) departure.value = queryDeparture;
      if (arrival.value) departure.min = addDays(arrival.value, minimumNights());
      for (const name of ['adults', 'children', 'infants', 'pets']) {
        const value = params.get(name);
        const input = form.elements.namedItem(name);
        if (value !== null && input instanceof HTMLInputElement && /^\d+$/.test(value) && Number.isSafeInteger(Number(value)) && Number(value) <= 99 && Number(value) >= Number(input.min)) input.value = value;
      }
    };
    panel.querySelectorAll<HTMLButtonElement>('[data-compact-guest-adjust]').forEach((button) => {
      button.addEventListener('click', () => {
        const input = form.elements.namedItem(button.dataset.compactGuestAdjust || '');
        if (!(input instanceof HTMLInputElement)) return;
        const minimum = Number(input.min || 0);
        input.value = String(Math.min(99, Math.max(minimum, Number(input.value) + Number(button.dataset.direction || 0))));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        updateGuestsSummary();
      });
    });
    panel.querySelector<HTMLButtonElement>('[data-compact-guests-done]')?.addEventListener('click', () => {
      if (mobileDock) closeMobileSheet(true);
      else if (guests) {
        guests.open = false;
        guests.querySelector('summary')?.focus();
      }
    });
    guests?.addEventListener('toggle', () => {
      if (guests.open) {
        setCalendarOpen(false);
        if (stayMenu) stayMenu.open = false;
        if (mobileDock) openMobileSheet('guests', guests.querySelector('summary'));
      } else if (mobileDock && activeMobileSheet === 'guests') closeMobileSheet(false);
    });

    calendar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (mobileDock) closeMobileSheet(false);
      else {
        setCalendarOpen(false);
        (dateTrigger || arrival).focus({ preventScroll: true });
      }
    });

    panel.querySelectorAll<HTMLButtonElement>('[data-compact-sheet-close]').forEach((button) => {
      button.addEventListener('click', () => closeMobileSheet(false));
    });
    sheetBackdrop?.addEventListener('click', () => closeMobileSheet(false));
    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileDock && panel.classList.contains('compact-booking-panel--calendar-open')) {
        setCalendarOpen(false);
        (dateTrigger || arrival).focus({ preventScroll: true });
      }
      if (event.key === 'Tab' && activeMobileSheet) {
        const sheet = activeMobileSheet === 'date'
          ? calendar
          : guests?.querySelector<HTMLElement>('.compact-guests__popover');
        const focusable = [...(sheet?.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], input:not(:disabled)') ?? [])]
          .filter((element) => element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (first && last && event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (first && last && !event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
      if (event.key === 'Escape' && !mobileDock && guests?.open) {
        guests.open = false;
        guests.querySelector('summary')?.focus();
      }
      if (event.key === 'Escape' && activeMobileSheet) {
        event.preventDefault();
        closeMobileSheet(false);
      }
    });

    const isBespoke = () => property.value === 'bespoke-arrangement';
    const updateStayLinks = () => {
      const selected = configured.find((stay) => stay.id === property.value);
      if (stayName) stayName.textContent = selected?.name.replace(/\s+\(max \d+ guests\)$/i, '') || 'Find a suitable stay';
      panel.querySelectorAll<HTMLAnchorElement>('[data-compact-stay-link]').forEach((link) => {
        const stay = configured.find((item) => item.id === link.dataset.compactStayLink);
        if (!stay) return;
        const params = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        params.set('propertyId', stay.id);
        if (arrival.value && departure.value) params.set('quickCheck', 'checked');
        link.href = `/listings/${stay.listingSlug}/?${params.toString()}`;
        if (stay.id === property.value) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    const validateCapacity = () => {
      const stay = configured.find((item) => item.id === property.value);
      const partySize = guestInputs().filter((input) => input.name !== 'pets').reduce((total, input) => total + Number(input.value), 0);
      const exceeded = Boolean(stay && partySize > stay.maximumGuests);
      const summary = guests?.querySelector('summary');
      guests?.classList.toggle('compact-guests--invalid', exceeded);
      if (exceeded && stay) {
        summary?.setAttribute('aria-invalid', 'true');
        summary?.setAttribute('aria-describedby', status.id);
        status.textContent = `${stay.name.replace(/\s+\(max \d+ guests\)$/i, '')} allows a maximum of ${stay.maximumGuests} guests, including infants. Reduce your party or choose another stay.`;
        checkedHref = '';
        if (quickTotal) quickTotal.hidden = true;
        submit.textContent = 'Check';
      } else {
        summary?.removeAttribute('aria-invalid');
        summary?.removeAttribute('aria-describedby');
      }
      return !exceeded;
    };
    const clearResult = () => {
      checkedQuote = null;
      checking = false; checkError = '';
      panel.dispatchEvent(new CustomEvent('booking-panel-invalidated'));
      checkedHref = '';
      inputRevision += 1;
      submit.disabled = false;
      result.hidden = true;
      result.replaceChildren();
      status.textContent = '';
      if (action) action.hidden = false;


      if (quickTotal) quickTotal.hidden = true;
      if (quickMessage) quickMessage.textContent = '';
      submit.textContent = isBespoke() ? 'Start a bespoke request' : (panel.dataset.submitLabel || 'Quick Check');
      validateCapacity();
      updateStayLinks();
      if (!initialising) rememberSelection();
    };
    const continuationHref = () => {
      const data = new FormData(form);
      const params = new URLSearchParams();
      for (const name of ['propertyId', 'arrival', 'departure', 'adults', 'children', 'infants', 'pets']) {
        params.set(name, String(data.get(name) ?? ''));
      }
      return `/book/?${params.toString()}`;
    };
    const continueLink = (label: string) => {
      const link = document.createElement('a');
      link.className = 'button compact-booking-result__continue';
      link.href = requestPage ? '#booking-request-details' : continuationHref() + (checkedQuote ? '&bookingContinue=checked' : '');
      if (requestPage) link.addEventListener('click', (event) => { event.preventDefault(); continueRequest(); });
      link.textContent = label;
      link.addEventListener('click', () => window.olrigAnalytics?.track('compact_booking_continued', {
        source: panel.dataset.source || 'unknown',
        property: property.value,
      }));
      return link;
    };
    const updateMode = (preserveDates = false) => {
      const bespoke = isBespoke();
      bespokeMessage.hidden = !bespoke;
      submit.textContent = bespoke ? 'Start a bespoke request' : (panel.dataset.submitLabel || 'Quick Check');
      if (!preserveDates && arrival.value && departure.value && departure.value < addDays(arrival.value, minimumNights())) {
        departure.value = '';
        updateDateLabels();
        calendarMessage.textContent = 'The minimum stay changed. Choose your departure date again.';
        renderCalendar();
      }
      clearResult();
    };
    const renderSuggestedResult = (guestTotalPence: number, currency = 'GBP') => {
      updateStayLinks();
      if (quickTotal && quickTotalValue) {
        quickTotalValue.textContent = money(guestTotalPence, currency);
        quickTotal.hidden = false;
      }
      checkedHref = continuationHref();
      submit.textContent = 'Book';
      if (quickMessage) quickMessage.textContent = "You won't be charged yet.";
      result.hidden = true;
    };
    const renderHostPriced = (body: QuoteResponse) => {
      status.textContent = 'This request requires review before an offer can be made. Continue with your request.';
      if (quickTotal && body.estimatedPricing) {
        renderSuggestedResult(
          Number(body.estimatedPricing.guestTotalPence || 0),
          body.estimatedPricing.currency || 'GBP',
        );
        return;
      }
      if (body.estimatedPricing && !suggestedStay) {
        const estimate = document.createElement('p');
        estimate.className = 'compact-booking-result__estimate';
        const total = document.createElement('strong');
        total.textContent = money(
          Number(body.estimatedPricing.guestTotalPence || 0),
          body.estimatedPricing.currency || 'GBP',
        );
        estimate.append('Estimated published-price total: ', total);
        const estimateNote = document.createElement('p');
        estimateNote.textContent = 'This is an indication, continue to get a confirmed quote.';
        result.append(estimate, estimateNote);
      }
      result.append(continueLink('Continue with request'));
      result.hidden = false;
    };
    const renderQuote = (body: QuoteResponse) => {
      if (quickTotal) {
        renderSuggestedResult(Number(body.guestTotalPence || 0), body.currency || 'GBP');
        const guidance = [body.reviewReason || '', ...(body.restrictions || []), ...(body.warnings || [])].filter(Boolean);
        if (guidance.length) status.textContent = guidance.join(' ');
        return;
      }
      const heading = document.createElement('div');
      heading.className = 'compact-booking-result__heading';
      const title = document.createElement('h3');
      title.textContent = 'These dates currently appear available';
      const total = document.createElement('strong');
      total.textContent = money(Number(body.guestTotalPence || 0), body.currency || 'GBP');
      submit.textContent = 'Book';
      heading.append(title);
      if (!suggestedStay) heading.append(total);
      result.append(heading);

      if (!suggestedStay) {
        const nights = document.createElement('p');
        nights.textContent = `${Number(body.nights || 0)} ${Number(body.nights) === 1 ? 'night' : 'nights'} · total`;
        result.append(nights);
      }

      if (body.reviewReason) { const note = document.createElement('p'); note.textContent = body.reviewReason; result.append(note); }
      if (body.lines?.length && !suggestedStay) {
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = 'Price details';
        const list = document.createElement('dl');
        for (const line of body.lines) {
          const term = document.createElement('dt');
          term.textContent = line.label || line.detail || 'Price item';
          const value = document.createElement('dd');
          value.textContent = money(Number(line.amountPence || 0), body.currency || 'GBP');
          list.append(term, value);
        }
        details.append(summary, list);
        result.append(details);
      }

      const guidance = [body.reviewReason || '', ...(body.restrictions || []), ...(body.warnings || [])].filter(Boolean);
      if (guidance.length) {
        const list = document.createElement('ul');
        for (const message of guidance) {
          const item = document.createElement('li');
          item.textContent = message;
          list.append(item);
        }
        result.append(list);
      }
      result.append(continueLink('Continue with request'));
      result.hidden = false;
    };

    // Only non-contact selections and provisional display results are retained.
    // The full request and submission APIs remain authoritative for price/availability.
    const checkedResultStorageKey = 'olrig-quick-check-result';
    const rememberSelection = (quote?: QuoteResponse) => {
      panel.toggleAttribute('data-active-stay', Boolean(arrival.value && departure.value));
      try {
        sessionStorage.setItem(checkedResultStorageKey, JSON.stringify({
          version: 1,
          checkedAt: quote ? Date.now() : 0,
          selection: continuationHref(),
          quote: quote ? {
            pricingAvailable: quote.pricingAvailable,
            guestTotalPence: quote.guestTotalPence,
            currency: quote.currency,
            estimatedPricing: quote.estimatedPricing,
            restrictions: quote.restrictions,
            warnings: quote.warnings,
          } : undefined,
        }));
      } catch {
        // Stay option links still transfer inputs when storage is disabled.
      }
    };
    const initialiseFromSession = () => {
      if (mobileDock) closeMobileSheet(true);
      setCalendarOpen(false);
      if (guests) guests.open = false;
      initialising = true;
      let saved: { version?: number; selection?: string; checkedAt?: number; quote?: QuoteResponse } | null = null;
      let savedParams: URLSearchParams | undefined;
      try {
        saved = JSON.parse(sessionStorage.getItem(checkedResultStorageKey) || 'null');
        if (saved?.version === 1 && typeof saved.selection === 'string') {
          const url = new URL(saved.selection, location.origin);
          if (url.origin === location.origin && url.pathname === '/book/') savedParams = url.searchParams;
        }
      } catch {
        // An unreadable snapshot must not prevent choosing a stay.
      }
      const query = new URLSearchParams(location.search);
      const explicitInputs = ['arrival', 'departure', 'adults', 'children', 'infants', 'pets', 'propertyId'].some((name) => query.has(name));
      const params = explicitInputs ? query : savedParams || query;
      arrival.value = '';
      departure.value = '';
      for (const input of guestInputs()) input.value = input.defaultValue;
      const requestedStay = panel.dataset.listingProperty || params.get('propertyId') || '';
      property.value = configured.some((stay) => stay.id === requestedStay) ? requestedStay : '';
      prepopulateFromQuery(params);
      updateMode(!explicitInputs);
      updateGuestsSummary();
      updateDateLabels();
      renderCalendar();
      panel.toggleAttribute('data-active-stay', Boolean(arrival.value && departure.value));
      initialising = false;
      if (!validateCapacity()) { rememberSelection(); return; }
      if (!arrival.value || !departure.value) return;

      const quote = saved?.quote;
      const price = quote?.pricingAvailable === true ? quote : quote?.estimatedPricing;
      const validPrice = price ? Number.isSafeInteger(price.guestTotalPence)
        && Number(price.guestTotalPence) >= 0 && (!price.currency || price.currency === 'GBP')
        : quote?.pricingAvailable === false;
      const validGuidance = [quote?.restrictions, quote?.warnings].every((items) =>
        items === undefined || (Array.isArray(items) && items.every((item) => typeof item === 'string')));
      initialContinuation = requestPage && Boolean(property.value && arrival.value >= today()
        && departure.value >= addDays(arrival.value, minimumNights())
        && departure.value <= addDays(arrival.value, 365))
        && (query.get('bookingContinue') === 'checked' || Boolean(savedParams
          && saved?.selection === continuationHref() && typeof saved.checkedAt === 'number'
          && saved.checkedAt <= Date.now() && Date.now() - saved.checkedAt < 15 * 60 * 1000
          && quote && validPrice && validGuidance));
      notifyCheck();
      if (!requestPage && savedParams && saved?.selection === continuationHref() && typeof saved.checkedAt === 'number'
        && saved.checkedAt <= Date.now() && Date.now() - saved.checkedAt < 15 * 60 * 1000
        && quote && validPrice && validGuidance) {
        if (quote.pricingAvailable === true) renderQuote(quote);
        else renderHostPriced(quote);
        return;
      }
      // A different listing always selects its own stay and obtains a fresh result.
      if ((requestPage && arrival.value && departure.value) || savedParams || query.get('quickCheck') === 'checked') form.requestSubmit();
    };

    stayMenu?.addEventListener('toggle', () => {
      if (!stayMenu.open) return;
      if (mobileDock) closeMobileSheet(true);
      setCalendarOpen(false);
      if (guests) guests.open = false;
      updateStayLinks();
    });
    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && stayMenu?.open) {
        stayMenu.open = false;
        stayMenu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (stayMenu?.open && event.target instanceof Node && !stayMenu.contains(event.target)) stayMenu.open = false;
    });
    for (const input of form.querySelectorAll<HTMLInputElement>('input')) input.addEventListener('input', clearResult);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (checkedHref) {
        if (requestPage) continueRequest();
        else window.location.assign(checkedHref + '&bookingContinue=checked');
        return;
      }
      clearResult();
      if (!validateCapacity() || !form.reportValidity()) return;
      if (!arrival.value || !departure.value || arrival.value < today() || departure.value <= arrival.value || departure.value > addDays(arrival.value, 365)) {
        status.textContent = 'Choose a departure date after the arrival date.';
        return;
      }

      if (property.value && departure.value < addDays(arrival.value, minimumNights())) {
        status.textContent = `This stay needs at least ${minimumNights()} nights. Choose a later departure date.`;
        return;
      }
      const revision = inputRevision;
      checking = true; checkError = ''; notifyCheck();
      submit.disabled = true;
      status.textContent = 'Checking the latest availability and price…';
      const data = new FormData(form);
      let safeAnalytics = { source: panel.dataset.source || 'unknown', property: property.value || 'none' };
      try {
        if (!property.value) {
          const partySize = ['adults', 'children', 'infants']
            .reduce((total, name) => total + Number(data.get(name) || 0), 0);
          const candidates = configured
            .filter((candidate) => candidate.id !== 'bespoke-arrangement' && candidate.maximumGuests >= partySize)
            .sort((a, b) => a.maximumGuests - b.maximumGuests);
          let selected: typeof candidates[number] | undefined;
          for (const candidate of candidates) {
            const params = new URLSearchParams({ property: candidate.id, from: arrival.value, to: departure.value });
            const response = await fetch(`/api/availability/?${params}`);
            const availability = await response.json() as { blocks?: unknown[]; error?: string };
            if (revision !== inputRevision) return;
            if (!response.ok) throw new Error(availability.error || 'Availability could not be checked.');
            if (!availability.blocks?.length) {
              selected = candidate;
              break;
            }
          }
          if (!selected) {
            status.textContent = 'Those dates are unavailable. Please choose different dates.';
            window.olrigAnalytics?.track('compact_booking_result', {
              source: panel.dataset.source || 'unknown', property: 'none', result: 'unavailable',
            });
            return;
          }
          property.value = selected.id;
          property.dataset.minimumNights = String(selected.minimumNights);
          if (panel.classList.contains('compact-booking-panel--calendar-open')) void loadCalendar();
          if (recommendation) {
            recommendation.dataset.name = selected.name.replace(/\s+\(max \d+ guests\)$/i, '');
            recommendation.dataset.slug = selected.listingSlug;
            recommendation.hidden = false;
          }
        } else if (!isBespoke()) {
          const availabilityParams = new URLSearchParams({
            property: property.value, from: arrival.value, to: departure.value,
          });
          const availabilityResponse = await fetch(`/api/availability/?${availabilityParams}`);
          const availability = await availabilityResponse.json() as { blocks?: unknown[]; error?: string };
          if (revision !== inputRevision) return;
          if (!availabilityResponse.ok) throw new Error(availability.error || 'Availability could not be checked.');
          if (availability.blocks?.length) {
            status.textContent = 'Those dates are unavailable. Please choose different dates.';
            window.olrigAnalytics?.track('compact_booking_result', {
              source: panel.dataset.source || 'unknown', property: property.value, result: 'unavailable',
            });
            return;
          }
        }

        safeAnalytics = { source: panel.dataset.source || 'unknown', property: property.value };
        window.olrigAnalytics?.track('compact_booking_started', safeAnalytics);
        if (isBespoke()) {
          checkedQuote = { pricingAvailable: false, administratorPriced: true };
          status.textContent = 'Accommodation, availability and price require review. Your dates are not reserved.';
          result.append(continueLink('Start a bespoke request'));
          result.hidden = false;
          window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'bespoke' });
          return;
        }

        data.set('propertyId', property.value);

        const quoteResponse = await fetch('/api/quote/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            propertyId: property.value,
            arrival: arrival.value,
            departure: departure.value,
            adults: Number(data.get('adults')),
            children: Number(data.get('children')),
            infants: Number(data.get('infants')),
            pets: Number(data.get('pets')),
          }),
        });
        const quote = await quoteResponse.json() as QuoteResponse;
        if (revision !== inputRevision) return;
        if (!quoteResponse.ok) {
          status.textContent = quote.error || 'A provisional price could not be calculated.';
          window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'error' });
          return;
        }
        checkedQuote = quote;
        status.textContent = '';
        if (quote.pricingAvailable) renderQuote(quote);
        else renderHostPriced(quote);
        rememberSelection(quote);
        window.olrigAnalytics?.track('compact_booking_result', {
          ...safeAnalytics, result: quote.pricingAvailable ? 'available' : 'host_priced',
        });
      } catch (error) {
        if (revision !== inputRevision) return;
        status.textContent = `${error instanceof Error ? error.message : 'The stay could not be checked.'} ${requestPage ? 'Please try again.' : 'Please try again or continue to the full request form.'}`;
        if (!requestPage) result.append(continueLink('Continue to request form'));
        result.hidden = false;
        window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'error' });
      } finally {
        if (revision === inputRevision) {
          submit.disabled = false; checking = false;
          checkError = checkedQuote ? '' : status.textContent || 'The stay could not be checked. Please try again.';
          notifyCheck();
        }
      }
    });

    mobileQuery.addEventListener('change', syncResponsiveModeAfterSelection);
    function syncResponsiveModeAfterSelection() {
      if (mobileDock) closeMobileSheet(true);
      else {
        setCalendarOpen(false);
        if (guests) guests.open = false;
      }
      syncResponsiveMode();
    }
    // Measure the actual dock, including results and wrapped guest summaries.
    const band = panel.closest<HTMLElement>('.quick-check-band');
    if (band) new ResizeObserver(() => {
      const height = band.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--quick-check-dock-height', `${height}px`);
    }).observe(band);
    const getState = () => ({
      selection: {
        propertyId: property.value, arrival: arrival.value, departure: departure.value,
        adults: Number((form.elements.namedItem('adults') as HTMLInputElement).value),
        children: Number((form.elements.namedItem('children') as HTMLInputElement).value),
        infants: Number((form.elements.namedItem('infants') as HTMLInputElement).value),
        pets: Number((form.elements.namedItem('pets') as HTMLInputElement).value),
      },
      quote: checkedQuote,
    });
    const continueRequest = () => {
      if (!checkedQuote) { form.requestSubmit(); return; }
      panel.dispatchEvent(new CustomEvent('booking-panel-continue', { detail: getState() }));
    };
    panel.bookingPanel = {
      getState,
      getCheckState: () => ({ initialContinuation, checking, error: checkError }),
      check: () => { clearResult(); form.requestSubmit(); },
      invalidate: clearResult,
      setQuote: (quote) => {
        clearResult(); checkedQuote = quote;
        if (quote.pricingAvailable) renderQuote(quote); else renderHostPriced(quote);
        rememberSelection(quote);
        notifyCheck();
      },
    };
    property.addEventListener('change', () => {
      updateMode(true);
      if (panel.classList.contains('compact-booking-panel--calendar-open')) void loadCalendar();
      if (arrival.value && departure.value) form.requestSubmit();
    });
    initialiseFromSession();
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) initialiseFromSession();
    });
  });
</script>

