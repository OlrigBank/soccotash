---
import { getProperties } from '../lib/booking/config';

interface Props {
  propertyId?: string;
  source?: 'homepage' | 'listing';
  heading?: string;
  idPrefix?: string;
  submitLabel?: string;
  autoSelectProperty?: boolean;
  mobileDock?: boolean;
}

const {
  propertyId,
  source = propertyId ? 'listing' : 'homepage',
  heading = 'Plan your stay',
  idPrefix = `compact-booking-${source}`,
  submitLabel = 'Quick Check',
  autoSelectProperty = false,
  mobileDock = false,
} = Astro.props;
const properties = getProperties();
const fixedProperty = propertyId ? properties.find((property) => property.id === propertyId) : undefined;
const fixedBespoke = fixedProperty?.id === 'bespoke-arrangement';

if (propertyId && !fixedProperty) {
  throw new Error(`Unknown compact booking property: ${propertyId}`);
}

---

<section
  class:list={['compact-booking-panel', mobileDock && 'compact-booking-panel--mobile-dock']}
  data-compact-booking-panel
  data-mobile-dock={mobileDock ? 'true' : undefined}
  data-source={source}
  data-fixed-property={fixedProperty?.id}
  data-submit-label={submitLabel}
  data-auto-select-property={autoSelectProperty ? 'true' : undefined}
  data-properties={autoSelectProperty ? JSON.stringify(properties.map(({ id, name, minimumNights, maximumGuests }) => ({ id, name, minimumNights, maximumGuests }))) : undefined}
  aria-labelledby={heading ? `${idPrefix}-heading` : undefined}
  aria-label={heading ? undefined : 'Quick Check'}
>
  {heading ? <div class="compact-booking-panel__heading">
    {autoSelectProperty ? null : <p class="eyebrow">{fixedBespoke ? 'Begin an enquiry' : 'Check a stay'}</p>}
    <h2 id={`${idPrefix}-heading`}>{heading}</h2>
  </div> : null}

  <form id={`${idPrefix}-form`} class="compact-booking-form" data-compact-booking-form>
    {autoSelectProperty ? null : fixedProperty ? (
      <div class="compact-booking-field compact-booking-field--property">
        <span>Stay arrangement</span>
        <strong>{fixedProperty.name}</strong>
        <input type="hidden" name="propertyId" value={fixedProperty.id} data-minimum-nights={fixedProperty.minimumNights} />
      </div>
    ) : (
      <label class="compact-booking-field compact-booking-field--property" for={`${idPrefix}-property`}>
        <span>Stay arrangement</span>
        <select id={`${idPrefix}-property`} name="propertyId" required>
          {properties.map((property) => (
            <option value={property.id} data-minimum-nights={property.minimumNights}>{property.name}</option>
          ))}
        </select>
      </label>
    )}

    {autoSelectProperty ? (
      <button class="compact-booking-date-trigger" type="button" data-compact-date-trigger aria-controls={`${idPrefix}-calendar`} aria-expanded="false">
        <span><small>Check-in</small><strong data-compact-arrival-label>Add date</strong></span>
        <span><small>Check-out</small><strong data-compact-departure-label>Add date</strong></span>
        <input id={`${idPrefix}-arrival`} name="arrival" type="hidden" required />
        <input id={`${idPrefix}-departure`} name="departure" type="hidden" required />
      </button>
    ) : (
      <>
        <label class="compact-booking-field" for={`${idPrefix}-arrival`}>
          <span>Arrival</span>
          <input id={`${idPrefix}-arrival`} name="arrival" type="date" required aria-controls={`${idPrefix}-calendar`} aria-expanded="false" />
        </label>
        <label class="compact-booking-field" for={`${idPrefix}-departure`}>
          <span>Departure</span>
          <input id={`${idPrefix}-departure`} name="departure" type="date" required aria-controls={`${idPrefix}-calendar`} aria-expanded="false" />
        </label>
      </>
    )}
    <fieldset
      id={`${idPrefix}-calendar`}
      class="compact-date-calendar"
      data-compact-date-calendar
      data-compact-mobile-dialog={mobileDock ? 'true' : undefined}
      aria-labelledby={mobileDock ? `${idPrefix}-calendar-title` : undefined}
    >
      <legend id={`${idPrefix}-calendar-title`}>Choose arrival and departure</legend>
      {mobileDock ? (
        <div class="compact-sheet__header">
          <strong aria-hidden="true">Choose arrival and departure</strong>
          <button class="compact-sheet__close" type="button" data-compact-sheet-close="date" aria-label="Close date selection">×</button>
        </div>
      ) : null}
      <div class="compact-date-calendar__toolbar">
        <button type="button" data-compact-calendar-previous aria-label="Show previous month">←</button>
        <strong data-compact-calendar-heading></strong>
        <button type="button" data-compact-calendar-next aria-label="Show next month">→</button>
      </div>
      <p data-compact-calendar-message role="status" aria-live="polite">Choose your arrival date, then your departure date.</p>
      <div class="compact-date-calendar__weekdays" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div class="compact-date-calendar__days" data-compact-calendar-days></div>
    </fieldset>
    {autoSelectProperty ? (
      <details class="compact-guests" data-compact-guests>
        <summary><span>Guests</span><strong data-compact-guests-summary>2 adults</strong></summary>
        <div
          class="compact-guests__popover"
          data-compact-mobile-dialog={mobileDock ? 'true' : undefined}
          aria-label={mobileDock ? 'Choose guests' : undefined}
        >
          {mobileDock ? (
            <button class="compact-sheet__close" type="button" data-compact-sheet-close="guests" aria-label="Close guest selection">×</button>
          ) : null}
          {[
            ['adults', 'Adults', 'Ages 13+', 1, 2],
            ['children', 'Children', 'Ages 2–12', 0, 0],
            ['infants', 'Infants', 'Under 2', 0, 0],
            ['pets', 'Pets', '', 0, 0],
          ].map(([name, label, help, minimum, value]) => (
            <div class="compact-guests__row">
              <span><strong>{label}</strong>{help ? <small>{help}</small> : null}</span>
              <div>
                <button type="button" data-compact-guest-adjust={name} data-direction="-1" aria-label={`Remove ${String(label).toLowerCase()}`}>−</button>
                <input id={`${idPrefix}-${name}`} name={String(name)} type="number" min={Number(minimum)} value={Number(value)} required readonly />
                <button type="button" data-compact-guest-adjust={name} data-direction="1" aria-label={`Add ${String(label).toLowerCase()}`}>+</button>
              </div>
            </div>
          ))}
          <button class="button compact-guests__done" type="button" data-compact-guests-done>Done</button>
        </div>
      </details>
    ) : (
      <>
        <label class="compact-booking-field" for={`${idPrefix}-adults`}><span>Adults <small>13+</small></span><input id={`${idPrefix}-adults`} name="adults" type="number" min="1" value="2" required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-children`}><span>Children <small>2–12</small></span><input id={`${idPrefix}-children`} name="children" type="number" min="0" value="0" required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-infants`}><span>Infants <small>Under 2</small></span><input id={`${idPrefix}-infants`} name="infants" type="number" min="0" value="0" required /></label>
        <label class="compact-booking-field" for={`${idPrefix}-pets`}><span>Pets</span><input id={`${idPrefix}-pets`} name="pets" type="number" min="0" value="0" required /></label>
      </>
    )}

    <div class="compact-booking-panel__action">
      <button class="button" type="submit" data-compact-booking-submit>
        {fixedBespoke ? 'Start a bespoke request' : submitLabel}
      </button>
    </div>

  </form>

  <div
    class="compact-booking-response"
    data-compact-booking-response
    data-compact-mobile-dialog={mobileDock ? 'true' : undefined}
    aria-label={mobileDock ? 'Quick Check result' : undefined}
  >
    {mobileDock ? (
      <button class="compact-sheet__close" type="button" data-compact-sheet-close="result" aria-label="Close Quick Check result">×</button>
    ) : null}
    {autoSelectProperty ? (
      <div class="compact-booking-field compact-booking-field--property compact-booking-field--recommendation" data-compact-booking-recommendation hidden>
        <input type="hidden" name="propertyId" value="" form={`${idPrefix}-form`} />
        <section class="compact-booking-result" data-compact-booking-result hidden aria-live="polite"></section>
      </div>
    ) : null}
    <p class="compact-booking-panel__bespoke" data-compact-booking-bespoke hidden={!fixedBespoke}>
      Tell us your preferred dates and party. This does not reserve or block the dates; Jenna will confirm the accommodation, availability and price.
    </p>
    <p class="compact-booking-panel__status" data-compact-booking-status role="status" aria-live="polite"></p>
    {autoSelectProperty ? null : <section class="compact-booking-result" data-compact-booking-result hidden aria-live="polite"></section>}
  </div>
  {mobileDock ? <button class="compact-sheet-backdrop" type="button" data-compact-sheet-backdrop aria-label="Close open Quick Check panel" hidden></button> : null}
</section>

<script>
  type QuoteLine = { label?: string; detail?: string; amountPence?: number };
  type QuoteResponse = {
    pricingAvailable?: boolean;
    administratorPriced?: boolean;
    hostDecisionRequired?: boolean;
    eligible?: boolean;
    currency?: string;
    nights?: number;
    guestTotalPence?: number;
    lines?: QuoteLine[];
    restrictions?: string[];
    warnings?: string[];
    message?: string;
    error?: string;
    estimatedPricing?: {
      currency?: string;
      nights?: number;
      guestTotalPence?: number;
    } | null;
  };

  const money = (pence: number, currency = 'GBP') => new Intl.NumberFormat('en-GB', {
    style: 'currency', currency,
  }).format(pence / 100);

  const today = () => new Date().toISOString().slice(0, 10);

  document.querySelectorAll<HTMLElement>('[data-compact-booking-panel]').forEach((panel) => {
    const form = panel.querySelector<HTMLFormElement>('[data-compact-booking-form]');
    const property = panel.querySelector<HTMLSelectElement | HTMLInputElement>('[name="propertyId"]');
    const arrival = panel.querySelector<HTMLInputElement>('[name="arrival"]');
    const departure = panel.querySelector<HTMLInputElement>('[name="departure"]');
    const submit = panel.querySelector<HTMLButtonElement>('[data-compact-booking-submit]');
    const action = panel.querySelector<HTMLElement>('.compact-booking-panel__action');
    const status = panel.querySelector<HTMLElement>('[data-compact-booking-status]');
    const result = panel.querySelector<HTMLElement>('[data-compact-booking-result]');
    const bespokeMessage = panel.querySelector<HTMLElement>('[data-compact-booking-bespoke]');
    const calendar = panel.querySelector<HTMLElement>('[data-compact-date-calendar]');
    const calendarHeading = panel.querySelector<HTMLElement>('[data-compact-calendar-heading]');
    const calendarMessage = panel.querySelector<HTMLElement>('[data-compact-calendar-message]');
    const calendarDays = panel.querySelector<HTMLElement>('[data-compact-calendar-days]');
    const calendarPrevious = panel.querySelector<HTMLButtonElement>('[data-compact-calendar-previous]');
    const calendarNext = panel.querySelector<HTMLButtonElement>('[data-compact-calendar-next]');
    const recommendation = panel.querySelector<HTMLElement>('[data-compact-booking-recommendation]');
    const responsePanel = panel.querySelector<HTMLElement>('[data-compact-booking-response]');
    const sheetBackdrop = panel.querySelector<HTMLButtonElement>('[data-compact-sheet-backdrop]');
    const mobileQuery = matchMedia('(max-width: 699px)');
    let mobileDock = panel.dataset.mobileDock === 'true' && mobileQuery.matches;
    const syncResponsiveMode = () => {
      mobileDock = panel.dataset.mobileDock === 'true' && mobileQuery.matches;
      panel.querySelectorAll<HTMLElement>('[data-compact-mobile-dialog]').forEach((dialog) => {
        if (mobileDock) {
          dialog.setAttribute('role', 'dialog');
          dialog.setAttribute('aria-modal', 'true');
        } else {
          dialog.removeAttribute('role');
          dialog.removeAttribute('aria-modal');
        }
      });
    };
    mobileQuery.addEventListener('change', syncResponsiveMode);
    syncResponsiveMode();
    const suggestedStay = panel.dataset.autoSelectProperty === 'true';
    const dateTrigger = panel.querySelector<HTMLButtonElement>('[data-compact-date-trigger]');
    const arrivalLabel = panel.querySelector<HTMLElement>('[data-compact-arrival-label]');
    const departureLabel = panel.querySelector<HTMLElement>('[data-compact-departure-label]');
    const guests = panel.querySelector<HTMLDetailsElement>('[data-compact-guests]');
    const guestsSummary = panel.querySelector<HTMLElement>('[data-compact-guests-summary]');
    type MobileSheet = 'date' | 'guests' | 'result';
    let activeMobileSheet: MobileSheet | null = null;
    let activeMobileTrigger: HTMLElement | null = null;
    let dateSnapshot = { arrival: '', departure: '' };
    let guestSnapshot: Record<string, string> = {};
    if (!form || !property || !arrival || !departure || !submit || !status || !result || !bespokeMessage
      || !calendar || !calendarHeading || !calendarMessage || !calendarDays || !calendarPrevious || !calendarNext) return;

    arrival.min = today();
    departure.min = today();
    arrival.readOnly = true;
    departure.readOnly = true;
    panel.classList.add('compact-booking-panel--calendar-ready');

    const setCalendarOpen = (open: boolean) => {
      panel.classList.toggle('compact-booking-panel--calendar-open', open);
      arrival.setAttribute('aria-expanded', String(open));
      departure.setAttribute('aria-expanded', String(open));
      dateTrigger?.setAttribute('aria-expanded', String(open));
    };

    const parseDate = (value: string) => new Date(`${value}T00:00:00.000Z`);
    const dateIso = (date: Date) => date.toISOString().slice(0, 10);
    const addDays = (value: string, days: number) => {
      const date = parseDate(value);
      date.setUTCDate(date.getUTCDate() + days);
      return dateIso(date);
    };
    const monthStart = (value: string) => {
      const date = parseDate(value);
      return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1));
    };
    const addMonths = (date: Date, months: number) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
    const firstMonth = monthStart(today());
    let calendarMonth = firstMonth;
    const monthLabel = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const dayLabel = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const shortDateLabel = (value: string) => {
      const date = parseDate(value);
      return [
        String(date.getUTCDate()).padStart(2, '0'),
        String(date.getUTCMonth() + 1).padStart(2, '0'),
        String(date.getUTCFullYear()).slice(-2),
      ].join('/');
    };
    const updateDateLabels = () => {
      if (arrivalLabel) arrivalLabel.textContent = arrival.value ? shortDateLabel(arrival.value) : 'Add date';
      if (departureLabel) departureLabel.textContent = departure.value ? shortDateLabel(departure.value) : 'Add date';
    };

    const guestInputs = () => ['adults', 'children', 'infants', 'pets']
      .map((name) => form.elements.namedItem(name))
      .filter((input): input is HTMLInputElement => input instanceof HTMLInputElement);

    const closeMobileSheet = (commit = false) => {
      if (!mobileDock || !activeMobileSheet) return;
      const closingSheet = activeMobileSheet;
      const returnTarget = activeMobileTrigger;
      activeMobileSheet = null;
      activeMobileTrigger = null;
      delete panel.dataset.openSheet;
      if (sheetBackdrop) sheetBackdrop.hidden = true;
      if (closingSheet === 'date') {
        if (!commit) {
          arrival.value = dateSnapshot.arrival;
          departure.value = dateSnapshot.departure;
          updateDateLabels();
          renderCalendar();
        }
        setCalendarOpen(false);
      }
      if (closingSheet === 'guests') {
        if (!commit) {
          for (const input of guestInputs()) input.value = guestSnapshot[input.name] ?? input.value;
          updateGuestsSummary();
        }
        if (guests) guests.open = false;
      }
      if (closingSheet === 'result' && action) action.hidden = false;
      returnTarget?.focus({ preventScroll: true });
    };

    const openMobileSheet = (sheet: MobileSheet, trigger: HTMLElement | null) => {
      if (!mobileDock) return;
      if (activeMobileSheet && activeMobileSheet !== sheet) closeMobileSheet(false);
      if (activeMobileSheet !== sheet) {
        if (sheet === 'date') dateSnapshot = { arrival: arrival.value, departure: departure.value };
        if (sheet === 'guests') {
          guestSnapshot = Object.fromEntries(guestInputs().map((input) => [input.name, input.value]));
        }
      }
      activeMobileSheet = sheet;
      activeMobileTrigger = trigger;
      panel.dataset.openSheet = sheet;
      if (sheetBackdrop) sheetBackdrop.hidden = false;
      queueMicrotask(() => panel.querySelector<HTMLButtonElement>(`[data-compact-sheet-close="${sheet}"]`)?.focus({ preventScroll: true }));
    };

    const minimumNights = () => Number(
      property instanceof HTMLSelectElement
        ? property.selectedOptions[0]?.dataset.minimumNights
        : property.dataset.minimumNights,
    ) || 1;
    const openCalendar = () => {
      openMobileSheet('date', dateTrigger || departure);
      const selectedDate = arrival.value || today();
      calendarMonth = monthStart(selectedDate);
      if (calendarMonth < firstMonth) calendarMonth = firstMonth;
      calendarMessage.textContent = arrival.value && departure.value
        ? `${dayLabel.format(parseDate(arrival.value))} to ${dayLabel.format(parseDate(departure.value))} selected. Choose a new arrival date to change the stay.`
        : arrival.value
          ? `Arrival: ${dayLabel.format(parseDate(arrival.value))}. Now choose your departure date.`
          : 'Choose your arrival date, then your departure date.';
      setCalendarOpen(true);
      renderCalendar();
    };
    const renderCalendar = () => {
      calendarHeading.textContent = monthLabel.format(calendarMonth);
      calendarDays.replaceChildren();
      const offset = (calendarMonth.getUTCDay() + 6) % 7;
      for (let index = 0; index < offset; index += 1) {
        const spacer = document.createElement('span');
        spacer.className = 'compact-date-calendar__spacer';
        spacer.setAttribute('aria-hidden', 'true');
        calendarDays.append(spacer);
      }
      const daysInMonth = new Date(Date.UTC(calendarMonth.getUTCFullYear(), calendarMonth.getUTCMonth() + 1, 0)).getUTCDate();
      for (let day = 1; day <= daysInMonth; day += 1) {
        const value = dateIso(new Date(Date.UTC(calendarMonth.getUTCFullYear(), calendarMonth.getUTCMonth(), day)));
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(day);
        button.dataset.date = value;
        button.setAttribute('aria-label', dayLabel.format(parseDate(value)));
        button.disabled = value < today();
        const selectedArrival = value === arrival.value;
        const selectedDeparture = value === departure.value;
        const inRange = Boolean(arrival.value && departure.value && arrival.value < value && value < departure.value);
        if (selectedArrival) button.classList.add('is-arrival');
        if (selectedDeparture) button.classList.add('is-departure');
        if (inRange) button.classList.add('is-in-range');
        button.setAttribute('aria-pressed', String(selectedArrival || selectedDeparture));
        if (selectedArrival) button.setAttribute('aria-label', `${dayLabel.format(parseDate(value))}, selected arrival`);
        if (selectedDeparture) button.setAttribute('aria-label', `${dayLabel.format(parseDate(value))}, selected departure`);
        button.addEventListener('click', () => selectDate(value));
        calendarDays.append(button);
      }
      calendarPrevious.disabled = calendarMonth <= firstMonth;
    };
    const selectDate = (value: string) => {
      clearResult();
      if (!arrival.value || departure.value || value <= arrival.value) {
        arrival.value = value;
        departure.value = '';
        departure.min = addDays(value, minimumNights());
        calendarMessage.textContent = `Arrival: ${dayLabel.format(parseDate(value))}. Now choose your departure date.`;
      } else {
        const earliestDeparture = addDays(arrival.value, minimumNights());
        if (value < earliestDeparture) {
          calendarMessage.textContent = `This stay needs at least ${minimumNights()} ${minimumNights() === 1 ? 'night' : 'nights'}. Choose a later departure date.`;
          return;
        }
        departure.value = value;
        calendarMessage.textContent = `${dayLabel.format(parseDate(arrival.value))} to ${dayLabel.format(parseDate(value))} selected.`;
      }
      updateDateLabels();
      renderCalendar();
      if (departure.value) {
        if (mobileDock) closeMobileSheet(true);
        else {
          setCalendarOpen(false);
          (dateTrigger || departure).focus({ preventScroll: true });
        }
      } else {
        calendarDays.querySelector<HTMLButtonElement>(`[data-date="${value}"]`)?.focus({ preventScroll: true });
      }
    };
    calendarPrevious.addEventListener('click', () => {
      calendarMonth = addMonths(calendarMonth, -1);
      if (calendarMonth < firstMonth) calendarMonth = firstMonth;
      renderCalendar();
    });
    calendarNext.addEventListener('click', () => {
      calendarMonth = addMonths(calendarMonth, 1);
      renderCalendar();
    });
    for (const input of [arrival, departure]) {
      input.addEventListener('click', openCalendar);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openCalendar();
        }
      });
    }
    dateTrigger?.addEventListener('click', openCalendar);
    const updateGuestsSummary = () => {
      if (!guestsSummary) return;
      const count = (name: string) => Number(form.elements.namedItem(name) instanceof HTMLInputElement
        ? (form.elements.namedItem(name) as HTMLInputElement).value : 0);
      const adults = count('adults');
      const parts = [`${adults} ${adults === 1 ? 'adult' : 'adults'}`];
      const children = count('children');
      const infants = count('infants');
      const pets = count('pets');
      if (children) parts.push(`${children} ${children === 1 ? 'child' : 'children'}`);
      if (infants) parts.push(`${infants} ${infants === 1 ? 'infant' : 'infants'}`);
      if (pets) parts.push(`${pets} ${pets === 1 ? 'pet' : 'pets'}`);
      guestsSummary.textContent = parts.join(', ');
    };
    panel.querySelectorAll<HTMLButtonElement>('[data-compact-guest-adjust]').forEach((button) => {
      button.addEventListener('click', () => {
        const input = form.elements.namedItem(button.dataset.compactGuestAdjust || '');
        if (!(input instanceof HTMLInputElement)) return;
        const minimum = Number(input.min || 0);
        input.value = String(Math.max(minimum, Number(input.value) + Number(button.dataset.direction || 0)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
        updateGuestsSummary();
      });
    });
    panel.querySelector<HTMLButtonElement>('[data-compact-guests-done]')?.addEventListener('click', () => {
      if (mobileDock) closeMobileSheet(true);
      else if (guests) guests.open = false;
    });
    guests?.addEventListener('toggle', () => {
      if (!mobileDock) return;
      if (guests.open) openMobileSheet('guests', guests.querySelector('summary'));
      else if (activeMobileSheet === 'guests') closeMobileSheet(false);
    });
    updateGuestsSummary();
    updateDateLabels();
    calendar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (mobileDock) closeMobileSheet(false);
      else {
        setCalendarOpen(false);
        arrival.focus({ preventScroll: true });
      }
    });

    panel.querySelectorAll<HTMLButtonElement>('[data-compact-sheet-close]').forEach((button) => {
      button.addEventListener('click', () => closeMobileSheet(false));
    });
    sheetBackdrop?.addEventListener('click', () => closeMobileSheet(false));
    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && activeMobileSheet) {
        const sheet = activeMobileSheet === 'date'
          ? calendar
          : activeMobileSheet === 'guests'
            ? guests?.querySelector<HTMLElement>('.compact-guests__popover')
            : responsePanel;
        const focusable = [...(sheet?.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], input:not(:disabled)') ?? [])]
          .filter((element) => element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (first && last && event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (first && last && !event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
      if (event.key === 'Escape' && activeMobileSheet) {
        event.preventDefault();
        closeMobileSheet(false);
      }
    });

    if (mobileDock && responsePanel) {
      const syncResponseSheet = () => {
        const hasResponse = Boolean(status.textContent?.trim()) || !result.hidden;
        if (hasResponse && activeMobileSheet !== 'result') openMobileSheet('result', submit);
        if (!hasResponse && activeMobileSheet === 'result') closeMobileSheet(true);
      };
      new MutationObserver(syncResponseSheet).observe(responsePanel, {
        attributes: true,
        attributeFilter: ['hidden'],
        childList: true,
        subtree: true,
        characterData: true,
      });
    }

    const isBespoke = () => property.value === 'bespoke-arrangement';
    const clearResult = () => {
      result.hidden = true;
      result.replaceChildren();
      status.textContent = '';
      if (action) action.hidden = false;
      if (recommendation) recommendation.hidden = true;
    };
    const continuationHref = () => {
      const data = new FormData(form);
      const params = new URLSearchParams();
      for (const name of ['propertyId', 'arrival', 'departure', 'adults', 'children', 'infants', 'pets']) {
        params.set(name, String(data.get(name) ?? ''));
      }
      return `/book/?${params.toString()}`;
    };
    const continueLink = (label: string) => {
      const link = document.createElement('a');
      link.className = 'button compact-booking-result__continue';
      link.href = continuationHref();
      link.textContent = label;
      link.addEventListener('click', () => window.olrigAnalytics?.track('compact_booking_continued', {
        source: panel.dataset.source || 'unknown',
        property: property.value,
      }));
      return link;
    };
    const updateMode = () => {
      const bespoke = isBespoke();
      bespokeMessage.hidden = !bespoke;
      submit.textContent = bespoke ? 'Start a bespoke request' : (panel.dataset.submitLabel || 'Quick Check');
      if (arrival.value && departure.value && departure.value < addDays(arrival.value, minimumNights())) {
        departure.value = '';
        calendarMessage.textContent = 'The minimum stay changed. Choose your departure date again.';
        renderCalendar();
      }
      clearResult();
    };
    const renderSuggestedResult = (guestTotalPence: number, currency = 'GBP') => {
      const price = document.createElement('p');
      price.className = 'compact-booking-result__estimate';
      const total = document.createElement('strong');
      total.textContent = money(guestTotalPence, currency);
      price.append(total, ' total');
      const stay = document.createElement('p');
      stay.className = 'compact-booking-result__stay';
      stay.textContent = recommendation?.dataset.name || '';
      const reassurance = document.createElement('p');
      reassurance.className = 'compact-booking-result__reassurance';
      reassurance.textContent = "You won't be charged yet";
      result.append(price, stay, continueLink('Reserve'), reassurance);
      result.hidden = false;
      if (action) action.hidden = true;
    };
    const renderHostPriced = (body: QuoteResponse) => {
      if (suggestedStay && body.estimatedPricing) {
        renderSuggestedResult(
          Number(body.estimatedPricing.guestTotalPence || 0),
          body.estimatedPricing.currency || 'GBP',
        );
        return;
      }
      if (body.estimatedPricing && !suggestedStay) {
        const estimate = document.createElement('p');
        estimate.className = 'compact-booking-result__estimate';
        const total = document.createElement('strong');
        total.textContent = money(
          Number(body.estimatedPricing.guestTotalPence || 0),
          body.estimatedPricing.currency || 'GBP',
        );
        estimate.append('Estimated published-price total: ', total);
        const estimateNote = document.createElement('p');
        estimateNote.textContent = 'This is an indication, continue to get a confirmed quote.';
        result.append(estimate, estimateNote);
      }
      result.append(continueLink('Continue with request'));
      result.hidden = false;
    };
    const renderQuote = (body: QuoteResponse) => {
      if (suggestedStay) {
        renderSuggestedResult(Number(body.guestTotalPence || 0), body.currency || 'GBP');
        return;
      }
      const heading = document.createElement('div');
      heading.className = 'compact-booking-result__heading';
      const title = document.createElement('h3');
      title.textContent = 'These dates currently appear available';
      const total = document.createElement('strong');
      total.textContent = money(Number(body.guestTotalPence || 0), body.currency || 'GBP');
      heading.append(title);
      if (!suggestedStay) heading.append(total);
      result.append(heading);

      if (!suggestedStay) {
        const nights = document.createElement('p');
        nights.textContent = `${Number(body.nights || 0)} ${Number(body.nights) === 1 ? 'night' : 'nights'} · provisional total`;
        result.append(nights);
      }

      if (body.lines?.length && !suggestedStay) {
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = 'Price details';
        const list = document.createElement('dl');
        for (const line of body.lines) {
          const term = document.createElement('dt');
          term.textContent = line.label || line.detail || 'Price item';
          const value = document.createElement('dd');
          value.textContent = money(Number(line.amountPence || 0), body.currency || 'GBP');
          list.append(term, value);
        }
        details.append(summary, list);
        result.append(details);
      }

      const guidance = [...(body.restrictions || []), ...(body.warnings || [])];
      if (guidance.length) {
        const list = document.createElement('ul');
        for (const message of guidance) {
          const item = document.createElement('li');
          item.textContent = message;
          list.append(item);
        }
        result.append(list);
      }
      result.append(continueLink('Continue with request'));
      result.hidden = false;
    };

    property.addEventListener('change', updateMode);
    for (const input of form.querySelectorAll<HTMLInputElement>('input')) input.addEventListener('input', clearResult);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearResult();
      if (!form.reportValidity()) return;
      if (departure.value <= arrival.value) {
        status.textContent = 'Choose a departure date after the arrival date.';
        return;
      }

      submit.disabled = true;
      status.textContent = 'Checking the latest availability and price…';
      const data = new FormData(form);
      let safeAnalytics = { source: panel.dataset.source || 'unknown', property: property.value || 'none' };
      try {
        if (suggestedStay) {
          const partySize = ['adults', 'children', 'infants']
            .reduce((total, name) => total + Number(data.get(name) || 0), 0);
          const configured = JSON.parse(panel.dataset.properties || '[]') as Array<{
            id: string; name: string; minimumNights: number; maximumGuests: number;
          }>;
          const candidates = configured
            .filter((candidate) => candidate.id !== 'bespoke-arrangement' && candidate.maximumGuests >= partySize)
            .sort((a, b) => a.maximumGuests - b.maximumGuests);
          let selected: typeof candidates[number] | undefined;
          for (const candidate of candidates) {
            const params = new URLSearchParams({ property: candidate.id, from: arrival.value, to: departure.value });
            const response = await fetch(`/api/availability/?${params}`);
            const availability = await response.json() as { blocks?: unknown[]; error?: string };
            if (!response.ok) throw new Error(availability.error || 'Availability could not be checked.');
            if (!availability.blocks?.length) {
              selected = candidate;
              break;
            }
          }
          if (!selected) {
            status.textContent = 'Those dates are unavailable. Please choose different dates.';
            window.olrigAnalytics?.track('compact_booking_result', {
              source: panel.dataset.source || 'unknown', property: 'none', result: 'unavailable',
            });
            return;
          }
          property.value = selected.id;
          property.dataset.minimumNights = String(selected.minimumNights);
          if (recommendation) {
            recommendation.dataset.name = selected.name;
            recommendation.hidden = false;
          }
        } else if (!isBespoke()) {
          const availabilityParams = new URLSearchParams({
            property: property.value, from: arrival.value, to: departure.value,
          });
          const availabilityResponse = await fetch(`/api/availability/?${availabilityParams}`);
          const availability = await availabilityResponse.json() as { blocks?: unknown[]; error?: string };
          if (!availabilityResponse.ok) throw new Error(availability.error || 'Availability could not be checked.');
          if (availability.blocks?.length) {
            status.textContent = 'Those dates are unavailable. Please choose different dates.';
            window.olrigAnalytics?.track('compact_booking_result', {
              source: panel.dataset.source || 'unknown', property: property.value, result: 'unavailable',
            });
            return;
          }
        }

        safeAnalytics = { source: panel.dataset.source || 'unknown', property: property.value };
        window.olrigAnalytics?.track('compact_booking_started', safeAnalytics);
        if (isBespoke()) {
          status.textContent = 'Jenna will confirm the accommodation, availability and price. Your dates are not reserved.';
          result.append(continueLink('Start a bespoke request'));
          result.hidden = false;
          window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'bespoke' });
          return;
        }

        data.set('propertyId', property.value);

        const quoteResponse = await fetch('/api/quote/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            propertyId: property.value,
            arrival: arrival.value,
            departure: departure.value,
            adults: Number(data.get('adults')),
            children: Number(data.get('children')),
            infants: Number(data.get('infants')),
            pets: Number(data.get('pets')),
          }),
        });
        const quote = await quoteResponse.json() as QuoteResponse;
        if (!quoteResponse.ok) {
          status.textContent = quote.error || 'A provisional price could not be calculated.';
          window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'error' });
          return;
        }
        status.textContent = '';
        if (quote.pricingAvailable) renderQuote(quote);
        else renderHostPriced(quote);
        window.olrigAnalytics?.track('compact_booking_result', {
          ...safeAnalytics, result: quote.pricingAvailable ? 'available' : 'host_priced',
        });
      } catch (error) {
        status.textContent = `${error instanceof Error ? error.message : 'The stay could not be checked.'} Please try again or continue to the full request form.`;
        result.append(continueLink('Continue to request form'));
        result.hidden = false;
        window.olrigAnalytics?.track('compact_booking_result', { ...safeAnalytics, result: 'error' });
      } finally {
        submit.disabled = false;
      }
    });

    updateMode();
    renderCalendar();
  });
</script>

<style>
  .compact-booking-panel {
    padding: clamp(1rem, 3vw, 1.4rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--panel-bg);
    box-shadow: var(--shadow);
  }
  .compact-booking-panel__heading { margin-bottom: 1rem; }
  .compact-booking-panel__heading :is(p, h2) { margin: 0; }
  .compact-booking-form {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.8rem;
    align-items: end;
  }
  .compact-booking-field { display: grid; gap: 0.35rem; min-width: 0; }
  .compact-booking-field > span { color: var(--muted); font-size: 0.85rem; font-weight: 700; }
  .compact-booking-field small { font-weight: 400; }
  .compact-booking-field :is(input, select) {
    width: 100%; min-height: 44px; padding: 0.55rem 0.65rem;
    border: 1px solid var(--line); border-radius: 0.55rem; background: #fff; color: var(--ink);
  }
  .compact-booking-date-trigger,
  .compact-guests > summary {
    min-height: 58px;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: #fff;
    color: var(--ink);
    text-align: left;
  }
  .compact-booking-date-trigger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }
  .compact-booking-date-trigger > span { display: grid; gap: 0.15rem; min-width: 0; }
  .compact-booking-date-trigger > span + span { padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .compact-booking-date-trigger small,
  .compact-guests > summary > span { color: var(--muted); font-size: 0.78rem; font-weight: 700; }
  .compact-booking-date-trigger strong,
  .compact-guests > summary strong { overflow: hidden; font-size: 0.92rem; text-overflow: ellipsis; white-space: nowrap; }
  .compact-guests { position: relative; min-width: 0; }
  .compact-guests > summary { display: grid; gap: 0.15rem; cursor: pointer; list-style: none; }
  .compact-guests > summary::-webkit-details-marker { display: none; }
  .compact-guests__popover {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.4rem);
    right: 0;
    width: min(21rem, calc(100vw - 4rem));
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .compact-guests__row { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 1rem; }
  .compact-guests__row > span { display: grid; }
  .compact-guests__row small { color: var(--muted); }
  .compact-guests__row > div { display: grid; grid-template-columns: 36px 42px 36px; align-items: center; }
  .compact-guests__row button { min-height: 36px; border: 1px solid var(--line); background: var(--panel-bg); color: var(--ink); font-size: 1.2rem; }
  .compact-guests__row button:first-child { border-radius: 999px 0 0 999px; }
  .compact-guests__row button:last-child { border-radius: 0 999px 999px 0; }
  .compact-guests__row input { width: 42px; min-height: 36px; border: solid var(--line); border-width: 1px 0; background: #fff; color: var(--ink); text-align: center; appearance: textfield; }
  .compact-guests__row input::-webkit-inner-spin-button { appearance: none; }
  .compact-guests__done { width: 100%; margin-top: 0.6rem; justify-content: center; }
  .compact-booking-field--property { grid-column: span 2; }
  .compact-booking-field--recommendation {
    grid-column: 1 / -1;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--panel-bg);
  }
  .compact-booking-field--recommendation[hidden] { display: none; }
  .compact-date-calendar {
    grid-column: 1 / -1; min-width: 0; margin: 0; padding: 0.8rem;
    border: 1px solid var(--line); border-radius: 0.75rem; background: #fff;
  }
  .compact-date-calendar legend { padding: 0 0.35rem; font-weight: 700; }
  .compact-date-calendar__toolbar { display: grid; grid-template-columns: 44px 1fr 44px; align-items: center; gap: 0.5rem; }
  .compact-date-calendar__toolbar strong { text-align: center; }
  .compact-date-calendar__toolbar button {
    min-width: 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel-bg); color: var(--ink);
  }
  .compact-date-calendar [data-compact-calendar-message] { min-height: 1.5em; margin: 0.6rem 0; color: var(--muted); font-size: 0.9rem; }
  .compact-date-calendar__weekdays,
  .compact-date-calendar__days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.2rem; text-align: center; }
  .compact-date-calendar__weekdays { margin-bottom: 0.25rem; color: var(--muted); font-size: 0.72rem; font-weight: 700; }
  .compact-date-calendar__days :global(button) {
    min-width: 0; min-height: 40px; padding: 0.2rem; border: 0; border-radius: 0.45rem; background: transparent; color: var(--ink);
  }
  .compact-date-calendar__days :global(button:not(:disabled):hover),
  .compact-date-calendar__days :global(button:not(:disabled):focus-visible) { outline: 2px solid var(--accent); outline-offset: 1px; }
  .compact-date-calendar__days :global(button.is-in-range) {
    border-radius: 0;
    background: #eef4eb;
  }
  .compact-date-calendar__days :global(button:is(.is-arrival, .is-departure)) {
    background: var(--soft-accent);
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--accent);
    font-weight: 800;
  }
  .compact-date-calendar__days :global(button:disabled) { color: var(--muted); opacity: 0.45; }
  .compact-booking-panel:not(.compact-booking-panel--calendar-ready) .compact-date-calendar,
  .compact-booking-panel--calendar-ready:not(.compact-booking-panel--calendar-open) .compact-date-calendar { display: none; }
  .compact-booking-panel--calendar-ready .compact-booking-field input[type='date'] { cursor: pointer; }
  .compact-booking-panel__action .button { width: 100%; min-height: 44px; margin: 0; justify-content: center; }
  .compact-booking-panel__bespoke,
  .compact-booking-panel__status { margin: 0.9rem 0 0; }
  .compact-booking-panel__status { color: var(--muted); }
  .compact-booking-result {
    margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line);
  }
  .compact-booking-result[hidden], .compact-booking-panel__bespoke[hidden] { display: none; }
  .compact-sheet__header,
  .compact-sheet__close,
  .compact-sheet-backdrop { display: none; }
  .compact-booking-result__heading { display: flex; gap: 1rem; align-items: baseline; justify-content: space-between; }
  .compact-booking-result__heading h3 { margin: 0; }
  .compact-booking-result__heading strong { font-size: 1.35rem; white-space: nowrap; }
  .compact-booking-result details { margin: 0.8rem 0; }
  .compact-booking-result summary { cursor: pointer; font-weight: 700; }
  .compact-booking-result dl { display: grid; grid-template-columns: 1fr auto; gap: 0.4rem 1rem; }
  .compact-booking-result :is(dt, dd) { margin: 0; }
  .compact-booking-result__estimate { margin: 0; font-size: 1.1rem; }
  .compact-booking-result__stay { margin: 0.45rem 0 0; font-weight: 800; }
  .compact-booking-result__continue { margin-top: 0.6rem; }
  .compact-booking-result__reassurance { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.85rem; }
  @media (max-width: 520px) {
    .compact-booking-form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .compact-booking-field--property, .compact-booking-panel__action { grid-column: 1 / -1; }
    .compact-booking-result__heading { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
  }

  @media (max-width: 699px) {
    .compact-booking-panel--mobile-dock {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .compact-booking-panel--mobile-dock .compact-booking-form {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 0.9fr) minmax(5.25rem, 0.8fr);
      gap: 0.35rem;
      align-items: stretch;
    }

    .compact-booking-panel--mobile-dock :is(.compact-booking-date-trigger, .compact-guests > summary) {
      min-height: 44px;
      padding: 0.3rem 0.42rem;
      border-radius: 0.4rem;
    }

    .compact-booking-panel--mobile-dock .compact-booking-date-trigger > span + span {
      padding-left: 0.4rem;
    }

    .compact-booking-panel--mobile-dock :is(.compact-booking-date-trigger small, .compact-guests > summary > span) {
      font-size: 0.62rem;
      line-height: 1;
    }

    .compact-booking-panel--mobile-dock :is(.compact-booking-date-trigger strong, .compact-guests > summary strong) {
      font-size: 0.72rem;
      line-height: 1.1;
    }

    .compact-booking-panel--mobile-dock .compact-booking-panel__action {
      grid-column: auto;
    }

    .compact-booking-panel--mobile-dock .compact-booking-panel__action .button {
      min-height: 44px;
      padding: 0.35rem 0.45rem;
      border-radius: 0.4rem;
      font-size: 0.72rem;
      line-height: 1.05;
    }

    .compact-booking-panel--mobile-dock :is(.compact-date-calendar, .compact-guests__popover, .compact-booking-response) {
      position: fixed;
      z-index: 4;
      right: 0.5rem;
      bottom: calc(4rem + env(safe-area-inset-bottom));
      left: 0.5rem;
      width: auto;
      max-height: calc(100dvh - 5rem - env(safe-area-inset-bottom));
      margin: 0;
      padding: 1rem;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-radius: 0.9rem 0.9rem 0 0;
      background: #fff;
      box-shadow: 0 -1rem 2.5rem rgba(19, 35, 27, 0.28);
    }

    .compact-booking-panel--mobile-dock .compact-booking-response {
      display: none;
      color: var(--ink);
    }

    .compact-booking-panel--mobile-dock[data-open-sheet='result'] .compact-booking-response {
      display: block;
    }

    .compact-booking-panel--mobile-dock .compact-guests__popover {
      top: auto;
    }

    .compact-booking-panel--mobile-dock .compact-sheet__close {
      position: sticky;
      z-index: 1;
      top: 0;
      display: flex;
      width: 44px;
      min-height: 44px;
      margin: -0.45rem -0.45rem 0.25rem auto;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--panel-bg);
      color: var(--ink);
      font-size: 1.6rem;
      line-height: 1;
    }

    .compact-booking-panel--mobile-dock .compact-date-calendar > legend {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .compact-booking-panel--mobile-dock .compact-sheet__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.35rem;
    }

    .compact-booking-panel--mobile-dock .compact-sheet__header .compact-sheet__close {
      position: static;
      flex: 0 0 auto;
      margin: -0.45rem -0.45rem 0 auto;
    }

    .compact-booking-panel--mobile-dock .compact-sheet-backdrop {
      position: fixed;
      z-index: 1;
      inset: 0 0 calc(4rem + env(safe-area-inset-bottom));
      width: 100%;
      border: 0;
      background: rgba(19, 35, 27, 0.54);
    }

    .compact-booking-panel--mobile-dock .compact-sheet-backdrop[hidden] {
      display: none;
    }

    .compact-booking-panel--mobile-dock .compact-booking-field--recommendation {
      padding: 0;
      border: 0;
      background: transparent;
    }

    .compact-booking-panel--mobile-dock .compact-booking-result {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .compact-booking-panel--mobile-dock .compact-booking-panel__status {
      margin: 0.5rem 0 0;
    }
  }

</style>
