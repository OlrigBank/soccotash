---
import BookingConversation from './BookingConversation.astro';
import type { BookingMessage } from '../lib/booking/messaging';
import type { CustomerBookingOffer } from '../lib/booking/repository';
import type { BookingPayment } from '../lib/booking/payment-lifecycle';
import { getCancellationDisplayState, hasAcceptedOfferEvidence } from '../lib/booking/cancellation-display';
import { listAllowedBookingTransitions } from '../lib/booking/lifecycle';

interface Props {
  offer: CustomerBookingOffer;
  messages: BookingMessage[];
  propertyName: string;
  pollingUrl: string;
  responseNotice?: string | null;
  responseError?: string;
  messageNotice?: string;
  messageError?: string;
  allowResponse?: boolean;
  adminPreview?: boolean;
  emailStatus?: 'sent' | 'failed' | 'skipped' | null;
  messageNotificationAvailable?: boolean;
  payments?: BookingPayment[];
  view?: 'combined' | 'messages' | 'reservation';
}

const {
  offer,
  messages,
  propertyName,
  pollingUrl,
  responseNotice = null,
  responseError = '',
  messageNotice = '',
  messageError = '',
  allowResponse = true,
  adminPreview = false,
  emailStatus = null,
  messageNotificationAvailable = false,
  payments = [],
  view = 'combined',
} = Astro.props;

const money = (pence: number, currency = 'GBP') => new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format(pence / 100);
const dateLabel = (value: string) => new Intl.DateTimeFormat('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${value}T12:00:00Z`));

const confirmed = offer.bookingStatus === 'confirmed' || offer.bookingStatus === 'approved';
const cancelled = offer.bookingStatus === 'cancelled';
const paymentPending = offer.bookingStatus === 'payment_pending';
const paymentReported = offer.bookingStatus === 'payment_reported';
const openPayment = payments.find((payment) => payment.status === 'reported') || null;
const depositVerified = payments.some((payment) => payment.stage === 'deposit' && payment.status === 'verified');
const balanceVerified = payments.some((payment) => payment.stage === 'balance' && payment.status === 'verified');
const fullPaymentVerified = payments.some((payment) => payment.stage === 'full_payment' && payment.status === 'verified');
const balanceReported = confirmed && openPayment?.stage === 'balance';
const fullyPaid = fullPaymentVerified || (offer.balanceDuePence > 0 && depositVerified && balanceVerified);
const acceptedOffer = hasAcceptedOfferEvidence({
  acceptedAt: offer.acceptedAt,
  customerStatus: offer.customerStatus,
  bookingStatus: offer.bookingStatus,
});
const cancellationDisplay = getCancellationDisplayState({
  cancelled,
  fullyPaid,
  acceptedOffer,
});
const canCancel = allowResponse && !adminPreview && listAllowedBookingTransitions(offer.bookingStatus, 'booker')
  .some((transition) => transition.action === 'cancel_booking');
const canReportBalance = allowResponse && confirmed && offer.balanceDuePence > 0 && depositVerified && !balanceVerified && !openPayment && !cancelled;
const fullPaymentRequired = offer.balanceDuePence === 0;
const initialPaymentLabel = fullPaymentRequired ? 'full payment' : 'deposit';
const initialPaymentLabelTitle = fullPaymentRequired ? 'Full payment' : 'Deposit';
const initialPaymentDueLabel = offer.depositDueAt
  ? new Date(offer.depositDueAt).toLocaleString('en-GB', { dateStyle: 'long', timeStyle: 'short' })
  : null;
const requestPending = offer.customerStatus === 'request_pending' || offer.bookingStatus === 'pending';
const isActive = allowResponse && offer.customerStatus === 'active' && offer.bookingStatus === 'offered';
const displayStatus = cancelled ? 'cancelled'
  : confirmed ? 'confirmed'
  : paymentReported ? 'payment_reported'
    : paymentPending ? 'payment_pending'
      : requestPending ? 'pending' : offer.customerStatus;
const statusHeading = cancelled
  ? cancellationDisplay.statusHeading
  : fullyPaid
  ? 'Booking confirmed and fully paid'
  : balanceReported
  ? 'Booking confirmed · balance awaiting verification'
  : confirmed
  ? 'Booking confirmed · balance outstanding'
  : paymentReported
    ? 'Payment reported — awaiting verification'
    : paymentPending
      ? `${initialPaymentLabelTitle} required`
      : requestPending
        ? 'Booking request received'
        : offer.customerStatus === 'declined'
          ? 'Offer declined'
          : offer.customerStatus === 'expired'
            ? 'Offer expired'
            : offer.customerStatus === 'superseded'
              ? 'Offer replaced'
              : offer.customerStatus === 'cancelled'
                ? 'Booking cancelled'
                : 'Booking offer ready';
const statusMessage = cancelled
  ? 'This booking has been cancelled. The conversation remains available as the permanent record.'
  : fullyPaid
  ? 'Your direct booking with Olrig Bank is confirmed and fully paid. This private page remains the current booking record.'
  : balanceReported
  ? 'Your booking remains confirmed while Olrig Bank verifies the reported remaining-balance transfer.'
  : confirmed
  ? 'Your direct booking with Olrig Bank is confirmed. The remaining balance can be paid now and must be received by the recorded deadline.'
  : paymentReported
    ? `You reported that the ${initialPaymentLabel} was sent. Olrig Bank must verify the transfer against the bank account before the booking is confirmed.`
    : paymentPending
      ? `You accepted the offer. Send the required ${initialPaymentLabel} by manual bank transfer; confirmation follows after Olrig Bank verifies receipt.`
      : requestPending
        ? offer.propertyId === 'bespoke-arrangement'
          ? 'Jenna and the Olrig Bank team are reviewing your non-blocking request. Your dates have not been reserved.'
          : 'Your dates are being held provisionally while Jenna and the Olrig Bank team review the request.'
        : offer.customerStatus === 'declined'
          ? 'You declined this offer. Continue the conversation if you would like to discuss another stay.'
          : offer.customerStatus === 'expired'
            ? 'The acceptance period has ended. Send a message if you would like the stay to be reconsidered.'
            : offer.customerStatus === 'superseded'
              ? 'A newer offer replaced this one. Reservation details show the current offer when available.'
              : offer.customerStatus === 'cancelled'
                ? 'This booking has been cancelled. The conversation remains available as a record.'
                : 'Open Reservation details to review the price, terms and response options.';

function responseMessage(): string {
  const accepted = responseNotice === 'accepted' || responseNotice === 'confirmed' || responseNotice === 'payment-required';
  if (accepted) {
    if (emailStatus === 'sent') return `Your offer is accepted. The ${initialPaymentLabel} is now required, and an email copy was sent.`;
    if (emailStatus === 'failed') return `Your offer is accepted and the ${initialPaymentLabel} is now required. The optional email copy could not be sent.`;
    return `Your offer is accepted. The ${initialPaymentLabel} is now required.`;
  }
  if (emailStatus === 'sent') return 'Your decision to decline was recorded and an email copy was sent.';
  if (emailStatus === 'failed') return 'Your decision to decline was recorded, although the optional email copy could not be sent.';
  return 'Your decision to decline was recorded.';
}

const conversationNotice = messageNotice || ((responseNotice === 'accepted' || responseNotice === 'confirmed' || responseNotice === 'payment-required' || responseNotice === 'declined') ? responseMessage() : '');
const conversationError = messageError || responseError;
---
<section class="customer-booking-shell">
  {adminPreview && <div class="customer-booking-message is-preview" role="status">
    Administrator preview of the Booker booking page.
    <a href={`/admin/bookings/${offer.bookingReference}/`}>Return to the booking conversation</a>
  </div>}

  {(view === 'combined' || view === 'messages') && <BookingConversation
    messages={messages}
    viewer="booker"
    heading={adminPreview ? `Booker conversation: ${offer.guestName}` : 'Conversation with Olrig Bank'}
    intro={adminPreview ? 'This is how the continuing booking conversation appears to the Booker.' : 'Reply here to Jenna and the Olrig Bank team. New messages are checked automatically.'}
    pollingUrl={pollingUrl}
    bookingStatus={offer.bookingStatus}
    reservationVersion={`${offer.bookingStatus}:${offer.customerStatus}:${offer.offerId || ''}:${offer.publishedAt || ''}:${offer.arrival}:${offer.departure}:${offer.bespokeSuggestedArrival || ''}`}
    canCompose={!adminPreview}
    notificationAvailable={messageNotificationAvailable}
    notificationLabel="Also notify the Olrig Bank administrators by email"
    messageNotice={conversationNotice}
    messageError={conversationError}
    reservationButtonLabel={cancelled ? 'Booking record' : confirmed ? 'Reservation & payments' : paymentReported ? 'Payment verification' : paymentPending ? 'Payment & reservation' : requestPending ? 'Request details' : 'Offer & reservation'}
    showReservationButton={view === 'combined'}
  />}

  {(view === 'combined' || view === 'reservation') && <>
  {view === 'combined' && <div class="booking-drawer-backdrop" data-reservation-backdrop></div>}
  <aside class:list={[view === 'combined' ? 'booking-reservation-drawer' : 'customer-reservation-page']} data-reservation-drawer={view === 'combined' ? true : undefined} aria-hidden={view === 'combined' ? 'true' : 'false'} aria-label="Reservation details">
    <header class="booking-reservation-drawer__header">
      <div>
        <p class="eyebrow">Reservation</p>
        <h2>{propertyName}</h2>
      </div>
      {view === 'combined' && <button type="button" class="booking-drawer-close" data-close-reservation-drawer aria-label="Close reservation details">×</button>}
    </header>

    <div class="booking-reservation-drawer__body">
      {view === 'reservation' && conversationNotice && <div class="booking-conversation__notice is-success" role="status">{conversationNotice}</div>}
      {view === 'reservation' && conversationError && <div class="booking-conversation__notice is-error" role="alert">{conversationError}</div>}
      <section class="booking-drawer-section booking-drawer-status">
        <div>
          <h3>{statusHeading}</h3>
          <p>{statusMessage}</p>
        </div>
        <span class={`customer-booking-status status-${displayStatus}`}>{displayStatus.replaceAll('_', ' ')}</span>
      </section>

      <section class="booking-drawer-section">
        <p class="eyebrow">Stay details</p>
        <h3>Your stay</h3>
        <dl class="customer-booking-details">
          <div><dt>Arrival</dt><dd>{dateLabel(offer.arrival)}</dd></div>
          <div><dt>Departure</dt><dd>{dateLabel(offer.departure)}</dd></div>
          <div><dt>Party</dt><dd>{offer.guests} guest{offer.guests === 1 ? '' : 's'}{offer.pets ? ` · ${offer.pets} pet${offer.pets === 1 ? '' : 's'}` : ''}</dd></div>
          <div><dt>Booker</dt><dd>{offer.guestName}</dd></div>
          <div><dt>Email</dt><dd>{offer.guestEmail || 'Not supplied — email is optional'}</dd></div>
          <div><dt>Telephone</dt><dd>{offer.guestTelephone || 'None supplied'}</dd></div>
          <div><dt>Reference</dt><dd><code>{offer.bookingReference}</code></dd></div>
          <div><dt>Requested</dt><dd>{new Date(offer.requestCreatedAt).toLocaleString('en-GB')}</dd></div>
          {!confirmed && !cancelled && offer.validUntil && <div><dt>Offer valid through</dt><dd>{dateLabel(offer.validUntil)}</dd></div>}
          {(confirmed || cancelled) && offer.acceptedAt && <div><dt>Offer accepted</dt><dd>{new Date(offer.acceptedAt).toLocaleString('en-GB')}</dd></div>}
        </dl>
      </section>

      {requestPending && offer.propertyId === 'bespoke-arrangement' && offer.bespokeSuggestedArrival && offer.bespokeSuggestedDeparture && <section class="booking-drawer-section customer-booking-date-proposal">
        <p class="eyebrow">Alternative dates suggested</p>
        <h3>Olrig Bank has suggested a change to your request</h3>
        <p><strong>{dateLabel(offer.bespokeSuggestedArrival)} to {dateLabel(offer.bespokeSuggestedDeparture)}</strong></p>
        <p>Your first requested dates remain <strong>{dateLabel(offer.originalArrival)} to {dateLabel(offer.originalDeparture)}</strong>. This is still a pending request, not a booking offer. You can agree to the suggestion, send different dates of your own, retain the first dates, or cancel below.</p>
        {!adminPreview && <div class="customer-booking-date-proposal__actions">
          <form method="post">
            <input type="hidden" name="action" value="respond-bespoke-dates" />
            <input type="hidden" name="dateDecision" value="accept" />
            <button class="customer-booking-submit customer-booking-accept" type="submit">Agree to suggested dates</button>
          </form>
          <form method="post" class="customer-booking-date-change-form">
            <input type="hidden" name="action" value="respond-bespoke-dates" />
            <input type="hidden" name="dateDecision" value="change" />
            <label>My arrival date<input type="date" name="changedArrival" min={new Date().toISOString().slice(0, 10)} value={offer.originalArrival} required /></label>
            <label>My departure date<input type="date" name="changedDeparture" min={new Date().toISOString().slice(0, 10)} value={offer.originalDeparture} required /></label>
            <button class="customer-booking-submit" type="submit">Send my revised dates</button>
          </form>
          <form method="post">
            <input type="hidden" name="action" value="respond-bespoke-dates" />
            <input type="hidden" name="dateDecision" value="keep_original" />
            <button class="customer-booking-submit" type="submit">Keep my original dates</button>
          </form>
        </div>}
      </section>}

      {(paymentPending || paymentReported || confirmed || cancelled) && <section class="booking-drawer-section customer-booking-payment-history">
        <p class="eyebrow">Payment summary</p>
        <h3>{cancelled ? cancellationDisplay.paymentHeading : fullyPaid ? 'Booking confirmed and fully paid' : 'Accepted payment plan'}</h3>
        <dl class="customer-booking-details">
          <div><dt>{cancelled ? cancellationDisplay.totalLabel : 'Accepted total'}</dt><dd>{money(offer.totalPence, offer.currency)}</dd></div>
          <div><dt>{fullPaymentRequired ? 'Full payment' : 'Deposit'}</dt><dd>{money(offer.depositPence, offer.currency)}</dd></div>
          {!fullPaymentRequired && <div><dt>Remaining balance</dt><dd>{money(offer.balanceDuePence, offer.currency)}</dd></div>}
          {!fullPaymentRequired && <div><dt>Balance deadline</dt><dd>{offer.balanceDueOn ? dateLabel(offer.balanceDueOn) : 'Date agreed with Olrig Bank'}</dd></div>}
          {!cancelled && !fullPaymentRequired && !balanceVerified && <div><dt>Balance state</dt><dd>{balanceReported
            ? 'Reported — awaiting verification'
            : offer.balanceDueOn && offer.balanceDueOn < new Date().toISOString().slice(0, 10)
              ? 'Overdue'
              : offer.balanceDueOn === new Date().toISOString().slice(0, 10)
                ? 'Due today'
                : 'Upcoming'}</dd></div>}
          {(fullyPaid || cancelled) && <div><dt>Payment state</dt><dd>{cancelled ? cancellationDisplay.paymentState : 'Paid'}</dd></div>}
        </dl>

        <h3>Payment history</h3>
        {payments.length ? <div class="admin-table-wrap"><table><thead><tr><th>Reported</th><th>Payment</th><th>Method</th><th>Status</th></tr></thead><tbody>
          {payments.map((payment) => <tr>
            <td>{new Date(payment.reportedAt).toLocaleString('en-GB')}</td>
            <td><strong>{payment.stage === 'balance' ? 'Balance' : payment.stage === 'full_payment' ? 'Full payment' : 'Deposit'}</strong><small>{money(payment.amountPence, payment.currency)}</small></td>
            <td>Manual bank transfer</td>
            <td><span class={`status-badge status-${payment.status}`}>{payment.status}</span>{payment.verifiedAt && <small>Verified {new Date(payment.verifiedAt).toLocaleString('en-GB')}</small>}{payment.rejectedAt && <small>Rejected {new Date(payment.rejectedAt).toLocaleString('en-GB')}</small>}{payment.rejectionReason && <small>{payment.rejectionReason}</small>}{payment.cancelledAt && <small>Closed {new Date(payment.cancelledAt).toLocaleString('en-GB')}</small>}</td>
          </tr>)}
        </tbody></table></div> : <p>No payment has been reported yet.</p>}
      </section>}

      <section class="booking-drawer-section">
        <p class="eyebrow">Price breakdown</p>
        <h3>{cancelled ? cancellationDisplay.priceHeading : confirmed ? 'Confirmed price' : paymentReported || paymentPending ? 'Accepted offer' : requestPending && !offer.priceAvailable ? 'Price to be agreed' : requestPending ? 'Recorded provisional cost' : 'Current offer'}</h3>
        {offer.priceAvailable ? <div class="customer-booking-price-table">
          {offer.lineItems.map((line) => <div class="customer-booking-price-line">
            <div><strong>{line.label}</strong>{line.detail && <small>{line.detail}</small>}</div>
            <span>{money(line.amountPence, offer.currency)}</span>
          </div>)}
          <div class="customer-booking-price-line is-total"><strong>{requestPending ? 'Provisional total' : 'Total'}</strong><strong>{money(offer.totalPence, offer.currency)}</strong></div>
        </div> : <p>The price has not yet been confirmed. Olrig Bank will add it as part of the offer.</p>}
        {requestPending && offer.priceAvailable && <p class="customer-booking-price-note">This calculation was recorded when the request was made and can be revised before an offer is published.</p>}
      </section>

      {offer.terms && <section class="booking-drawer-section customer-booking-copy">
        <p class="eyebrow">Additional terms</p>
        <p>{offer.terms}</p>
      </section>}

      {paymentReported && <section class="booking-drawer-section customer-booking-payment">
        <div>
          <p class="eyebrow">{initialPaymentLabelTitle} verification</p>
          <h3>Your payment report is awaiting verification</h3>
          <p>Olrig Bank will check the bank account. No further payment-report action is needed unless Jenna contacts you in the conversation.</p>
        </div>
        <div class="pricing-message" role="status">
          <strong>The booking is not confirmed yet.</strong> It becomes confirmed only after an administrator verifies receipt of the {initialPaymentLabel}.
        </div>
      </section>}

      {balanceReported && <section class="booking-drawer-section customer-booking-payment">
        <div>
          <p class="eyebrow">Balance verification</p>
          <h3>Your balance report is awaiting verification</h3>
          <p>Olrig Bank will check the bank account. Your booking remains confirmed while this is completed.</p>
        </div>
        <div class="pricing-message" role="status"><strong>No further action is needed.</strong> The payment history will update after an administrator decides this report.</div>
      </section>}

      {canReportBalance && <section class="booking-drawer-section customer-booking-payment">
        <div>
          <p class="eyebrow">Remaining balance</p>
          <h3>Send {money(offer.balanceDuePence, offer.currency)} by manual bank transfer</h3>
          <p>You may pay now. The deadline is <strong>{offer.balanceDueOn ? dateLabel(offer.balanceDueOn) : 'the date agreed with Olrig Bank'}</strong>.</p>
          <p>Your booking remains confirmed while the transfer is reported and verified.</p>
        </div>
        <div class="customer-booking-payment-options">
          <article class="customer-booking-payment-option is-recommended">
            <span class="customer-booking-payment-badge">Available for first live bookings</span>
            <h4>Manual bank transfer</h4>
            <p>Use the bank details supplied by Olrig Bank and booking reference <code>{offer.bookingReference}</code>.</p>
            <form method="post" class="customer-booking-decision-form">
              <input type="hidden" name="action" value="report-bank-transfer" />
              <label class="customer-booking-confirm-check">
                <input type="checkbox" name="confirmTransfer" value="yes" required />
                <span>I confirm that I have sent the remaining balance by bank transfer.</span>
              </label>
              <button class="customer-booking-submit customer-booking-accept" type="submit">Report balance sent</button>
            </form>
            <small>This creates a new report for verification. It does not alter confirmation.</small>
          </article>
        </div>
      </section>}

      {paymentPending && <section class="booking-drawer-section customer-booking-payment">
        <div>
          <p class="eyebrow">{initialPaymentLabelTitle}</p>
          <h3>Send {money(offer.depositPence, offer.currency)} by manual bank transfer</h3>
          {initialPaymentDueLabel && <p>This payment is due by <strong>{initialPaymentDueLabel}</strong>.</p>}
          {fullPaymentRequired
            ? <p>The full accepted total is due because this booking was accepted within the pricing plan’s balance-payment period.</p>
            : <p>The remaining balance is {money(offer.balanceDuePence, offer.currency)} and is due by <strong>{offer.balanceDueOn ? dateLabel(offer.balanceDueOn) : 'the date agreed with Olrig Bank'}</strong>.</p>}
        </div>
        <div class="customer-booking-payment-options">
          <article class="customer-booking-payment-option is-recommended">
            <span class="customer-booking-payment-badge">Available for first live bookings</span>
            <h4>Manual bank transfer</h4>
            <p>Send the {initialPaymentLabel} using the bank details supplied by Olrig Bank. Use booking reference <code>{offer.bookingReference}</code>.</p>
            <form method="post" class="customer-booking-decision-form">
              <input type="hidden" name="action" value="report-bank-transfer" />
              <label class="customer-booking-confirm-check">
                <input type="checkbox" name="confirmTransfer" value="yes" required />
                <span>I confirm that I have sent the {initialPaymentLabel} by bank transfer.</span>
              </label>
              <button class="customer-booking-submit customer-booking-accept" type="submit">Report bank transfer sent</button>
            </form>
            <small>This records your report for administrator verification; it does not confirm the booking.</small>
          </article>
          <article class="customer-booking-payment-option">
            <h4>GoCardless Instant Bank Pay</h4>
            <p>Hosted online bank payment is planned for a later release.</p>
            <button type="button" class="customer-booking-submit" disabled aria-disabled="true">Not available yet</button>
          </article>
          <article class="customer-booking-payment-option">
            <h4>Stripe card payment</h4>
            <p>Hosted card checkout is planned for a later release.</p>
            <button type="button" class="customer-booking-submit" disabled aria-disabled="true">Not available yet</button>
          </article>
        </div>
      </section>}

      {isActive && <section class="booking-drawer-section customer-booking-response">
        <div>
          <p class="eyebrow">Your response</p>
          <h3>Accept or decline this offer</h3>
          <p>Accepting records your agreement to the dates, price and terms. The booking is confirmed after the initial payment required by the pricing plan is verified.</p>
        </div>
        <div class="customer-booking-actions">
          <form method="post" class="customer-booking-decision-form">
            <input type="hidden" name="action" value="accept" />
            <strong>Accept offer</strong>
            <p>Confirm that you accept the dates, price and terms shown here.</p>
            <label class="customer-booking-confirm-check">
              <input type="checkbox" name="confirmAccept" value="yes" required />
              <span>I have reviewed and accept the dates, price and terms.</span>
            </label>
            <button class="customer-booking-submit customer-booking-accept" type="submit">Accept offer and continue to payment</button>
          </form>

          <form method="post" class="customer-booking-decision-form is-decline">
            <input type="hidden" name="action" value="decline" />
            <strong>Decline this offer</strong>
            <p>Declining closes this offer. Continue the conversation to discuss a different stay.</p>
            <label class="customer-booking-confirm-check">
              <input type="checkbox" name="confirmDecline" value="yes" required />
              <span>I understand that declining will close this offer.</span>
            </label>
            <button class="customer-booking-submit customer-booking-decline" type="submit">Decline booking offer</button>
          </form>
        </div>
      </section>}

      {canCancel && <section class="booking-drawer-section customer-booking-response">
        <div>
          <p class="eyebrow">{requestPending ? 'Cancel request' : 'Cancel booking'}</p>
          <h3>{requestPending ? 'Cancel this pending request' : 'Cancel this booking and release its dates'}</h3>
          <p>{requestPending
            ? 'This closes the request without treating the date discussion as an offer. The conversation remains available as a permanent record.'
            : 'This is separate from declining an offer. The booking, payment history and conversation will remain available as a permanent record.'}</p>
        </div>
        <form method="post" class="customer-booking-decision-form is-decline">
          <input type="hidden" name="action" value="cancel-booking" />
          <label class="booking-field">
            <span>Reason for cancellation</span>
            <textarea name="cancellationReason" rows="4" maxlength="1000" required></textarea>
          </label>
          <label class="customer-booking-confirm-check">
            <input type="checkbox" name="confirmCancellation" value="yes" required />
            <span>I confirm that I want to cancel this {requestPending ? 'request' : 'booking and release its dates'}.</span>
          </label>
          <button class="customer-booking-submit customer-booking-decline" type="submit">Cancel {requestPending ? 'request' : 'booking'}</button>
        </form>
      </section>}

      <p class="customer-booking-help">Use the conversation as the primary contact method for questions, changes and later amendment requests.</p>
    </div>
  </aside></>}
</section>
