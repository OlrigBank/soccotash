---
import '../styles/global.css';

const { title = 'Administration' } = Astro.props;
const user = Astro.locals.adminUser;
const activePath = Astro.url.pathname;
const links = [
  ['/admin/', 'Dashboard'],
  ['/admin/content/', 'Website content'],
  ['/admin/listings/', 'Listings'],
  ['/admin/calendars/', 'Calendars'],
  ['/admin/planner/', 'Holiday Planner'],
  ['/admin/local-guide/', 'Local Guide'],
  ['/admin/planner/contributions/', 'Guide contributions'],
  ['/admin/pricing/', 'Pricing'],
  ['/admin/occupancy/', 'Occupancy'],
  ['/admin/accommodation/', 'Accommodation'],
  ['/admin/bookings/', 'Bookings'],
  ['/admin/airbnb/', 'Airbnb records'],
  ['/admin/alerts/', 'Alerts'],
  ['/admin/settings/', 'Settings'],
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} | Olrig Bank Administration</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-content">Skip to main content</a>
    <header class="admin-header">
      <a class="admin-brand" href="/admin/">
        <span class="brand-mark">OB</span>
        <span>Olrig Bank Administration</span>
      </a>
      <div class="admin-account">
        <span>{user?.displayName}</span>
        <a href="/">View website</a>
        <form method="post" action="/admin/logout/">
          <button type="submit" class="link-button">Log out</button>
        </form>
      </div>
    </header>
    <details class="admin-mobile-menu">
      <summary>Administration menu</summary>
      <nav aria-label="Mobile administration navigation">
        {links.map(([href, label]) => {
          const active = href === '/admin/' ? activePath === href
            : href === '/admin/planner/' ? activePath.startsWith(href) && !activePath.startsWith('/admin/planner/contributions/')
            : activePath.startsWith(href);
          return (
            <a href={href} aria-current={active ? 'page' : undefined}>
              {label}
            </a>
          );
        })}
      </nav>
    </details>
    <div class="admin-shell">
      <aside class="admin-sidebar" aria-label="Administration navigation">
        <nav>
          {links.map(([href, label]) => {
            const active = href === '/admin/' ? activePath === href
              : href === '/admin/planner/' ? activePath.startsWith(href) && !activePath.startsWith('/admin/planner/contributions/')
              : activePath.startsWith(href);
            return (
              <a href={href} aria-current={active ? 'page' : undefined}>
                {label}
              </a>
            );
          })}
        </nav>
      </aside>
      <main id="admin-content" class="admin-main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
