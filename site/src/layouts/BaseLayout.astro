---
import SideMenu from '../components/SideMenu.astro';
import Analytics from '../components/Analytics.astro';
import { isNoIndex, productionAssetUrl, productionUrl } from '../lib/public-metadata';
import '../styles/global.css';
import '../styles/green-theme.css';

const {
  title = 'Olrig Bank',
  description = 'Guest information and local guide for Olrig Bank.',
  showSidebar = true,
  robots = '',
  analytics = true,
  socialImage = '/media/images/listings/house.jpeg',
  socialImageAlt = 'The stone front of Olrig Bank in Kendal',
  socialType = 'website',
} = Astro.props;

const pageTitle = title.includes('Olrig Bank') ? title : `${title} | Olrig Bank`;
const activePath = Astro.url.pathname;
const indexable = !isNoIndex(robots);
const productionSite = Astro.site ?? new URL('https://olrig-bank.com');
const canonicalUrl = indexable ? productionUrl(productionSite, activePath).href : '';
const socialImageUrl = indexable ? productionAssetUrl(productionSite, socialImage).href : '';
const currentYear = new Date().getFullYear();

function isCurrent(href: string) {
  if (href === '/') return activePath === '/';
  return activePath === href || activePath.startsWith(href);
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ec" />
    {robots && <meta name="robots" content={robots} />}
    <title>{pageTitle}</title>
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {indexable && <meta property="og:site_name" content="Olrig Bank" />}
    {indexable && <meta property="og:type" content={socialType} />}
    {indexable && <meta property="og:title" content={pageTitle} />}
    {indexable && <meta property="og:description" content={description} />}
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    {indexable && <meta property="og:image" content={socialImageUrl} />}
    {indexable && <meta property="og:image:alt" content={socialImageAlt} />}
    {indexable && <meta name="twitter:card" content="summary_large_image" />}
    {indexable && <meta name="twitter:title" content={pageTitle} />}
    {indexable && <meta name="twitter:description" content={description} />}
    {indexable && <meta name="twitter:image" content={socialImageUrl} />}
    {indexable && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {analytics && <Analytics />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="site-shell mobile-first-shell">
      <header class="site-header">
        <div class="header-inner mobile-first-header-inner">
          <a href="/" class="brand" aria-label="Olrig Bank home">
            <span class="brand-mark" aria-hidden="true">OB</span>
            <span class="brand-name">Olrig Bank</span>
          </a>

          <div class="mobile-header-actions">
            <a class="mobile-request-link" href="/book/">Request a stay</a>
            <details class="mobile-site-menu">
              <summary>Menu</summary>
              <nav aria-label="Mobile navigation">
                <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
                <a href="/listings/" aria-current={isCurrent('/listings/') ? 'page' : undefined}>Ways to stay</a>
                <a href="/guest-information/" aria-current={isCurrent('/guest-information/') ? 'page' : undefined}>Guest information</a>
                <a href="/local-guide/" aria-current={isCurrent('/local-guide/') ? 'page' : undefined}>Local guide</a>
                <a href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Contact</a>
              </nav>
            </details>
          </div>

          <nav class="top-nav desktop-top-nav" aria-label="Main navigation">
            <a href="/book/">Request a stay</a>
            <a href="/listings/">Listings</a>
            <a href="/guest-information/">Guest information</a>
            <a href="/contact/">Contact</a>
            <a href="/local-guide/">Local guide</a>
          </nav>
        </div>
      </header>

      <div class:list={['page-grid', showSidebar ? 'has-sidebar' : 'no-sidebar']}>
        {showSidebar ? (
          <div class="desktop-sidebar-wrap">
            <SideMenu activePath={activePath} />
          </div>
        ) : null}

        <main id="main-content" tabindex="-1">
          <slot />
        </main>
      </div>

      <footer class="site-footer">
        <div class="footer-inner">
          <p>© {currentYear} Olrig Bank, Kendal, Cumbria.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    min-width: 320px;
    overflow-x: hidden;
  }

  .mobile-first-shell,
  .site-header,
  .mobile-first-header-inner {
    min-width: 0;
    max-width: 100%;
  }

  .mobile-first-shell {
    width: 100%;
    overflow-x: hidden;
  }

  .site-header {
    contain: inline-size;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 100;
    transform: translateY(-150%);
    padding: 0.65rem 0.85rem;
    border-radius: 999px;
    background: var(--accent-dark);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .header-inner,
  .page-grid,
  .footer-inner {
    width: min(1180px, calc(100% - 1rem));
    margin-inline: auto;
  }

  .mobile-first-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0;
  }

  .brand {
    min-height: 44px;
  }

  .brand-mark {
    flex: 0 0 auto;
  }

  .mobile-header-actions {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .mobile-request-link,
  .mobile-site-menu > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
  }

  .mobile-request-link {
    padding: 0.65rem 0.8rem;
    background: var(--accent-dark);
    color: #fff;
  }

  .mobile-site-menu > summary {
    gap: 0.35rem;
    min-width: 4.35rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--panel-bg);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .mobile-site-menu > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-site-menu > summary::after {
    content: '▾';
    transition: transform 160ms ease;
  }

  .mobile-site-menu[open] > summary::after {
    transform: rotate(180deg);
  }

  .mobile-site-menu nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    z-index: 20;
    display: grid;
    width: min(18rem, calc(100vw - 1rem));
    padding: 0.55rem;
    background: var(--panel-bg);
    border: 1px solid var(--line);
    border-radius: 1rem;
    box-shadow: var(--shadow);
  }

  .mobile-site-menu nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 0.75rem;
    border-radius: 0.65rem;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-site-menu nav a[aria-current='page'] {
    background: var(--soft-accent);
  }

  .mobile-request-link:hover,
  .mobile-request-link:focus-visible {
    background: var(--accent);
  }

  .mobile-site-menu > summary:hover,
  .mobile-site-menu > summary:focus-visible,
  .mobile-site-menu nav a:hover,
  .mobile-site-menu nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .desktop-top-nav {
    display: none;
  }

  .desktop-sidebar-wrap {
    display: none;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1rem 0 2rem;
  }

  main {
    min-width: 0;
    width: 100%;
  }

  .hero {
    padding: clamp(1.25rem, 7vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 10vw, 4rem);
    line-height: 1.05;
  }

  .prose {
    padding: clamp(1rem, 5vw, 2rem);
    overflow-wrap: anywhere;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .card-content {
    padding: clamp(1rem, 4vw, 1.25rem);
  }

  .button {
    min-height: 44px;
    padding: 0.7rem 1rem;
  }

  input,
  select,
  textarea,
  button {
    font: inherit;
  }

  @media (min-width: 480px) {
    .header-inner,
    .page-grid,
    .footer-inner {
      width: min(1180px, calc(100% - 1.5rem));
    }
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }
  }

  @media (min-width: 820px) {
    .header-inner,
    .page-grid,
    .footer-inner {
      width: min(1180px, calc(100% - 2rem));
    }

    .desktop-top-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.8rem;
    }

    .desktop-top-nav a {
      min-height: auto;
      padding: 0;
      border-radius: 0.5rem;
      background: transparent;
    }

    .mobile-header-actions {
      display: none;
    }

    .desktop-sidebar-wrap {
      display: block;
      min-width: 0;
    }

    .page-grid {
      padding: 2rem 0 3rem;
    }

    .page-grid.has-sidebar {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 2rem;
    }

    .desktop-sidebar-wrap .sidebar {
      position: sticky;
      top: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (max-width: 359px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .mobile-request-link {
      padding-inline: 0.65rem;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-site-menu > summary::after {
      transition: none;
    }
  }
</style>
