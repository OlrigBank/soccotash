---
import BookerNavigation from '../components/BookerNavigation.astro';
import { sessionAccount } from '../lib/booker/accounts.ts';
const signedIn = Boolean(await sessionAccount(Astro.cookies));
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import '../styles/green-theme.css';

const {
  title = 'Your booking',
  description = 'Your private booking page.',
  robots = 'noindex,nofollow,noarchive',
  analytics = false,
  showHeader = true,
  homeHref = Astro.url.pathname.match(/^\/booking\/manage\/[^/]+/)?.[0] + '/',
  homeLabel = 'Your booking home',
  areaTitle = 'Your booking',
  footerLabel = 'Private booking service',
} = Astro.props;
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ec" />
    <meta name="robots" content={robots} />
    <title>{title} | {areaTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {analytics && <Analytics />}
  </head>
  <body class="public-ui booker-area">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="booker-shell">
      <header class="booker-header" hidden={!showHeader}>
        <div class="booker-header__inner">
          <a class="booker-brand" href={homeHref} aria-label={`Olrig Bank Kendal — ${homeLabel}`}>
            <img class="booker-brand__logo" src="/media/images/listings/olrig-bank-header-logo.png" alt="" width="1536" height="1024" />
          </a>
          <BookerNavigation signedIn={signedIn} />
        </div>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="booker-footer"><p>{footerLabel} · © {currentYear} Olrig Bank</p></footer>
    </div>
  </body>
</html>

<style>
  .skip-link { position:fixed;top:.5rem;left:.5rem;z-index:100;padding:.75rem 1rem;background:#fffaf2;color:var(--accent-dark);transform:translateY(calc(-100% - 1rem)); }
  .skip-link:focus { transform:none;outline:3px solid var(--accent-dark);outline-offset:2px; }
  @media(max-width:600px) { .booker-header__inner { flex-wrap:wrap; } }
</style>
