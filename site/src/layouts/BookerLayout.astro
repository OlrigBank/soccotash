---
import BookerAccountEntry from '../components/BookerAccountEntry.astro';
import { sessionAccount } from '../lib/booker/accounts.ts';
const signedIn = Boolean(await sessionAccount(Astro.cookies));
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import '../styles/green-theme.css';

const {
  title = 'Your booking',
  description = 'Your private booking page.',
  robots = 'noindex,nofollow,noarchive',
  analytics = false,
  showHeader = true,
  homeHref = Astro.url.pathname.match(/^\/booking\/manage\/[^/]+/)?.[0] + '/',
  homeLabel = 'Your booking home',
  areaLabel = 'Private stay area',
  areaTitle = 'Your booking',
  footerLabel = 'Private booking service',
} = Astro.props;
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3ec" />
    <meta name="robots" content={robots} />
    <title>{title} | {areaTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {analytics && <Analytics />}
  </head>
  <body class="public-ui booker-area">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="booker-shell">
      <header class="booker-header" hidden={!showHeader}>
        <div class="booker-header__inner">
          <a class="booker-brand" href={homeHref} aria-label={homeLabel}>
            <img class="booker-brand__logo" src="/media/images/listings/olrig-bank-header-logo.png" alt="" width="1536" height="1024" />
            <span><small>{areaLabel}</small><strong>{areaTitle}</strong></span>
          </a>
          <div class="booker-account-actions">
          <BookerAccountEntry />
          {signedIn && <form method="post" action="/api/booker/logout/"><button type="submit" class="button">Log out</button></form>}
          <a class="booker-public-link" href="/" target="_blank" rel="noopener noreferrer">Visit the public website <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </header>
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="booker-footer"><p>{footerLabel} · © {currentYear} Olrig Bank</p></footer>
    </div>
  </body>
</html>

<style>
  .booker-account-actions { display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:.75rem; }
  .booker-account-actions form { margin:0; }
  .booker-account-actions :global(.booker-public-link) { min-height:44px;display:inline-flex;align-items:center; }
  @media(max-width:600px) { .booker-account-actions { justify-content:flex-start;gap:.5rem; } }
</style>
