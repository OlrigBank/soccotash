---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
export const prerender = false;
---
<BaseLayout title="Request a stay" description="Check current availability and request a provisional stay at Olrig Bank." showSidebar={false} pageClass="booking-journey-page">
  <section class="hero"><span class="badge">Book direct</span><h1>Request a stay</h1><p>Choose your stay, check the latest availability and price, then send your details to Olrig Bank.</p><p class="booking-journey-reassurance">You will not be charged and your booking is not confirmed when you send this request.</p></section>
  <BookingCalendar />
</BaseLayout>
