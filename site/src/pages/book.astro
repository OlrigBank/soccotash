---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
export const prerender = false;
---
<BaseLayout title="Arrange a stay or event" description="Choose a stay arrangement or plan a bespoke event at Olrig Bank.">
  <section class="hero"><span class="badge">Direct enquiry</span><h1>What would you like to arrange?</h1><p>Choose a predefined stay below, or tell us about a bespoke event.</p><p><a class="button" href="/events/request/">Plan an event at Olrig Bank</a></p></section>
  <BookingCalendar />
</BaseLayout>
