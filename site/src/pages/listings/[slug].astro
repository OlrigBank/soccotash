---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactBookingPanel from '../../components/CompactBookingPanel.astro';
import Space from '../../components/Space.astro';
import { getProperties } from '../../lib/booking/config';
import { vacationRentalStructuredData, serializeStructuredData } from '../../lib/vacation-rental-structured-data';

export const prerender = true;

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  return listings.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allSpaces = await getCollection('spaces');
const spacesBySlug = new Map(allSpaces.map((space) => [space.data.slug, space]));
const selectedSpaces: CollectionEntry<'spaces'>[] = [];

for (const slug of entry.data.spaces) {
  const space = spacesBySlug.get(slug);
  if (space) selectedSpaces.push(space);
}

const missingSpaceSlugs = entry.data.spaces.filter((slug) => !spacesBySlug.has(slug));
const listingFacts = [entry.data.sleeps, entry.data.bedrooms, entry.data.bathrooms].filter(Boolean);
const bookingProperty = getProperties().find((property) => property.listingSlug === entry.data.slug);
const bespokeListing = bookingProperty?.id === 'bespoke-arrangement';
const roomTitles: Record<string, Record<string, string>> = {
  'olrig-bank': {
    'house-bedroom-1': 'Bedroom 1',
    'house-bedroom-2': 'Bedroom 2',
    'house-bedroom-3': 'Bedroom 3',
    'house-bedroom-4': 'Bedroom 4',
    'house-bathroom-1': 'Upstairs Bathroom 1',
    'house-bathroom-2': 'Downstairs Bathroom 1',
  },
  event: {
    'house-bedroom-1': 'Bedroom 1',
    'house-bedroom-2': 'Bedroom 2',
    'house-bedroom-3': 'Bedroom 3',
    'house-bedroom-4': 'Bedroom 4',
    'cottage-bedroom-1': 'Bedroom 5',
    'cottage-bedroom-2': 'Bedroom 6',
    'house-bathroom-1': 'Upstairs Bathroom 1',
    'cottage-bathroom-1': 'Upstairs Bathroom 2',
    'house-bathroom-2': 'Downstairs Bathroom 1',
    'cottage-wc-1': 'WC',
    'cottage-landing-1': 'Landing',
  },
};
const roomPresentation = (space: CollectionEntry<'spaces'>) => {
  const title = roomTitles[entry.data.slug ?? entry.id]?.[space.data.slug];
  if (!title) return {};
  return {
    title,
    summary: entry.data.slug === 'event' && space.data.spaceGroup === 'cottage'
      ? `${title} at Olrig Bank Max.`
      : space.data.summary,
  };
};
const productionSite = Astro.site ?? new URL('https://olrig-bank.com');
const listingImages = [
  entry.data.image,
  ...selectedSpaces.flatMap((space) => [space.data.image, ...(space.data.gallery ?? [])]),
].filter((path): path is string => Boolean(path));
const structuredData = vacationRentalStructuredData({
  site: productionSite,
  slug: entry.data.slug ?? entry.id,
  identifier: `olrig-bank:${bookingProperty?.id ?? entry.id}`,
  name: entry.data.title,
  description: entry.data.description ?? entry.data.summary ?? entry.data.title,
  sleeps: entry.data.sleeps,
  bedrooms: entry.data.bedrooms,
  bathrooms: entry.data.bathrooms,
  imagePaths: listingImages,
  hasGarden: entry.data.spaces.includes('garden'),
});
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.description ?? entry.data.summary}
  socialImage={entry.data.image}
  socialImageAlt={entry.data.imageAlt ?? entry.data.title}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeStructuredData(structuredData)}
  ></script>

  <div class:list={["listing-opening", { "listing-opening--with-booking": bookingProperty }] }>
    <section class="hero listing-opening__description">
      {entry.data.heroEyebrow ? <p class="eyebrow">{entry.data.heroEyebrow}</p> : null}
      <h1>{entry.data.heroTitle ?? entry.data.title}</h1>
      {entry.data.summary ? <p>{entry.data.summary}</p> : null}
      {listingFacts.length ? <p class="listing-facts">{listingFacts.join(' · ')}</p> : null}
      <p class="listing-opening__contact">
        {bespokeListing ? 'Want to discuss your plans first?' : 'Have a question before checking?'} <a href="https://wa.me/447907650960">Message Jenna on WhatsApp</a>.
      </p>
    </section>

    {bookingProperty ? (
      <CompactBookingPanel
        propertyId={bookingProperty.id}
        source="listing"
        heading={bespokeListing ? 'Tell us about your preferred stay' : `Check ${entry.data.title}`}
        idPrefix={`compact-booking-listing-${entry.data.slug}`}
      />
    ) : null}
  </div>

  {entry.data.image ? <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} class="listing-hero-image" /> : null}

  <section class="prose">
    <Content />
  </section>

  {selectedSpaces.length ? (
    <section class="spaces-section">
      <div class="section-heading">
        <h2>Inside this stay</h2>
        <p>Rooms and spaces included in this accommodation option.</p>
      </div>
      <div class="space-grid">
        {selectedSpaces.map((space) => {
          const presentation = roomPresentation(space);
          return <Space space={space} displayTitle={presentation.title} displaySummary={presentation.summary} />;
        })}
      </div>
    </section>
  ) : null}

  <section class="prose enquiry-panel">
    <h2>Other questions?</h2>
    <p>For accessibility needs, local information or anything the stay checker does not cover, <a href="/contact/">contact Jenna</a> or <a href="mailto:olrig.bank@gmail.com">email Olrig Bank</a>.</p>
  </section>

  {import.meta.env.DEV && missingSpaceSlugs.length ? (
    <section class="prose developer-note">
      <h2>Missing space references</h2>
      <p>The following space slugs do not have matching content: {missingSpaceSlugs.join(', ')}</p>
    </section>
  ) : null}
</BaseLayout>

<script is:inline define:vars={{ listing: entry.data.slug }}>
  window.olrigAnalytics?.track('listing_viewed', { listing });
</script>

<style>
  .listing-opening {
    margin-bottom: 1.5rem;
  }

  .listing-opening .hero {
    height: 100%;
    margin-bottom: 0;
  }

  .listing-opening__contact {
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .listing-opening--with-booking {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(32rem, 1.1fr);
      gap: 1.5rem;
      align-items: stretch;
    }
  }
</style>
