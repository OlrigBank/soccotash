---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlanItinerary from '../../components/PlanItinerary.astro';
import { getPublishedExamplePlanBySlug } from '../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../lib/planner/local-guide.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const plan = await getPublishedExamplePlanBySlug(Astro.params.slug ?? '');
if (!plan) Astro.response.status = 404;
const guideEntries = plan ? await getPlannerGuideEntries() : [];
---

<BaseLayout title={plan?.title ?? 'Holiday plan unavailable'} description={plan?.description || 'This holiday plan is not available.'} robots={plan ? '' : 'noindex,nofollow'} showSidebar={false}>
  {plan ? (
    <>
      <PlanItinerary {plan} {guideEntries} />
      <p class="plan-print-action no-print"><button class="button" type="button" onclick="window.print()">Print itinerary</button></p>
    </>
  ) : (
    <section class="hero"><h1>Holiday plan unavailable</h1><p>The requested page could not be found.</p></section>
  )}
</BaseLayout>
