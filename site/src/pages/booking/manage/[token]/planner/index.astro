---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { resolveBookingAccessCredential } from '../../../../../lib/booking/booking-access.ts';
import { getBookingLinkedPlanByBookingReference } from '../../../../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../../../../lib/planner/local-guide.ts';

export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');
const token=String(Astro.params.token||'');
const access=await resolveBookingAccessCredential(token,{recordUse:true,recordDenied:true});
if(!access.allowed)return new Response('Holiday plan not found.',{status:404});
const plan=await getBookingLinkedPlanByBookingReference(access.reference);
if(!plan)return new Response('Holiday plan not found.',{status:404});
const guides=await getPlannerGuideEntries();
const guideFor=(slug:string|null)=>slug?guides.find(entry=>entry.slug===slug)??null:null;
const statuses=['idea','proposed','agreed','booked','completed','cancelled'];
---
<BaseLayout title={plan.title} description="Your private Olrig Bank Holiday Planner." showSidebar={false} robots="noindex,nofollow,noarchive">
  <header class="hero booking-planner-hero"><p class="eyebrow">Your private Holiday Planner</p><h1>{plan.title}</h1><p>{plan.startsOn} to {plan.endsOn} · revision <strong data-revision>{plan.revision}</strong></p><a class="button button--secondary" href={`/booking/manage/${token}/`}>Back to booking</a></header>
  <div id="planner-message" class="pricing-message" role="status" aria-live="polite" hidden></div>
  <section class="booking-panel"><h2>Plan details</h2><form id="plan-form" class="planner-form"><label>Title<input name="title" value={plan.title} required minlength="3" maxlength="160"/></label><label class="planner-wide">Summary<textarea name="description" maxlength="5000" rows="3">{plan.description}</textarea></label><button class="button" type="submit">Save plan</button></form></section>
  <section class="planner-days" aria-labelledby="days-heading"><h2 id="days-heading">Days</h2>{plan.days.map((day,index)=><article class="booking-panel planner-day" data-day-id={day.id}>
    <div class="planner-day-heading"><h3>Day {index+1}</h3><div class="planner-move-controls" aria-label={`Move ${day.title}`}><button type="button" data-day-move="up" disabled={index===0} aria-label={`Move ${day.title} up`}>↑</button><button type="button" data-day-move="down" disabled={index===plan.days.length-1} aria-label={`Move ${day.title} down`}>↓</button></div></div>
    <form class="planner-form day-form"><label>Title<input name="title" value={day.title} maxlength="160" required/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} value={day.date??''} required/></label><label class="planner-wide">Summary<textarea name="summary" maxlength="3000">{day.summary}</textarea></label><div class="planner-form-actions"><button class="button" type="submit">Save day</button><button type="button" class="button button--secondary" data-remove-day>Remove day</button></div></form>
    <div class="planner-items">{day.items.map((item,itemIndex)=><article class="planner-item" data-item-id={item.id}><div class="planner-day-heading"><h4>{guideFor(item.localGuideSlug)?.title??item.title} · {item.status}</h4><div class="planner-move-controls"><button type="button" data-item-move="up" disabled={itemIndex===0} aria-label={`Move ${item.title} up`}>↑</button><button type="button" data-item-move="down" disabled={itemIndex===day.items.length-1} aria-label={`Move ${item.title} down`}>↓</button></div></div>
      {item.localGuideSlug&&guideFor(item.localGuideSlug)&&<p class="planner-guide-reference"><strong>Local Guide:</strong> <a href={`/local-guide/${item.localGuideSlug}/`} target="_blank">{guideFor(item.localGuideSlug)!.title}</a></p>}
      <form class="planner-form item-form"><label>Title<input name="title" value={item.title} required maxlength="200"/></label><label>Type<select name="itemType">{['activity','journey','meal','reservation','free_time','other'].map(v=><option value={v} selected={item.itemType===v}>{v.replace('_',' ')}</option>)}</select></label><label>Starts<input name="startTime" type="time" value={item.startTime??''}/></label><label>Ends<input name="endTime" type="time" value={item.endTime??''}/></label><label>Location<input name="locationText" value={item.locationText??''} maxlength="500"/></label><label>Status<select name="status">{statuses.map(v=><option value={v} selected={item.status===v}>{v}</option>)}</select></label><label class="planner-wide">Plan note<textarea name="description" maxlength="10000">{item.description}</textarea></label><label class="planner-wide">Reservation note<textarea name="reservationNote" maxlength="3000">{item.reservationNote??''}</textarea></label><div class="planner-form-actions planner-wide"><button class="button" type="submit">Save item</button><label>Local Guide<select data-guide><option value="">Custom item</option>{guides.map(g=><option value={g.slug} selected={g.slug===item.localGuideSlug}>{g.title}</option>)}</select></label><button type="button" class="button button--secondary" data-set-guide>Apply guide</button><label>Move to day<select data-target-day>{plan.days.map((targetDay,targetIndex)=><option value={targetDay.id} selected={targetDay.id===day.id}>Day {targetIndex+1}: {targetDay.title}</option>)}</select></label><button type="button" class="button button--secondary" data-move-to-day>Move</button><button type="button" class="button button--secondary" data-remove-item>Remove item</button></div></form>
    </article>)}<details><summary>Add an item</summary><form class="planner-form add-item-form"><label>Title<input name="title" required maxlength="200"/></label><label>Type<select name="itemType"><option value="activity">activity</option><option value="journey">journey</option><option value="meal">meal</option><option value="reservation">reservation</option><option value="free_time">free time</option><option value="other">other</option></select></label><label>Local Guide<select name="localGuideSlug"><option value="">Custom item</option>{guides.map(g=><option value={g.slug}>{g.title}</option>)}</select></label><input type="hidden" name="status" value="idea"/><label class="planner-wide">Plan note<textarea name="description" maxlength="10000"></textarea></label><button class="button" type="submit">Add item</button></form></details></div>
  </article>)}</section>
  <section class="booking-panel"><h2>Add day</h2><form id="add-day-form" class="planner-form"><label>Title<input name="title" required maxlength="160"/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} required/></label><label class="planner-wide">Summary<textarea name="summary" maxlength="3000"></textarea></label><button class="button" type="submit">Add day</button></form></section>
</BaseLayout>
<script is:inline define:vars={{endpoint:`/api/booking/planner/${token}/`,initialRevision:plan.revision}}>
let revision=initialRevision;const message=document.querySelector('#planner-message');const values=f=>Object.fromEntries(new FormData(f));function show(t,e=false){message.hidden=false;message.textContent=t;message.className=`pricing-message ${e?'is-error':''}`}async function action(p){const r=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...p,expectedRevision:revision})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Planner action failed.');revision=d.revision??revision;document.querySelector('[data-revision]').textContent=revision;return d}
document.querySelector('#plan-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updatePlan',...values(e.currentTarget)});show('Plan saved.')}catch(x){show(x.message,true)}});document.querySelector('#add-day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addDay',...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});
document.querySelectorAll('.planner-day').forEach(day=>{const dayId=day.dataset.dayId;day.querySelector('.day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateDay',dayId,...values(e.currentTarget)});show('Day saved.')}catch(x){show(x.message,true)}});day.querySelector('[data-remove-day]')?.addEventListener('click',async()=>{if(confirm('Remove this day and its activities?'))try{await action({action:'removeDay',dayId});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('[data-day-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveDay',dayId,direction:b.dataset.dayMove});location.reload()}catch(x){show(x.message,true)}}));day.querySelector('.add-item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addItem',dayId,...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('.planner-item').forEach(item=>{const itemId=item.dataset.itemId;item.querySelector('.item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateItem',itemId,...values(e.currentTarget)});show('Item saved.')}catch(x){show(x.message,true)}});item.querySelector('[data-set-guide]')?.addEventListener('click',async()=>{try{await action({action:'setGuideReference',itemId,localGuideSlug:item.querySelector('[data-guide]').value});location.reload()}catch(x){show(x.message,true)}});item.querySelector('[data-move-to-day]')?.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:item.querySelector('[data-target-day]').value,position:'end'});location.reload()}catch(x){show(x.message,true)}});item.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(confirm('Remove this activity?'))try{await action({action:'removeItem',itemId});location.reload()}catch(x){show(x.message,true)}});item.querySelectorAll('[data-item-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:dayId,position:b.dataset.itemMove});location.reload()}catch(x){show(x.message,true)}}))})});
</script>
