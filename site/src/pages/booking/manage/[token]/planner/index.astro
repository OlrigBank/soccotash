---
import BookerLayout from '../../../../../layouts/BookerLayout.astro';
import LocalGuideTree from '../../../../../components/LocalGuideTree.astro';
import { resolveBookingAccessCredential } from '../../../../../lib/booking/booking-access.ts';
import { getBookingLinkedPlanByBookingReference } from '../../../../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../../../../lib/planner/local-guide.ts';
import { londonDate, plannerDayLabel, selectPlannerDay } from '../../../../../lib/planner/day-selection.ts';
import { getLocalGuideCategories } from '../../../../../lib/navigation.ts';
import { buildLocalGuideTree } from '../../../../../lib/local-guide/tree.ts';

export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
const token=String(Astro.params.token||'');
const access=await resolveBookingAccessCredential(token,{recordUse:true,recordDenied:true});
if(!access.allowed)return new Response('Holiday plan not found.',{status:404});
const plan=await getBookingLinkedPlanByBookingReference(access.reference);
if(!plan)return new Response('Holiday plan not found.',{status:404});
const guides=await getPlannerGuideEntries();
const guideTree=buildLocalGuideTree(getLocalGuideCategories(),guides.map(guide=>({id:guide.id,slug:guide.slug,title:guide.title,categoryId:guide.category})));
const selectedDay=selectPlannerDay(plan.days,Astro.url.searchParams.get('day'));
const dayHref=(dayId:string)=>`/booking/manage/${token}/planner/?day=${dayId}`;
const currentLondonDate=londonDate();
const guideFor=(id:string|null)=>id?guides.find((guide)=>guide.id===id):null;
---
<BookerLayout title="Holiday Planner" description="Build your private holiday plan." robots="noindex,nofollow,noarchive">
  <header class="hero booking-planner-hero">
    <p class="eyebrow">Your private Holiday Planner</p>
    <h1>Holiday Planner</h1>
    <p>{plan.startsOn} to {plan.endsOn} · revision <strong data-revision>{plan.revision}</strong></p>
    <a class="button button--secondary" href={`/booking/manage/${token}/`}>Back to booking</a>
  </header>

  <div id="planner-message" class="pricing-message" role="status" aria-live="polite" tabindex="-1" hidden></div>
  <div class="pricing-message is-error" data-planner-conflict role="alert" hidden><p>This plan changed while you were editing. Your change was not applied.</p><p data-conflict-revision></p><button type="button" class="button button--secondary" data-reload-plan>Reload latest plan</button></div>

  {plan.days.length&&<section class="guest-planner-day-tabs" aria-labelledby="holiday-days-heading">
    <p id="holiday-days-heading"><strong>Holiday days</strong><span>Scroll to see every day · drop a candidate onto a day</span></p>
    <nav class="planner-day-selector" aria-label="Choose holiday day">{plan.days.map((day,index)=><a href={dayHref(day.id)} aria-current={day.id===selectedDay?.id?'date':undefined} data-selected={day.id===selectedDay?.id} data-day-drop={day.id}>{plannerDayLabel(day,index)}{day.date===currentLondonDate&&<small>Today</small>}</a>)}</nav>
  </section>}

  <div class="guest-planner-sections">
    <details class="guest-planner-section guest-guide-browser">
      <summary><strong>Local Guide</strong><span>Browse ideas to add to your candidates</span></summary>
      <div class="guest-planner-section__body">
        <LocalGuideTree nodes={guideTree} plannerMode storageKey="olrig-bank:planner-local-guide:disclosures:v1" />
      </div>
    </details>

    <details class="guest-planner-section" open>
      <summary><strong>Candidate activities</strong><span>Highest priority first</span></summary>
      <div class="guest-planner-section__body" data-candidate-dropzone>
        <div class="guest-planner-heading"><p>Keep activities here until you decide which day they belong to.</p><button class="button" type="button" data-open-candidate-dialog>Add my own activity</button></div>
        {plan.candidates.length?<ol class="candidate-activity-list">
          {plan.candidates.map((candidate,index)=><li draggable="true" data-candidate-id={candidate.id}>
            <span class="planner-drag-handle" aria-hidden="true" title="Drag activity">⠿</span>
            <span class="candidate-priority">{index+1}</span>
            <div><strong>{candidate.title}</strong>{candidate.sourceUrl&&<a href={candidate.sourceUrl} target="_blank" rel="noopener noreferrer">Open webpage ↗</a>}{candidate.localGuideSlug&&<a href={`/local-guide/${candidate.localGuideSlug}/`} target="_blank" rel="noopener noreferrer">Local Guide details ↗</a>}</div>
            <details class="planner-action-menu"><summary aria-label={`Actions for ${candidate.title}`}>⋮</summary><div>
              <button type="button" data-candidate-move="up" disabled={index===0}>Move up</button>
              <button type="button" data-candidate-move="down" disabled={index===plan.candidates.length-1}>Move down</button>
              <label>Add to day<select data-candidate-day>{plan.days.map((day,dayIndex)=><option value={day.id}>{plannerDayLabel(day,dayIndex)}</option>)}</select></label>
              <button type="button" data-schedule-candidate disabled={plan.days.length===0}>Add to selected day</button>
              <button type="button" class="is-destructive" data-remove-candidate>Remove</button>
            </div></details>
          </li>)}
        </ol>:<p class="guest-planner-empty">No candidate activities yet. Add one from the Local Guide or create your own.</p>}
      </div>
    </details>

    <details class="guest-planner-section" open>
      <summary><strong>Your plan</strong><span>Activities in the order they happen</span></summary>
      <div class="guest-planner-section__body">
        {plan.days.length?<>
          {selectedDay&&<section class="guest-plan-day" data-day-id={selectedDay.id} data-plan-dropzone>
            <h2>{selectedDay.title}</h2>{selectedDay.summary&&<p>{selectedDay.summary}</p>}
            {selectedDay.items.length?<ol class="scheduled-activity-list">{selectedDay.items.map((item,index)=><li draggable="true" data-item-id={item.id}>
              <span class="planner-drag-handle" aria-hidden="true" title="Drag activity">⠿</span>
              <button type="button" class="scheduled-activity-open" data-open-item>{item.startTime&&<time>{item.startTime}</time>}<strong>{guideFor(item.localGuideEntryId)?.title??item.title}</strong></button>
              <details class="planner-action-menu"><summary aria-label={`Actions for ${item.title}`}>⋮</summary><div><button type="button" data-item-move="up" disabled={index===0}>Move up</button><button type="button" data-item-move="down" disabled={index===selectedDay.items.length-1}>Move down</button><button type="button" data-return-item>Return to candidates</button><button type="button" class="is-destructive" data-remove-item>Remove</button></div></details>
              <template data-item-data>{JSON.stringify(item)}</template>
            </li>)}</ol>:<p class="guest-planner-empty">Nothing is scheduled for this day yet.</p>}
          </section>}
        </>:<p>No holiday days are available. Reload the booking or contact Olrig Bank.</p>}
      </div>
    </details>
  </div>

  <dialog class="guest-planner-dialog" data-candidate-dialog><form method="dialog" data-candidate-form><button class="dialog-close" value="cancel" aria-label="Close">×</button><h2>Add a candidate activity</h2><label>Title<input name="title" required maxlength="200" /></label><label>Webpage URL<input name="sourceUrl" type="url" required maxlength="2000" placeholder="https://…" /></label><a data-check-candidate-url target="_blank" rel="noopener noreferrer">Open link in a new tab ↗</a><label>Description<textarea name="description" rows="5" maxlength="10000"></textarea></label><button class="button" value="submit">Add to candidates</button></form></dialog>

  <dialog class="guest-planner-dialog" data-item-dialog><form method="dialog" data-item-form><button class="dialog-close" value="cancel" aria-label="Close">×</button><h2>Activity details</h2><input name="itemId" type="hidden" /><label>Title<input name="title" required maxlength="200" /></label><label>Webpage URL<input name="sourceUrl" type="url" maxlength="2000" /></label><a data-open-item-url target="_blank" rel="noopener noreferrer">Open link in a new tab ↗</a><label>Description<textarea name="description" rows="5" maxlength="10000"></textarea></label><label>Type<select name="itemType">{['activity','journey','meal','reservation','free_time','other'].map(value=><option value={value}>{value.replace('_',' ')}</option>)}</select></label><label>Starts<input name="startTime" type="time" /></label><label>Ends<input name="endTime" type="time" /></label><label>Location<input name="locationText" maxlength="500" /></label><label>Status<select name="status">{['idea','proposed','agreed','booked','completed','cancelled'].map(value=><option value={value}>{value}</option>)}</select></label><label>Reservation note<textarea name="reservationNote" rows="3" maxlength="3000"></textarea></label><button class="button" value="submit">Save activity</button></form></dialog>
</BookerLayout>

<script is:inline define:vars={{endpoint:`/api/booking/planner/${token}/`,initialRevision:plan.revision}}>
let revision=initialRevision;const message=document.querySelector('#planner-message');const conflict=document.querySelector('[data-planner-conflict]');
function show(text,error=false){message.hidden=false;message.textContent=text;message.className=`pricing-message ${error?'is-error':''}`;message.focus()}
async function action(payload){const response=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,expectedRevision:revision})});const data=await response.json().catch(()=>({}));if(!response.ok){if(data.code==='STALE_REVISION'){conflict.hidden=false;conflict.querySelector('[data-conflict-revision]').textContent=`The latest plan is revision ${data.currentRevision}. Reload before trying again.`}throw new Error(data.error||'The change could not be completed.')}revision=data.revision??revision;document.querySelector('[data-revision]').textContent=revision;return data}
const reload=()=>location.reload();document.querySelector('[data-reload-plan]')?.addEventListener('click',reload);
document.addEventListener('click',async event=>{const button=event.target.closest('[data-add-guide],[data-add-guide-category]');if(!button)return;try{if(button.dataset.addGuide)await action({action:'addCandidate',localGuideEntryId:button.dataset.addGuide});else await action({action:'addGuideCategoryCandidates',categoryId:button.dataset.addGuideCategory});reload()}catch(error){show(error.message,true)}});
const candidateDialog=document.querySelector('[data-candidate-dialog]');const candidateForm=document.querySelector('[data-candidate-form]');document.querySelector('[data-open-candidate-dialog]')?.addEventListener('click',()=>candidateDialog.showModal());candidateForm?.elements.sourceUrl.addEventListener('input',event=>{const link=document.querySelector('[data-check-candidate-url]');link.href=event.target.value});candidateForm?.addEventListener('submit',async event=>{if(event.submitter?.value!=='submit')return;event.preventDefault();try{await action({action:'addCandidate',...Object.fromEntries(new FormData(candidateForm))});reload()}catch(error){show(error.message,true)}});
document.querySelectorAll('[data-candidate-id]').forEach(row=>{const candidateId=row.dataset.candidateId;row.querySelectorAll('[data-candidate-move]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'moveCandidate',candidateId,direction:button.dataset.candidateMove});reload()}catch(error){show(error.message,true)}}));row.querySelector('[data-schedule-candidate]')?.addEventListener('click',async()=>{try{await action({action:'scheduleCandidate',candidateId,dayId:row.querySelector('[data-candidate-day]').value});reload()}catch(error){show(error.message,true)}});row.querySelector('[data-remove-candidate]')?.addEventListener('click',async()=>{if(!confirm('Remove this candidate activity?'))return;try{await action({action:'removeCandidate',candidateId});reload()}catch(error){show(error.message,true)}})});
const itemDialog=document.querySelector('[data-item-dialog]');const itemForm=document.querySelector('[data-item-form]');document.querySelectorAll('[data-item-id]').forEach(row=>{const item=JSON.parse(row.querySelector('[data-item-data]').content.textContent);row.querySelector('[data-open-item]')?.addEventListener('click',()=>{for(const [key,value]of Object.entries(item)){const field=itemForm.elements.namedItem(key);if(field)field.value=value??''}document.querySelector('[data-open-item-url]').href=item.sourceUrl||'';itemDialog.showModal()});row.querySelectorAll('[data-item-move]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId:item.id,targetDayId:row.closest('[data-day-id]').dataset.dayId,position:button.dataset.itemMove});reload()}catch(error){show(error.message,true)}}));row.querySelector('[data-return-item]')?.addEventListener('click',async()=>{try{await action({action:'returnItemToCandidates',itemId:item.id});reload()}catch(error){show(error.message,true)}});row.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(!confirm('Remove this activity from the plan?'))return;try{await action({action:'removeItem',itemId:item.id});reload()}catch(error){show(error.message,true)}});row.addEventListener('dragover',event=>event.preventDefault());row.addEventListener('drop',async event=>{if(!dragged?.dataset.itemId||dragged===row)return;event.preventDefault();event.stopPropagation();try{await action({action:'placeItem',itemId:dragged.dataset.itemId,relativeItemId:item.id,placement:event.clientY<row.getBoundingClientRect().top+row.offsetHeight/2?'before':'after'});reload()}catch(error){show(error.message,true)}})});itemForm?.elements.sourceUrl.addEventListener('input',event=>{document.querySelector('[data-open-item-url]').href=event.target.value});itemForm?.addEventListener('submit',async event=>{if(event.submitter?.value!=='submit')return;event.preventDefault();try{await action({action:'updateItem',...Object.fromEntries(new FormData(itemForm))});itemDialog.close();show('Activity saved.')}catch(error){show(error.message,true)}});
let dragged=null;document.addEventListener('dragstart',event=>{dragged=event.target.closest('[data-guide-drag],[data-guide-category-drag],[data-candidate-id],[data-item-id]')});document.querySelector('[data-candidate-dropzone]')?.addEventListener('dragover',event=>event.preventDefault());document.querySelector('[data-candidate-dropzone]')?.addEventListener('drop',async event=>{event.preventDefault();try{if(dragged?.dataset.guideDrag)await action({action:'addCandidate',localGuideEntryId:dragged.dataset.guideDrag});else if(dragged?.dataset.guideCategoryDrag)await action({action:'addGuideCategoryCandidates',categoryId:dragged.dataset.guideCategoryDrag});else if(dragged?.dataset.itemId)await action({action:'returnItemToCandidates',itemId:dragged.dataset.itemId});reload()}catch(error){show(error.message,true)}});document.querySelectorAll('[data-day-drop]').forEach(tab=>{tab.addEventListener('dragover',event=>{if(dragged?.dataset.candidateId)event.preventDefault()});tab.addEventListener('drop',async event=>{if(!dragged?.dataset.candidateId)return;event.preventDefault();try{await action({action:'scheduleCandidate',candidateId:dragged.dataset.candidateId,dayId:tab.dataset.dayDrop});location.href=tab.href}catch(error){show(error.message,true)}})});document.querySelector('[data-plan-dropzone]')?.addEventListener('dragover',event=>event.preventDefault());document.querySelector('[data-plan-dropzone]')?.addEventListener('drop',async event=>{event.preventDefault();if(!dragged?.dataset.candidateId)return;try{await action({action:'scheduleCandidate',candidateId:dragged.dataset.candidateId,dayId:event.currentTarget.dataset.dayId});reload()}catch(error){show(error.message,true)}});
</script>
