---
import BookerLayout from '../../../../../layouts/BookerLayout.astro';
import LocalGuideTree from '../../../../../components/LocalGuideTree.astro';
import { resolveBookingAccessCredential } from '../../../../../lib/booking/booking-access.ts';
import { resolveGuestPlanSession } from '../../../../../lib/planner/guest-password.ts';
import { getBookingFamilyPlan, getBookingLinkedPlanByBookingReference, getHolidayPlan, listPlanAiCapabilities, listPlanParticipants, listPlanShareLinks } from '../../../../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../../../../lib/planner/local-guide.ts';
import { listAiProposals } from '../../../../../lib/planner/ai-proposals.ts';
import { londonDate, plannerDayLabel, selectPlannerDay } from '../../../../../lib/planner/day-selection.ts';
import { categoriesAsNavigation,listPublishedLocalGuideCategories } from '../../../../../lib/local-guide/workspace.ts';
import { buildLocalGuideTree } from '../../../../../lib/local-guide/tree.ts';

export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
const token=String(Astro.params.token||'');
const guestMode=Astro.url.pathname.startsWith('/planner/guest/')||Astro.url.searchParams.get('guest')==='1';
const participantAccess=guestMode?await resolveGuestPlanSession(token,Astro.cookies,true):null;
const access=guestMode?null:await resolveBookingAccessCredential(token,{recordUse:true,recordDenied:true});
if(guestMode?!participantAccess:!access?.allowed)return new Response('Holiday plan not found.',{status:404});
const bookingReference=access?.allowed?access.reference:null;
const requestedPlan=Astro.url.searchParams.get('plan');
const plan=participantAccess?await getHolidayPlan(participantAccess.planId):requestedPlan?await getBookingFamilyPlan(bookingReference!,requestedPlan):await getBookingLinkedPlanByBookingReference(bookingReference!);
if(!plan)return new Response('Holiday plan not found.',{status:404});
const guides=await getPlannerGuideEntries();
const guideCategories=await listPublishedLocalGuideCategories();const guideTree=buildLocalGuideTree(categoriesAsNavigation(guideCategories),guides.map(guide=>({id:guide.id,slug:guide.slug,title:guide.title,categoryId:guide.category})));
const selectedDay=selectPlannerDay(plan.days,Astro.url.searchParams.get('day'));
const plannerView=Astro.url.searchParams.get('view')==='schedule'?'schedule':'list';
const plannerHref=(view:'list'|'schedule',dayId=selectedDay?.id)=>`${guestMode?`/planner/guest/${token}/`:`/booking/manage/${token}/planner/`}?${new URLSearchParams({...guestMode&&{guest:'1'},...requestedPlan&&{plan:requestedPlan},...dayId&&{day:dayId},view}).toString()}`;
const dayHref=(dayId:string)=>plannerHref(plannerView,dayId);
const currentLondonDate=londonDate();
const guideFor=(id:string|null)=>id?guides.find((guide)=>guide.id===id):null;
const timeMinutes=(value:string|null)=>value?Number(value.slice(0,2))*60+Number(value.slice(3,5)):null;
const timedItems=selectedDay?.items.filter(item=>item.startTime&&item.endTime)??[];
const untimedItems=selectedDay?.items.filter(item=>!item.startTime||!item.endTime)??[];
const scheduleStartHour=Math.min(7,...timedItems.map(item=>Math.floor(timeMinutes(item.startTime)!/60)));
const scheduleEndHour=Math.max(21,...timedItems.map(item=>Math.ceil(timeMinutes(item.endTime)!/60)));
const scheduleHours=Array.from({length:scheduleEndHour-scheduleStartHour+1},(_,index)=>scheduleStartHour+index);
const scheduleTop=(value:string)=>`${((timeMinutes(value)!-scheduleStartHour*60)/60)*72}px`;
const scheduleHeight=(start:string,end:string)=>`${Math.max(36,((timeMinutes(end)!-timeMinutes(start)!)/60)*72)}px`;
const pageTitle=guestMode&&participantAccess?`${participantAccess.displayName}'s Holiday Planner`:'Holiday Planner';
const ownerAccess=!guestMode&&access?.allowed?access:null;
const participants=ownerAccess?await listPlanParticipants(plan.id,ownerAccess.bookingId):[];
const shareLinks=ownerAccess?await listPlanShareLinks(plan.id,ownerAccess.bookingId):[];
const aiCapabilities=ownerAccess?await listPlanAiCapabilities(plan.id,{type:'booker',bookingId:ownerAccess.bookingId}):[];
const aiProposals=ownerAccess?await listAiProposals(plan.id):[];
const activityTime=(value:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/London'}).format(new Date(value));
---
<BookerLayout title={pageTitle} description="Build your private holiday plan." robots="noindex,nofollow,noarchive" showHeader={!guestMode}>
  <header class="hero booking-planner-hero">
    <p class="eyebrow">Your private Holiday Planner</p>
    <h1>{pageTitle}</h1>
    <p>{plan.startsOn} to {plan.endsOn} · revision <strong data-revision>{plan.revision}</strong></p>
    {!guestMode&&<a class="button button--secondary" href={`/booking/manage/${token}/holiday-planner/`}>Back to planning dashboard</a>}
  </header>

  <div id="planner-message" class="pricing-message" role="status" aria-live="polite" tabindex="-1" hidden></div>
  <div class="pricing-message is-error" data-planner-conflict role="alert" hidden><p>This plan changed while you were editing. Your change was not applied.</p><p data-conflict-revision></p><button type="button" class="button button--secondary" data-reload-plan>Reload latest plan</button></div>

  <div class="guest-planner-sections">
    <details class="guest-planner-section guest-daily-planner" open>
      <summary><strong>Your daily planner</strong><span>Choose a day and arrange its activities</span></summary>
      <div class="guest-planner-section__body">
        <div class="planner-view-switch" aria-label="Planner view">
          <a href={plannerHref('list')} aria-current={plannerView==='list'?'page':undefined}>List</a>
          <a href={plannerHref('schedule')} aria-current={plannerView==='schedule'?'page':undefined}>Schedule</a>
        </div>
        {plan.days.length?<>
          <p class="guest-planner-day-guidance">Scroll to see every day · drop a candidate onto a day</p>
          <nav class="planner-day-selector" aria-label="Choose holiday day">{plan.days.map((day,index)=><a href={dayHref(day.id)} aria-current={day.id===selectedDay?.id?'date':undefined} data-selected={day.id===selectedDay?.id} data-day-drop={day.id}>{plannerDayLabel(day,index)}{day.date===currentLondonDate&&<small>Today</small>}</a>)}</nav>
          {selectedDay&&<section class="guest-plan-day" data-day-id={selectedDay.id} data-plan-dropzone hidden={plannerView==='schedule'}>
            <h2>{selectedDay.title}</h2>{selectedDay.summary&&<p>{selectedDay.summary}</p>}
            {selectedDay.items.length?<ol class="scheduled-activity-list">{selectedDay.items.map((item,index)=><li draggable="true" data-item-id={item.id}>
              <span class="planner-drag-handle" aria-hidden="true" title="Drag activity">⠿</span>
              <div class="scheduled-activity-main">
                <button type="button" class="scheduled-activity-open" data-open-item>{item.startTime&&<time>{item.startTime}</time>}<strong>{guideFor(item.localGuideEntryId)?.title??item.title}</strong></button>
                {item.sourceUrl&&<a class="planner-compact-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open the website for ${item.title} in a new tab`}>WS ↗</a>}
                {guideFor(item.localGuideEntryId)&&<a class="planner-compact-link" href={`/local-guide/${guideFor(item.localGuideEntryId)!.slug}/`} target="_blank" rel="noopener noreferrer" aria-label={`Open the Local Guide entry for ${item.title} in a new tab`}>LG</a>}
              </div>
              <details class="planner-action-menu"><summary aria-label={`Actions for ${item.title}`}>⋮</summary><div>{item.startTime?<p class="planner-action-note">Ordered by scheduled time</p>:<><button type="button" data-item-move="up" disabled={index===0}>Move up</button><button type="button" data-item-move="down" disabled={index===selectedDay.items.length-1}>Move down</button></>}<button type="button" data-return-item>Return to candidates</button><button type="button" class="is-destructive" data-remove-item>Remove</button></div></details>
              <template data-item-data>{JSON.stringify(item)}</template>
            </li>)}</ol>:<p class="guest-planner-empty">Nothing is scheduled for this day yet.</p>}
          </section>}
          {selectedDay&&<section class="guest-schedule" data-schedule-view data-day-id={selectedDay.id} hidden={plannerView==='list'}>
            <div class="guest-schedule-heading"><div><h2>{selectedDay.title}</h2>{selectedDay.summary&&<p>{selectedDay.summary}</p>}</div><p>{String(scheduleStartHour).padStart(2,'0')}:00–{String(scheduleEndHour).padStart(2,'0')}:00 · 30-minute steps</p></div>
            <section class="guest-unscheduled" data-unscheduled-dropzone aria-labelledby="unscheduled-heading">
              <h3 id="unscheduled-heading">Unscheduled for this day</h3>
              {untimedItems.length?<ul>{untimedItems.map(item=><li draggable="true" data-schedule-item-id={item.id}><button type="button" class="planner-drag-handle" data-schedule-drag-handle aria-label={`Drag ${item.title} onto the timeline`} title="Drag onto the timeline">⠿</button><button type="button" data-open-schedule-item>{item.title}</button><span>Drop onto the timeline</span></li>)}</ul>:<p>Every activity on this day has a time.</p>}
            </section>
            <div class="guest-time-grid" data-time-grid data-start-minutes={scheduleStartHour*60} data-end-minutes={scheduleEndHour*60} style={`height:${(scheduleEndHour-scheduleStartHour)*72}px`}>
              {scheduleHours.map((hour,index)=><div class="guest-time-grid__hour" style={`top:${index*72}px`}><time>{String(hour).padStart(2,'0')}:00</time><span></span></div>)}
              <div class="guest-time-grid__events">
                {timedItems.map(item=><article class="guest-time-block" draggable="true" data-schedule-item-id={item.id} style={`top:${scheduleTop(item.startTime!)};height:${scheduleHeight(item.startTime!,item.endTime!)}`}>
                  <button type="button" class="planner-drag-handle guest-time-block__grip" data-schedule-day-drag-handle aria-label={`Drag ${item.title} to another day`} title="Drag to another day">⠿</button>
                  <button type="button" class="guest-time-block__content" data-open-schedule-item><time>{item.startTime}–{item.endTime}</time><strong>{guideFor(item.localGuideEntryId)?.title??item.title}</strong></button>
                  {item.sourceUrl&&<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open the website for ${item.title} in a new tab`}>WS ↗</a>}
                  <details class="planner-action-menu"><summary aria-label={`Schedule actions for ${item.title}`}>⋮</summary><div><button type="button" data-open-schedule-item>Edit activity and times</button><label>Move to day<select data-schedule-target-day>{plan.days.map((day,index)=><option value={day.id} selected={day.id===selectedDay.id}>{plannerDayLabel(day,index)}</option>)}</select></label><button type="button" data-move-schedule-day>Move to selected day</button><button type="button" data-unschedule-item>Remove time</button></div></details>
                  <button type="button" class="guest-time-block__resize" data-resize-item aria-label={`Change the duration of ${item.title}`}></button>
                </article>)}
              </div>
            </div>
          </section>}
        </>:<p>No holiday days are available. Reload the booking or contact Olrig Bank.</p>}
      </div>
    </details>

    <details class="guest-planner-section" open hidden={plannerView==='schedule'}>
      <summary><strong>Candidate activities</strong><span>Highest priority first</span></summary>
      <div class="guest-planner-section__body" data-candidate-dropzone>
        <div class="guest-planner-heading"><p>Keep activities here until you decide which day they belong to.</p><button class="button" type="button" data-open-candidate-dialog>Add my own activity</button></div>
        {plan.candidates.length?<ol class="candidate-activity-list">
          {plan.candidates.map((candidate,index)=><li draggable="true" data-candidate-id={candidate.id}>
            <span class="planner-drag-handle" aria-hidden="true" title="Drag activity">⠿</span>
            <span class="candidate-priority">{index+1}</span>
            <div class="candidate-activity-main">{candidate.sourceUrl?<a class="candidate-activity-title" href={candidate.sourceUrl} target="_blank" rel="noopener noreferrer">{candidate.title} ↗</a>:<strong>{candidate.title}</strong>}{candidate.localGuideSlug&&<a class="planner-compact-link" href={`/local-guide/${candidate.localGuideSlug}/`} target="_blank" rel="noopener noreferrer" aria-label={`Open the Local Guide entry for ${candidate.title} in a new tab`}>LG</a>}</div>
            <details class="planner-action-menu"><summary aria-label={`Actions for ${candidate.title}`}>⋮</summary><div>
              <button type="button" data-candidate-move="up" disabled={index===0}>Move up</button>
              <button type="button" data-candidate-move="down" disabled={index===plan.candidates.length-1}>Move down</button>
              <label>Add to day<select data-candidate-day>{plan.days.map((day,dayIndex)=><option value={day.id}>{plannerDayLabel(day,dayIndex)}</option>)}</select></label>
              <button type="button" data-schedule-candidate disabled={plan.days.length===0}>Add to selected day</button>
              <button type="button" class="is-destructive" data-remove-candidate>Remove</button>
            </div></details>
          </li>)}
        </ol>:<p class="guest-planner-empty">No candidate activities yet. Add one from the Local Guide or create your own.</p>}
      </div>
    </details>

    <details class="guest-planner-section guest-guide-browser" hidden={plannerView==='schedule'}>
      <summary><strong>Local Guide</strong><span>Browse ideas to add to your candidates</span></summary>
      <div class="guest-planner-section__body">
        <LocalGuideTree nodes={guideTree} plannerMode storageKey="olrig-bank:planner-local-guide:disclosures:v1" />
      </div>
    </details>
  </div>

  {ownerAccess&&<details class="guest-planner-section planner-collaboration" open>
    <summary><strong>Share and collaborate</strong><span>Guests, read-only links and temporary AI access</span></summary>
    <div class="guest-planner-section__body">
      <section aria-labelledby="participants-heading"><h2 id="participants-heading">People with access</h2><p>Invitation links are private credentials. Send each link only to the named guest.</p>
        <div class="planner-participants">{participants.map(participant=><div data-participant-id={participant.id}><strong>{participant.displayName}</strong> · {participant.email??'Booker'} · {participant.revokedAt?'revoked':participant.acceptedAt?'joined':'invited'} {participant.role==='owner'?<span>· owner</span>:<><label>Role<select data-participant-role disabled={Boolean(participant.revokedAt)}>{['editor','contributor','viewer'].map(role=><option value={role} selected={role===participant.role}>{role}</option>)}</select></label><button type="button" class="button button--secondary" data-save-participant disabled={Boolean(participant.revokedAt)}>Save role</button><button type="button" class="button button--secondary" data-revoke-participant disabled={Boolean(participant.revokedAt)}>Revoke</button></>}</div>)}</div>
        <form id="invite-participant-form" class="planner-form"><label>Name<input name="displayName" required maxlength="160"/></label><label>Email<input name="email" type="email" required maxlength="254"/></label><label>Role<select name="role"><option value="editor">editor</option><option value="contributor">contributor</option><option value="viewer">viewer</option></select></label><button class="button" type="submit">Create invitation</button></form>
        <div data-invitation-result hidden><p><strong>Copy this invitation link now.</strong> It will not be shown again.</p><input data-invitation-link readonly/><button type="button" class="button button--secondary" data-copy-invitation>Copy link</button></div>
      </section>
      <section aria-labelledby="sharing-heading"><h2 id="sharing-heading">Read-only sharing</h2><p>Create a temporary sanitized itinerary link. Reservation notes, private items, people and booking details are excluded.</p>
        <form id="create-share-form" class="planner-form"><label>Link lifetime<select name="expiresDays"><option value="1">1 day</option><option value="7" selected>7 days</option><option value="14">14 days</option><option value="30">30 days</option></select></label><button class="button" type="submit">Create share link</button></form>
        <div data-share-result hidden><p><strong>Copy this read-only link now.</strong> It will not be shown again.</p><input data-share-link readonly/><button type="button" class="button button--secondary" data-copy-share>Copy link</button></div>
        {shareLinks.length>0&&<ul data-share-history>{shareLinks.map(link=><li>{link.revokedAt?'revoked':new Date(link.expiresAt)<=new Date()?'expired':'active'} · expires {activityTime(link.expiresAt)}{!link.revokedAt&&new Date(link.expiresAt)>new Date()&&<button type="button" class="button button--secondary" data-revoke-share={link.id}>Revoke</button>}</li>)}</ul>}
      </section>
      <section aria-labelledby="ai-sharing-heading"><h2 id="ai-sharing-heading">Temporary AI collaboration</h2><p>This shares itinerary dates, visible activities, non-sensitive notes and public place references. It excludes contacts, payments, booking credentials, participants, private items, reservation notes and Local Guide consent.</p>
        <form id="create-ai-capability-form" class="planner-form"><label>Link lifetime<select name="expiresHours"><option value="1">1 hour</option><option value="4" selected>4 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select></label><button class="button" type="submit">Create AI collaboration link</button></form>
        <div data-ai-capability-result hidden><p><strong>Copy or scan this link now.</strong> It will not be shown again.</p><input data-ai-capability-link readonly/><button type="button" class="button button--secondary" data-copy-ai-capability>Copy AI link</button><a class="button button--secondary" data-download-ai-qr download="olrig-bank-ai-collaboration.png">Download QR code</a><p><img data-ai-capability-qr alt="QR code for the temporary AI collaboration link" width="320" height="320"/></p></div>
        {aiCapabilities.length>0&&<ul data-ai-capability-history>{aiCapabilities.map(capability=><li>{capability.revokedAt?'revoked':new Date(capability.expiresAt)<=new Date()?'expired':'active'} · expires {activityTime(capability.expiresAt)}{!capability.revokedAt&&new Date(capability.expiresAt)>new Date()&&<button type="button" class="button button--secondary" data-revoke-ai-capability={capability.id}>Revoke</button>}</li>)}</ul>}
      </section>
      <section aria-labelledby="ai-proposals-heading"><h2 id="ai-proposals-heading">AI proposals awaiting review</h2>{aiProposals.length===0?<p>No proposals have been submitted.</p>:<ul>{aiProposals.map(proposal=><li><a href={`/booking/manage/${token}/planner/proposals/${proposal.id}/`}>{proposal.summary}</a> · {proposal.status}</li>)}</ul>}</section>
      <section aria-labelledby="activity-heading"><h2 id="activity-heading">Recent activity</h2><ol data-plan-activity>{plan.revisions.slice(-10).reverse().map(entry=><li><strong>{entry.actorDisplayName}</strong> {entry.summary} <time datetime={entry.createdAt}>{activityTime(entry.createdAt)}</time></li>)}</ol></section>
    </div>
  </details>}

  <dialog class="guest-planner-dialog" data-candidate-dialog><form method="dialog" data-candidate-form><button class="dialog-close" value="cancel" aria-label="Close">×</button><h2>Add a candidate activity</h2><label>Title<input name="title" required maxlength="200" /></label><label>Webpage URL<input name="sourceUrl" type="url" required maxlength="2000" placeholder="https://…" /></label><a data-check-candidate-url target="_blank" rel="noopener noreferrer">Open link in a new tab ↗</a><label>Description<textarea name="description" rows="5" maxlength="10000"></textarea></label><label><input name="doNotSaveForGuide" type="checkbox"/> Do not save this activity for possible inclusion in the Local Guide</label><small>Saved suggestions remain private until reviewed by an administrator.</small><button class="button" value="submit">Add to candidates</button></form></dialog>

  <dialog class="guest-planner-dialog" data-item-dialog><form method="dialog" data-item-form><button class="dialog-close" value="cancel" aria-label="Close">×</button><h2>Activity details</h2><input name="itemId" type="hidden" /><label>Title<input name="title" required maxlength="200" /></label><label>Webpage URL<input name="sourceUrl" type="url" maxlength="2000" /></label><a data-open-item-url target="_blank" rel="noopener noreferrer">Open link in a new tab ↗</a><label>Description<textarea name="description" rows="5" maxlength="10000"></textarea></label><label>Type<select name="itemType">{['activity','journey','meal','reservation','free_time','other'].map(value=><option value={value}>{value.replace('_',' ')}</option>)}</select></label><label>Starts<input name="startTime" type="time" /></label><label>Ends<input name="endTime" type="time" /></label><label>Location<input name="locationText" maxlength="500" /></label><label>Status<select name="status">{['idea','proposed','agreed','booked','completed','cancelled'].map(value=><option value={value}>{value}</option>)}</select></label><label>Olrig Bank Local Guide<select name="localGuideEntryId"><option value="">Custom activity</option>{guides.map(guide=><option value={guide.id}>{guide.title} · {guide.category}</option>)}</select></label><button class="button button--secondary" type="button" data-set-item-guide>Apply guide reference</button><label>Reservation note<textarea name="reservationNote" rows="3" maxlength="3000"></textarea></label><button class="button" value="submit">Save activity</button></form></dialog>
</BookerLayout>

<script is:inline define:vars={{endpoint:guestMode?`/api/planner/participant/${token}/`:`/api/booking/planner/${token}/${requestedPlan?`?plan=${requestedPlan}`:''}`,initialRevision:plan.revision}}>
let revision=initialRevision;const message=document.querySelector('#planner-message');const conflict=document.querySelector('[data-planner-conflict]');
function show(text,error=false){message.hidden=false;message.textContent=text;message.className=`pricing-message ${error?'is-error':''}`;message.focus()}
async function action(payload){const response=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...payload,expectedRevision:revision})});const data=await response.json().catch(()=>({}));if(!response.ok){if(data.code==='STALE_REVISION'){conflict.hidden=false;conflict.querySelector('[data-conflict-revision]').textContent=`The latest plan is revision ${data.currentRevision}. Reload before trying again.`}throw new Error(data.error||'The change could not be completed.')}revision=data.revision??revision;document.querySelector('[data-revision]').textContent=revision;return data}
const reload=()=>location.reload();document.querySelector('[data-reload-plan]')?.addEventListener('click',reload);
const values=form=>Object.fromEntries(new FormData(form));
document.querySelector('#invite-participant-form')?.addEventListener('submit',async event=>{event.preventDefault();try{const result=await action({action:'inviteParticipant',...values(event.currentTarget)});const box=document.querySelector('[data-invitation-result]');box.querySelector('[data-invitation-link]').value=`${location.origin}/planner/invite/${result.token}/`;box.hidden=false;show('Invitation created. Copy its private link now.')}catch(error){show(error.message,true)}});document.querySelector('[data-copy-invitation]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-invitation-link]').value));document.querySelectorAll('[data-participant-id]').forEach(row=>{const participantId=row.dataset.participantId;row.querySelector('[data-save-participant]')?.addEventListener('click',async()=>{try{await action({action:'changeParticipantRole',participantId,role:row.querySelector('[data-participant-role]').value});reload()}catch(error){show(error.message,true)}});row.querySelector('[data-revoke-participant]')?.addEventListener('click',async()=>{if(confirm('Revoke this participant link?'))try{await action({action:'revokeParticipant',participantId});reload()}catch(error){show(error.message,true)}})});
document.querySelector('#create-share-form')?.addEventListener('submit',async event=>{event.preventDefault();try{const result=await action({action:'createShareLink',...values(event.currentTarget)});const box=document.querySelector('[data-share-result]');box.querySelector('[data-share-link]').value=`${location.origin}/planner/share/${result.token}/`;box.hidden=false;show('Read-only share link created.')}catch(error){show(error.message,true)}});document.querySelector('[data-copy-share]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-share-link]').value));document.querySelectorAll('[data-revoke-share]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'revokeShareLink',shareId:button.dataset.revokeShare});reload()}catch(error){show(error.message,true)}}));
document.querySelector('#create-ai-capability-form')?.addEventListener('submit',async event=>{event.preventDefault();try{const result=await action({action:'createAiCapability',...values(event.currentTarget)});const box=document.querySelector('[data-ai-capability-result]');box.querySelector('[data-ai-capability-link]').value=result.url;box.querySelector('[data-ai-capability-qr]').src=result.qrDataUrl;box.querySelector('[data-download-ai-qr]').href=result.qrDataUrl;box.hidden=false;show('Temporary AI collaboration link created.')}catch(error){show(error.message,true)}});document.querySelector('[data-copy-ai-capability]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-ai-capability-link]').value));document.querySelectorAll('[data-revoke-ai-capability]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'revokeAiCapability',capabilityId:button.dataset.revokeAiCapability});reload()}catch(error){show(error.message,true)}}));
document.addEventListener('click',async event=>{const button=event.target.closest('[data-add-guide],[data-add-guide-category]');if(!button)return;try{if(button.dataset.addGuide)await action({action:'addCandidate',localGuideEntryId:button.dataset.addGuide});else await action({action:'addGuideCategoryCandidates',categoryId:button.dataset.addGuideCategory});reload()}catch(error){show(error.message,true)}});
const candidateDialog=document.querySelector('[data-candidate-dialog]');const candidateForm=document.querySelector('[data-candidate-form]');document.querySelector('[data-open-candidate-dialog]')?.addEventListener('click',()=>candidateDialog.showModal());candidateForm?.elements.sourceUrl.addEventListener('input',event=>{const link=document.querySelector('[data-check-candidate-url]');link.href=event.target.value});candidateForm?.addEventListener('submit',async event=>{if(event.submitter?.value!=='submit')return;event.preventDefault();try{await action({action:'addCandidate',...Object.fromEntries(new FormData(candidateForm)),retainForGuide:!candidateForm.elements.doNotSaveForGuide.checked});reload()}catch(error){show(error.message,true)}});
document.querySelectorAll('[data-candidate-id]').forEach(row=>{const candidateId=row.dataset.candidateId;row.querySelectorAll('[data-candidate-move]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'moveCandidate',candidateId,direction:button.dataset.candidateMove});reload()}catch(error){show(error.message,true)}}));row.querySelector('[data-schedule-candidate]')?.addEventListener('click',async()=>{try{await action({action:'scheduleCandidate',candidateId,dayId:row.querySelector('[data-candidate-day]').value});reload()}catch(error){show(error.message,true)}});row.querySelector('[data-remove-candidate]')?.addEventListener('click',async()=>{if(!confirm('Remove this candidate activity?'))return;try{await action({action:'removeCandidate',candidateId});reload()}catch(error){show(error.message,true)}})});
const itemDialog=document.querySelector('[data-item-dialog]');const itemForm=document.querySelector('[data-item-form]');document.querySelectorAll('[data-item-id]').forEach(row=>{const item=JSON.parse(row.querySelector('[data-item-data]').content.textContent);row.querySelector('[data-open-item]')?.addEventListener('click',()=>{itemForm.elements.itemId.value=item.id;for(const [key,value]of Object.entries(item)){const field=itemForm.elements.namedItem(key);if(field)field.value=value??''}document.querySelector('[data-open-item-url]').href=item.sourceUrl||'';itemDialog.showModal()});row.querySelectorAll('[data-item-move]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId:item.id,targetDayId:row.closest('[data-day-id]').dataset.dayId,position:button.dataset.itemMove});reload()}catch(error){show(error.message,true)}}));row.querySelector('[data-return-item]')?.addEventListener('click',async()=>{try{await action({action:'returnItemToCandidates',itemId:item.id});reload()}catch(error){show(error.message,true)}});row.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(!confirm('Remove this activity from the plan?'))return;try{await action({action:'removeItem',itemId:item.id});reload()}catch(error){show(error.message,true)}});row.addEventListener('dragover',event=>event.preventDefault());row.addEventListener('drop',async event=>{if(!dragged?.dataset.itemId||dragged===row)return;event.preventDefault();event.stopPropagation();try{await action({action:'placeItem',itemId:dragged.dataset.itemId,relativeItemId:item.id,placement:event.clientY<row.getBoundingClientRect().top+row.offsetHeight/2?'before':'after'});reload()}catch(error){show(error.message,true)}})});itemForm?.elements.sourceUrl.addEventListener('input',event=>{document.querySelector('[data-open-item-url]').href=event.target.value});itemForm?.addEventListener('submit',async event=>{if(event.submitter?.value!=='submit')return;event.preventDefault();try{await action({action:'updateItem',...Object.fromEntries(new FormData(itemForm))});itemDialog.close();show('Activity saved.')}catch(error){show(error.message,true)}});
itemForm?.querySelector('[data-set-item-guide]')?.addEventListener('click',async()=>{try{await action({action:'setGuideReference',itemId:itemForm.elements.itemId.value,localGuideEntryId:itemForm.elements.localGuideEntryId.value});reload()}catch(error){show(error.message,true)}});
const planItem=id=>{const template=document.querySelector(`[data-item-id="${CSS.escape(id)}"] [data-item-data]`);return template?JSON.parse(template.content.textContent):null};
const updateItemTimes=async(item,startTime,endTime)=>action({action:'updateItem',...item,itemId:item.id,startTime,endTime});
document.querySelectorAll('[data-schedule-item-id]').forEach(card=>{const item=planItem(card.dataset.scheduleItemId);if(!item)return;card.querySelectorAll('[data-open-schedule-item]').forEach(button=>button.addEventListener('click',()=>document.querySelector(`[data-item-id="${CSS.escape(item.id)}"] [data-open-item]`)?.click()));card.querySelector('[data-unschedule-item]')?.addEventListener('click',async()=>{try{await updateItemTimes(item,null,null);reload()}catch(error){show(error.message,true)}});card.querySelector('[data-move-schedule-day]')?.addEventListener('click',async()=>{const targetDayId=card.querySelector('[data-schedule-target-day]').value;if(targetDayId===card.closest('[data-day-id]').dataset.dayId)return;try{await action({action:'moveItem',itemId:item.id,targetDayId,position:'end'});location.href=document.querySelector(`[data-day-drop="${CSS.escape(targetDayId)}"]`).href}catch(error){show(error.message,true)}})});
let dragged=null;document.addEventListener('dragstart',event=>{dragged=event.target.closest('[data-guide-drag],[data-guide-category-drag],[data-candidate-id],[data-item-id],[data-schedule-item-id]')});document.addEventListener('dragend',()=>{dragged=null});document.querySelector('[data-candidate-dropzone]')?.addEventListener('dragover',event=>event.preventDefault());document.querySelector('[data-candidate-dropzone]')?.addEventListener('drop',async event=>{event.preventDefault();try{if(dragged?.dataset.guideDrag)await action({action:'addCandidate',localGuideEntryId:dragged.dataset.guideDrag});else if(dragged?.dataset.guideCategoryDrag)await action({action:'addGuideCategoryCandidates',categoryId:dragged.dataset.guideCategoryDrag});else if(dragged?.dataset.itemId)await action({action:'returnItemToCandidates',itemId:dragged.dataset.itemId});reload()}catch(error){show(error.message,true)}});document.querySelectorAll('[data-day-drop]').forEach(tab=>{tab.addEventListener('dragover',event=>{if(dragged?.dataset.candidateId||dragged?.dataset.scheduleItemId){event.preventDefault();tab.classList.add('is-drop-target')}});tab.addEventListener('dragleave',()=>tab.classList.remove('is-drop-target'));tab.addEventListener('drop',async event=>{event.preventDefault();tab.classList.remove('is-drop-target');try{if(dragged?.dataset.candidateId)await action({action:'scheduleCandidate',candidateId:dragged.dataset.candidateId,dayId:tab.dataset.dayDrop});else if(dragged?.dataset.scheduleItemId)await action({action:'moveItem',itemId:dragged.dataset.scheduleItemId,targetDayId:tab.dataset.dayDrop,position:'end'});else return;location.href=tab.href}catch(error){show(error.message,true)}})});document.querySelector('[data-plan-dropzone]')?.addEventListener('dragover',event=>event.preventDefault());document.querySelector('[data-plan-dropzone]')?.addEventListener('drop',async event=>{event.preventDefault();if(!dragged?.dataset.candidateId)return;try{await action({action:'scheduleCandidate',candidateId:dragged.dataset.candidateId,dayId:event.currentTarget.dataset.dayId});reload()}catch(error){show(error.message,true)}});
const timeText=minutes=>`${String(Math.floor(minutes/60)).padStart(2,'0')}:${String(minutes%60).padStart(2,'0')}`;const timeGrid=document.querySelector('[data-time-grid]');
const placeItemAt=async(item,clientY)=>{const rect=timeGrid.getBoundingClientRect();const startLimit=Number(timeGrid.dataset.startMinutes);const endLimit=Number(timeGrid.dataset.endMinutes);const raw=startLimit+((clientY-rect.top)/rect.height)*(endLimit-startLimit);const start=Math.max(startLimit,Math.min(endLimit-30,Math.round(raw/30)*30));const oldStart=item.startTime?Number(item.startTime.slice(0,2))*60+Number(item.startTime.slice(3,5)):null;const oldEnd=item.endTime?Number(item.endTime.slice(0,2))*60+Number(item.endTime.slice(3,5)):null;const duration=oldStart!==null&&oldEnd!==null?oldEnd-oldStart:60;const end=Math.min(endLimit,start+Math.max(30,duration));await updateItemTimes(item,timeText(start),timeText(end))};
timeGrid?.addEventListener('dragover',event=>{if(dragged?.dataset.scheduleItemId){event.preventDefault();timeGrid.classList.add('is-drop-target')}});timeGrid?.addEventListener('dragleave',event=>{if(!timeGrid.contains(event.relatedTarget))timeGrid.classList.remove('is-drop-target')});timeGrid?.addEventListener('drop',async event=>{const item=dragged?.dataset.scheduleItemId&&planItem(dragged.dataset.scheduleItemId);if(!item)return;event.preventDefault();timeGrid.classList.remove('is-drop-target');try{await placeItemAt(item,event.clientY);reload()}catch(error){show(error.message,true)}});
document.querySelectorAll('[data-schedule-drag-handle]').forEach(handle=>handle.addEventListener('pointerdown',event=>{if(!timeGrid)return;event.preventDefault();const card=handle.closest('[data-schedule-item-id]');const item=planItem(card.dataset.scheduleItemId);if(!item)return;card.draggable=false;card.classList.add('is-pointer-dragging');handle.setPointerCapture(event.pointerId);const move=moveEvent=>{const rect=timeGrid.getBoundingClientRect();timeGrid.classList.toggle('is-drop-target',moveEvent.clientX>=rect.left&&moveEvent.clientX<=rect.right&&moveEvent.clientY>=rect.top&&moveEvent.clientY<=rect.bottom)};const finish=async(upEvent)=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',finish);handle.removeEventListener('pointercancel',cancel);card.draggable=true;card.classList.remove('is-pointer-dragging');const rect=timeGrid.getBoundingClientRect();const inside=upEvent.clientX>=rect.left&&upEvent.clientX<=rect.right&&upEvent.clientY>=rect.top&&upEvent.clientY<=rect.bottom;timeGrid.classList.remove('is-drop-target');if(!inside)return;try{await placeItemAt(item,upEvent.clientY);reload()}catch(error){show(error.message,true)}};const cancel=()=>{card.draggable=true;card.classList.remove('is-pointer-dragging');timeGrid.classList.remove('is-drop-target')};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',finish);handle.addEventListener('pointercancel',cancel)}));
document.querySelectorAll('[data-schedule-day-drag-handle]').forEach(handle=>handle.addEventListener('pointerdown',event=>{event.preventDefault();event.stopPropagation();const card=handle.closest('[data-schedule-item-id]');const origin={x:event.clientX,y:event.clientY};card.draggable=false;card.classList.add('is-pointer-dragging');handle.setPointerCapture(event.pointerId);const tabs=[...document.querySelectorAll('[data-day-drop]')];const targetAt=(x,y)=>tabs.find(tab=>{const rect=tab.getBoundingClientRect();return x>=rect.left&&x<=rect.right&&y>=rect.top&&y<=rect.bottom});const inGrid=(x,y)=>{const rect=timeGrid.getBoundingClientRect();return x>=rect.left&&x<=rect.right&&y>=rect.top&&y<=rect.bottom};const clear=()=>{card.draggable=true;card.classList.remove('is-pointer-dragging');card.style.transform='';card.style.zIndex='';tabs.forEach(tab=>tab.classList.remove('is-drop-target'));timeGrid.classList.remove('is-drop-target')};const move=moveEvent=>{card.style.transform=`translate(${moveEvent.clientX-origin.x}px,${moveEvent.clientY-origin.y}px)`;card.style.zIndex='30';const target=targetAt(moveEvent.clientX,moveEvent.clientY);tabs.forEach(tab=>tab.classList.toggle('is-drop-target',tab===target));timeGrid.classList.toggle('is-drop-target',!target&&inGrid(moveEvent.clientX,moveEvent.clientY))};const finish=async upEvent=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',finish);handle.removeEventListener('pointercancel',cancel);const target=targetAt(upEvent.clientX,upEvent.clientY);const overGrid=!target&&inGrid(upEvent.clientX,upEvent.clientY);clear();try{if(target&&target.dataset.dayDrop!==card.closest('[data-day-id]').dataset.dayId){await action({action:'moveItem',itemId:card.dataset.scheduleItemId,targetDayId:target.dataset.dayDrop,position:'end'});location.href=target.href}else if(overGrid){const item=planItem(card.dataset.scheduleItemId);await placeItemAt(item,upEvent.clientY);reload()}}catch(error){show(error.message,true)}};const cancel=()=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',finish);clear()};handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',finish);handle.addEventListener('pointercancel',cancel)}));
document.querySelectorAll('[data-resize-item]').forEach(handle=>handle.addEventListener('pointerdown',event=>{event.preventDefault();event.stopPropagation();const block=handle.closest('[data-schedule-item-id]');const item=planItem(block.dataset.scheduleItemId);if(!item?.startTime)return;const grid=block.closest('[data-time-grid]');const start=Number(item.startTime.slice(0,2))*60+Number(item.startTime.slice(3,5));const endLimit=Number(grid.dataset.endMinutes);const gridRect=grid.getBoundingClientRect();handle.setPointerCapture(event.pointerId);const move=moveEvent=>{const raw=Number(grid.dataset.startMinutes)+((moveEvent.clientY-gridRect.top)/gridRect.height)*(endLimit-Number(grid.dataset.startMinutes));const end=Math.max(start+30,Math.min(endLimit,Math.round(raw/30)*30));block.style.height=`${Math.max(36,((end-start)/(endLimit-Number(grid.dataset.startMinutes)))*gridRect.height)}px`;block.dataset.previewEnd=timeText(end)};const finish=async()=>{handle.removeEventListener('pointermove',move);handle.removeEventListener('pointerup',finish);handle.removeEventListener('pointercancel',cancel);if(!block.dataset.previewEnd)return;try{await updateItemTimes(item,item.startTime,block.dataset.previewEnd);reload()}catch(error){show(error.message,true)}};const cancel=()=>reload();handle.addEventListener('pointermove',move);handle.addEventListener('pointerup',finish);handle.addEventListener('pointercancel',cancel)}));
</script>
