---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { resolveBookingAccessCredential } from '../../../../../lib/booking/booking-access.ts';
import { getBookingLinkedPlanByBookingReference, listGuideContributions, listPlanAiCapabilities, listPlanParticipants, listPlanShareLinks } from '../../../../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../../../../lib/planner/local-guide.ts';
import { listAiProposals } from '../../../../../lib/planner/ai-proposals.ts';

export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');
const token=String(Astro.params.token||'');
const access=await resolveBookingAccessCredential(token,{recordUse:true,recordDenied:true});
if(!access.allowed)return new Response('Holiday plan not found.',{status:404});
const plan=await getBookingLinkedPlanByBookingReference(access.reference);
if(!plan)return new Response('Holiday plan not found.',{status:404});
const participants=await listPlanParticipants(plan.id,access.bookingId);
const shareLinks=await listPlanShareLinks(plan.id,access.bookingId);
const aiCapabilities=await listPlanAiCapabilities(plan.id,{type:'booker',bookingId:access.bookingId});
const aiProposals=await listAiProposals(plan.id);
const contributions=await listGuideContributions(plan.id);
const ownItemIds=new Set(plan.revisions.filter(entry=>entry.actorType==='guest'&&entry.participantId===null&&entry.action==='item_added').map(entry=>String(entry.changes.itemId??'')));
const activeContributionItemIds=new Set(contributions.filter(entry=>['pending','under_review','accepted'].includes(entry.status)).map(entry=>entry.itemId));
const contributableItems=plan.days.flatMap(day=>day.items).filter(item=>ownItemIds.has(item.id)&&!item.localGuideSlug&&!activeContributionItemIds.has(item.id));
const ownCandidateIds=new Set(plan.revisions.filter(entry=>entry.actorType==='guest'&&entry.participantId===null&&entry.action==='guide_contribution_offered').map(entry=>String(entry.changes.candidateId??'')));
const guides=await getPlannerGuideEntries();
const guideFor=(slug:string|null)=>slug?guides.find(entry=>entry.slug===slug)??null:null;
const statuses=['idea','proposed','agreed','booked','completed','cancelled'];
const activityTime=(value:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/London'}).format(new Date(value));
---
<BaseLayout title={plan.title} description="Your private Olrig Bank Holiday Planner." showSidebar={false} robots="noindex,nofollow,noarchive">
  <header class="hero booking-planner-hero"><p class="eyebrow">Your private Holiday Planner</p><h1>{plan.title}</h1><p>{plan.startsOn} to {plan.endsOn} · revision <strong data-revision>{plan.revision}</strong></p><a class="button button--secondary" href={`/booking/manage/${token}/`}>Back to booking</a> <a class="button button--secondary" href={`/booking/manage/${token}/planner/print/`}>Print itinerary</a></header>
  <div id="planner-message" class="pricing-message" role="status" aria-live="polite" hidden></div>
  <div class="pricing-message is-error" data-planner-conflict role="alert" hidden><p>This plan changed while you were editing. Your save was not applied.</p><p data-conflict-revision></p><button type="button" class="button button--secondary" data-reload-plan>Reload latest plan</button></div>
  <section class="booking-panel"><h2>Plan details</h2><form id="plan-form" class="planner-form"><label>Title<input name="title" value={plan.title} required minlength="3" maxlength="160"/></label><label class="planner-wide">Summary<textarea name="description" maxlength="5000" rows="3">{plan.description}</textarea></label><button class="button" type="submit">Save plan</button></form></section>
  <section class="planner-days" aria-labelledby="days-heading"><h2 id="days-heading">Days</h2>{plan.days.map((day,index)=><article class="booking-panel planner-day" data-day-id={day.id}>
    <div class="planner-day-heading"><h3>Day {index+1}</h3><div class="planner-move-controls" aria-label={`Move ${day.title}`}><button type="button" data-day-move="up" disabled={index===0} aria-label={`Move ${day.title} up`}>↑</button><button type="button" data-day-move="down" disabled={index===plan.days.length-1} aria-label={`Move ${day.title} down`}>↓</button></div></div>
    <form class="planner-form day-form"><label>Title<input name="title" value={day.title} maxlength="160" required/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} value={day.date??''} required/></label><label class="planner-wide">Summary<textarea name="summary" maxlength="3000">{day.summary}</textarea></label><div class="planner-form-actions"><button class="button" type="submit">Save day</button><button type="button" class="button button--secondary" data-remove-day>Remove day</button></div></form>
    <div class="planner-items">{day.items.map((item,itemIndex)=><article class="planner-item" data-item-id={item.id}><div class="planner-day-heading"><h4>{guideFor(item.localGuideSlug)?.title??item.title} · {item.status}</h4><div class="planner-move-controls"><button type="button" data-item-move="up" disabled={itemIndex===0} aria-label={`Move ${item.title} up`}>↑</button><button type="button" data-item-move="down" disabled={itemIndex===day.items.length-1} aria-label={`Move ${item.title} down`}>↓</button></div></div>
      {item.localGuideSlug&&guideFor(item.localGuideSlug)&&<p class="planner-guide-reference"><strong>Local Guide:</strong> <a href={`/local-guide/${item.localGuideSlug}/`} target="_blank">{guideFor(item.localGuideSlug)!.title}</a></p>}
      <form class="planner-form item-form"><label>Title<input name="title" value={item.title} required maxlength="200"/></label><label>Type<select name="itemType">{['activity','journey','meal','reservation','free_time','other'].map(v=><option value={v} selected={item.itemType===v}>{v.replace('_',' ')}</option>)}</select></label><label>Starts<input name="startTime" type="time" value={item.startTime??''}/></label><label>Ends<input name="endTime" type="time" value={item.endTime??''}/></label><label>Location<input name="locationText" value={item.locationText??''} maxlength="500"/></label><label>Status<select name="status">{statuses.map(v=><option value={v} selected={item.status===v}>{v}</option>)}</select></label><label class="planner-wide">Plan note<textarea name="description" maxlength="10000">{item.description}</textarea></label><label class="planner-wide">Reservation note<textarea name="reservationNote" maxlength="3000">{item.reservationNote??''}</textarea></label><div class="planner-form-actions planner-wide"><button class="button" type="submit">Save item</button><label>Local Guide<select data-guide><option value="">Custom item</option>{guides.map(g=><option value={g.slug} selected={g.slug===item.localGuideSlug}>{g.title}</option>)}</select></label><button type="button" class="button button--secondary" data-set-guide>Apply guide</button><label>Move to day<select data-target-day>{plan.days.map((targetDay,targetIndex)=><option value={targetDay.id} selected={targetDay.id===day.id}>Day {targetIndex+1}: {targetDay.title}</option>)}</select></label><button type="button" class="button button--secondary" data-move-to-day>Move</button><button type="button" class="button button--secondary" data-remove-item>Remove item</button></div></form>
    </article>)}<details><summary>Add an item</summary><form class="planner-form add-item-form"><label>Title<input name="title" required maxlength="200"/></label><label>Type<select name="itemType"><option value="activity">activity</option><option value="journey">journey</option><option value="meal">meal</option><option value="reservation">reservation</option><option value="free_time">free time</option><option value="other">other</option></select></label><label>Local Guide<select name="localGuideSlug"><option value="">Custom item</option>{guides.map(g=><option value={g.slug}>{g.title}</option>)}</select></label><input type="hidden" name="status" value="idea"/><label class="planner-wide">Plan note<textarea name="description" maxlength="10000"></textarea></label><button class="button" type="submit">Add item</button></form></details></div>
  </article>)}</section>
  <section class="booking-panel"><h2>Add day</h2><form id="add-day-form" class="planner-form"><label>Title<input name="title" required maxlength="160"/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} required/></label><label class="planner-wide">Summary<textarea name="summary" maxlength="3000"></textarea></label><button class="button" type="submit">Add day</button></form></section>
  <section class="booking-panel" aria-labelledby="participants-heading"><h2 id="participants-heading">People with access</h2><p>Invitation links are private credentials. Send each link only to the named guest.</p><div class="planner-participants">{participants.map(participant=><div data-participant-id={participant.id}><strong>{participant.displayName}</strong> · {participant.email??'Booker'} · {participant.revokedAt?'revoked':participant.acceptedAt?'joined':'invited'} {participant.role==='owner'?<span>· owner</span>:<><label>Role<select data-participant-role disabled={Boolean(participant.revokedAt)}>{['editor','contributor','viewer'].map(role=><option value={role} selected={role===participant.role}>{role}</option>)}</select></label><button type="button" class="button button--secondary" data-save-participant disabled={Boolean(participant.revokedAt)}>Save role</button><button type="button" class="button button--secondary" data-revoke-participant disabled={Boolean(participant.revokedAt)}>Revoke</button></>}</div>)}</div><form id="invite-participant-form" class="planner-form"><label>Name<input name="displayName" required maxlength="160"/></label><label>Email<input name="email" type="email" required maxlength="254"/></label><label>Role<select name="role"><option value="editor">editor</option><option value="contributor">contributor</option><option value="viewer">viewer</option></select></label><button class="button" type="submit">Create invitation</button></form><div data-invitation-result hidden><p><strong>Copy this invitation link now.</strong> It will not be shown again.</p><input data-invitation-link readonly/><button type="button" class="button button--secondary" data-copy-invitation>Copy link</button></div></section>
  <section class="booking-panel" aria-labelledby="sharing-heading"><h2 id="sharing-heading">Read-only sharing</h2><p>Create a temporary sanitized itinerary link. Reservation notes, private items, people and booking details are excluded.</p><form id="create-share-form" class="planner-form"><label>Link lifetime<select name="expiresDays"><option value="1">1 day</option><option value="7" selected>7 days</option><option value="14">14 days</option><option value="30">30 days</option></select></label><button class="button" type="submit">Create share link</button></form><div data-share-result hidden><p><strong>Copy this read-only link now.</strong> It will not be shown again.</p><input data-share-link readonly/><button type="button" class="button button--secondary" data-copy-share>Copy link</button></div>{shareLinks.length>0&&<ul data-share-history>{shareLinks.map(link=><li>{link.revokedAt?'revoked':new Date(link.expiresAt)<=new Date()?'expired':'active'} · expires {activityTime(link.expiresAt)}{!link.revokedAt&&new Date(link.expiresAt)>new Date()&&<button type="button" class="button button--secondary" data-revoke-share={link.id}>Revoke</button>}</li>)}</ul>}</section>
  <section class="booking-panel" aria-labelledby="ai-sharing-heading"><h2 id="ai-sharing-heading">Temporary AI collaboration</h2><p>This shares itinerary dates, visible activities, non-sensitive notes and public place references. It excludes contacts, payments, booking credentials, participants, private items, reservation notes and Local Guide consent.</p><form id="create-ai-capability-form" class="planner-form"><label>Link lifetime<select name="expiresHours"><option value="1">1 hour</option><option value="4" selected>4 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select></label><button class="button" type="submit">Create AI collaboration link</button></form><div data-ai-capability-result hidden><p><strong>Copy or scan this link now.</strong> It will not be shown again.</p><input data-ai-capability-link readonly/><button type="button" class="button button--secondary" data-copy-ai-capability>Copy AI link</button><a class="button button--secondary" data-download-ai-qr download="olrig-bank-ai-collaboration.png">Download QR code</a><p><img data-ai-capability-qr alt="QR code for the temporary AI collaboration link" width="320" height="320"/></p></div>{aiCapabilities.length>0&&<ul data-ai-capability-history>{aiCapabilities.map(capability=><li>{capability.revokedAt?'revoked':new Date(capability.expiresAt)<=new Date()?'expired':'active'} · version {capability.protocolVersion} · expires {activityTime(capability.expiresAt)}{!capability.revokedAt&&new Date(capability.expiresAt)>new Date()&&<button type="button" class="button button--secondary" data-revoke-ai-capability={capability.id}>Revoke</button>}</li>)}</ul>}</section>
  <section class="booking-panel" aria-labelledby="contribution-heading"><h2 id="contribution-heading">Offer a recommendation to the Local Guide</h2><p>Only custom activities you added are eligible. Nothing is published until Olrig Bank reviews it.</p>{contributableItems.length===0?<p>No custom recommendations are currently available to offer.</p>:contributableItems.map(item=><form class="planner-form contribution-form" data-item-id={item.id}><label>Title<input name="offeredTitle" value={item.title} required maxlength="200"/></label><label>Location<input name="offeredLocationText" value={item.locationText??''} maxlength="500"/></label><label class="planner-wide">Recommendation<textarea name="offeredDescription" maxlength="5000">{item.description}</textarea></label><label class="planner-wide"><input name="consent" type="checkbox" required/> Share this specific recommendation with Olrig Bank so it may help future guests.</label><label class="planner-wide"><input name="attributionPermitted" type="checkbox"/> Olrig Bank may credit me by name.</label><button class="button" type="submit">Offer for review</button></form>)}<h3>Contribution history</h3>{contributions.length===0?<p>No recommendations have been offered.</p>:<ul data-contribution-history>{contributions.map(entry=><li><strong>{entry.offeredTitle}</strong> · {entry.status} · offered by {entry.submittedByName}{entry.attributionPermitted?' · attribution permitted':' · anonymous'} {entry.status==='pending'&&ownCandidateIds.has(entry.id)&&<button type="button" class="button button--secondary" data-withdraw-contribution={entry.id}>Withdraw</button>}</li>)}</ul>}</section>
  <section class="booking-panel" aria-labelledby="ai-proposals-heading"><h2 id="ai-proposals-heading">AI proposals awaiting review</h2>{aiProposals.length===0?<p>No proposals have been submitted.</p>:<ul>{aiProposals.map(proposal=><li><a href={`/booking/manage/${token}/planner/proposals/${proposal.id}/`}>{proposal.summary}</a> · {proposal.status} · source revision {proposal.sourceRevision}</li>)}</ul>}</section>
  <section class="booking-panel" aria-labelledby="activity-heading"><h2 id="activity-heading">Recent activity</h2><ol data-plan-activity>{plan.revisions.slice(-10).reverse().map(entry=><li><strong>{entry.actorDisplayName}</strong> {entry.summary} <time datetime={entry.createdAt}>{activityTime(entry.createdAt)}</time></li>)}</ol></section>
</BaseLayout>
<script is:inline define:vars={{endpoint:`/api/booking/planner/${token}/`,initialRevision:plan.revision}}>
let revision=initialRevision;const message=document.querySelector('#planner-message');const conflict=document.querySelector('[data-planner-conflict]');const values=f=>Object.fromEntries(new FormData(f));function show(t,e=false){message.hidden=false;message.textContent=t;message.className=`pricing-message ${e?'is-error':''}`}async function action(p){const r=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...p,expectedRevision:revision})});const d=await r.json().catch(()=>({}));if(!r.ok){if(d.code==='STALE_REVISION'){conflict.hidden=false;conflict.querySelector('[data-conflict-revision]').textContent=`The latest plan is revision ${d.currentRevision}. Reload before trying again.`}throw new Error(d.error||'Planner action failed.')}revision=d.revision??revision;document.querySelector('[data-revision]').textContent=revision;return d}document.querySelector('[data-reload-plan]')?.addEventListener('click',()=>location.reload());
document.querySelector('#plan-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updatePlan',...values(e.currentTarget)});show('Plan saved.')}catch(x){show(x.message,true)}});document.querySelector('#add-day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addDay',...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});
document.querySelectorAll('.planner-day').forEach(day=>{const dayId=day.dataset.dayId;day.querySelector('.day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateDay',dayId,...values(e.currentTarget)});show('Day saved.')}catch(x){show(x.message,true)}});day.querySelector('[data-remove-day]')?.addEventListener('click',async()=>{if(confirm('Remove this day and its activities?'))try{await action({action:'removeDay',dayId});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('[data-day-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveDay',dayId,direction:b.dataset.dayMove});location.reload()}catch(x){show(x.message,true)}}));day.querySelector('.add-item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addItem',dayId,...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('.planner-item').forEach(item=>{const itemId=item.dataset.itemId;item.querySelector('.item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateItem',itemId,...values(e.currentTarget)});show('Item saved.')}catch(x){show(x.message,true)}});item.querySelector('[data-set-guide]')?.addEventListener('click',async()=>{try{await action({action:'setGuideReference',itemId,localGuideSlug:item.querySelector('[data-guide]').value});location.reload()}catch(x){show(x.message,true)}});item.querySelector('[data-move-to-day]')?.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:item.querySelector('[data-target-day]').value,position:'end'});location.reload()}catch(x){show(x.message,true)}});item.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(confirm('Remove this activity?'))try{await action({action:'removeItem',itemId});location.reload()}catch(x){show(x.message,true)}});item.querySelectorAll('[data-item-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:dayId,position:b.dataset.itemMove});location.reload()}catch(x){show(x.message,true)}}))})});
document.querySelector('#invite-participant-form')?.addEventListener('submit',async e=>{e.preventDefault();try{const result=await action({action:'inviteParticipant',...values(e.currentTarget)});const box=document.querySelector('[data-invitation-result]');const link=box.querySelector('[data-invitation-link]');link.value=`${location.origin}/planner/invite/${result.token}/`;box.hidden=false;show('Invitation created. Copy its private link now.')}catch(x){show(x.message,true)}});document.querySelector('[data-copy-invitation]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-invitation-link]').value));document.querySelectorAll('[data-participant-id]').forEach(row=>{const participantId=row.dataset.participantId;row.querySelector('[data-save-participant]')?.addEventListener('click',async()=>{try{await action({action:'changeParticipantRole',participantId,role:row.querySelector('[data-participant-role]').value});location.reload()}catch(x){show(x.message,true)}});row.querySelector('[data-revoke-participant]')?.addEventListener('click',async()=>{if(confirm('Revoke this participant link?'))try{await action({action:'revokeParticipant',participantId});location.reload()}catch(x){show(x.message,true)}})});
document.querySelectorAll('.contribution-form').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'offerGuideContribution',itemId:form.dataset.itemId,...values(form),consent:form.elements.consent.checked,attributionPermitted:form.elements.attributionPermitted.checked});location.reload()}catch(x){show(x.message,true)}}));document.querySelectorAll('[data-withdraw-contribution]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'withdrawGuideContribution',candidateId:button.dataset.withdrawContribution});location.reload()}catch(x){show(x.message,true)}}));
document.querySelector('#create-share-form')?.addEventListener('submit',async e=>{e.preventDefault();try{const result=await action({action:'createShareLink',...values(e.currentTarget)});const box=document.querySelector('[data-share-result]');const link=box.querySelector('[data-share-link]');link.value=`${location.origin}/planner/share/${result.token}/`;box.hidden=false;show('Read-only share link created.')}catch(x){show(x.message,true)}});document.querySelector('[data-copy-share]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-share-link]').value));document.querySelectorAll('[data-revoke-share]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'revokeShareLink',shareId:button.dataset.revokeShare});location.reload()}catch(x){show(x.message,true)}}));
document.querySelector('#create-ai-capability-form')?.addEventListener('submit',async e=>{e.preventDefault();try{const result=await action({action:'createAiCapability',...values(e.currentTarget)});const box=document.querySelector('[data-ai-capability-result]');box.querySelector('[data-ai-capability-link]').value=result.url;box.querySelector('[data-ai-capability-qr]').src=result.qrDataUrl;box.querySelector('[data-download-ai-qr]').href=result.qrDataUrl;box.hidden=false;show('Temporary AI collaboration link created.')}catch(x){show(x.message,true)}});document.querySelector('[data-copy-ai-capability]')?.addEventListener('click',()=>navigator.clipboard.writeText(document.querySelector('[data-ai-capability-link]').value));document.querySelectorAll('[data-revoke-ai-capability]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'revokeAiCapability',capabilityId:button.dataset.revokeAiCapability});location.reload()}catch(x){show(x.message,true)}}));
</script>
