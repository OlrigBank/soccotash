---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';import AiProposalReview from '../../../../../../components/AiProposalReview.astro';import {resolveBookingAccessCredential} from '../../../../../../lib/booking/booking-access.ts';import {getBookingLinkedPlanByBookingReference} from '../../../../../../lib/planner/repository.ts';import {compareAiProposal,getAiProposal} from '../../../../../../lib/planner/ai-proposals.ts';
export const prerender=false;Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Referrer-Policy','no-referrer');Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');const token=String(Astro.params.token||'');const access=await resolveBookingAccessCredential(token,{recordUse:true,recordDenied:true});if(!access.allowed)return new Response('Proposal not found.',{status:404});const plan=await getBookingLinkedPlanByBookingReference(access.reference);const proposal=plan?await getAiProposal(plan.id,String(Astro.params.proposalId||'')):null;if(!plan||!proposal)return new Response('Proposal not found.',{status:404});const diff=compareAiProposal(plan,proposal);
---
<BaseLayout title={`Review · ${proposal.summary}`} showSidebar={false} robots="noindex,nofollow,noarchive"><a class="button button--secondary" href={`/booking/manage/${token}/planner/`}>Back to planner</a><AiProposalReview record={proposal} diff={diff} endpoint={`/api/booking/planner/${token}/`} currentRevision={plan.revision}/></BaseLayout>
