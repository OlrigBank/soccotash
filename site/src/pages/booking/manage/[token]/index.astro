---
import BookerLayout from '../../../../layouts/BookerLayout.astro';
import CustomerBookingView from '../../../../components/CustomerBookingView.astro';
import BookingOccupancyDetails from '../../../../components/BookingOccupancyDetails.astro';
import { resolveBookingAccessCredential } from '../../../../lib/booking/booking-access';
import { getProperties } from '../../../../lib/booking/config';
import {
  getCustomerBookingPage,
  getProvisionalBookingRequest,
  recordBookingActivity,
  respondToBespokeDateSuggestion,
  respondToCustomerBookingOffer,
  withdrawProvisionalBookingWhatsAppConsent,
  type CustomerOfferResponseResult,
} from '../../../../lib/booking/repository';
import {
  getBookingPaymentHistory,
  reportManualBankTransfer,
} from '../../../../lib/booking/payment-lifecycle';
import { deliverBookingLifecycleNotification } from '../../../../lib/booking/lifecycle-notification';
import {
  getBookingPaymentNotice,
  isCurrentPaymentReportResult,
} from '../../../../lib/booking/payment-notice';
import {
  createBookerBookingMessage,
  getBookingMessagesByToken,
  markBookingMessageNotification,
} from '../../../../lib/booking/messaging';
import {
  sendCustomerOfferResponseEmail,
  sendManagementOfferResponseEmail,
} from '../../../../lib/booking/offer-email';
import { sendAdministratorMessageEmail } from '../../../../lib/booking/message-email';
import { deliverBookingNotification } from '../../../../lib/booking/notification-delivery';
import { cancelBookingByBookerToken } from '../../../../lib/booking/cancellation-lifecycle';
import { validateCancellationInput } from '../../../../lib/booking/cancellation-display';
import {
  getBookingManagementRecipients,
  getEmailConfiguration,
} from '../../../../lib/email/sender';
import { copyPublishedExampleIntoBookingPlan, createBookingLinkedPlan, deleteGuestPlan, duplicateBookingPlanForGuest, getBookingLinkedPlanByBookingReference, listBookingPlanFamily, listPublishedExamplePlans, replaceGuestPlanCredential, resetGuestPlanPassword, revokeGuestPlanCredential } from '../../../../lib/planner/repository.ts';
import { PlannerError } from '../../../../lib/planner/types.ts';
import { getOccupancyDetails, occupancyDetailsFromForm, replaceOccupancyDetails } from '../../../../lib/booking/occupancy-details';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('X-Soccotash-Booking-UI', '39-access-lifecycle');

const token = String(Astro.params.token || '');
const access = await resolveBookingAccessCredential(token, { recordUse: true, recordDenied: true });
if (!access.allowed) return new Response('Booking not found.', { status: 404 });

let offer = await getCustomerBookingPage(token, true);
if (!offer) return new Response('Booking not found.', { status: 404 });

const propertyName = getProperties().find((property) => property.id === offer?.propertyId)?.name ?? offer.propertyId;
const configuredOrigin = String(process.env.BOOKING_PUBLIC_URL || '').trim();
const publicOrigin = configuredOrigin || Astro.url.origin;
const manageUrl = new URL(`/booking/manage/${token}/`, publicOrigin).toString();
const managementRecipients = getBookingManagementRecipients();
const messageEmailConfiguration = getEmailConfiguration();
const messageNotificationAvailable = messageEmailConfiguration.configured && managementRecipients.length > 0;

let responseError = '';
let messageError = '';
let responseResult: CustomerOfferResponseResult | null = null;
let occupancyDetails = await getOccupancyDetails(offer.bookingReference);
let occupancyNotice = '';
let occupancyError = '';
let holidayPlan = await getBookingLinkedPlanByBookingReference(offer.bookingReference);
let planFamily = holidayPlan ? await listBookingPlanFamily(offer.bookingReference) : [];
let newGuestPlanLink = '';
let newGuestPlanId = '';
const publishedExamplePlans = holidayPlan && holidayPlan.days.length === 0 ? await listPublishedExamplePlans() : [];

if (Astro.request.method === 'POST') {
  // The unguessable token in this URL is the authorisation credential for the Booker.
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');

  if (action === 'save-occupancy-details') {
    try {
      occupancyDetails = await replaceOccupancyDetails(offer.bookingReference, occupancyDetailsFromForm(form, offer), 'customer');
      occupancyNotice = 'Occupant and pet details were saved.';
    } catch (error) {
      occupancyError = error instanceof Error && error.message === 'OCCUPANT_COUNT_MISMATCH' ? 'The named occupants exceed the booking party counts.' : 'Check the pet species and describe any “other” species.';
    }
  } else if (action === 'reset-guest-plan-password') {
    try{await resetGuestPlanPassword({bookingReference:offer.bookingReference,planId:String(form.get('planId')||''),actor:{type:'booker',bookingId:access.bookingId}});planFamily=await listBookingPlanFamily(offer.bookingReference)}
    catch(error){responseError=error instanceof PlannerError?error.message:'The guest password could not be reset.'}
  } else if (action === 'delete-guest-plan') {
    try{await deleteGuestPlan({bookingReference:offer.bookingReference,planId:String(form.get('planId')||''),actor:{type:'booker',bookingId:access.bookingId}});planFamily=await listBookingPlanFamily(offer.bookingReference)}
    catch(error){responseError=error instanceof PlannerError?error.message:'The guest plan could not be deleted.'}
  } else if (action === 'replace-guest-plan-link') {
    try{newGuestPlanId=String(form.get('planId')||'');const created=await replaceGuestPlanCredential({bookingReference:offer.bookingReference,planId:newGuestPlanId,actor:{type:'booker',bookingId:access.bookingId}});newGuestPlanLink=new URL(`/planner/guest/${created.token}/`,publicOrigin).toString();planFamily=await listBookingPlanFamily(offer.bookingReference)}
    catch(error){responseError=error instanceof PlannerError?error.message:'The guest link could not be replaced.'}
  } else if (action === 'revoke-guest-plan-link') {
    try{await revokeGuestPlanCredential({bookingReference:offer.bookingReference,planId:String(form.get('planId')||''),actor:{type:'booker',bookingId:access.bookingId}});planFamily=await listBookingPlanFamily(offer.bookingReference)}
    catch(error){responseError=error instanceof PlannerError?error.message:'The guest link could not be revoked.'}
  } else if (action === 'duplicate-guest-plan') {
    try {
      if (!holidayPlan) throw new PlannerError('NOT_FOUND','Holiday plan not found.');
      const created=await duplicateBookingPlanForGuest({bookingReference:offer.bookingReference,sourcePlanId:holidayPlan.id,
        guestName:String(form.get('guestName')||''),actor:{type:'booker',bookingId:access.bookingId}});
      newGuestPlanId=created.planId;
      newGuestPlanLink=new URL(`/planner/guest/${created.token}/`,publicOrigin).toString();
      planFamily=await listBookingPlanFamily(offer.bookingReference);
    } catch (error) {
      responseError = error instanceof PlannerError ? error.message : 'The guest plan could not be created.';
    }
  } else if (action === 'copy-example-plan') {
    try {
      await copyPublishedExampleIntoBookingPlan({
        bookingReference: offer.bookingReference,
        sourcePlanId: String(form.get('sourcePlanId') || ''),
        expectedRevision: Number(form.get('expectedRevision')),
        actor: { type: 'booker', bookingId: access.bookingId },
      });
      return Astro.redirect(`/booking/manage/${token}/holiday-planner/?planner=example-copied#holiday-planner`);
    } catch (error) {
      responseError = error instanceof PlannerError ? error.message : 'The example plan could not be copied.';
    }
  } else if (action === 'create-holiday-plan') {
    try {
      await createBookingLinkedPlan({
        bookingReference: offer.bookingReference,
        actor: { type: 'booker', bookingId: access.bookingId },
      });
      return Astro.redirect(`/booking/manage/${token}/holiday-planner/?planner=created#holiday-planner`);
    } catch (error) {
      responseError = error instanceof PlannerError ? error.message : 'The holiday plan could not be created.';
    }
  } else if (action === 'withdraw-whatsapp-consent') {
    await withdrawProvisionalBookingWhatsAppConsent(offer.bookingReference, 'booker');
    await recordBookingActivity({
      bookingReference: offer.bookingReference,
      actor: 'customer',
      eventType: 'whatsapp_consent_withdrawn',
    });
    return Astro.redirect(`/booking/manage/${token}/reservation/?consent=withdrawn`);
  } else if (action === 'respond-bespoke-dates') {
    const decision = String(form.get('dateDecision') || '');
    if (decision !== 'accept' && decision !== 'change' && decision !== 'keep_original') {
      responseError = 'Choose how you want to revise this request.';
    } else {
      const changedDates = decision === 'change' ? {
        arrival: String(form.get('changedArrival') || ''),
        departure: String(form.get('changedDeparture') || ''),
      } : undefined;
      const today = new Date().toISOString().slice(0, 10);
      if (changedDates && changedDates.arrival < today) {
        responseError = 'Choose an arrival date that is today or later.';
      } else {
        const result = await respondToBespokeDateSuggestion(token, decision, changedDates);
        if (result === 'accepted' || result === 'changed' || result === 'original_retained') {
        return Astro.redirect(`/booking/manage/${token}/reservation/?dates=${result}`);
        }
        responseError = result === 'invalid_dates'
          ? 'Enter valid arrival and departure dates for a stay of no more than 365 nights.'
          : result === 'no_suggestion'
            ? 'That date suggestion has already been answered. Refresh the page to see the current request.'
            : 'The date suggestion can no longer be answered from this booking.';
      }
    }
  } else if (action === 'cancel-booking') {
    const cancellation = validateCancellationInput({
      confirmed: form.get('confirmCancellation') === 'yes',
      reason: String(form.get('cancellationReason') || ''),
    });
    if (!cancellation.accepted) {
      responseError = cancellation.code === 'confirmation_required'
        ? 'Confirm that this booking should be cancelled and its dates released.'
        : 'Enter the reason for cancelling the booking.';
    } else {
      const booking = await getProvisionalBookingRequest(offer.bookingReference);
      if (!booking) return new Response('Booking not found.', { status: 404 });
      const cancelled = await cancelBookingByBookerToken(token, cancellation.reason);
      if (cancelled !== 'cancelled') {
        responseError = cancelled === 'reason_required'
          ? 'Enter the reason for cancelling the booking.'
          : cancelled === 'not_found'
            ? 'The booking could not be found.'
            : 'The booking can no longer be cancelled from its current status.';
      } else {
        const adminUrl = new URL(`/admin/bookings/${offer.bookingReference}/`, publicOrigin).toString();
        const notification = await deliverBookingLifecycleNotification({
          event: 'booking_cancelled_by_booker',
          booking,
          propertyName,
          adminUrl,
          reason: cancellation.reason,
          notificationSourceKey: `booking-cancelled-by-booker:${offer.bookingReference}`,
        });
        await recordBookingActivity({
          bookingReference: offer.bookingReference,
          offerId: offer.offerId,
          actor: 'system',
          eventType: `booking_cancelled_by_booker_email_${notification.status}`,
          details: notification,
        });
        return Astro.redirect(`/booking/manage/${token}/reservation/?cancelled=1&email=${notification.status}`);
      }
    }
  } else if (action === 'send-message') {
    const body = String(form.get('messageBody') || '').trim().slice(0, 5000);
    const notificationRequested = form.get('sendMessageEmail') === 'yes';
    if (!body) {
      messageError = 'Write a message before sending.';
    } else {
      const shouldNotify = notificationRequested && messageNotificationAvailable;
      const message = await createBookerBookingMessage({
        token,
        body,
        notificationRequested: shouldNotify,
        notificationRecipient: shouldNotify ? managementRecipients[0] : null,
      });
      let notificationStatus: 'sent' | 'failed' | 'skipped' = 'skipped';
      if (shouldNotify) {
        const booking = await getProvisionalBookingRequest(offer.bookingReference);
        if (!booking) return new Response('Booking not found.', { status: 404 });
        try {
          const adminUrl = new URL(`/admin/bookings/${offer.bookingReference}/`, publicOrigin).toString();
          const delivery = await deliverBookingNotification({
            booking, propertyName, target: 'administrator', eventType: 'booker_message_received',
            sourceKey: `booker-message:${message.publicId}:administrator`,
            emailDelivery: async () => {
              const sent = await sendAdministratorMessageEmail({ booking, propertyName, body, adminUrl });
              return sent ? { ...sent.result, recipient: sent.primaryRecipient } : null;
            },
          });
          notificationStatus = delivery.status === 'sent' ? 'sent' : delivery.status === 'failed' ? 'failed' : 'skipped';
          await markBookingMessageNotification({
            messageId: message.id,
            status: notificationStatus,
            recipient: delivery.channel === 'email' ? managementRecipients[0] : null,
          });
        } catch (error) {
          notificationStatus = 'failed';
          await markBookingMessageNotification({
            messageId: message.id,
            status: 'failed',
            error: error instanceof Error ? error.message : String(error),
          });
        }
      }
      await recordBookingActivity({
        bookingReference: offer.bookingReference,
        actor: 'customer',
        eventType: 'booker_message_sent',
        details: { messageId: message.publicId, notificationRequested, notificationAvailable: messageNotificationAvailable, notificationStatus },
      });
      return Astro.redirect(`/booking/manage/${token}/messages/?message=sent&messageEmail=${notificationRequested ? notificationStatus : 'not-requested'}`);
    }
  } else if (action === 'report-bank-transfer') {
    const confirmedTransfer = form.get('confirmTransfer') === 'yes';
    if (!confirmedTransfer) {
      responseError = 'Please tick the confirmation box before reporting the transfer.';
    } else {
      const transferResult = await reportManualBankTransfer(token);
      if (transferResult === 'payment_reported') {
        const booking = await getProvisionalBookingRequest(offer.bookingReference);
        if (!booking) return new Response('Booking not found.', { status: 404 });
        const adminUrl = new URL(
          `/admin/bookings/${offer.bookingReference}/payment/`,
          publicOrigin,
        ).toString();
        const paymentStage = booking.currentPaymentStage || (booking.balanceDuePence ? 'deposit' : 'full_payment');
        const paymentAmountPence = paymentStage === 'balance'
          ? Number(booking.balanceDuePence || 0)
          : Number(booking.depositPence || 0);
        const notification = await deliverBookingLifecycleNotification({
          event: paymentStage === 'balance' ? 'balance_payment_reported' : 'payment_reported',
          booking,
          propertyName,
          adminUrl,
          paymentStage,
          paymentAmountPence,
          paymentCurrency: booking.latestOfferCurrency || booking.pricingCurrency || 'GBP',
          notificationSourceKey: `payment-reported:${booking.currentPaymentPublicId || booking.reference}:${paymentStage}`,
        });
        await recordBookingActivity({
          bookingReference: offer.bookingReference,
          offerId: offer.offerId,
          actor: 'system',
          eventType: `payment_reported_email_${notification.status}`,
          details: notification,
        });
        return Astro.redirect(
          `/booking/manage/${token}/reservation/?payment=bank-transfer-reported&paymentEmail=${notification.status}`,
        );
      }
      if (transferResult === 'already_reported') {
        return Astro.redirect(`/booking/manage/${token}/reservation/?payment=bank-transfer-reported`);
      }
      responseError = transferResult === 'payment_not_due'
        ? 'A manual transfer cannot be reported at this stage of the booking.'
        : 'The booking could not be found.';
    }
  } else {
    const confirmed = action === 'accept'
      ? form.get('confirmAccept') === 'yes'
      : action === 'decline'
        ? form.get('confirmDecline') === 'yes'
        : false;

    if (action !== 'accept' && action !== 'decline') {
      responseError = 'The requested booking action was not recognised.';
    } else if (!confirmed) {
      responseError = action === 'accept'
        ? 'Please tick the confirmation box before accepting the offer.'
        : 'Please tick the confirmation box before declining the offer.';
    } else {
      responseResult = await respondToCustomerBookingOffer(token, action);
      if (responseResult === 'accepted' || responseResult === 'declined') {
        offer = await getCustomerBookingPage(token, false);
        if (!offer) return new Response('Booking not found.', { status: 404 });
        const response = responseResult;
        let customerEmailStatus: 'submitted' | 'sent' | 'failed' | 'skipped' = 'skipped';
        const booking = await getProvisionalBookingRequest(offer.bookingReference);
        if (booking) {
          const responseOffer = offer;
          const delivery = await deliverBookingNotification({
            booking, propertyName, manageUrl, target: 'booker',
            eventType: response === 'accepted' ? 'payment_required' : 'offer_declined',
            sourceKey: `offer-response:${offer.offerId || offer.bookingReference}:${response}:booker`,
            emailDelivery: responseOffer.guestEmail ? async () => {
              const sent = await sendCustomerOfferResponseEmail({ offer: responseOffer, propertyName, response, manageUrl });
              return { ...sent, recipient: responseOffer.guestEmail };
            } : undefined,
          });
          customerEmailStatus = delivery.status === 'submitted' ? 'submitted' : delivery.status === 'sent' ? 'sent' : delivery.status === 'failed' ? 'failed' : 'skipped';
          await recordBookingActivity({
            bookingReference: offer.bookingReference,
            offerId: offer.offerId,
            actor: 'system',
            eventType: `customer_response_notification_${customerEmailStatus}`,
            details: { response, channel: delivery.channel, status: delivery.status },
          });
        }

        try {
          const adminUrl = new URL(`/admin/bookings/${offer.bookingReference}/`, publicOrigin).toString();
          const sent = await sendManagementOfferResponseEmail({ offer, propertyName, response, adminUrl });
          await recordBookingActivity({
            bookingReference: offer.bookingReference,
            offerId: offer.offerId,
            actor: 'system',
            eventType: sent ? 'management_response_email_sent' : 'management_response_email_skipped',
            details: sent ? { response, provider: sent.provider, messageId: sent.messageId } : { response, reason: 'No management recipient configured.' },
          });
        } catch (error) {
          await recordBookingActivity({
            bookingReference: offer.bookingReference,
            offerId: offer.offerId,
            actor: 'system',
            eventType: 'management_response_email_failed',
            details: { response, error: error instanceof Error ? error.message : String(error) },
          });
        }

        return Astro.redirect(`/booking/manage/${token}/reservation/?response=${response === 'accepted' ? 'payment-required' : 'declined'}&email=${customerEmailStatus}`);
      }

      const messages: Record<CustomerOfferResponseResult, string> = {
        accepted: '',
        declined: '',
        already_accepted: 'This offer has already been accepted and is awaiting payment.',
        already_declined: 'This offer has already been declined.',
        expired: 'This offer has expired and can no longer be accepted or declined online.',
        superseded: 'This offer has been replaced. Reload this booking page to see the current offer.',
        dates_unavailable: 'The dates are no longer available. Your response was not recorded; please message Olrig Bank.',
        not_found: 'This booking offer could not be found.',
      };
      responseError = messages[responseResult];
      offer = await getCustomerBookingPage(token, false) ?? offer;
    }
  }
}

const responseNotice = Astro.url.searchParams.get('response');
const payments = await getBookingPaymentHistory(offer.bookingReference);
const currentReportedPayment = payments.find((payment) => payment.status === 'reported') || null;
const paymentStatus = Astro.url.searchParams.get('payment');
const paymentReportResultCurrent = isCurrentPaymentReportResult(paymentStatus, offer.bookingStatus)
  || (paymentStatus === 'bank-transfer-reported' && currentReportedPayment?.stage === 'balance');
const paymentNotice = paymentStatus === 'bank-transfer-reported' && currentReportedPayment?.stage === 'balance'
  ? 'Your remaining-balance transfer was reported. Your booking remains confirmed while Olrig Bank verifies it.'
  : getBookingPaymentNotice(paymentStatus, offer.bookingStatus);
const emailParam = Astro.url.searchParams.get('paymentEmail') || Astro.url.searchParams.get('email');
const emailStatus = emailParam === 'failed' ? 'failed' : emailParam === 'sent' ? 'sent' : emailParam === 'skipped' ? 'skipped' : null;
const messageSent = Astro.url.searchParams.get('message') === 'sent';
const messageEmailStatus = Astro.url.searchParams.get('messageEmail');
const cancellationRecorded = Astro.url.searchParams.get('cancelled') === '1';
const dateDecision = Astro.url.searchParams.get('dates');
const messageNotice = cancellationRecorded
  ? 'Your cancellation has been recorded. The dates have been released, and the booking record remains available here.'
  : dateDecision === 'accepted'
    ? 'Your agreement to the suggested dates was sent to Olrig Bank as a revised request. This is not a booking offer or confirmation.'
    : dateDecision === 'changed'
      ? 'Your replacement dates were sent to Olrig Bank for review. The request and conversation remain open.'
    : dateDecision === 'original_retained'
      ? 'Your original dates were kept and your decision was sent to Olrig Bank for another review.'
  : messageSent
  ? messageEmailStatus === 'sent'
    ? 'Your message was added to the conversation and the Olrig Bank administrators were notified by email.'
    : messageEmailStatus === 'failed'
      ? 'Your message was added to the conversation, but the optional administrator email notification failed.'
      : 'Your message was added to the conversation.'
  : '';
const confirmedBooking = offer.bookingStatus === 'confirmed' || offer.bookingStatus === 'approved';
const cancelledBooking = offer.bookingStatus === 'cancelled';
const pendingBooking = offer.customerStatus === 'request_pending' || offer.bookingStatus === 'pending';
const conversationMessages = await getBookingMessagesByToken(token, 'booker', { markRead: true });
const workspace = Astro.url.searchParams.get('workspace');
const bookingTitle = cancelledBooking ? 'Cancelled booking' : confirmedBooking ? 'Confirmed booking' : pendingBooking ? 'Booking request' : 'Booking offer';
const bookingLandingUrl = new URL(`/booking/manage/${token}/`, Astro.url).toString();
---
<BookerLayout
  title={`${bookingTitle} · ${propertyName}`}
  description="Manage your Olrig Bank booking and conversation."
  showSidebar={false}
  robots="noindex,nofollow,noarchive"
>
  <header class="booker-page-header">
    <div><p class="eyebrow">{bookingTitle}</p><h1>{propertyName}</h1><p>For {offer.guestName} · {offer.arrival} to {offer.departure}</p></div>
    {workspace && <a class="button button--secondary" href={`/booking/manage/${token}/`}>Booking overview</a>}
  </header>

  <nav class:list={['booker-workspace-list', workspace && 'booker-workspace-list--compact']} aria-label="Your booking">
    <a href={`/booking/manage/${token}/reservation/`} aria-current={workspace === 'reservation' ? 'page' : undefined}><span>Reservation</span><strong>{propertyName}</strong><small>Dates, status, price, payments and responses</small></a>
    <a href={`/booking/manage/${token}/messages/`} aria-current={workspace === 'messages' ? 'page' : undefined}><span>Messages</span><strong>Conversation with Olrig Bank</strong><small>{conversationMessages.length} message{conversationMessages.length === 1 ? '' : 's'}</small></a>
    <a href={`/booking/manage/${token}/holiday-planner/`} aria-current={workspace === 'holiday-planner' ? 'page' : undefined}><span>Holiday Planner</span><strong>{holidayPlan?.title ?? 'Plan your stay'}</strong><small>{holidayPlan ? `${holidayPlan.days.length} planned day${holidayPlan.days.length === 1 ? '' : 's'}` : confirmedBooking ? 'Create your private plan' : 'Available after confirmation'}</small></a>
  </nav>

  {!workspace && <section class="customer-booking-card customer-booking-access-card">
    <div>
      <p class="eyebrow">Your private booking page</p>
      <h2>Save this booking link</h2>
        <p>Bookmark this landing page or keep its address somewhere safe. Your Reservation, Messages and Holiday Planner are all available from here.</p>
      <p class="customer-booking-security-note">Anyone with this link can view and respond to the booking, so do not share it publicly.</p>
    </div>
    <div class="customer-booking-access-actions">
      <button class="customer-booking-submit" type="button" data-copy-booking-link={bookingLandingUrl}>Copy booking link</button>
      <button class="customer-booking-submit customer-booking-refresh" type="button" data-refresh-booking-page>Check for updates</button>
      <span class="customer-booking-copy-status" data-copy-booking-status aria-live="polite"></span>
    </div>
  </section>}

  {(workspace === 'reservation' || workspace === 'messages') && <CustomerBookingView
    offer={offer}
    messages={conversationMessages}
    propertyName={propertyName}
    pollingUrl={`/api/booking/messages/${token}`}
    responseNotice={responseNotice}
    responseError={responseError}
    messageNotice={paymentNotice || messageNotice}
    messageError={messageError}
    emailStatus={emailStatus}
    allowResponse={true}
    messageNotificationAvailable={messageNotificationAvailable}
    payments={payments}
    view={workspace}
  />}
  {workspace === 'reservation' && <BookingOccupancyDetails details={occupancyDetails} counts={offer} notice={occupancyNotice} error={occupancyError} />}
  {workspace === 'holiday-planner' && <section id="holiday-planner" class="booking-panel booking-planner-card" aria-labelledby="holiday-planner-heading">
    <p class="eyebrow">Holiday Planner</p>
    <h2 id="holiday-planner-heading">Planning dashboard</h2>
    {holidayPlan ? (
      <>
        <p>Keep your original plan and create independent copies for other guests. Changes to one plan never alter another.</p>
        <div class="planning-dashboard-list">{planFamily.map(entry=><article class="planning-dashboard-card">
          <p class="eyebrow">{entry.role==='original'?'Original plan':'Guest copy'}</p><h3>{entry.guestName??entry.title}</h3>
          <p>{entry.startsOn} to {entry.endsOn} · {entry.dayCount} {entry.dayCount===1?'day':'days'} · revision {entry.revision}</p>
          <p class="planning-dashboard-card-actions"><a class="button" href={`/booking/manage/${token}/planner/?plan=${entry.id}`}>Open plan</a>
            {entry.id===newGuestPlanId&&newGuestPlanLink&&<button class="button button--secondary" type="button" data-copy-new-guest-link data-guest-link={newGuestPlanLink}>Copy link (to send to guest)</button>}
            {entry.id===newGuestPlanId&&<span class="visually-hidden" role="status" data-guest-link-status></span>}
          </p>
          {entry.role==='guest_copy'&&<details class="planner-action-menu"><summary aria-label={`Actions for ${entry.guestName}`}>⋮</summary><div>
            <form method="post"><input type="hidden" name="action" value="replace-guest-plan-link"/><input type="hidden" name="planId" value={entry.id}/><button type="submit">{entry.accessActive?'Replace guest link':'Create guest link'}</button></form>
            <form method="post" data-confirm-submit="Reset this guest password? The guest will need to choose a new password."><input type="hidden" name="action" value="reset-guest-plan-password"/><input type="hidden" name="planId" value={entry.id}/><button type="submit">Reset guest password</button></form>
            {entry.accessActive&&<form method="post"><input type="hidden" name="action" value="revoke-guest-plan-link"/><input type="hidden" name="planId" value={entry.id}/><button class="is-destructive" type="submit">Revoke guest link</button></form>}
            <form method="post" data-confirm-submit={`Delete ${entry.guestName}'s plan permanently? This cannot be undone.`}><input type="hidden" name="action" value="delete-guest-plan"/><input type="hidden" name="planId" value={entry.id}/><button class="is-destructive" type="submit">Delete guest plan</button></form>
          </div></details>}
          {entry.role==='guest_copy'&&<small>{entry.accessActive?'Guest link active. Replace it if the link is lost.':'Guest link revoked.'}</small>}
        </article>)}</div>
        <details class="planning-dashboard-create"><summary>Duplicate plan for another guest</summary><form method="post" class="planner-form">
          <input type="hidden" name="action" value="duplicate-guest-plan"/><label>Guest name<input name="guestName" required maxlength="160" autocomplete="off"/></label>
          <p>This creates an independent snapshot of {holidayPlan.title}. Later changes will not be synchronised.</p><button class="button" type="submit">Create guest plan</button>
        </form></details>
        {holidayPlan.days.length === 0 && publishedExamplePlans.length > 0 && <form method="post" class="booking-planner-copy-form">
          <input type="hidden" name="action" value="copy-example-plan" />
          <input type="hidden" name="expectedRevision" value={holidayPlan.revision} />
          <label>Start from an Olrig Bank example
            <select name="sourcePlanId" required><option value="" selected disabled>Choose an example…</option>{publishedExamplePlans.map((example) => <option value={example.id}>{example.title} · {example.dayCount} days</option>)}</select>
          </label>
          <button class="button" type="submit">Copy example into my plan</button>
          <small>Items become independent ideas. Private items and reservation notes are never copied.</small>
        </form>}
      </>
    ) : confirmedBooking ? (
      <form method="post">
        <input type="hidden" name="action" value="create-holiday-plan" />
        <p>Start with an empty private plan linked only to this confirmed booking.</p>
        <button class="button" type="submit">Create my holiday plan</button>
      </form>
    ) : (
      <p>The Holiday Planner becomes available after this booking is confirmed.</p>
    )}
    {Astro.url.searchParams.get('planner') === 'created' && <p role="status">Your private holiday plan has been created.</p>}
    {Astro.url.searchParams.get('planner') === 'example-copied' && <p role="status">The example was copied into your private holiday plan.</p>}
  </section>}
  {workspace === 'reservation' && <section class="booking-panel" aria-labelledby="whatsapp-preferences-heading">
    <h2 id="whatsapp-preferences-heading">WhatsApp preferences</h2>
    {offer.whatsappConsentStatus === 'active' ? (
      <>
        <p>Transactional WhatsApp notifications are enabled for this booking. Your private booking page remains the authoritative record.</p>
        <form method="post">
          <input type="hidden" name="action" value="withdraw-whatsapp-consent" />
          <button class="button button--secondary" type="submit">Stop WhatsApp notifications</button>
        </form>
      </>
    ) : (
      <p>WhatsApp notifications are {offer.whatsappConsentStatus === 'withdrawn' ? 'withdrawn' : 'not enabled'} for this booking. Email and this private page remain available.</p>
    )}
    {Astro.url.searchParams.get('consent') === 'withdrawn' && <p role="status">WhatsApp consent has been withdrawn. No further WhatsApp notifications will be submitted for this booking.</p>}
  </section>}
</BookerLayout>

<script is:inline define:vars={{ responseNotice, paymentReportResultCurrent, messageSent, confirmedBooking, propertyId: offer.propertyId }}>
  document.querySelector('[data-copy-new-guest-link]')?.addEventListener('click',async event=>{const button=event.currentTarget;try{await navigator.clipboard.writeText(button.dataset.guestLink);button.remove();document.querySelector('[data-guest-link-status]').textContent='Guest link copied.'}catch{document.querySelector('[data-guest-link-status]').textContent='The guest link could not be copied.'}});
  document.querySelectorAll('[data-confirm-submit]').forEach(form=>form.addEventListener('submit',event=>{if(!confirm(form.dataset.confirmSubmit))event.preventDefault()}));
  const analyticsEvents = [
    ['manage_booking_opened', { property: propertyId }],
    responseNotice === 'payment-required' && ['offer_accepted', { property: propertyId }],
    responseNotice === 'declined' && ['offer_declined', { property: propertyId }],
    messageSent && ['message_sent', { property: propertyId }],
    paymentReportResultCurrent && ['payment_reported', { property: propertyId, method: 'bank_transfer' }],
    confirmedBooking && ['booking_confirmed', { property: propertyId }],
  ].filter(Boolean);

  for (const [name, data] of analyticsEvents) {
    const key = `olrig-analytics:${name}:${location.search}`;
    if (name === 'manage_booking_opened' || sessionStorage.getItem(key) !== 'sent') {
      window.olrigAnalytics?.track(name, data);
      if (name !== 'manage_booking_opened') sessionStorage.setItem(key, 'sent');
    }
  }
</script>

<script>
  document.querySelector<HTMLButtonElement>('[data-copy-booking-link]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const status = document.querySelector<HTMLElement>('[data-copy-booking-status]');
    const bookingUrl = button.dataset.copyBookingLink;
    if (!bookingUrl) return;
    try {
      await navigator.clipboard.writeText(bookingUrl);
      if (status) status.textContent = 'Booking link copied.';
    } catch {
      if (status) status.textContent = 'Use your browser address bar to copy this booking link.';
    }
  });
  document.querySelector<HTMLButtonElement>('[data-refresh-booking-page]')?.addEventListener('click', () => window.location.reload());
</script>
