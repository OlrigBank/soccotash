---
export const prerender = false;
const workspace = String(Astro.params.workspace || '');
if (!['reservation', 'messages', 'holiday-planner'].includes(workspace)) {
  return new Response('Booking workspace not found.', { status: 404 });
}
const target = new URL(`/booking/manage/${Astro.params.token}/`, Astro.url);
for (const [key, value] of Astro.url.searchParams) target.searchParams.append(key, value);
target.searchParams.set('workspace', workspace);
return Astro.rewrite(target);
---
