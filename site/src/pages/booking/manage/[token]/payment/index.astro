---
import { currentBookerAccountId } from '../../../../../lib/booker/context.ts';
import { getEditableRequestJourney } from '../../../../../lib/booking/request-journey.ts';
import BookerLayout from '../../../../../layouts/BookerLayout.astro';
import { getProperties } from '../../../../../lib/booking/config.ts';
import { resolveBookingAccessCredential } from '../../../../../lib/booking/booking-access.ts';
import { getCustomerBookingPage, previewOfferPaymentTerms, paymentReviewKey, respondToCustomerBookingOffer } from '../../../../../lib/booking/repository.ts';
import { getBookingPaymentHistory } from '../../../../../lib/booking/payment-lifecycle.ts';
import { activeCheckoutAttempt, bankTransferDetails, startCardCheckout, stripeAvailable, switchToBankTransfer } from '../../../../../lib/booking/stripe-checkout.ts';
import { isSameBookerOrigin } from '../../../../../lib/booker/origin.ts';
import { formatPartyComposition } from '../../../../../lib/booking/party-composition.ts';
import { cancellationTermsSnapshot, formatCancellationTerms } from '../../../../../lib/pricing/cancellation-terms.ts';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

const token = String(Astro.params.token || '');
const access = await resolveBookingAccessCredential(token, { recordUse: true, recordDenied: true });
if (!access.allowed) return new Response('Booking not found.', { status: 404 });
let offer = await getCustomerBookingPage(token, true);
if (!offer) return new Response('Booking not found.', { status: 404 });
const propertyName = getProperties().find((property) => property.id === offer?.propertyId)?.name || offer.propertyId;
const publicOrigin = String(process.env.BOOKING_PUBLIC_URL || Astro.url.origin).replace(/\/$/, '');
let error = '';
if (Astro.request.method === 'POST') {
  if (!isSameBookerOrigin(Astro.request)) return new Response('Cross-site form submission forbidden.', { status: 403 });
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');
  if (['card-checkout', 'request-bank-details'].includes(action)) {
    if (action === 'card-checkout' && !stripeAvailable()) error = 'Card payment is temporarily unavailable.';
    else if (action === 'request-bank-details' && !bankTransferDetails()) error = 'Bank transfer details are temporarily unavailable.';
    else if (offer.bookingStatus === 'offered' || form.has('paymentReviewKey')) {
      if (form.get('confirmAccept') !== 'yes') error = 'Confirm that you have reviewed and accept the booking and cancellation terms and the reservation summary.';
      else {
        const accepted = await respondToCustomerBookingOffer(token, 'accept', Number(form.get('journeyRevision')), {
          key: String(form.get('paymentReviewKey') || ''), offerId: String(form.get('offerId') || ''),
          method: action === 'card-checkout' ? 'card' : 'bank',
        });
        if (!['accepted', 'already_accepted'].includes(accepted)) error = accepted === 'dates_unavailable'
          ? 'These dates are no longer available. Please contact Olrig Bank through your booking messages.'
          : 'This booking has changed or is no longer available. Review the current reservation summary and terms before continuing.';
      }
    }
    if (!error && action === 'card-checkout') {
      const result = await startCardCheckout(token, publicOrigin);
      if (result.url) return Astro.redirect(result.url, 303);
      error = result.error || 'Card checkout could not start.';
    } else if (!error) return Astro.redirect(`/booking/manage/${token}/payment/?method=bank`, 303);
  } else if (action === 'switch-to-bank') {
    error = await switchToBankTransfer(token) || '';
    if (!error) return Astro.redirect(`/booking/manage/${token}/payment/?method=bank`, 303);
  } else error = 'Choose a payment method to continue.';
  offer = await getCustomerBookingPage(token, false) || offer;
}
const journey = offer.requestJourneyRevision > 0 ? await getEditableRequestJourney(token, currentBookerAccountId()) : null;
const payments = await getBookingPaymentHistory(offer.bookingReference);
const activeCheckout = await activeCheckoutAttempt(offer.bookingReference);
const bank = bankTransferDetails();
const card = stripeAvailable();
const requestedMethod = Astro.url.searchParams.get('method');
const selectedMethod = requestedMethod === 'bank' || (requestedMethod !== 'card' && !card && bank) ? 'bank' : 'card';
const previewTerms = offer.bookingStatus === 'offered' ? await previewOfferPaymentTerms(token) : null;
const terms = offer.paymentTermsSnapshot || previewTerms;
const reviewKey = previewTerms && offer.offerId ? paymentReviewKey(offer.offerId, previewTerms) : '';
const cancellationTerms = cancellationTermsSnapshot(terms?.cancellationTerms);
const verifiedDeposit = payments.some((payment) => payment.stage === 'deposit' && payment.status === 'verified');
const verifiedBalance = payments.some((payment) => payment.stage === 'balance' && payment.status === 'verified');
const verifiedFull = payments.some((payment) => payment.stage === 'full_payment' && payment.status === 'verified');
const reported = payments.some((payment) => payment.status === 'reported');
const awaitingOffer = offer.bookingStatus === 'pending';
const offerReady = offer.bookingStatus === 'offered' && offer.customerStatus === 'active';
const balanceDue = offer.bookingStatus === 'confirmed' && verifiedDeposit && !verifiedBalance && offer.balanceDuePence > 0;
const initialDue = offer.bookingStatus === 'payment_pending' && !verifiedDeposit && !verifiedFull;
const due = balanceDue || initialDue || (offerReady && Boolean(previewTerms));
const initialAmount = previewTerms?.initialPaymentPence ?? offer.depositPence;
const remainingAmount = previewTerms?.balanceDuePence ?? offer.balanceDuePence;
const amountPence = balanceDue ? offer.balanceDuePence : initialAmount;
const stageLabel = balanceDue ? 'Remaining balance' : remainingAmount > 0 ? 'Deposit' : 'Full payment';
const money = (pence: number) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: offer.currency }).format(pence / 100);
const date = (value: string) => new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
const checkoutMessage = Astro.url.searchParams.get('checkout') === 'returned' && offer.bookingStatus !== 'confirmed'
  ? 'Your card payment is being checked. The reservation will update when Stripe confirms payment.'
  : Astro.url.searchParams.get('checkout') === 'cancelled'
    ? 'Card checkout was cancelled. You can try again or choose bank transfer.' : '';
---
<BookerLayout title={`Payment · ${propertyName}`} description="Review your booking and choose how to pay." showSidebar={false}>
  <div class:list={['payment-page', { 'has-payment-bar': due && !reported }]}>
    <nav class="payment-progress" aria-label="Booking progress"><ol>
      {offer.requestJourneyRevision > 0 ? <>
        <li>{journey ? <a href={`/book/?booking=${token}&step=stay`}>Check your stay</a> : 'Check your stay'}</li>
        <li>{journey ? <a href={`/book/?booking=${token}&step=details`}>Your details</a> : 'Your details'}</li>
        <li aria-current="step">{awaitingOffer ? 'Review and send request' : 'Make a payment'}</li>
      </> : <><li>Dates</li><li>Contact</li><li aria-current={offer.bookingStatus === 'confirmed' ? undefined : 'step'}>Payment</li><li aria-current={offer.bookingStatus === 'confirmed' ? 'step' : undefined}>Reservation</li></>}
    </ol></nav>
    <header class="payment-heading"><p class="eyebrow">Your booking</p><h1>{offer.bookingStatus === 'confirmed' && !balanceDue ? 'Reservation confirmed' : 'Make a payment'}</h1>
      <p>{propertyName} · {date(offer.arrival)} to {date(offer.departure)}</p></header>
    {error && <p class="payment-alert" role="alert">{error}</p>}
    {checkoutMessage && <p class="payment-alert" role="status">{checkoutMessage}</p>}
    {due && !reported && <div class="payment-mobile-bar" aria-label="Payment due">
      <div><small>{stageLabel} due</small><strong>{money(amountPence)}</strong></div>
      <a href="#methods-heading">Choose payment method</a>
    </div>}
    <div class="payment-layout"><div class="payment-main payment-panel">
      {awaitingOffer && <section class="payment-state" aria-labelledby="review-heading"><h2 id="review-heading">Your request is being reviewed</h2>
        <p>Olrig Bank will confirm the price and terms before payment is requested. Return through your private booking link when the offer is ready.</p>
        <a class="payment-secondary" href={`/booking/manage/${token}/reservation/`}>View request details</a></section>}
      {offerReady && !previewTerms && <p class="payment-alert" role="status">Payment details are temporarily unavailable. Please contact Olrig Bank through your booking messages.</p>}
      {due && !reported && <section aria-labelledby="methods-heading"><h2 id="methods-heading">Payment details</h2>
        <p>Choose how to pay the {stageLabel.toLowerCase()} of <strong>{money(amountPence)}</strong>.</p>
        <nav class="payment-methods" aria-label="Payment method">
          <a href="?method=card#methods-heading" aria-current={selectedMethod === 'card' ? 'true' : undefined}><span aria-hidden="true">▣</span> Credit or debit card</a>
          <a href="?method=bank#methods-heading" aria-current={selectedMethod === 'bank' ? 'true' : undefined}><span aria-hidden="true">▥</span> Bank transfer</a>
        </nav>
        <div class="payment-method-content">
          {selectedMethod === 'card' ? <article class="payment-method" aria-label="Credit or debit card">
            <p>Pay securely with Stripe. Available cards and wallets appear at checkout.</p>
            {card ? <form method="post"><input type="hidden" name="action" value="card-checkout" />
              {offerReady && <><input type="hidden" name="journeyRevision" value={offer.requestJourneyRevision} /><input type="hidden" name="offerId" value={offer.offerId} /><input type="hidden" name="paymentReviewKey" value={reviewKey} />
                <label class="payment-check"><input type="checkbox" name="confirmAccept" value="yes" required /><span>I have reviewed and accept the <a href="#terms-heading">booking and cancellation terms</a> and the content of the <a href="#reservation-summary-heading">reservation summary</a>.</span></label></>}
              <button class="payment-primary" type="submit">Pay {money(amountPence)} by card</button></form>
              : <p class="payment-unavailable">Card payment is temporarily unavailable.</p>}
          </article> : <article class="payment-method" aria-label="Bank transfer">
            <p>Your reservation is confirmed after Olrig Bank verifies receipt of your payment.</p>
            {offerReady && bank ? <form method="post"><input type="hidden" name="action" value="request-bank-details" />
              <input type="hidden" name="journeyRevision" value={offer.requestJourneyRevision} /><input type="hidden" name="offerId" value={offer.offerId} /><input type="hidden" name="paymentReviewKey" value={reviewKey} />
              <label class="payment-check"><input type="checkbox" name="confirmAccept" value="yes" required /><span>I have reviewed and accept the <a href="#terms-heading">booking and cancellation terms</a> and the content of the <a href="#reservation-summary-heading">reservation summary</a>.</span></label>
              <button class="payment-primary" type="submit">Request bank transfer details</button>
              <p>Requesting these details does not confirm payment or your reservation.</p>
            </form> : activeCheckout ? <form method="post"><input type="hidden" name="action" value="switch-to-bank" /><button class="payment-secondary" type="submit">Switch to bank transfer</button></form>
              : bank ? <div class="payment-bank"><dl class="payment-facts"><div><dt>Payee</dt><dd>{bank.payee}</dd></div><div><dt>Sort code</dt><dd>{bank.sortCode}</dd></div>
                <div><dt>Account number</dt><dd>{bank.accountNumber}</dd></div><div><dt>Amount</dt><dd>{money(amountPence)}</dd></div><div><dt>Reference</dt><dd><code>{offer.customerReference}</code></dd></div></dl>
                <form method="post" action={`/booking/manage/${token}/reservation/`}><input type="hidden" name="action" value="report-bank-transfer" /><input type="hidden" name="returnToPayment" value="yes" />
                  <label class="payment-check"><input type="checkbox" name="confirmTransfer" value="yes" required /><span>I confirm that I have sent this bank transfer.</span></label>
                  <button class="payment-primary" type="submit">Report bank transfer sent</button></form>
              </div> : <p class="payment-unavailable">Bank transfer details are temporarily unavailable. Please contact Olrig Bank through your booking messages.</p>}
          </article>}
        </div>
      </section>}
      {reported && <section class="payment-state" aria-labelledby="reported-heading"><h2 id="reported-heading">Bank transfer awaiting verification</h2><p>Olrig Bank will check for your payment. Your booking status will update after receipt is verified.</p></section>}
      {offer.bookingStatus === 'confirmed' && !balanceDue && <section class="payment-state"><h2>Reservation confirmed</h2><p>Your payment has been recorded. You can review the reservation and any remaining balance in your private booking area.</p></section>}
      {['cancelled', 'declined', 'expired'].includes(offer.bookingStatus) && <section class="payment-state"><h2>Payment is unavailable</h2><p>This offer is no longer active. Open the reservation for the current status and available next steps.</p></section>}
      {(offer.terms || terms) && <section class="payment-terms" aria-labelledby="terms-heading"><h2 id="terms-heading">Booking and cancellation terms</h2>
        {offer.terms && <p>{offer.terms}</p>}
        <p>{formatCancellationTerms(cancellationTerms)}</p>
        <details><summary>Show refund bands</summary><table><thead><tr><th>Cancellation timing</th><th>Refund of verified payments</th></tr></thead><tbody>
          <tr><td>30 days or more before arrival</td><td>{cancellationTerms.refundBands[0].refundPercentage}%</td></tr>
          <tr><td>14 to 29 days before arrival</td><td>{cancellationTerms.refundBands[1].refundPercentage}%</td></tr>
          <tr><td>Fewer than 14 days before arrival</td><td>{cancellationTerms.refundBands[2].refundPercentage}%</td></tr>
        </tbody></table></details>
      </section>}

    </div><aside class="payment-totals" aria-labelledby="reservation-summary-heading"><h2 id="reservation-summary-heading">Reservation summary</h2>
      <p class="payment-property">{propertyName}</p>
      <section class="payment-summary-section" aria-labelledby="stay-heading"><div class="payment-summary-heading"><h3 id="stay-heading">Your stay</h3>{journey && <a href={`/book/?booking=${token}&step=stay`} aria-label="Edit stay dates and guests">Edit</a>}</div>
        <dl class="payment-facts payment-stay-facts">
          <div><dt>Dates</dt><dd>{date(offer.arrival)} – {date(offer.departure)}</dd></div>
          <div><dt>Guests</dt><dd>{formatPartyComposition(offer, ', ')}</dd></div>
          <div><dt>Booking reference</dt><dd><code>{offer.customerReference}</code></dd></div>
        </dl>
      </section>
      <section class="payment-summary-section" aria-labelledby="contact-heading"><div class="payment-summary-heading"><h3 id="contact-heading">Your contact details</h3>{journey && <a href={`/book/?booking=${token}&step=details`} aria-label="Edit contact details">Edit</a>}</div>
        <p>{offer.guestName}</p>
        {offer.guestEmail && <p>{offer.guestEmail}</p>}
        {offer.guestTelephone && <p>{offer.guestTelephone}</p>}
        {!offer.guestEmail && !offer.guestTelephone && <p>Contact verified for this booking</p>}
      </section>
      {offer.priceAvailable && offer.lineItems.length > 0 && <details class="payment-price-breakdown payment-summary-section">
        <summary>Price breakdown</summary>
        <dl class="payment-facts">{offer.lineItems.map((line) => <div><dt>{line.label}{line.detail && <small>{line.detail}</small>}</dt><dd>{money(line.amountPence)}</dd></div>)}</dl>
      </details>}
      <section class="payment-summary-section" aria-labelledby="schedule-heading"><h3 id="schedule-heading">Payment schedule</h3>
      <dl class="payment-facts"><div><dt>{awaitingOffer ? 'Provisional total' : 'Booking total'}</dt><dd>{offer.priceAvailable ? money(offer.totalPence) : 'Price to be agreed'}</dd></div>
        {(due || offerReady) && <div><dt>{stageLabel}</dt><dd>{money(amountPence)}</dd></div>}
        {remainingAmount > 0 && !balanceDue && <div><dt>Remaining balance</dt><dd>{money(remainingAmount)}</dd></div>}
        {initialDue && offer.depositDueAt && <div><dt>Payment deadline</dt><dd>{date(offer.depositDueAt.slice(0, 10))}</dd></div>}
        {(previewTerms?.balanceDueOn || offer.balanceDueOn) && <div><dt>Balance deadline</dt><dd>{date((previewTerms?.balanceDueOn || offer.balanceDueOn)!)}</dd></div>}</dl>
      </section>
      {offer.requestJourneyRevision > 0 && !journey && !awaitingOffer && <p class="payment-change-help">To request changes to your stay or contact details, <a href={`/booking/manage/${token}/messages/`}>send a booking message</a>.</p>}
      {(verifiedDeposit || verifiedBalance || verifiedFull) && <a href={`/booking/manage/${token}/reservation/`}>View reservation details</a>}
    </aside></div>
  </div>
</BookerLayout>

<style>
  .payment-page { max-width:74rem; margin:0 auto; padding:clamp(1rem,3vw,2.5rem); color:#22342f; }
  .payment-progress ol { display:flex; gap:.5rem; list-style:none; padding:0; margin:0 0 2rem; flex-wrap:wrap; color:#5b6862; }
  .payment-progress li+li::before { content:'›'; margin-right:.5rem; color:#83918a; }
  .payment-progress [aria-current] { font-weight:700; color:#173d32; border-bottom:3px solid #b98648; }
  .payment-heading h1 { font-size:clamp(2rem,4vw,3.3rem); margin:.2rem 0; }
  .payment-heading p:last-child { color:#59665d; margin-top:.25rem; }
  .payment-layout { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(18rem,1fr); gap:1.5rem; align-items:start; }
  .payment-main { display:grid; gap:1.5rem; min-width:0; }
  .payment-panel,.payment-totals { background:#fffdf8; border:1px solid #d9dfd5; border-radius:1rem; padding:clamp(1.1rem,2vw,1.7rem); box-shadow:0 7px 28px #173d320b; overflow-wrap:anywhere; }
  .payment-panel h2,.payment-totals h2 { font-size:1.35rem; margin:0 0 1rem; }
  .payment-panel p { margin:.4rem 0 1rem; }
  .payment-facts { margin:0; display:grid; gap:.75rem; }
  .payment-facts div { display:flex; justify-content:space-between; gap:1rem; border-bottom:1px solid #e4e8df; padding-bottom:.65rem; }
  .payment-facts div:last-child { border:0; padding-bottom:0; }
  .payment-facts dt { color:#59665d; }
  .payment-facts dd { margin:0; text-align:right; font-weight:650; overflow-wrap:anywhere; }
  .payment-facts small { display:block; margin-top:.25rem; }
  .payment-facts code { font:inherit; letter-spacing:.04em; }
  .payment-methods { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; margin:1.25rem 0; }
  .payment-methods a { display:flex; align-items:center; gap:.6rem; padding:1rem; min-height:3.5rem; border:1px solid #aabbb0; border-radius:.55rem; color:#204d3d; text-decoration:none; font-weight:700; }
  .payment-methods a[aria-current] { border:2px solid #204d3d; padding:calc(1rem - 1px); background:#edf3ed; }
  .payment-methods a:hover { background:#edf3ed; }
  .payment-method { min-width:0; }
  .payment-primary,.payment-secondary { display:inline-block; appearance:none; border:1px solid #204d3d; border-radius:.55rem; padding:.8rem 1rem; text-decoration:none; font:inherit; font-weight:700; cursor:pointer; }
  .payment-primary { background:#204d3d; color:#fff; }
  .payment-secondary { background:#fffdf8; color:#204d3d; }
  .payment-primary:hover { background:#123a2b; }
  .payment-page :is(a,button,input,summary):focus-visible { outline:3px solid #b98648; outline-offset:3px; }
  .payment-check input:focus { outline:3px solid #b98648; outline-offset:3px; }
  .payment-bank { border-top:1px solid #d9dfd5; padding-top:1rem; }
  .payment-bank .payment-facts { margin-bottom:1.2rem; }
  .payment-check { display:flex; gap:.7rem; align-items:start; margin:1rem 0; }
  .payment-check input { width:1.2rem; height:1.2rem; flex:none; accent-color:#204d3d; }
  .payment-alert { padding:1rem; background:#fff1df; border:1px solid #d49f55; border-radius:.5rem; }
  .payment-unavailable { color:#6a4f34; }
  .payment-terms { border-top:1px solid #d9dfd5; padding-top:1.5rem; }
  .payment-terms details { margin-top:1rem; }
  .payment-page summary { cursor:pointer; font-weight:700; }
  .payment-terms table { width:100%; margin-top:.8rem; border-collapse:collapse; }
  .payment-terms th,.payment-terms td { padding:.65rem .5rem; border-bottom:1px solid #d9dfd5; text-align:left; vertical-align:top; }
  .payment-totals { min-width:0; }
  .payment-property { font-weight:700; }
  .payment-summary-section { margin-top:1.2rem; padding-top:1.2rem; border-top:1px solid #d9dfd5; }
  .payment-progress a { color:inherit; }
  .payment-summary-heading { display:flex; justify-content:space-between; align-items:baseline; gap:.75rem; }
  .payment-summary-heading a { margin:0; padding:.35rem .5rem; }
  .payment-summary-section h3 { font-size:1rem; margin:0 0 .8rem; }
  .payment-summary-section p { margin:.3rem 0; }
  .payment-stay-facts div { display:block; border:0; }
  .payment-stay-facts dd { text-align:left; margin-top:.25rem; }
  .payment-price-breakdown .payment-facts { margin-top:1rem; }
  .payment-totals a { display:inline-block; margin-top:1.2rem; color:#204d3d; font-weight:700; }
  .payment-change-help a { display:inline; margin:0; }
  .payment-mobile-bar { display:none; }
  @media(max-width:800px) {
    .payment-layout { grid-template-columns:1fr; }
  }
  @media(max-width:480px) {
    #methods-heading,#terms-heading,#reservation-summary-heading,.payment-page :is(a,button,input,summary) { scroll-margin-top:8rem; }
    .payment-page { padding:1rem; }
    .payment-progress { font-size:.9rem; }
    .payment-panel,.payment-totals { padding:1rem; }
    .payment-methods a { padding:.8rem .6rem; font-size:.9rem; gap:.4rem; }
    .payment-methods a[aria-current] { padding:calc(.8rem - 1px) calc(.6rem - 1px); }
    .payment-primary,.payment-secondary { width:100%; text-align:center; }
    .payment-mobile-bar { position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:1rem; justify-content:space-between; background:#fffdf8; border:1px solid #cad7ce; border-radius:.55rem; box-shadow:0 5px 25px #173d3220; padding:.7rem 1rem; margin:0 0 1rem; }
    .payment-mobile-bar div { display:grid; }
    .payment-mobile-bar small { color:#59665d; }
    .payment-mobile-bar strong { font-size:1.2rem; }
    .payment-mobile-bar a { background:#204d3d; color:#fff; padding:.75rem; border-radius:.55rem; text-align:center; text-decoration:none; font-weight:700; }
  }
</style>
