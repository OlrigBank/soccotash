---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalGuideTree from '../../components/LocalGuideTree.astro';
import { getLocalGuideEntries } from '../../lib/content';
import { buildLocalGuideTree } from '../../lib/local-guide/tree.ts';
import { categoriesAsNavigation,listPublishedLocalGuideCategories } from '../../lib/local-guide/workspace.ts';
import { listPublishedExamplePlans } from '../../lib/planner/repository.ts';

const [entries,categories] = await Promise.all([getLocalGuideEntries(),listPublishedLocalGuideCategories()]);
const examplePlans = await listPublishedExamplePlans();
Astro.response.headers.set('Cache-Control', 'no-store');
const tree = buildLocalGuideTree(categoriesAsNavigation(categories), entries);

---

<BaseLayout title="Local Guide" description="Local recommendations near Olrig Bank and Kendal.">
  <section class="hero">
    <h1>Local guide</h1>
    <p>Ideas for eating out, walks, activities, events and days out from Olrig Bank.</p>
  </section>

  <section class="section-block local-guide-browser" aria-labelledby="local-guide-browser-heading">
    <div class="section-heading"><h2 id="local-guide-browser-heading">Browse the guide</h2><p>Open any folders that interest you. They stay open until you close them.</p></div>
    {tree.length > 0 ? <LocalGuideTree nodes={tree} /> : <div class="prose"><p>No recommendations are currently published.</p></div>}
  </section>

  {examplePlans.length > 0 && <section class="section-block" aria-labelledby="example-plans-heading">
    <div class="section-heading"><h2 id="example-plans-heading">Example holiday plans</h2><p>Ready-made ideas for exploring Kendal and the Lakes.</p></div>
    <div class="grid">{examplePlans.map((plan) => <article class="card"><a class="card-link" href={`/holiday-plans/${plan.publicSlug}/`}><div class="card-content"><h3>{plan.title}</h3><p>{plan.description}</p><p class="category-count">{plan.dayCount} {plan.dayCount === 1 ? 'day' : 'days'}</p></div></a></article>)}</div>
  </section>}

  <section class="prose" style="margin-top: 1.5rem;">
    <h2>Stay close to these places</h2>
    <p>Use the guide while planning a stay at <a href="/listings/main-house/">Olrig Bank in Kendal</a>, <a href="/listings/event/">Olrig Bank Max for a larger group</a> or <a href="/listings/cottage/">The Cottage at Olrig Bank</a>.</p>
  </section>

</BaseLayout>
