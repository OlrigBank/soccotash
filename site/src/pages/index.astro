---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactBookingPanel from '../components/CompactBookingPanel.astro';
import HomeGallery from '../components/HomeGallery.astro';
import PublicReviewCarousel from '../components/PublicReviewCarousel.astro';
import publicReviewData from '../data/public-reviews.json';
import publicReviewSummaryData from '../data/public-review-summary.json';
import { validatePublicReviewData, validatePublicReviewSummary } from '../lib/public-reviews';
import { formatBaseNightlyPrice, getPublishedBaseNightlyPrices } from '../lib/pricing/public-base-prices';

const page = await getEntry('pages', 'home');
const publicReviews = validatePublicReviewData(publicReviewData).reviews;
const publicReviewSummary = validatePublicReviewSummary(publicReviewSummaryData);
const comparedPropertyIds = ['main-house', 'whole-property', 'cottage'];
const baseNightlyPrices = await getPublishedBaseNightlyPrices(comparedPropertyIds).catch(() =>
  Object.fromEntries(comparedPropertyIds.map((propertyId) => [propertyId, null])),
);
---

<BaseLayout
  title={page?.data.title ?? 'Olrig Bank'}
  description={page?.data.description}
  socialImage="/media/images/listings/house.jpeg"
  socialImageAlt="The stone front of Olrig Bank in Kendal"
>
  <section class="home-hero">
    <img
      src="/media/images/listings/house.jpeg"
      alt="The stone front of Olrig Bank beneath a blue sky, viewed from Little Aynam"
      width="1440"
      height="1085"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__content">
      <h1>{page?.data.heroTitle ?? page?.data.title ?? 'Olrig Bank'}</h1>
      {page?.data.heroText ? <p>{page.data.heroText}</p> : null}
      <CompactBookingPanel
        source="homepage"
        heading=""
        idPrefix="homepage-hero-booking"
        submitLabel="Quick Check"
        autoSelectProperty={true}
      />
    </div>
  </section>

  <section id="ways-to-stay" class="ways-to-stay">
    <h2>Choosing your stay</h2>
    {page?.data.waysToStayIntro ? <p class="ways-to-stay__intro">{page.data.waysToStayIntro}</p> : null}
    {page?.data.waysToStayGroupFit ? <p class="ways-to-stay__group-fit">{page.data.waysToStayGroupFit}</p> : null}
    <div
      class="ways-to-stay__table-scroll"
      role="region"
      aria-label="Comparison of ways to stay at Olrig Bank"
      tabindex="0"
    >
      <table>
        <caption>Swipe sideways to compare all stays.</caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col"><a href="/listings/olrig-bank/">Olrig Bank</a></th>
            <th scope="col"><a href="/listings/event/">Olrig Bank++</a></th>
            <th scope="col"><a href="/listings/cottage/">Cottage at Olrig Bank</a></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Maximum guests</th>
            <td>8</td>
            <td>12</td>
            <td>4</td>
          </tr>
          <tr>
            <th scope="row">Bedrooms</th>
            <td>4</td>
            <td>6</td>
            <td>2</td>
          </tr>
          <tr>
            <th scope="row">Bathrooms</th>
            <td>2</td>
            <td>3</td>
            <td>1</td>
          </tr>
          <tr>
            <th scope="row">Base price per night</th>
            <td>{formatBaseNightlyPrice(baseNightlyPrices['main-house'])}</td>
            <td>{formatBaseNightlyPrice(baseNightlyPrices['whole-property'])}</td>
            <td>{formatBaseNightlyPrice(baseNightlyPrices.cottage)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="ways-to-stay__help">
      If none of these three options is quite right for you, use{' '}
      <a href="/listings/bespoke/">Olrig Bank Bespoke</a> to request an arrangement beyond our standard stays, or{' '}
      <a href="/contact/">ask Jenna to help you choose</a>.
    </p>
  </section>

  <HomeGallery />

  <section class="local-guide-panel" aria-labelledby="local-guide-heading">
    <img
      src="/media/images/local-guide/kendalcastle.png"
      alt="The ruins of Kendal Castle overlooking the town"
      width="1320"
      height="879"
      loading="lazy"
    />
    <div class="local-guide-panel__content">
      <p class="local-guide-panel__eyebrow">Plan your stay</p>
      <h2 id="local-guide-heading">Our local guide</h2>
      <p>
        Make more of every day in Kendal with a guide curated by people who know it well. We have gathered
        favourite walks, independent places to eat and drink, family days out and worthwhile trips further
        afield, so you can spend less time searching and more time enjoying your stay.
      </p>
      <p>Kendal Castle is just one of our hand-picked ideas—and an easy adventure from Olrig Bank.</p>
      <a class="button" href="/local-guide/">Explore the local guide <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <PublicReviewCarousel reviews={publicReviews} summary={publicReviewSummary} />
</BaseLayout>

<style>
  .home-hero {
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--accent-dark);
    box-shadow: var(--shadow);
  }

  .ways-to-stay {
    margin-top: 1.5rem;
    scroll-margin-top: 6rem;
  }

  .ways-to-stay > h2 {
    margin-bottom: 0.8rem;
  }

  .ways-to-stay :is(.ways-to-stay__intro, .ways-to-stay__group-fit) {
    max-width: 68ch;
    margin: 0;
    color: var(--muted);
  }

  .ways-to-stay__table-scroll {
    overflow-x: auto;
    margin-top: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--panel-bg);
    box-shadow: var(--shadow);
    overscroll-behavior-inline: contain;
    scrollbar-gutter: stable;
  }

  .ways-to-stay__table-scroll:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .ways-to-stay table {
    width: 100%;
    min-width: 44rem;
    border-collapse: separate;
    border-spacing: 0;
  }

  .ways-to-stay caption {
    padding: 0.8rem 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: left;
  }

  .ways-to-stay :is(th, td) {
    min-width: 9.5rem;
    padding: 0.9rem 1rem;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .ways-to-stay thead th {
    background: color-mix(in srgb, var(--panel-bg) 86%, var(--accent) 14%);
    color: var(--ink);
  }

  .ways-to-stay :is(thead th:first-child, tbody th) {
    position: sticky;
    z-index: 1;
    left: 0;
    min-width: 8.5rem;
    background: var(--panel-bg);
    box-shadow: 1px 0 0 var(--line);
  }

  .ways-to-stay thead th:first-child {
    z-index: 2;
    background: color-mix(in srgb, var(--panel-bg) 86%, var(--accent) 14%);
  }

  .ways-to-stay__help {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .local-guide-panel {
    display: grid;
    overflow: hidden;
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--panel-bg);
    box-shadow: var(--shadow);
  }

  .local-guide-panel > img {
    width: 100%;
    height: 100%;
    min-height: 15rem;
    border-radius: 0;
    object-fit: cover;
  }

  .local-guide-panel__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .local-guide-panel__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .local-guide-panel h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    line-height: 1.08;
  }

  .local-guide-panel__content > p:not(.local-guide-panel__eyebrow) {
    max-width: 54ch;
    margin: 0.85rem 0 0;
    color: var(--muted);
  }

  .local-guide-panel .button {
    align-self: flex-start;
    margin-top: 1.2rem;
  }

  .home-hero > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    object-fit: cover;
    object-position: center 46%;
  }

  .home-hero__content {
    padding: clamp(1.25rem, 6vw, 2rem);
    color: #fff;
  }

  .home-hero__content :global(.compact-booking-panel) {
    width: 100%;
    margin-top: 1.25rem;
    color: var(--ink);
    text-align: left;
  }

  .home-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2.15rem, 10vw, 4.5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1rem, 3vw, 1.16rem);
  }

  @media (min-width: 700px) {
    .local-guide-panel {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }

    .home-hero {
      position: relative;
      min-height: clamp(28rem, 54vw, 37rem);
    }

    .home-hero::after {
      position: absolute;
      inset: 0;
      content: '';
      background: linear-gradient(
        90deg,
        rgba(19, 35, 27, 0.82) 0%,
        rgba(19, 35, 27, 0.72) 62%,
        rgba(19, 35, 27, 0.25) 80%,
        transparent 100%
      );
      pointer-events: none;
    }

    .home-hero > img {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .home-hero__content {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: inherit;
      width: 100%;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(2rem, 5vw, 4rem);
    }

    .home-hero p {
      max-width: 42ch;
    }
  }

</style>
