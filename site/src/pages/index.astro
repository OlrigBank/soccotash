---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactBookingPanel from '../components/CompactBookingPanel.astro';
import HomeGallery from '../components/HomeGallery.astro';
import PublicReviewCarousel from '../components/PublicReviewCarousel.astro';
import publicReviewData from '../data/public-reviews.json';
import publicReviewSummaryData from '../data/public-review-summary.json';
import { validatePublicReviewData, validatePublicReviewSummary } from '../lib/public-reviews';
import { formatBaseNightlyPrice, getPublishedBaseNightlyPrices } from '../lib/pricing/public-base-prices';

const page = await getEntry('pages', 'home');
const publicReviews = validatePublicReviewData(publicReviewData).reviews;
const publicReviewSummary = validatePublicReviewSummary(publicReviewSummaryData);
const comparedPropertyIds = ['main-house', 'whole-property', 'cottage'];
const baseNightlyPrices = await getPublishedBaseNightlyPrices(comparedPropertyIds).catch(() =>
  Object.fromEntries(comparedPropertyIds.map((propertyId) => [propertyId, null])),
);
---

<BaseLayout
  title={page?.data.title ?? 'Olrig Bank'}
  description={page?.data.description}
  socialImage="/media/images/listings/house.jpeg"
  socialImageAlt="The stone front of Olrig Bank in Kendal"
>
  <section class="home-hero">
    <img
      src="/media/images/listings/house.jpeg"
      alt="The stone front of Olrig Bank beneath a blue sky, viewed from Little Aynam"
      width="1440"
      height="1085"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__content">
      <h1>{page?.data.heroTitle ?? page?.data.title ?? 'Olrig Bank'}</h1>
      {page?.data.heroFacts ? <p class="home-hero__facts">{page.data.heroFacts}</p> : null}
      {page?.data.heroText ? <p>{page.data.heroText}</p> : null}
      <CompactBookingPanel
        source="homepage"
        heading=""
        idPrefix="homepage-hero-booking"
        submitLabel="Quick Check"
        autoSelectProperty={true}
      />
    </div>
  </section>

  <section id="ways-to-stay" class="ways-to-stay">
    <h2>Choosing your stay</h2>
    {page?.data.waysToStayIntro ? <p class="ways-to-stay__intro">{page.data.waysToStayIntro}</p> : null}
    {page?.data.waysToStayGroupFit ? <p class="ways-to-stay__group-fit">{page.data.waysToStayGroupFit}</p> : null}
    <div
      class="ways-to-stay__table-scroll"
      role="region"
      aria-label="Comparison of ways to stay at Olrig Bank"
      tabindex="0"
    >
      <table>
        <caption>Compare stays at Olrig Bank</caption>
        <thead>
          <tr>
            <th scope="col">Stay</th>
            <th scope="col">
              <span class="ways-to-stay__column-heading">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>Guests</span>
              </span>
            </th>
            <th scope="col">
              <span class="ways-to-stay__column-heading">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M2 4v16M22 20V8M2 16h20M6 8h4a2 2 0 0 1 2 2v6H4v-6a2 2 0 0 1 2-2ZM12 11h7a3 3 0 0 1 3 3v2H12Z" />
                </svg>
                <span>Bedrooms</span>
              </span>
            </th>
            <th scope="col">
              <span class="ways-to-stay__column-heading">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M4 12h16v4a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-4ZM6 12V5a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2" />
                  <path d="M8 20v2M16 20v2" />
                </svg>
                <span>Bathrooms</span>
              </span>
            </th>
            <th scope="col">
              <span class="ways-to-stay__column-heading">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M18 7c0-2.21-1.79-4-4-4s-4 1.79-4 4v10a4 4 0 0 1-4 4h12M6 11h9" />
                </svg>
                <span>Price/night</span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><a href="/listings/olrig-bank/">Olrig Bank</a></th>
            <td>8</td>
            <td>4</td>
            <td>2</td>
            <td>{formatBaseNightlyPrice(baseNightlyPrices['main-house'])}</td>
          </tr>
          <tr>
            <th scope="row"><a href="/listings/event/">Olrig Bank++</a></th>
            <td>12</td>
            <td>6</td>
            <td>3</td>
            <td>{formatBaseNightlyPrice(baseNightlyPrices['whole-property'])}</td>
          </tr>
          <tr>
            <th scope="row"><a href="/listings/cottage/">Cottage at Olrig Bank</a></th>
            <td>4</td>
            <td>2</td>
            <td>1</td>
            <td>{formatBaseNightlyPrice(baseNightlyPrices.cottage)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="ways-to-stay__help">
      If none of these three options is quite right for you, use{' '}
      <a href="/listings/bespoke/">Olrig Bank Bespoke</a> to request an arrangement beyond our standard stays, or{' '}
      <a href="/contact/">ask Jenna to help you choose</a>.
    </p>
  </section>

  <HomeGallery />

  <PublicReviewCarousel reviews={publicReviews} summary={publicReviewSummary} />

  <section class="local-guide-panel" aria-labelledby="local-guide-heading">
    <img
      src="/media/images/local-guide/kendalcastle.png"
      alt="The ruins of Kendal Castle overlooking the town"
      width="1320"
      height="879"
      loading="lazy"
    />
    <div class="local-guide-panel__content">
      <p class="local-guide-panel__eyebrow">Plan your stay</p>
      <h2 id="local-guide-heading">Our local guide</h2>
      <p>
        Make more of every day in Kendal with a guide curated by people who know it well. We have gathered
        favourite walks, independent places to eat and drink, family days out and worthwhile trips further
        afield, so you can spend less time searching and more time enjoying your stay.
      </p>
      <p>Kendal Castle is just one of our hand-picked ideas—and an easy adventure from Olrig Bank.</p>
      <a class="button" href="/local-guide/">Explore the local guide <span aria-hidden="true">→</span></a>
    </div>
  </section>

</BaseLayout>

<style>
  .home-hero {
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--accent-dark);
    box-shadow: var(--shadow);
  }

  .ways-to-stay {
    margin-top: 1.5rem;
    scroll-margin-top: 6rem;
  }

  .ways-to-stay > h2 {
    margin-bottom: 0.8rem;
  }

  .ways-to-stay :is(.ways-to-stay__intro, .ways-to-stay__group-fit) {
    max-width: 68ch;
    margin: 0;
    color: var(--muted);
  }

  .ways-to-stay__table-scroll {
    overflow-x: auto;
    margin-top: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--panel-bg);
    box-shadow: var(--shadow);
    overscroll-behavior-inline: contain;
    scrollbar-gutter: stable;
  }

  .ways-to-stay__table-scroll:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .ways-to-stay table {
    width: 100%;
    min-width: 36rem;
    border-collapse: separate;
    border-spacing: 0;
  }

  .ways-to-stay caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ways-to-stay :is(th, td) {
    min-width: 5.75rem;
    padding: 0.75rem 0.65rem;
    border-top: 1px solid var(--line);
    text-align: center;
    vertical-align: middle;
  }

  .ways-to-stay thead th {
    background: color-mix(in srgb, var(--panel-bg) 86%, var(--accent) 14%);
    color: var(--ink);
  }

  .ways-to-stay :is(thead th:first-child, tbody th) {
    position: sticky;
    z-index: 1;
    left: 0;
    width: 11rem;
    min-width: 11rem;
    background: var(--panel-bg);
    box-shadow: 1px 0 0 var(--line);
    text-align: left;
  }

  .ways-to-stay thead th:first-child {
    z-index: 2;
    background: color-mix(in srgb, var(--panel-bg) 86%, var(--accent) 14%);
  }

  .ways-to-stay__column-heading {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    white-space: nowrap;
    font-size: 0.78rem;
  }

  .ways-to-stay__column-heading svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ways-to-stay__help {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .local-guide-panel {
    display: grid;
    overflow: hidden;
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--panel-bg);
    box-shadow: var(--shadow);
  }

  .local-guide-panel > img {
    width: 100%;
    height: 100%;
    min-height: 15rem;
    border-radius: 0;
    object-fit: cover;
  }

  .local-guide-panel__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .local-guide-panel__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .local-guide-panel h2 {
    margin: 0;
    font-size: clamp(1.8rem, 5vw, 2.75rem);
    line-height: 1.08;
  }

  .local-guide-panel__content > p:not(.local-guide-panel__eyebrow) {
    max-width: 54ch;
    margin: 0.85rem 0 0;
    color: var(--muted);
  }

  .local-guide-panel .button {
    align-self: flex-start;
    margin-top: 1.2rem;
  }

  .home-hero > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    object-fit: cover;
    object-position: center 46%;
  }

  .home-hero__content {
    padding: clamp(1.25rem, 6vw, 2rem);
    color: #fff;
  }

  .home-hero__content :global(.compact-booking-panel) {
    width: 100%;
    margin-top: 1.25rem;
    color: var(--ink);
    text-align: left;
  }

  @media (max-width: 699px) {
    .home-hero__content :global(.compact-booking-panel) {
      display: none;
    }
  }

  .home-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2.15rem, 10vw, 4.5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1rem, 3vw, 1.16rem);
  }

  .home-hero .home-hero__facts {
    max-width: none;
    font-size: clamp(0.84rem, 2.2vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  @media (min-width: 700px) {
    .local-guide-panel {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }

    .home-hero {
      position: relative;
      min-height: clamp(28rem, 54vw, 37rem);
    }

    .home-hero::after {
      position: absolute;
      inset: 0;
      content: '';
      background: linear-gradient(
        90deg,
        rgba(19, 35, 27, 0.82) 0%,
        rgba(19, 35, 27, 0.72) 62%,
        rgba(19, 35, 27, 0.25) 80%,
        transparent 100%
      );
      pointer-events: none;
    }

    .home-hero > img {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .home-hero__content {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: inherit;
      width: 100%;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(2rem, 5vw, 4rem);
    }

    .home-hero p {
      max-width: 42ch;
    }
  }

</style>
