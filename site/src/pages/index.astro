---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferingCard from '../components/OfferingCard.astro';
import ListingCard from '../components/ListingCard.astro';
import CompactBookingPanel from '../components/CompactBookingPanel.astro';
import { getFeaturedLocalGuideEntries } from '../lib/content';

const page = await getEntry('pages', 'home');
const { Content } = page ? await render(page) : { Content: undefined };
const featuredGuide = await getFeaturedLocalGuideEntries(6);
const listingOrder = ['olrig-bank', 'cottage', 'event', 'bespoke'];
const listings = (await getCollection('listings')).sort((a, b) => {
  const aPosition = listingOrder.indexOf(a.data.slug || a.id);
  const bPosition = listingOrder.indexOf(b.data.slug || b.id);
  return (aPosition === -1 ? listingOrder.length : aPosition) -
    (bPosition === -1 ? listingOrder.length : bPosition);
});
---

<BaseLayout
  title={page?.data.title ?? 'Olrig Bank'}
  description={page?.data.description}
  socialImage="/media/images/spaces/house/View of front of house-no-cyclists-hero.jpg"
  socialImageAlt="The stone front of Olrig Bank in Kendal"
>
  <section class="home-hero">
    <img
      src="/media/images/spaces/house/View of front of house-no-cyclists-hero.jpg"
      alt="The stone front of Olrig Bank in Kendal, viewed across the road"
      width="1448"
      height="814"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__content">
      <h1>{page?.data.heroTitle ?? page?.data.title ?? 'Olrig Bank'}</h1>
      {page?.data.heroText ? <p>{page.data.heroText}</p> : null}
    </div>
  </section>

  <CompactBookingPanel source="homepage" />

  <section id="ways-to-stay" class="ways-to-stay">
    <h2>Ways to stay</h2>
    {Content ? <div class="ways-to-stay__intro"><Content /></div> : null}
    <div class="grid places-grid">
      {listings.map((entry) => <ListingCard entry={entry} />)}
    </div>
  </section>

  <section style="margin-top: 1.5rem;">
    <h2>Featured local guide</h2>
    <div class="grid">
      {featuredGuide.map((entry) => <OfferingCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: var(--accent-dark);
    box-shadow: var(--shadow);
  }

  .ways-to-stay {
    margin-top: 1.5rem;
    scroll-margin-top: 6rem;
  }

  .ways-to-stay > h2 {
    margin-bottom: 0.4rem;
  }

  .ways-to-stay__intro {
    max-width: 68ch;
    margin-bottom: 1.25rem;
    color: var(--muted);
  }

  .ways-to-stay__intro :global(p) {
    margin: 0;
  }

  .ways-to-stay__intro :global(p + p) {
    margin-top: 0.35rem;
  }

  .home-hero > img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0;
    object-fit: cover;
  }

  .home-hero__content {
    padding: clamp(1.25rem, 6vw, 2rem);
    color: #fff;
  }

  .home-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2.15rem, 10vw, 4.5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero p {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1rem, 3vw, 1.16rem);
  }

  @media (min-width: 700px) {
    .home-hero {
      position: relative;
      min-height: clamp(28rem, 54vw, 37rem);
    }

    .home-hero::after {
      position: absolute;
      inset: 0;
      content: '';
      background: linear-gradient(
        90deg,
        rgba(19, 35, 27, 0.82) 0%,
        rgba(19, 35, 27, 0.72) 62%,
        rgba(19, 35, 27, 0.25) 80%,
        transparent 100%
      );
      pointer-events: none;
    }

    .home-hero > img {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .home-hero__content {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: inherit;
      max-width: 38rem;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(2rem, 5vw, 4rem);
    }

    .home-hero p {
      max-width: 38ch;
    }
  }

</style>
