---
import BookerLayout from '../../../../../layouts/BookerLayout.astro';
import PlannerItinerary from '../../../../../components/PlannerItinerary.astro';
import { resolveParticipantCredential } from '../../../../../lib/planner/participant-access.ts';
import { getHolidayPlan } from '../../../../../lib/planner/repository.ts';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Referrer-Policy','no-referrer');Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');
const token=String(Astro.params.token||'');const access=await resolveParticipantCredential(token,true);if(!access)return new Response('Holiday plan not found.',{status:404});const plan=await getHolidayPlan(access.planId);if(!plan)return new Response('Holiday plan not found.',{status:404});
---
<BookerLayout title={`${plan.title} · Print`} description="Private printable holiday itinerary." robots="noindex,nofollow,noarchive" analytics={false} homeHref={`/planner/invite/${token}/`} homeLabel="Back to planner" areaLabel="Private planning area" areaTitle="Holiday Planner" footerLabel="Private planning service"><div class="private-planner-page private-planner-print"><p class="no-print"><a class="button button--secondary" href={`/planner/invite/${token}/`}>Back to planner</a></p><PlannerItinerary plan={plan} includePrivateItems={true} includeReservationNotes={true}/></div></BookerLayout>
