---
import BookerLayout from '../../../../../layouts/BookerLayout.astro';import AiProposalReview from '../../../../../components/AiProposalReview.astro';import {resolveParticipantCredential} from '../../../../../lib/planner/participant-access.ts';import {getHolidayPlan} from '../../../../../lib/planner/repository.ts';import {compareAiProposal,getAiProposal} from '../../../../../lib/planner/ai-proposals.ts';
export const prerender=false;Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Referrer-Policy','no-referrer');Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');const token=String(Astro.params.token||'');const access=await resolveParticipantCredential(token,true);if(!access||access.role!=='editor')return new Response('Proposal not found.',{status:404});const plan=await getHolidayPlan(access.planId);const proposal=plan?await getAiProposal(plan.id,String(Astro.params.proposalId||'')):null;if(!plan||!proposal)return new Response('Proposal not found.',{status:404});const diff=compareAiProposal(plan,proposal);
---
<BookerLayout title={`Review · ${proposal.summary}`} robots="noindex,nofollow,noarchive" analytics={false} homeHref={`/planner/invite/${token}/`} homeLabel="Back to planner" areaLabel="Private planning area" areaTitle="Proposal review" footerLabel="Private planning service"><div class="private-planner-page"><a class="button button--secondary" href={`/planner/invite/${token}/`}>Back to planner</a><AiProposalReview record={proposal} diff={diff} endpoint={`/api/planner/participant/${token}/`} currentRevision={plan.revision}/></div></BookerLayout>
