---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { resolveParticipantCredential } from '../../../lib/planner/participant-access.ts';
import { getHolidayPlan, listGuideContributions } from '../../../lib/planner/repository.ts';
import { getPlannerGuideEntries } from '../../../lib/planner/local-guide.ts';
export const prerender=false;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow, noarchive');
const token=String(Astro.params.token||'');
const access=await resolveParticipantCredential(token,true);
if(!access)return new Response('Holiday plan not found.',{status:404});
const plan=await getHolidayPlan(access.planId);
if(!plan)return new Response('Holiday plan not found.',{status:404});
const contributions=await listGuideContributions(plan.id);
const ownItemIds=new Set(plan.revisions.filter(entry=>entry.participantId===access.participantId&&entry.action==='item_added').map(entry=>String(entry.changes.itemId??'')));
const activeContributionItemIds=new Set(contributions.filter(entry=>['pending','under_review','accepted'].includes(entry.status)).map(entry=>entry.itemId));
const contributableItems=plan.days.flatMap(day=>day.items).filter(item=>ownItemIds.has(item.id)&&!item.localGuideSlug&&!activeContributionItemIds.has(item.id));
const ownCandidateIds=new Set(plan.revisions.filter(entry=>entry.participantId===access.participantId&&entry.action==='guide_contribution_offered').map(entry=>String(entry.changes.candidateId??'')));
const guides=await getPlannerGuideEntries();
const canEdit=access.role==='editor';
const canPropose=access.role==='contributor';
const statuses=['idea','proposed','agreed','booked','completed','cancelled'];
const activityTime=(value:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/London'}).format(new Date(value));
---
<BaseLayout title={plan.title} description="A private shared Olrig Bank Holiday Planner." showSidebar={false} robots="noindex,nofollow,noarchive">
  <header class="hero booking-planner-hero"><p class="eyebrow">Shared Holiday Planner · {access.role}</p><h1>{plan.title}</h1><p>Welcome, {access.displayName}. {plan.startsOn} to {plan.endsOn} · revision <strong data-revision>{plan.revision}</strong></p></header>
  <div id="planner-message" class="pricing-message" role="status" aria-live="polite" hidden></div>
  <div class="pricing-message is-error" data-planner-conflict role="alert" hidden><p>This plan changed while you were editing. Your save was not applied.</p><p data-conflict-revision></p><button type="button" class="button button--secondary" data-reload-plan>Reload latest plan</button></div>
  <section class="booking-panel"><h2>Plan details</h2>{canEdit?<form id="plan-form" class="planner-form"><label>Title<input name="title" value={plan.title} required minlength="3" maxlength="160"/></label><label>Summary<textarea name="description" maxlength="5000">{plan.description}</textarea></label><button class="button" type="submit">Save plan</button></form>:<p>{plan.description||'No plan summary yet.'}</p>}</section>
  <section class="planner-days"><h2>Days</h2>{plan.days.map((day,index)=><article class="booking-panel planner-day" data-day-id={day.id}><div class="planner-day-heading"><h3>Day {index+1}: {day.title}</h3>{canEdit&&<div class="planner-move-controls"><button type="button" data-day-move="up" disabled={index===0}>↑</button><button type="button" data-day-move="down" disabled={index===plan.days.length-1}>↓</button></div>}</div>{canEdit?<form class="planner-form day-form"><label>Title<input name="title" value={day.title} required/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} value={day.date??''} required/></label><label>Summary<textarea name="summary">{day.summary}</textarea></label><button class="button" type="submit">Save day</button><button type="button" class="button button--secondary" data-remove-day>Remove day</button></form>:<p>{day.date} · {day.summary}</p>}<div class="planner-items">{day.items.map((item,itemIndex)=><article class="planner-item" data-item-id={item.id}><h4>{item.title} · {item.status}</h4>{item.localGuideSlug&&<p><a href={`/local-guide/${item.localGuideSlug}/`} target="_blank">Open Local Guide reference</a></p>}{canEdit?<form class="planner-form item-form"><label>Title<input name="title" value={item.title} required/></label><label>Type<select name="itemType">{['activity','journey','meal','reservation','free_time','other'].map(value=><option value={value} selected={value===item.itemType}>{value}</option>)}</select></label><label>Starts<input name="startTime" type="time" value={item.startTime??''}/></label><label>Ends<input name="endTime" type="time" value={item.endTime??''}/></label><label>Location<input name="locationText" value={item.locationText??''}/></label><label>Status<select name="status">{statuses.map(value=><option value={value} selected={value===item.status}>{value}</option>)}</select></label><label>Plan note<textarea name="description">{item.description}</textarea></label><label>Reservation note<textarea name="reservationNote">{item.reservationNote??''}</textarea></label><button class="button" type="submit">Save item</button><button type="button" data-item-move="up" disabled={itemIndex===0}>↑</button><button type="button" data-item-move="down" disabled={itemIndex===day.items.length-1}>↓</button><button type="button" class="button button--secondary" data-remove-item>Remove item</button></form>:<><p>{item.description}</p>{item.reservationNote&&<p><strong>Reservation note:</strong> {item.reservationNote}</p>}</>}</article>)}{(canEdit||canPropose)&&<details><summary>{canPropose?'Propose an activity':'Add an item'}</summary><form class="planner-form add-item-form"><label>Title<input name="title" required/></label><label>Type<select name="itemType"><option value="activity">activity</option><option value="journey">journey</option><option value="meal">meal</option><option value="reservation">reservation</option><option value="free_time">free time</option><option value="other">other</option></select></label><label>Local Guide<select name="localGuideSlug"><option value="">Custom item</option>{guides.map(guide=><option value={guide.slug}>{guide.title}</option>)}</select></label><label>Starts<input name="startTime" type="time"/></label><label>Ends<input name="endTime" type="time"/></label><label>Location<input name="locationText"/></label><label>Plan note<textarea name="description"></textarea></label><button class="button" type="submit">{canPropose?'Propose activity':'Add item'}</button></form></details>}</div></article>)}</section>
  {canEdit&&<section class="booking-panel"><h2>Add day</h2><form id="add-day-form" class="planner-form"><label>Title<input name="title" required/></label><label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} required/></label><label>Summary<textarea name="summary"></textarea></label><button class="button" type="submit">Add day</button></form></section>}
  {access.role==='viewer'&&<p class="booking-panel">This invitation is view-only.</p>}
  {access.role!=='viewer'&&<section class="booking-panel" aria-labelledby="contribution-heading"><h2 id="contribution-heading">Offer a recommendation to the Local Guide</h2><p>Only custom activities you added are eligible. Nothing is published until Olrig Bank reviews it.</p>{contributableItems.length===0?<p>No custom recommendations are currently available to offer.</p>:contributableItems.map(item=><form class="planner-form contribution-form" data-item-id={item.id}><label>Title<input name="offeredTitle" value={item.title} required maxlength="200"/></label><label>Location<input name="offeredLocationText" value={item.locationText??''} maxlength="500"/></label><label>Recommendation<textarea name="offeredDescription" maxlength="5000">{item.description}</textarea></label><label><input name="consent" type="checkbox" required/> Share this specific recommendation with Olrig Bank so it may help future guests.</label><label><input name="attributionPermitted" type="checkbox"/> Olrig Bank may credit me by name.</label><button class="button" type="submit">Offer for review</button></form>)}<h3>Contribution history</h3>{contributions.length===0?<p>No recommendations have been offered.</p>:<ul data-contribution-history>{contributions.map(entry=><li><strong>{entry.offeredTitle}</strong> · {entry.status} · offered by {entry.submittedByName}{entry.attributionPermitted?' · attribution permitted':' · anonymous'} {entry.status==='pending'&&ownCandidateIds.has(entry.id)&&<button type="button" class="button button--secondary" data-withdraw-contribution={entry.id}>Withdraw</button>}</li>)}</ul>}</section>}
  <section class="booking-panel" aria-labelledby="activity-heading"><h2 id="activity-heading">Recent activity</h2><ol data-plan-activity>{plan.revisions.slice(-10).reverse().map(entry=><li><strong>{entry.actorDisplayName}</strong> {entry.summary} <time datetime={entry.createdAt}>{activityTime(entry.createdAt)}</time></li>)}</ol></section>
</BaseLayout>
<script is:inline define:vars={{endpoint:`/api/planner/participant/${token}/`,initialRevision:plan.revision}}>
let revision=initialRevision;const message=document.querySelector('#planner-message');const conflict=document.querySelector('[data-planner-conflict]');const values=f=>Object.fromEntries(new FormData(f));function show(t,e=false){message.hidden=false;message.textContent=t;message.className=`pricing-message ${e?'is-error':''}`}async function action(p){const r=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...p,expectedRevision:revision})});const d=await r.json().catch(()=>({}));if(!r.ok){if(d.code==='STALE_REVISION'){conflict.hidden=false;conflict.querySelector('[data-conflict-revision]').textContent=`The latest plan is revision ${d.currentRevision}. Reload before trying again.`}throw new Error(d.error||'Planner action failed.')}revision=d.revision??revision;document.querySelector('[data-revision]').textContent=revision;return d}document.querySelector('[data-reload-plan]')?.addEventListener('click',()=>location.reload());
document.querySelector('#plan-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updatePlan',...values(e.currentTarget)});show('Plan saved.')}catch(x){show(x.message,true)}});document.querySelector('#add-day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addDay',...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});document.querySelectorAll('.planner-day').forEach(day=>{const dayId=day.dataset.dayId;day.querySelector('.day-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateDay',dayId,...values(e.currentTarget)});show('Day saved.')}catch(x){show(x.message,true)}});day.querySelector('[data-remove-day]')?.addEventListener('click',async()=>{if(confirm('Remove this day and its activities?'))try{await action({action:'removeDay',dayId});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('[data-day-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveDay',dayId,direction:b.dataset.dayMove});location.reload()}catch(x){show(x.message,true)}}));day.querySelector('.add-item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'addItem',dayId,...values(e.currentTarget)});location.reload()}catch(x){show(x.message,true)}});day.querySelectorAll('.planner-item').forEach(item=>{const itemId=item.dataset.itemId;item.querySelector('.item-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'updateItem',itemId,...values(e.currentTarget)});show('Item saved.')}catch(x){show(x.message,true)}});item.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(confirm('Remove this activity?'))try{await action({action:'removeItem',itemId});location.reload()}catch(x){show(x.message,true)}});item.querySelectorAll('[data-item-move]').forEach(b=>b.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:dayId,position:b.dataset.itemMove});location.reload()}catch(x){show(x.message,true)}}))})});
document.querySelectorAll('.contribution-form').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();try{await action({action:'offerGuideContribution',itemId:form.dataset.itemId,...values(form),consent:form.elements.consent.checked,attributionPermitted:form.elements.attributionPermitted.checked});location.reload()}catch(x){show(x.message,true)}}));document.querySelectorAll('[data-withdraw-contribution]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'withdrawGuideContribution',candidateId:button.dataset.withdrawContribution});location.reload()}catch(x){show(x.message,true)}}));
</script>
