---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESOURCES } from '../../lib/booking/arrangements';
import { EVENT_TYPES } from '../../lib/booking/events';
export const prerender = false;
---
<BaseLayout title="Plan an event at Olrig Bank" description="Tell us how you would like to use Olrig Bank and receive a tailored offer.">
  <section class="hero"><span class="badge">Bespoke enquiry</span><h1>Plan an event at Olrig Bank</h1><p>Describe the event, areas and timings you need. We will review availability and prepare a tailored offer.</p></section>
  <section class="booking-panel">
    <form class="booking-form" data-event-form>
      <div class="booking-field"><label for="event-name">Event name</label><input id="event-name" name="eventName" maxlength="160" required /></div>
      <div class="booking-field"><label for="event-type">Event type</label><select id="event-type" name="eventType" required>{EVENT_TYPES.map((type) => <option value={type}>{type[0].toUpperCase() + type.slice(1)}</option>)}</select></div>
      <div class="booking-field booking-field-wide"><label for="event-type-other">Other event type (if selected)</label><input id="event-type-other" name="eventTypeOther" maxlength="120" /></div>
      <div class="booking-field booking-field-wide"><label for="description">Proposed use</label><textarea id="description" name="description" rows="5" maxlength="5000" required></textarea></div>
      <div class="booking-field"><label for="setup-start">Setup starts (Olrig Bank local time)</label><input id="setup-start" name="setupStartAt" type="datetime-local" required /></div>
      <div class="booking-field"><label for="event-start">Event starts</label><input id="event-start" name="eventStartAt" type="datetime-local" required /></div>
      <div class="booking-field"><label for="event-end">Event ends</label><input id="event-end" name="eventEndAt" type="datetime-local" required /></div>
      <div class="booking-field"><label for="clearing-end">Clearing finishes</label><input id="clearing-end" name="clearingEndAt" type="datetime-local" required /></div>
      <div class="booking-field"><label for="daytime-attendees">Expected daytime attendees</label><input id="daytime-attendees" name="daytimeAttendees" type="number" min="0" value="0" required /></div>
      <div class="booking-field"><label for="overnight-guests">Expected overnight guests</label><input id="overnight-guests" name="overnightGuests" type="number" min="0" value="0" required /></div>
      <fieldset class="booking-field booking-field-wide"><legend>Requested areas</legend>{RESOURCES.map((resource) => <label class="booking-consent"><input name="requestedResourceIds" type="checkbox" value={resource.id} /><span>{resource.name}</span></label>)}</fieldset>
      <div class="booking-field booking-field-wide"><label for="areas-text">Other area or detail</label><textarea id="areas-text" name="requestedAreasText" rows="2" maxlength="1000"></textarea></div>
      <div class="booking-field booking-field-wide"><label class="booking-consent"><input name="accommodationRequired" type="checkbox" value="yes" /><span>Accommodation is required</span></label></div>
      <div class="booking-field booking-field-wide"><label for="accommodation-notes">Accommodation requested</label><textarea id="accommodation-notes" name="accommodationNotes" rows="2" maxlength="1000"></textarea></div>
      <div class="booking-field"><label for="catering">Catering requirements</label><textarea id="catering" name="cateringRequirements" rows="3" maxlength="1000"></textarea></div>
      <div class="booking-field"><label for="parking">Parking requirements</label><textarea id="parking" name="parkingRequirements" rows="3" maxlength="1000"></textarea></div>
      <div class="booking-field"><label for="accessibility">Accessibility requirements</label><textarea id="accessibility" name="accessibilityRequirements" rows="3" maxlength="1000"></textarea></div>
      <div class="booking-field"><label for="equipment">Equipment or facilities</label><textarea id="equipment" name="equipmentRequirements" rows="3" maxlength="1000"></textarea></div>
      <div class="booking-field"><label class="booking-consent"><input name="publicAccess" type="checkbox" value="yes" /><span>The public will have access</span></label></div>
      <div class="booking-field"><label class="booking-consent"><input name="amplifiedMusic" type="checkbox" value="yes" /><span>Amplified music is planned</span></label></div>
      <div class="booking-field"><label class="booking-consent"><input name="outsideSuppliers" type="checkbox" value="yes" /><span>Outside suppliers are planned</span></label></div>
      <div class="booking-field"><label for="budget">Optional budget or pricing expectation</label><input id="budget" name="budgetExpectation" maxlength="500" /></div>
      <div class="booking-field"><label for="booker-name">Booker name</label><input id="booker-name" name="name" autocomplete="name" maxlength="120" required /></div>
      <div class="booking-field"><label for="booker-email">Booker email</label><input id="booker-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
      <div class="booking-field"><label for="booker-telephone">Telephone</label><input id="booker-telephone" name="telephone" type="tel" autocomplete="tel" maxlength="80" /></div>
      <div class="booking-field booking-field-wide"><label class="booking-consent"><input name="whatsappConsent" type="checkbox" value="yes" /><span>Olrig Bank may send transactional WhatsApp messages about this enquiry and its payments.</span></label></div>
      <div class="booking-field booking-field-wide"><label class="booking-consent"><input name="acknowledgement" type="checkbox" value="yes" required /><span>I understand this submission is an enquiry, not a confirmed reservation.</span></label></div>
      <div class="booking-field booking-field-wide"><p class="booking-status" data-event-status role="alert" aria-live="polite"></p><button class="button" type="submit">Send event enquiry</button></div>
    </form>
  </section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-event-form]');
  const status = document.querySelector<HTMLElement>('[data-event-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries()) as Record<string, unknown>;
    payload.requestedResourceIds = data.getAll('requestedResourceIds');
    for (const name of ['accommodationRequired','publicAccess','amplifiedMusic','outsideSuppliers','whatsappConsent','acknowledgement']) payload[name] = data.get(name) === 'yes';
    if (status) status.textContent = 'Saving your event enquiry…';
    const response = await fetch('/api/event-requests', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
    const result = await response.json();
    if (!response.ok) { if (status) status.textContent = result.error || 'The enquiry could not be saved.'; return; }
    window.location.assign(result.managePath);
  });
</script>
