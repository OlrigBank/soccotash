---
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { audit, isSameOrigin } from '../../../../../lib/admin/auth';
import { getBookingAccessAdminState, revokeBookingAccessCredential } from '../../../../../lib/booking/booking-access';
import { getProvisionalBookingRequest } from '../../../../../lib/booking/repository';
import { getPool } from '../../../../../lib/booking/db';
export const prerender = false;
const reference = String(Astro.params.reference || '');
if (!/^[0-9a-f-]{36}$/i.test(reference)) return Astro.redirect('/admin/bookings/');
const booking = await getProvisionalBookingRequest(reference);
if (!booking) return new Response('Booking not found.', { status: 404 });
let error = '';
if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request)) return new Response('Cross-origin request rejected.', { status: 403 });
  const form = await Astro.request.formData();
  const reason = String(form.get('reason') || '').trim().slice(0, 1000);
  const action = String(form.get('action') || '');
  if (!reason || form.get('confirm') !== 'yes') error = 'Give a reason and confirm the access change.';
  else if (action === 'revoke') {
    await revokeBookingAccessCredential({ reference, adminUserId: Astro.locals.adminUser!.id, reason });
    await audit(Astro.locals.adminUser!.id, 'booking.access_revoked', { bookingReference: reference, reason });
    return Astro.redirect(`/admin/bookings/${reference}/access/?saved=1`);
  } else if (action === 'restore') {
    await getPool().query('UPDATE provisional_bookings SET customer_access_token_revoked_at=NULL WHERE public_id=$1::uuid AND deletion_requested_at IS NULL', [reference]);
    await audit(Astro.locals.adminUser!.id, 'booking.access_restored', { bookingReference: reference, reason });
    return Astro.redirect(`/admin/bookings/${reference}/access/?saved=1`);
  } else error = 'Unknown access action.';
}
const access = await getBookingAccessAdminState(reference);
const ownership = (await getPool().query('SELECT booker_account_id,booker_claim_channel,booker_claim_identifier FROM provisional_bookings WHERE public_id=$1::uuid', [reference])).rows[0];
const manageUrl = new URL(`/booking/manage/${reference}/`, process.env.BOOKING_PUBLIC_URL || Astro.url.origin).toString();
---
<AdminLayout title={`Booker access · ${booking.name}`}>
  <h1>Booker account access</h1>
  <p><a href={`/admin/bookings/${reference}/`}>Back to booking</a></p>
  {error && <p role="alert">{error}</p>}
  {Astro.url.searchParams.has('saved') && <p role="status">Access updated.</p>}
  <p>Access: <strong>{access?.state}</strong>. Automatic expiry: {access?.expiresOn}.</p>
  <p>{ownership.booker_account_id ? 'This booking is linked to a verified booker account. Editing booking contact details does not change account ownership.' : ownership.booker_claim_identifier ? `Awaiting verification of ${ownership.booker_claim_channel === 'email' ? 'email' : 'mobile'}: ${ownership.booker_claim_identifier}` : 'No usable claim contact. Correct the booking email or mobile number before it can be claimed.'}</p>
  <p><a href={manageUrl}>Booker sign-in link</a> — the booker must sign in to the account that owns this booking. This link does not grant access.</p>
  <form method="post">
    <label>Reason <textarea name="reason" required maxlength="1000"></textarea></label>
    <label><input type="checkbox" name="confirm" value="yes" required /> Confirm this booking access change</label>
    <button type="submit" name="action" value={access?.state === 'revoked' ? 'restore' : 'revoke'}>{access?.state === 'revoked' ? 'Restore account access' : 'Revoke account access'}</button>
  </form>
  <p>Revocation blocks this booking on every device. Restoring access retains the automatic expiry date. Neither action sends a message.</p>
</AdminLayout>
