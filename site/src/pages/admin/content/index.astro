---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PAGES_CMS_BRANCH, PAGES_CMS_BRANCH_URL, PAGES_CMS_SECTIONS } from '../../../lib/admin/pages-cms';

export const prerender = false;
---
<AdminLayout title="Website content">
  <header class="admin-page-header admin-page-header-with-action">
    <div>
      <p class="eyebrow">Administration</p>
      <h1>Website content</h1>
      <p>
        Edit the text, images and structure of the public Olrig Bank website. Each section opens the
        hosted Pages CMS application in a new browser tab.
      </p>
    </div>
    <a
      class="admin-secondary-button"
      href={PAGES_CMS_BRANCH_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Open Pages CMS home
      <span aria-hidden="true">↗</span>
    </a>
  </header>

  <section class="admin-notice" aria-labelledby="pages-cms-access-heading">
    <h2 id="pages-cms-access-heading">Pages CMS access</h2>
    <p>
      These editors save content and images to the <strong>{PAGES_CMS_BRANCH}</strong> branch.
      Saving does not publish your changes. Review the rebuilt web and print previews, then arrange
      an approved merge to main and deployment to update the public website.
    </p>
    <p>
      On the first visit, Pages CMS may ask you to sign in and authorise access to the Soccotash
      GitHub repository. During later visits, an active Pages CMS session should take you directly to
      the selected section. You may be asked to sign in again after the session expires or browser
      cookies are cleared.
    </p>
  </section>

  <section class="admin-notice" aria-labelledby="welcome-preview-heading">
    <h2 id="welcome-preview-heading">Welcome page previews</h2>
    <p>
      <a href="/welcome/" target="_blank" rel="noopener noreferrer">View welcome page (opens in a new tab)</a>
      {' · '}
      <a href="/welcome/print/" target="_blank" rel="noopener noreferrer">View printable poster (opens in a new tab)</a>.
      These views show the content built into this version of the website. Newly saved CMS edits
      appear after the corresponding branch has been rebuilt in a preview or approved deployment.
    </p>
  </section>

  <section class="admin-content-grid" aria-label="Website content sections">
    {PAGES_CMS_SECTIONS.map((section) => (
      <article class="admin-content-card">
        <div>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
        </div>
        <a
          class="admin-button-link"
          href={section.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${section.buttonLabel} in Pages CMS (opens in a new tab)`}
        >
          {section.buttonLabel}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </section>
</AdminLayout>

<style>
  .admin-page-header p { color: var(--ink); }
</style>
