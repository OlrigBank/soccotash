---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getHolidayPlan } from '../../../lib/planner/repository.ts';
import { PlannerError } from '../../../lib/planner/types.ts';
import { getPlannerGuideEntries } from '../../../lib/planner/local-guide.ts';

export const prerender = false;
let plan = null;
try { plan = await getHolidayPlan(Astro.params.id ?? ''); } catch (error) { if (!(error instanceof PlannerError)) throw error; }
if (!plan || plan.planType !== 'example') return Astro.redirect('/admin/planner/?result=not-found');
const editable = !plan.archivedAt;
const dated = plan.startsOn !== null;
const guideEntries = await getPlannerGuideEntries();
const guideFor = (slug: string | null) => slug ? guideEntries.find(entry=>entry.slug===slug) ?? null : null;
---
<AdminLayout title={plan.title}>
  <header class="admin-page-header"><div><p class="eyebrow"><a href="/admin/planner/">Holiday Planner</a></p><h1>{plan.title}</h1><p>Revision <strong data-revision>{plan.revision}</strong> · {plan.publicationStatus}{plan.archivedAt ? ' · archived' : ''}</p></div><div class="planner-header-actions"><button id="duplicate-plan" class="admin-button admin-button--secondary" type="button">Duplicate as draft</button>{editable && <button id="archive-plan" class="admin-button admin-button--danger" type="button">Archive plan</button>}</div></header>
  <div id="planner-message" class="admin-alert" role="status" aria-live="polite" hidden></div>
  <section class="admin-panel"><h2>Plan details</h2>
    <form id="plan-form" class="planner-form">
      <label>Title<input name="title" value={plan.title} required minlength="3" maxlength="160" disabled={!editable} /></label>
      <label class="planner-wide">Description<textarea name="description" maxlength="5000" rows="3" disabled={!editable}>{plan.description}</textarea></label>
      <label>Duration in days<input name="durationDays" type="number" min="1" max="366" value={plan.durationDays ?? ''} disabled={!editable} /></label>
      <fieldset class="planner-dates"><legend>Optional fixed dates</legend><label>Starts<input name="startsOn" type="date" value={plan.startsOn ?? ''} disabled={!editable || plan.days.length > 0} /></label><label>Ends<input name="endsOn" type="date" value={plan.endsOn ?? ''} disabled={!editable || plan.days.length > 0} /></label></fieldset>
      {editable && <button class="admin-button" type="submit">Save plan details</button>}
    </form>
    {plan.days.length > 0 && <p class="planner-help">Plan dates are locked after days are added so existing days cannot silently change meaning.</p>}
  </section>
  <section class="planner-days" aria-labelledby="days-heading"><h2 id="days-heading">Days</h2>
    {editable && <label class="planner-guide-search">Search Local Guide entries<input type="search" data-guide-filter placeholder="Search title, summary or category" /></label>}
    {plan.days.map((day, index) => <article class="admin-panel planner-day" data-day-id={day.id}>
      <div class="planner-day-heading"><h3>Day {index + 1}</h3>{editable && <div class="planner-move-controls" aria-label={`Move ${day.title}`}><button type="button" data-move="up" disabled={index === 0} aria-label={`Move ${day.title} up`}>↑</button><button type="button" data-move="down" disabled={index === plan.days.length - 1} aria-label={`Move ${day.title} down`}>↓</button></div>}</div>
      <form class="planner-form day-form">
        <label>Title<input name="title" value={day.title} required maxlength="160" disabled={!editable} /></label>
        {dated && <label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} value={day.date ?? ''} required disabled={!editable} /></label>}
        <label class="planner-wide">Summary<textarea name="summary" maxlength="3000" rows="2" disabled={!editable}>{day.summary}</textarea></label>
        {editable && <div class="planner-form-actions"><button class="admin-button" type="submit">Save day</button><button class="admin-button admin-button--danger" data-remove type="button">Remove day</button></div>}
      </form>
      <div class="planner-items">
        {day.items.map((item, itemIndex) => <article class="planner-item" data-item-id={item.id}>
          <div class="planner-day-heading"><h4><span class:list={['status-badge', `status-${item.status}`]}>{item.status}</span> {guideFor(item.localGuideSlug)?.title ?? item.title}</h4>{editable && <div class="planner-move-controls" aria-label={`Move ${item.title}`}><button type="button" data-item-move="up" disabled={itemIndex===0} aria-label={`Move ${item.title} up`}>↑</button><button type="button" data-item-move="down" disabled={itemIndex===day.items.length-1} aria-label={`Move ${item.title} down`}>↓</button></div>}</div>
          {item.localGuideSlug && guideFor(item.localGuideSlug) ? <aside class="planner-guide-reference"><strong>Local Guide</strong><p>{guideFor(item.localGuideSlug)!.summary}</p><a href={`/local-guide/${item.localGuideSlug}/`} target="_blank">View current guide entry</a></aside> : item.localGuideSlug ? <aside class="admin-alert admin-alert--error"><strong>Missing Local Guide entry:</strong> {item.localGuideSlug}. The item remains editable; replace or detach this reference.</aside> : <p class="planner-guide-candidate">Custom item · potential future Local Guide candidate</p>}
          <form class="planner-form item-form">
            <label>Title<input name="title" value={item.title} required maxlength="200" disabled={!editable}/></label>
            <label>Type<select name="itemType" disabled={!editable}>{['activity','journey','meal','reservation','free_time','other'].map(value=><option value={value} selected={item.itemType===value}>{value.replace('_',' ')}</option>)}</select></label>
            <label>Starts<input name="startTime" type="time" value={item.startTime??''} disabled={!editable}/></label><label>Ends<input name="endTime" type="time" value={item.endTime??''} disabled={!editable}/></label>
            <label>Location<input name="locationText" value={item.locationText??''} maxlength="500" disabled={!editable}/></label>
            <label>Status<select name="status" disabled={!editable}>{['idea','proposed','agreed','booked','completed','cancelled'].map(value=><option value={value} selected={item.status===value}>{value}</option>)}</select></label>
            <label>Visibility<select name="visibility" disabled={!editable}>{['participants','private','public'].map(value=><option value={value} selected={item.visibility===value}>{value}</option>)}</select></label>
            <label class="planner-wide">Description<textarea name="description" maxlength="10000" rows="2" disabled={!editable}>{item.description}</textarea></label>
            <label class="planner-wide">Reservation note<textarea name="reservationNote" maxlength="3000" rows="2" disabled={!editable}>{item.reservationNote??''}</textarea></label>
            {editable && <div class="planner-form-actions planner-wide"><button class="admin-button" type="submit">Save item</button><label>Local Guide<select data-guide-reference><option value="">Custom item / detach</option>{guideEntries.map(entry=><option value={entry.slug} data-guide-search={`${entry.title} ${entry.summary} ${entry.category}`.toLowerCase()} selected={entry.slug===item.localGuideSlug}>{entry.title} · {entry.category}</option>)}</select></label><button type="button" data-set-guide class="admin-button admin-button--secondary">Apply guide reference</button><label>Move to day<select data-target-day>{plan.days.map((target,index)=><option value={target.id} selected={target.id===day.id}>Day {index+1}: {target.title}</option>)}</select></label><button type="button" data-move-day class="admin-button admin-button--secondary">Move</button><button type="button" data-remove-item class="admin-button admin-button--danger">Remove item</button></div>}
          </form>
        </article>)}
        {editable && <details class="planner-add-item"><summary>Add item to {day.title}</summary><form class="planner-form add-item-form"><label>Title<input name="title" required maxlength="200"/></label><label>Local Guide reference<select name="localGuideSlug"><option value="">Custom item</option>{guideEntries.map(entry=><option value={entry.slug} data-guide-search={`${entry.title} ${entry.summary} ${entry.category}`.toLowerCase()}>{entry.title} · {entry.category}</option>)}</select></label><label>Type<select name="itemType"><option value="activity">activity</option><option value="journey">journey</option><option value="meal">meal</option><option value="reservation">reservation</option><option value="free_time">free time</option><option value="other">other</option></select></label><label>Starts<input name="startTime" type="time"/></label><label>Ends<input name="endTime" type="time"/></label><label>Location<input name="locationText" maxlength="500"/></label><label>Status<select name="status"><option value="idea">idea</option><option value="proposed">proposed</option></select></label><input type="hidden" name="visibility" value="participants"/><label class="planner-wide">Plan-specific description<textarea name="description" maxlength="10000" rows="2"></textarea></label><label class="planner-wide">Reservation note<textarea name="reservationNote" maxlength="3000" rows="2"></textarea></label><button class="admin-button" type="submit">Add item</button></form></details>}
      </div>
    </article>)}
    {!plan.days.length && <p class="admin-panel">No days yet. Add the first day below.</p>}
  </section>
  {editable && <section class="admin-panel"><h2>Add day</h2><form id="add-day-form" class="planner-form"><label>Title<input name="title" required maxlength="160" /></label>{dated && <label>Date<input name="date" type="date" min={plan.startsOn!} max={plan.endsOn!} required /></label>}<label class="planner-wide">Summary<textarea name="summary" maxlength="3000" rows="2"></textarea></label><button class="admin-button" type="submit">Add day</button></form></section>}
  <section class="admin-panel planner-history" aria-labelledby="history-heading"><h2 id="history-heading">Revision history</h2><p>History is retained for active and archived plans. Restoring an old revision is not part of this stage.</p><ol reversed>{[...plan.revisions].reverse().map(entry=><li><div><strong>Revision {entry.revision}: {entry.summary}</strong><span>{new Date(entry.createdAt).toLocaleString('en-GB')} · {entry.actorType} · {entry.source}</span></div><details><summary>Structured change</summary><pre>{JSON.stringify(entry.changes,null,2)}</pre></details></li>)}</ol></section>
</AdminLayout>
<script is:inline define:vars={{ planId: plan.id, initialRevision: plan.revision }}>
  let revision = initialRevision;
  const message = document.querySelector('#planner-message');
  function show(text, error = false) { if (message instanceof HTMLElement) { message.hidden = false; message.textContent = text; message.className = `admin-alert ${error ? 'admin-alert--error' : 'admin-alert--success'}`; } }
  async function action(payload) { const response = await fetch('/api/admin/planner/action/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ...payload, planId, expectedRevision: revision }) }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error || 'Planner action failed.'); revision = data.revision ?? revision; return data; }
  function values(form) { return Object.fromEntries(new FormData(form)); }
  document.querySelector('#plan-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; if (!(form instanceof HTMLFormElement)) return; try { await action({ action: 'updatePlan', ...values(form) }); show('Plan details saved.'); } catch (error) { show(error.message, true); } });
  document.querySelector('#add-day-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget; if (!(form instanceof HTMLFormElement)) return; try { await action({ action: 'addDay', ...values(form) }); window.location.reload(); } catch (error) { show(error.message, true); } });
  document.querySelectorAll('.planner-day').forEach((card) => { const dayId = card.dataset.dayId; const form = card.querySelector('.day-form'); form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!(form instanceof HTMLFormElement)) return; try { await action({ action: 'updateDay', dayId, ...values(form) }); show('Day saved.'); } catch (error) { show(error.message, true); } }); card.querySelector('[data-remove]')?.addEventListener('click', async () => { if (!confirm('Remove this day and its content?')) return; try { await action({ action: 'removeDay', dayId }); window.location.reload(); } catch (error) { show(error.message, true); } }); card.querySelectorAll('[data-move]').forEach((button) => button.addEventListener('click', async () => { try { await action({ action: 'moveDay', dayId, direction: button.dataset.move }); window.location.reload(); } catch (error) { show(error.message, true); } })); });
  document.querySelectorAll('.planner-day').forEach((dayCard) => { const dayId=dayCard.dataset.dayId; const addForm=dayCard.querySelector('.add-item-form'); addForm?.addEventListener('submit',async(event)=>{event.preventDefault();if(!(addForm instanceof HTMLFormElement))return;try{await action({action:'addItem',dayId,...values(addForm)});window.location.reload()}catch(error){show(error.message,true)}}); dayCard.querySelectorAll('.planner-item').forEach((itemCard)=>{const itemId=itemCard.dataset.itemId;const itemForm=itemCard.querySelector('.item-form');itemForm?.addEventListener('submit',async(event)=>{event.preventDefault();if(!(itemForm instanceof HTMLFormElement))return;try{await action({action:'updateItem',itemId,...values(itemForm)});show('Item saved.')}catch(error){show(error.message,true)}});itemCard.querySelector('[data-set-guide]')?.addEventListener('click',async()=>{const select=itemCard.querySelector('[data-guide-reference]');if(!(select instanceof HTMLSelectElement))return;try{await action({action:'setGuideReference',itemId,localGuideSlug:select.value});window.location.reload()}catch(error){show(error.message,true)}});itemCard.querySelectorAll('[data-item-move]').forEach(button=>button.addEventListener('click',async()=>{try{await action({action:'moveItem',itemId,targetDayId:dayId,position:button.dataset.itemMove});window.location.reload()}catch(error){show(error.message,true)}}));itemCard.querySelector('[data-move-day]')?.addEventListener('click',async()=>{const select=itemCard.querySelector('[data-target-day]');if(!(select instanceof HTMLSelectElement))return;try{await action({action:'moveItem',itemId,targetDayId:select.value,position:'end'});window.location.reload()}catch(error){show(error.message,true)}});itemCard.querySelector('[data-remove-item]')?.addEventListener('click',async()=>{if(!confirm('Remove this item and discard its plan-specific content?'))return;try{await action({action:'removeItem',itemId});window.location.reload()}catch(error){show(error.message,true)}})}) });
  document.querySelector('[data-guide-filter]')?.addEventListener('input',(event)=>{const query=event.currentTarget.value.trim().toLowerCase();document.querySelectorAll('[data-guide-search]').forEach(option=>{option.hidden=!!query&&!option.dataset.guideSearch.includes(query)})});
  document.querySelector('#archive-plan')?.addEventListener('click', async () => { if (!confirm('Archive this plan? Its history will be retained.')) return; try { await action({ action: 'archivePlan' }); window.location.reload(); } catch (error) { show(error.message, true); } });
  document.querySelector('#duplicate-plan')?.addEventListener('click',async()=>{try{const data=await action({action:'duplicatePlan'});window.location.href=`/admin/planner/${data.plan.id}/`}catch(error){show(error.message,true)}});
</script>
