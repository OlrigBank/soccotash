---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getPlannerGuideEntries } from '../../../../lib/planner/local-guide.ts';
import { listGuideContributionModerationQueue } from '../../../../lib/planner/repository.ts';
export const prerender=false;
const [candidates,guides]=await Promise.all([listGuideContributionModerationQueue(),getPlannerGuideEntries()]);
const pending=candidates.filter(candidate=>candidate.status==='pending');
const decided=candidates.filter(candidate=>['accepted','rejected'].includes(candidate.status));
const format=(value:string)=>new Intl.DateTimeFormat('en-GB',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/London'}).format(new Date(value));
---
<AdminLayout title="Local Guide contributions">
  <header class="admin-page-header"><div><p class="eyebrow">Holiday Planner</p><h1>Local Guide contributions</h1><p>Review only the content each guest explicitly offered. Accepted results remain non-public drafts.</p></div></header>
  <div id="moderation-message" class="admin-alert" role="status" aria-live="polite" hidden></div>
  <section aria-labelledby="pending-heading"><h2 id="pending-heading">Pending review ({pending.length})</h2>{pending.length===0?<p class="admin-panel">No contributions are waiting.</p>:pending.map(candidate=><article class="admin-panel contribution-review" data-candidate-id={candidate.id}><header><h3>{candidate.offeredTitle}</h3><p>Offered {format(candidate.consentedAt)} · {candidate.attributionPermitted?`Attribution permitted: ${candidate.attributionName}`:'Anonymous use only'}</p></header><blockquote>{candidate.consentStatement}</blockquote><dl><dt>Recommendation</dt><dd>{candidate.offeredDescription||'No description supplied.'}</dd><dt>Location</dt><dd>{candidate.offeredLocationText||'No location supplied.'}</dd></dl><form class="planner-form accept-form"><input type="hidden" name="decision" value="accept"/><label>Reviewed title<input name="reviewedTitle" value={candidate.offeredTitle} required maxlength="200"/></label><label>Result<select name="resultType"><option value="new_entry_draft">New Local Guide entry draft</option><option value="suggested_update">Suggested update to existing entry</option></select></label><label>Local Guide slug<input name="resultGuideSlug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" list="guide-slugs"/></label><label class="planner-wide">Reviewed summary<textarea name="reviewedDescription" maxlength="5000">{candidate.offeredDescription}</textarea></label><label>Reviewed location<input name="reviewedLocationText" value={candidate.offeredLocationText??''} maxlength="500"/></label><label class="planner-wide">Moderation note<textarea name="moderationNotes" maxlength="3000"></textarea></label><button class="admin-button" type="submit">Accept as non-public draft</button></form><form class="planner-form reject-form"><input type="hidden" name="decision" value="reject"/><label class="planner-wide">Rejection reason<textarea name="moderationNotes" required maxlength="3000"></textarea></label><button class="admin-button admin-button--danger" type="submit">Reject contribution</button></form></article>)}</section>
  <datalist id="guide-slugs">{guides.map(guide=><option value={guide.slug}>{guide.title}</option>)}</datalist>
  <section aria-labelledby="decided-heading"><h2 id="decided-heading">Decision history</h2>{decided.length===0?<p class="admin-panel">No moderation decisions yet.</p>:<div class="admin-table-wrap"><table><thead><tr><th>Contribution</th><th>Decision</th><th>Result</th><th>Reviewed by</th><th>Reviewed</th></tr></thead><tbody>{decided.map(candidate=><tr><td>{candidate.offeredTitle}</td><td>{candidate.status}</td><td>{candidate.resultType?`${candidate.resultType.replaceAll('_',' ')} · ${candidate.resultGuideSlug}`:candidate.moderationNotes}</td><td>{candidate.reviewedByName??'Former administrator'}</td><td>{candidate.reviewedAt?format(candidate.reviewedAt):''}</td></tr>)}</tbody></table></div>}</section>
</AdminLayout>
<script>
const message=document.querySelector('#moderation-message');const values=(form:HTMLFormElement)=>Object.fromEntries(new FormData(form));async function submit(form:HTMLFormElement){const response=await fetch('/api/admin/planner/contributions/',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({candidateId:form.closest<HTMLElement>('[data-candidate-id]')?.dataset.candidateId,...values(form)})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Moderation failed.');location.reload()}document.querySelectorAll<HTMLFormElement>('.accept-form,.reject-form').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();try{await submit(form)}catch(error){if(message instanceof HTMLElement){message.hidden=false;message.textContent=error instanceof Error?error.message:'Moderation failed.';message.className='admin-alert admin-alert--error'}}}));
</script>
