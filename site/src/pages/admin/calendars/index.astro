---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAvailabilityProperties, getProperties } from '../../../lib/booking/config';
import { nightsBetween } from '../../../lib/booking/dates';
import { getAdminCalendarEntries, getProvisionalBookingRequest, type AdminCalendarEntry } from '../../../lib/booking/repository';
export const prerender = false;

const properties = getProperties();
const propertyNames = new Map(properties.map((property) => [property.id, property.name]));
const requestedProperty = Astro.url.searchParams.get('property') || 'all';
const selectedProperty = requestedProperty === 'all' || properties.some((property) => property.id === requestedProperty)
  ? requestedProperty
  : 'all';

function monthStartFromQuery(value: string | null): Date {
  if (value && /^\d{4}-\d{2}$/.test(value)) {
    const [year, month] = value.split('-').map(Number);
    if (year >= 2020 && year <= 2100 && month >= 1 && month <= 12) return new Date(Date.UTC(year, month - 1, 1));
  }
  const now = new Date();
  return new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
}
function addMonths(value: Date, count: number): Date {
  return new Date(Date.UTC(value.getUTCFullYear(), value.getUTCMonth() + count, 1));
}
function isoDate(value: Date): string {
  return value.toISOString().slice(0, 10);
}
function monthValue(value: Date): string {
  return value.toISOString().slice(0, 7);
}
function dayValue(year: number, month: number, day: number): string {
  return new Date(Date.UTC(year, month, day)).toISOString().slice(0, 10);
}
function daysInMonth(value: Date): number {
  return new Date(Date.UTC(value.getUTCFullYear(), value.getUTCMonth() + 1, 0)).getUTCDate();
}
function addDays(value: string, count: number): string {
  const date = new Date(`${value}T00:00:00.000Z`);
  date.setUTCDate(date.getUTCDate() + count);
  return date.toISOString().slice(0, 10);
}
function entriesOnDay(entries: AdminCalendarEntry[], value: string): AdminCalendarEntry[] {
  return entries.filter((entry) => entry.startsOn <= value && entry.endsOn > value);
}
function entryLabel(entry: AdminCalendarEntry): string {
  const propertyName = propertyNames.get(entry.propertyId) ?? entry.propertyId;
  if (entry.source === 'override') return `Available for bespoke stays · ${propertyName}${entry.reason ? ` · ${entry.reason}` : ''}`;
  if (entry.source === 'direct') return `Direct · ${propertyName} · ${entry.guestName || 'Booker'}`;
  if (entry.source === 'provisional' && entry.propertyId === 'bespoke-arrangement') return `Non-blocking request · ${propertyName} · ${entry.guestName || 'Booker'}`;
  if (entry.source === 'provisional') return `Provisional · ${propertyName} · ${entry.guestName || 'Booker'}`;
  if (entry.source === 'airbnb') return `Airbnb · ${propertyName}`;
  return `Unavailable · ${propertyName}`;
}

const startMonth = monthStartFromQuery(Astro.url.searchParams.get('month'));
const rangeEnd = addMonths(startMonth, 3);
const requestedBookingReference = Astro.url.searchParams.get('booking') || '';
const calendarBooking = /^[0-9a-f-]{36}$/i.test(requestedBookingReference)
  ? await getProvisionalBookingRequest(requestedBookingReference)
  : null;
const bespokeBooking = calendarBooking?.propertyId === 'bespoke-arrangement' && calendarBooking.status === 'pending'
  ? calendarBooking
  : null;
const requestedNights = bespokeBooking ? nightsBetween(bespokeBooking.arrival, bespokeBooking.departure) : 0;
const allEntries = await getAdminCalendarEntries(isoDate(startMonth), isoDate(rangeEnd));
const selectedAvailabilityIds = selectedProperty === 'all'
  ? new Set<string>()
  : new Set(getAvailabilityProperties(selectedProperty).map((property) => property.id));
const entries = selectedProperty === 'all'
  ? allEntries
  : allEntries.filter((entry) =>
      getAvailabilityProperties(entry.propertyId).some((property) => selectedAvailabilityIds.has(property.id)),
    );
const months = [startMonth, addMonths(startMonth, 1), addMonths(startMonth, 2)];
const previousMonth = monthValue(addMonths(startMonth, -1));
const nextMonth = monthValue(addMonths(startMonth, 1));
const bookingQuery = bespokeBooking ? `&booking=${encodeURIComponent(bespokeBooking.reference)}` : '';
const propertyQuery = `${selectedProperty === 'all' ? '' : `&property=${encodeURIComponent(selectedProperty)}`}${bookingQuery}`;
const monthFormatter = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const today = new Date().toISOString().slice(0, 10);
const result = Astro.url.searchParams.get('result');
const resultMessage = result === 'unblocked'
  ? 'The selected night is now available for bespoke stay requests despite any underlying calendar entries.'
  : result === 'restored'
    ? 'The availability override was removed. Underlying calendar entries block the night again.'
      : result === 'confirmation-required'
        ? 'Explicit confirmation is required before a blocked night can be made available.'
      : result === 'review-required'
        ? 'Bespoke availability can only be opened while reviewing a pending Bespoke request, and only for nights in that request.'
      : result === 'already-unblocked'
        ? 'That night already has a Bespoke availability override. The existing override was left unchanged.'
      : result === 'invalid'
        ? 'The availability override request was invalid.'
        : result === 'failed'
          ? 'The availability override could not be changed.'
          : result === 'not-found'
            ? 'That availability override no longer exists.'
            : result === 'dates-unavailable'
              ? 'The selected stay still crosses one or more blocked nights. Open every affected resource night or choose another stay.'
              : result === 'duration-mismatch'
                ? 'Alternative dates must preserve the original requested stay length.'
              : result === 'invalid-dates'
                ? 'Choose a valid future stay with the same requested duration.'
                : result === 'booking-stale'
                  ? 'This request can no longer receive a Bespoke date suggestion.'
                  : result === 'date-update-failed'
                    ? 'The alternative dates could not be suggested.'
            : '';
const resultTone = ['unblocked', 'restored', 'already-unblocked'].includes(result || '') ? 'success' : 'error';

const bespokeAvailabilityIds = getAvailabilityProperties('bespoke-arrangement').map((property) => property.id);
function entryAffectsAvailability(entry: AdminCalendarEntry, availabilityId: string): boolean {
  return entry.source !== 'override'
    && !(entry.propertyId === 'bespoke-arrangement' && entry.source === 'provisional')
    && getAvailabilityProperties(entry.propertyId).some((property) => property.id === availabilityId);
}
function nightIsOpen(value: string): boolean {
  const dayEntries = entriesOnDay(allEntries, value);
  return bespokeAvailabilityIds.every((availabilityId) => {
    const blocked = dayEntries.some((entry) => entryAffectsAvailability(entry, availabilityId));
    const overridden = dayEntries.some((entry) => entry.source === 'override' && entry.propertyId === availabilityId);
    return !blocked || overridden;
  });
}
function rangeIsOpen(arrival: string, nights: number): boolean {
  if (!nights || addDays(arrival, nights) > isoDate(rangeEnd)) return false;
  return Array.from({ length: nights }, (_, index) => addDays(arrival, index)).every(nightIsOpen);
}
let nearestOpenArrival: string | null = null;
if (bespokeBooking && requestedNights > 0) {
  const firstCandidate = bespokeBooking.arrival > today ? bespokeBooking.arrival : today;
  for (let candidate = firstCandidate; addDays(candidate, requestedNights) <= isoDate(rangeEnd); candidate = addDays(candidate, 1)) {
    if (rangeIsOpen(candidate, requestedNights)) { nearestOpenArrival = candidate; break; }
  }
}
---
<AdminLayout title="Calendars">
  <header class="admin-page-header">
    <div>
      <p class="eyebrow">Administration</p>
      <h1>Calendars</h1>
      <p>Imported Airbnb blocks, provisional requests and confirmed direct bookings are shown together.</p>
      <p><strong>Bespoke-stay overrides take precedence over every calendar entry without deleting the underlying booking or imported block. Standard stay arrangements remain blocked.</strong></p>
    </div>
  </header>

  {resultMessage && <div class={`admin-alert admin-alert--${resultTone}`} role="status">{resultMessage}</div>}

  {bespokeBooking && <section class="admin-panel admin-calendar-booking-context">
    <div>
      <p class="eyebrow">Bespoke stay date review</p>
      <h2>{bespokeBooking.name}</h2>
      <p>Requested: <strong>{bespokeBooking.arrival} to {bespokeBooking.departure}</strong> · {requestedNights} night{requestedNights === 1 ? '' : 's'} · {bespokeBooking.guests} guest{bespokeBooking.guests === 1 ? '' : 's'}{bespokeBooking.pets ? ` · ${bespokeBooking.pets} pet${bespokeBooking.pets === 1 ? '' : 's'}` : ''}</p>
      <p>If the requested dates are open, no calendar change is needed. “Allow bespoke” controls appear only on blocked nights within this request. Alternative stays shown here are already open and keep the same duration.</p>
      {nearestOpenArrival
        ? <p>Nearest open same-length stay: <strong>{nearestOpenArrival} to {addDays(nearestOpenArrival, requestedNights)}</strong>.</p>
        : <p>No fully open same-length stay was found in this three-month view.</p>}
    </div>
    <form method="post" action={`/admin/bookings/${bespokeBooking.reference}/dates/`} class="admin-calendar-date-choice" data-bespoke-date-form data-nights={requestedNights}>
      <label>Selected arrival<input name="arrival" type="date" min={today} value={nearestOpenArrival || bespokeBooking.arrival} required /></label>
      <label>Departure<input name="departure" type="date" value={addDays(nearestOpenArrival || bespokeBooking.arrival, requestedNights)} readonly required /></label>
      <button class="admin-button" type="submit">Suggest dates and return to booking</button>
    </form>
    <a class="admin-button admin-button--secondary" href={`/admin/bookings/${bespokeBooking.reference}/?reservation=open`}>Return to booking without changes</a>
  </section>}

  <section class="admin-panel admin-calendar-controls">
    <form method="get" class="admin-calendar-filter">
      <input type="hidden" name="month" value={monthValue(startMonth)} />
      {bespokeBooking && <input type="hidden" name="booking" value={bespokeBooking.reference} />}
      <label>Stay arrangement
        <select name="property">
          <option value="all" selected={selectedProperty === 'all'}>All arrangements</option>
          {properties.map((property) => <option value={property.id} selected={selectedProperty === property.id}>{property.name}</option>)}
        </select>
      </label>
      <button class="admin-button admin-button--secondary" type="submit">Apply</button>
    </form>
    <nav class="admin-calendar-navigation" aria-label="Calendar months">
      <a class="admin-button admin-button--secondary" href={`/admin/calendars/?month=${previousMonth}${propertyQuery}`}>← Previous</a>
      <a class="admin-button admin-button--secondary" href={`/admin/calendars/?month=${monthValue(new Date())}${propertyQuery}`}>Current month</a>
      <a class="admin-button admin-button--secondary" href={`/admin/calendars/?month=${nextMonth}${propertyQuery}`}>Next →</a>
    </nav>
  </section>

  <div class="admin-calendar-legend" aria-label="Calendar legend">
    <span><i class="admin-calendar-key is-direct"></i>Confirmed direct booking</span>
    <span><i class="admin-calendar-key is-provisional"></i>Provisional request or offer</span>
    <span><i class="admin-calendar-key is-airbnb"></i>Airbnb unavailable</span>
    <span><i class="admin-calendar-key is-external"></i>Other unavailable block</span>
    <span><i class="admin-calendar-key is-override"></i>Available for bespoke stays</span>
  </div>

  <div class="admin-calendar-stack">
    {months.map((month) => {
      const year = month.getUTCFullYear();
      const monthIndex = month.getUTCMonth();
      const leadingDays = (new Date(Date.UTC(year, monthIndex, 1)).getUTCDay() + 6) % 7;
      const dayCount = daysInMonth(month);
      return <section class="admin-panel admin-calendar-month">
        <h2>{monthFormatter.format(month)}</h2>
        <div class="admin-calendar-weekdays" aria-hidden="true">
          {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((weekday) => <span>{weekday}</span>)}
        </div>
        <div class="admin-calendar-grid">
          {Array.from({ length: leadingDays }, () => <div class="admin-calendar-spacer"></div>)}
          {Array.from({ length: dayCount }, (_, index) => {
            const day = index + 1;
            const value = dayValue(year, monthIndex, day);
            const dayEntries = entriesOnDay(entries, value);
            const overrides = dayEntries.filter((entry) => entry.source === 'override');
            const blockers = dayEntries.filter((entry) =>
              entry.source !== 'override'
              && !(entry.propertyId === 'bespoke-arrangement' && entry.source === 'provisional'),
            );
            const affectedAvailabilityIds = [...new Set([
              ...blockers.flatMap((entry) => getAvailabilityProperties(entry.propertyId).map((property) => property.id)),
              ...overrides.map((entry) => entry.propertyId),
            ])];
            const inRequestedStay = Boolean(bespokeBooking && bespokeBooking.arrival <= value && value < bespokeBooking.departure);
            const inNearestStay = Boolean(nearestOpenArrival && nearestOpenArrival <= value && value < addDays(nearestOpenArrival, requestedNights));
            const selectableArrival = Boolean(bespokeBooking && value >= today && rangeIsOpen(value, requestedNights));
            return <div class:list={['admin-calendar-day', { 'is-today': value === today, 'has-events': dayEntries.length > 0, 'has-override': overrides.length > 0, 'is-requested-stay': inRequestedStay, 'is-nearest-stay': inNearestStay }]}>
              <span class="admin-calendar-day-number">{day}</span>
              <div class="admin-calendar-events">
                {dayEntries.map((entry) => {
                  const className = `admin-calendar-event is-${entry.source}`;
                  const label = entryLabel(entry);
                  if (entry.source === 'direct' && entry.bookingReference && entry.bookingStatus === 'confirmed') {
                    return <a class={className} href={`/admin/bookings/${entry.bookingReference}/customer-view/`} title={`${label}. View the Booker booking page.`}>{label}</a>;
                  }
                  if ((entry.source === 'direct' || entry.source === 'provisional') && entry.bookingReference) {
                    return <a class={className} href={`/admin/bookings/${entry.bookingReference}/`} title={`${label}. Review the booking record.`}>{label}</a>;
                  }
                  return <span class={className} title={label}>{label}</span>;
                })}
              </div>
              {selectableArrival && <button type="button" class="admin-calendar-select-stay" data-select-bespoke-arrival={value}>Select {requestedNights}-night stay</button>}
              {affectedAvailabilityIds.map((availabilityId) => {
                const override = overrides.find((entry) => entry.propertyId === availabilityId);
                const availabilityName = propertyNames.get(availabilityId) ?? availabilityId;
                if (override) {
                  return <form method="post" action="/admin/calendars/override/" class="admin-calendar-override-form">
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="propertyId" value={availabilityId} />
                    <input type="hidden" name="date" value={value} />
                    <input type="hidden" name="month" value={monthValue(startMonth)} />
                    <input type="hidden" name="selectedProperty" value={selectedProperty} />
                    {bespokeBooking && <input type="hidden" name="bookingReference" value={bespokeBooking.reference} />}
                    <button type="submit" class="admin-calendar-override-action is-restore" title={`Restore bespoke-stay blocking for ${availabilityName}`}>Restore {availabilityName}</button>
                  </form>;
                }
                if (!bespokeBooking || !inRequestedStay) return null;
                return <form
                  method="post"
                  action="/admin/calendars/override/"
                  class="admin-calendar-override-form"
                  onsubmit="return window.confirm('Make this night available for bespoke stay requests even if it overlaps an Airbnb reservation, provisional request, or confirmed booking? Standard stays will remain blocked.')"
                >
                  <input type="hidden" name="action" value="create" />
                  <input type="hidden" name="propertyId" value={availabilityId} />
                  <input type="hidden" name="date" value={value} />
                  <input type="hidden" name="month" value={monthValue(startMonth)} />
                  <input type="hidden" name="selectedProperty" value={selectedProperty} />
                  <input type="hidden" name="bookingReference" value={bespokeBooking.reference} />
                  <input type="hidden" name="confirmed" value="yes" />
                  <input name="reason" maxlength="500" aria-label={`Reason for allowing bespoke stays at ${availabilityName} on ${value}`} placeholder="Reason (optional)" />
                  <button type="submit" class="admin-calendar-override-action">Allow bespoke · {availabilityName}</button>
                </form>;
              })}
            </div>;
          })}
        </div>
      </section>;
    })}
  </div>

  {!entries.length && <section class="admin-panel pricing-empty-page"><h2>No calendar entries in this period</h2><p>Choose another property or move to a different three-month period.</p></section>}
</AdminLayout>

<script>
  const bespokeDateForm = document.querySelector<HTMLFormElement>('[data-bespoke-date-form]');
  const bespokeArrival = bespokeDateForm?.querySelector<HTMLInputElement>('[name="arrival"]');
  const bespokeDeparture = bespokeDateForm?.querySelector<HTMLInputElement>('[name="departure"]');
  const bespokeNights = Number(bespokeDateForm?.dataset.nights || 0);
  function departureFor(arrival: string): string {
    const date = new Date(`${arrival}T00:00:00.000Z`);
    date.setUTCDate(date.getUTCDate() + bespokeNights);
    return date.toISOString().slice(0, 10);
  }
  function selectBespokeArrival(value: string): void {
    if (!bespokeArrival || !bespokeDeparture || !value) return;
    bespokeArrival.value = value;
    bespokeDeparture.value = departureFor(value);
    bespokeDateForm?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  bespokeArrival?.addEventListener('change', () => selectBespokeArrival(bespokeArrival.value));
  document.querySelectorAll<HTMLButtonElement>('[data-select-bespoke-arrival]').forEach((button) => {
    button.addEventListener('click', () => selectBespokeArrival(button.dataset.selectBespokeArrival || ''));
  });
</script>
