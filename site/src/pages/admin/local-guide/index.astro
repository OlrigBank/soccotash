---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listLocalGuideEntries } from '../../../lib/local-guide/repository.ts';
import { listGuideContributionModerationQueue } from '../../../lib/planner/repository.ts';
import { getLocalGuideWorkspace,listWorkingLocalGuideCategories,listWorkingUrlHealth } from '../../../lib/local-guide/workspace.ts';
export const prerender=false;
const [entries,categories,workspace,health,contributions]=await Promise.all([listLocalGuideEntries(),listWorkingLocalGuideCategories(),getLocalGuideWorkspace(),listWorkingUrlHealth(),listGuideContributionModerationQueue()]);
const visibleEntries=entries.filter(entry=>entry.status!=='archived'&&entry.workingRevision);
const pending=contributions.filter(candidate=>candidate.status==='pending');
const children=new Map<string,typeof categories>();for(const category of categories){const list=children.get(category.parent)??[];list.push(category);children.set(category.parent,list)}
const flattened:Array<{category:(typeof categories)[number];depth:number}>=[];const visit=(parent:string,depth:number)=>{for(const category of children.get(parent)??[]){flattened.push({category,depth});visit(category.id,depth+1)}};visit('',0);
const entriesByCategory=new Map<string,typeof visibleEntries>();for(const entry of visibleEntries){const id=entry.workingRevision!.categoryId,list=entriesByCategory.get(id)??[];list.push(entry);entriesByCategory.set(id,list)}
const warningByEntry=new Map<string,typeof health>();for(const check of health.filter(item=>item.result==='warning')){const list=warningByEntry.get(check.entryId)??[];list.push(check);warningByEntry.set(check.entryId,list)}
---
<AdminLayout title="Local Guide workspace">
 <header class="admin-page-header local-guide-workspace-header"><div><p class="eyebrow">Administration</p><h1>Local Guide draft</h1><p>Maintain the complete guide privately, then publish it as one coherent update.</p></div><div class="local-guide-workspace-actions"><button class="admin-button admin-button--secondary" data-check-urls>Check all URLs</button><button class="admin-button" data-publish-guide>Publish Local Guide</button></div></header>
 <div id="guide-message" class="admin-alert" role="status" aria-live="polite" hidden></div>
 <section class="admin-panel local-guide-workspace-summary"><div><strong>Draft version {workspace.lockVersion}</strong><span>Published version {workspace.publishedVersion}</span></div><div><strong>{workspace.warningCount} URL warnings</strong><span>{workspace.pendingContributionCount} contributions waiting</span></div></section>
 <section class="admin-panel local-guide-tree-panel">
  <header><div><h2>Guide structure</h2><p>Select an entry to edit it. Use category menus to maintain the tree.</p></div><button class="admin-button admin-button--secondary" data-new-category>Add category</button></header>
  <div class="local-guide-admin-tree" role="tree">
   {flattened.map(({category,depth})=><div class="local-guide-admin-branch" style={`--tree-depth:${depth}`}>
    <div class="local-guide-admin-category" role="treeitem" aria-level={depth+1}>
     <strong>{category.label}</strong><small>{category.id}</small>
     <details class="planner-action-menu"><summary aria-label={`Actions for ${category.label}`}>⋮</summary><div><button data-edit-category={category.id}>Edit or move</button><button data-move-category={category.id} data-direction="up">Move up</button><button data-move-category={category.id} data-direction="down">Move down</button>{category.id!=='home'&&<button class="is-destructive" data-delete-category={category.id}>Delete if empty</button>}</div></details>
    </div>
    {(entriesByCategory.get(category.id)??[]).map(entry=>{const warnings=warningByEntry.get(entry.id)??[];return <button class="local-guide-admin-leaf" type="button" data-edit-entry={entry.id} aria-label={`Edit ${entry.workingRevision!.title}`}>
      <span>{entry.workingRevision!.title}</span><small>{entry.slug}</small>{entry.workingRevisionId!==entry.publishedRevisionId&&<span class="status-badge status-draft">Draft</span>}{warnings.length>0&&<span class="local-guide-url-warning" title={warnings.map(item=>`${item.kind}: ${item.failureCode}`).join('\n')} aria-label={`${warnings.length} URL warnings`}>⚠</span>}
      <template data-entry-json>{JSON.stringify(entry)}</template>
     </button>})}
   </div>)}
  </div>
  <button class="admin-button" data-new-entry>Create entry</button>
 </section>
 <section class="admin-panel local-guide-contributions"><header><div><h2>Contribution candidates</h2><p>Examine guest suggestions and promote suitable content into this draft.</p></div><span class="status-badge">{pending.length} pending</span></header>{pending.length===0?<p>No contributions are waiting.</p>:<div class="planner-card-grid">{pending.map(candidate=><article class="planner-card"><h3>{candidate.offeredTitle}</h3><p>{candidate.offeredDescription||'No description supplied.'}</p><button class="admin-button admin-button--secondary" data-review-contribution={candidate.id}>Examine</button><template data-contribution-json>{JSON.stringify(candidate)}</template></article>)}</div>}</section>

 <dialog class="local-guide-editor" data-entry-dialog><form method="dialog" data-entry-form>
  <header><div><p class="eyebrow">Working draft</p><h2 data-entry-heading>Local Guide entry</h2></div><div><button class="admin-button" value="save">Save</button><button class="booking-drawer-close" value="cancel" aria-label="Close">×</button></div></header>
  <div class="local-guide-editor__body"><input type="hidden" name="entryId"/><input type="hidden" name="expectedVersion"/>
   <label>Title<input name="title" required maxlength="200"/></label><label>Public URL slug<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*"/></label>
   <label>Category<select name="categoryId" required>{categories.map(category=><option value={category.id}>{category.label}</option>)}</select></label>
   <label>Image URL<input name="imagePath" type="url" required pattern="https://.*" placeholder="https://…"/><button type="button" class="admin-button admin-button--secondary" data-preview-image>Preview image</button></label><img data-image-preview alt="Entry image preview" hidden/>
   <label class="planner-wide">Website URL<input name="externalLink" type="url" placeholder="https://…"/><a class="admin-button admin-button--secondary local-guide-open-url" data-open-website target="_blank" rel="noopener noreferrer" aria-disabled="true">Open website in new tab ↗</a></label><label class="planner-wide">Summary<textarea name="summary" maxlength="1000" rows="3"></textarea></label>
   <label class="planner-wide">Content<textarea name="markdownBody" maxlength="100000" rows="12"></textarea></label><label><input name="recommended" type="checkbox"/> Recommended</label>
   <details data-entry-history hidden><summary>Revision history and advanced actions</summary><p><a data-open-entry-page>Open full revision history</a></p><button type="button" class="admin-button admin-button--danger" data-archive-entry>Archive entry</button></details>
  </div>
 </form></dialog>

 <dialog class="local-guide-editor local-guide-category-editor" data-category-dialog><form method="dialog" data-category-form><header><h2>Category</h2><div><button class="admin-button" value="save">Save</button><button class="booking-drawer-close" value="cancel" aria-label="Close">×</button></div></header><div class="local-guide-editor__body"><label>Identifier<input name="id" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*"/></label><label>Name<input name="label" required maxlength="200"/></label><label>Parent<select name="parentId"><option value="">Root</option>{categories.map(category=><option value={category.id}>{category.label}</option>)}</select></label><label class="planner-wide">Description<textarea name="description" maxlength="1000"></textarea></label></div></form></dialog>

 <dialog class="local-guide-editor" data-contribution-dialog><form method="dialog" data-contribution-form><header><div><p class="eyebrow">Contribution candidate</p><h2 data-contribution-heading>Examine suggestion</h2></div><button class="booking-drawer-close" value="cancel" aria-label="Close">×</button></header><div class="local-guide-editor__body"><input type="hidden" name="candidateId"/><p data-contribution-provenance></p><label>Reviewed title<input name="reviewedTitle" required maxlength="200"/></label><label>Result<select name="resultType"><option value="new_entry_draft">New entry draft</option><option value="suggested_update">Suggested update</option></select></label><label>Local Guide slug<input name="resultGuideSlug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*"/></label><label>Category<select name="reviewedCategoryId">{categories.map(category=><option value={category.id}>{category.label}</option>)}</select></label><label class="planner-wide">Reviewed description<textarea name="reviewedDescription" maxlength="5000" rows="8"></textarea></label><label class="planner-wide">Moderation note<textarea name="moderationNotes" maxlength="3000"></textarea></label><div class="planner-form-actions"><button class="admin-button" value="accept">Promote into draft</button><button class="admin-button admin-button--danger" value="reject">Reject</button></div></div></form></dialog>
</AdminLayout>
<script is:inline define:vars={{initialWorkspaceVersion:workspace.lockVersion,categoriesData:categories}}>
let workspaceVersion=initialWorkspaceVersion;const message=document.querySelector('#guide-message');const show=(text,error=false)=>{if(message instanceof HTMLElement){message.hidden=false;message.textContent=text;message.className=`admin-alert ${error?'admin-alert--error':''}`;message.focus()}};
async function request(url,body){const response=await fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The action failed.');return data}
const entryDialog=document.querySelector('[data-entry-dialog]'),entryForm=document.querySelector('[data-entry-form]');let entryOriginal=null;
const slugify=value=>value.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/['’]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const websiteLink=document.querySelector('[data-open-website]');function updateWebsiteLink(){const value=entryForm.elements.externalLink.value.trim();let valid=false;try{const url=new URL(value);valid=['http:','https:'].includes(url.protocol);if(valid)websiteLink.href=url.toString()}catch{}websiteLink.setAttribute('aria-disabled',String(!valid));if(!valid)websiteLink.removeAttribute('href')}
function openEntry(entry=null){entryOriginal=entry;entryForm.reset();entryForm.elements.entryId.value=entry?.id??'';entryForm.elements.expectedVersion.value=entry?.lockVersion??'';entryForm.elements.title.value=entry?.workingRevision?.title??'';entryForm.elements.slug.value=entry?.slug??'';entryForm.elements.categoryId.value=entry?.workingRevision?.categoryId??categoriesData.find(c=>c.id!=='home')?.id??'home';entryForm.elements.imagePath.value=entry?.workingRevision?.imagePath??'';entryForm.elements.externalLink.value=entry?.workingRevision?.externalLink??'';entryForm.elements.summary.value=entry?.workingRevision?.summary??'';entryForm.elements.markdownBody.value=entry?.workingRevision?.markdownBody??'';entryForm.elements.recommended.checked=entry?.workingRevision?.recommended??false;document.querySelector('[data-entry-heading]').textContent=entry?.workingRevision?.title??'Create entry';document.querySelector('[data-entry-history]').hidden=!entry;document.querySelector('[data-open-entry-page]').href=entry?`/admin/local-guide/${entry.id}/`:'';updateWebsiteLink();entryDialog.showModal();history.pushState({localGuideEditor:true},'')}
document.querySelector('[data-new-entry]')?.addEventListener('click',()=>openEntry());document.querySelectorAll('[data-edit-entry]').forEach(button=>button.addEventListener('click',()=>openEntry(JSON.parse(button.querySelector('[data-entry-json]').content.textContent))));entryForm.elements.title.addEventListener('input',()=>{if(!entryOriginal)entryForm.elements.slug.value=slugify(entryForm.elements.title.value)});
entryForm.elements.externalLink.addEventListener('input',updateWebsiteLink);websiteLink.addEventListener('click',event=>{if(!websiteLink.href)event.preventDefault()});
entryForm.addEventListener('submit',async event=>{if(event.submitter?.value!=='save')return;event.preventDefault();const values=Object.fromEntries(new FormData(entryForm));values.recommended=entryForm.elements.recommended.checked;try{if(!entryOriginal){await request('/api/admin/local-guide/action/',{action:'create',...values})}else{let version=Number(values.expectedVersion);if(values.slug!==entryOriginal.slug){const changed=await request('/api/admin/local-guide/action/',{action:'slug',entryId:values.entryId,expectedVersion:version,slug:values.slug});version=changed.entry.lockVersion}await request('/api/admin/local-guide/action/',{action:'edit',...values,expectedVersion:version})}location.reload()}catch(error){show(error.message,true)}});
document.querySelector('[data-preview-image]')?.addEventListener('click',()=>{const preview=document.querySelector('[data-image-preview]');preview.src=entryForm.elements.imagePath.value;preview.hidden=false});document.querySelector('[data-archive-entry]')?.addEventListener('click',async()=>{if(!entryOriginal||!confirm(`Archive ${entryOriginal.workingRevision.title}?`))return;try{await request('/api/admin/local-guide/action/',{action:'archive',entryId:entryOriginal.id,expectedVersion:entryOriginal.lockVersion});location.reload()}catch(error){show(error.message,true)}});
const categoryDialog=document.querySelector('[data-category-dialog]'),categoryForm=document.querySelector('[data-category-form]');function openCategory(category=null){categoryForm.reset();categoryForm.elements.id.value=category?.id??'';categoryForm.elements.id.readOnly=Boolean(category);categoryForm.elements.label.value=category?.label??'';categoryForm.elements.description.value=category?.description??'';categoryForm.elements.parentId.value=category?.parent??'';categoryDialog.showModal();history.pushState({localGuideEditor:true},'')};document.querySelector('[data-new-category]')?.addEventListener('click',()=>openCategory());document.querySelectorAll('[data-edit-category]').forEach(button=>button.addEventListener('click',()=>openCategory(categoriesData.find(category=>category.id===button.dataset.editCategory))));categoryForm.addEventListener('submit',async event=>{if(event.submitter?.value!=='save')return;event.preventDefault();try{await request('/api/admin/local-guide/workspace/',{action:'categorySave',expectedWorkspaceVersion:workspaceVersion,...Object.fromEntries(new FormData(categoryForm))});location.reload()}catch(error){show(error.message,true)}});
document.querySelectorAll('[data-move-category]').forEach(button=>button.addEventListener('click',async()=>{try{await request('/api/admin/local-guide/workspace/',{action:'categoryMove',expectedWorkspaceVersion:workspaceVersion,id:button.dataset.moveCategory,direction:button.dataset.direction});location.reload()}catch(error){show(error.message,true)}}));document.querySelectorAll('[data-delete-category]').forEach(button=>button.addEventListener('click',async()=>{if(!confirm(`Delete empty category ${button.dataset.deleteCategory}?`))return;try{await request('/api/admin/local-guide/workspace/',{action:'categoryDelete',expectedWorkspaceVersion:workspaceVersion,id:button.dataset.deleteCategory});location.reload()}catch(error){show(error.message,true)}}));
document.querySelector('[data-check-urls]')?.addEventListener('click',async event=>{event.currentTarget.disabled=true;show('Checking Local Guide URLs…');try{const result=await request('/api/admin/local-guide/workspace/',{action:'checkUrls'});show(`Checked ${result.checked} URLs: ${result.passed} passed and ${result.warnings} need attention.`);setTimeout(()=>location.reload(),900)}catch(error){show(error.message,true)}finally{event.currentTarget.disabled=false}});document.querySelector('[data-publish-guide]')?.addEventListener('click',async()=>{const acknowledge=workspaceVersion&&confirm('Publish the complete working draft? Any displayed URL warnings will be acknowledged.');if(!acknowledge)return;try{await request('/api/admin/local-guide/workspace/',{action:'publish',expectedWorkspaceVersion:workspaceVersion,acknowledgeWarnings:true});location.reload()}catch(error){show(error.message,true)}});
const contributionDialog=document.querySelector('[data-contribution-dialog]'),contributionForm=document.querySelector('[data-contribution-form]');document.querySelectorAll('[data-review-contribution]').forEach(button=>button.addEventListener('click',()=>{const candidate=JSON.parse(button.closest('article').querySelector('[data-contribution-json]').content.textContent);contributionForm.reset();contributionForm.elements.candidateId.value=candidate.id;contributionForm.elements.reviewedTitle.value=candidate.offeredTitle;contributionForm.elements.reviewedDescription.value=candidate.offeredDescription??'';contributionForm.elements.resultGuideSlug.value=slugify(candidate.offeredTitle);document.querySelector('[data-contribution-heading]').textContent=candidate.offeredTitle;document.querySelector('[data-contribution-provenance]').textContent=`Submitted by ${candidate.submittedByName}. ${candidate.attributionPermitted?'Attribution permitted.':'Anonymous use only.'}`;contributionDialog.showModal();history.pushState({localGuideEditor:true},'')}));contributionForm.addEventListener('submit',async event=>{if(!['accept','reject'].includes(event.submitter?.value))return;event.preventDefault();const values=Object.fromEntries(new FormData(contributionForm));values.decision=event.submitter.value;if(values.decision==='reject'&&!values.moderationNotes){show('A rejection reason is required.',true);return}try{await request('/api/admin/planner/contributions/',values);location.reload()}catch(error){show(error.message,true)}});
window.addEventListener('popstate',()=>document.querySelectorAll('dialog[open]').forEach(dialog=>dialog.close()));
</script>
