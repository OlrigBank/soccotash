---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getLocalGuideEntry,listLocalGuideRevisions } from '../../../lib/local-guide/repository.ts';
import { getLocalGuideCategories } from '../../../lib/navigation.ts';
import { renderSafeLocalGuideMarkdown } from '../../../lib/local-guide/markdown.ts';
export const prerender=false;
const entry=await getLocalGuideEntry(Astro.params.id??''); if(!entry)return Astro.redirect('/admin/local-guide/');
const revisions=await listLocalGuideRevisions(entry.id);const working=entry.workingRevision!;const archived=entry.status==='archived';const categories=getLocalGuideCategories();const preview=renderSafeLocalGuideMarkdown(working.markdownBody);
const hasUnpublishedChanges=entry.workingRevisionId!==entry.publishedRevisionId;
---
<AdminLayout title={working.title}>
 <header class="admin-page-header"><div><p class="eyebrow"><a href="/admin/local-guide/">Local Guide</a></p><h1>{working.title}</h1><p><span class:list={['status-badge',`status-${entry.status}`]}>{entry.status}</span> · version {entry.lockVersion} · <code>{entry.slug}</code></p></div></header>
 <div id="guide-message" class="admin-alert" role="status" aria-live="polite" hidden></div>
 {archived&&<div class="admin-alert">Archived entries are read-only.</div>}
 <section class="admin-panel"><h2>Working revision</h2><form id="edit-guide" class="planner-form">
  <label>Title<input name="title" value={working.title} required maxlength="200" disabled={archived}/></label><label>Category<select name="categoryId" disabled={archived}>{categories.map(c=><option value={c.id} selected={c.id===working.categoryId}>{c.label}</option>)}</select></label>
  <label class="planner-wide">Summary<textarea name="summary" maxlength="1000" disabled={archived}>{working.summary}</textarea></label><label>Category label<input name="categoryLabel" value={working.categoryLabel??''} disabled={archived}/></label><label>Image path<input name="imagePath" value={working.imagePath??''} disabled={archived}/></label><label class="planner-wide">External link<input name="externalLink" type="url" value={working.externalLink??''} disabled={archived}/></label>
  <label class="planner-wide">Markdown body<textarea name="markdownBody" rows="12" maxlength="100000" disabled={archived}>{working.markdownBody}</textarea></label><label><input name="recommended" type="checkbox" checked={working.recommended} disabled={archived}/> Recommended</label>{!archived&&<button class="admin-button">Save new revision</button>}
 </form></section>
 <section class="admin-panel"><h2>Public entry preview</h2><article class="prose" data-local-guide-preview>
  <h3>{working.title}</h3><p>{working.summary||'No summary supplied.'}</p>
  {working.imagePath&&<p><img src={working.imagePath} alt="" /></p>}
  {working.externalLink&&<p><a href={working.externalLink} target="_blank" rel="noreferrer">Visit external website</a></p>}
  {working.markdownBody.trim()?<div set:html={preview}/>:<p><em>No additional body content.</em></p>}
 </article></section>
 {!archived&&<section class="admin-panel"><h2>Lifecycle and URL</h2>{hasUnpublishedChanges&&entry.status==='published'&&<div class="admin-alert">The working revision contains unpublished changes. The public page still shows the previously published revision.</div>}<form id="slug-guide" class="planner-form"><label>Canonical slug<input name="slug" value={entry.slug}/></label><button class="admin-button admin-button--secondary">Change slug</button></form><div class="planner-form-actions">{(entry.status!=='published'||hasUnpublishedChanges)&&<button class="admin-button" data-action="publish">Publish working revision</button>}{entry.status==='published'&&<button class="admin-button admin-button--secondary" data-action="unpublish">Unpublish current entry</button>}<button class="admin-button admin-button--danger" data-action="archive">Archive entry</button></div></section>}
 <section class="admin-panel"><h2>Revision history</h2><ol>{revisions.map(r=><li><strong>Revision {r.revisionNumber}: {r.title}</strong> · {r.action} · {new Date(r.createdAt).toLocaleString('en-GB')} {r.id!==working.id&&!archived&&<button class="admin-button admin-button--secondary" data-restore={r.id}>Restore as new revision</button>}<details><summary>Compare content</summary><pre>{JSON.stringify({title:r.title,summary:r.summary,category:r.categoryId,image:r.imagePath,externalLink:r.externalLink,recommended:r.recommended,markdown:r.markdownBody},null,2)}</pre></details></li>)}</ol></section>
</AdminLayout>
<script define:vars={{entryId:entry.id,initialVersion:entry.lockVersion}}>
let expectedVersion=initialVersion;
const m=document.querySelector('#guide-message');
async function act(body){const r=await fetch('/api/admin/local-guide/action/',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({entryId,expectedVersion,...body})});const d=await r.json();if(!r.ok){if(m instanceof HTMLElement){m.hidden=false;m.textContent=d.code==='STALE_VERSION'?`${d.error} Current version: ${d.currentVersion}. Reload to recover.`:d.error;m.className='admin-alert admin-alert--error'}return null}return d.entry}
document.querySelector('#edit-guide')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;if(!(f instanceof HTMLFormElement))return;const v=Object.fromEntries(new FormData(f));v.recommended=f.elements.namedItem('recommended')?.checked??false;if(await act({action:'edit',...v}))location.reload()});
document.querySelector('#slug-guide')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget;if(f instanceof HTMLFormElement&&await act({action:'slug',...Object.fromEntries(new FormData(f))}))location.reload()});
document.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',async()=>{if(confirm(`Confirm ${b.dataset.action}?`)&&await act({action:b.dataset.action}))location.reload()}));
document.querySelectorAll('[data-restore]').forEach(b=>b.addEventListener('click',async()=>{if(confirm('Restore this revision as a new working revision?')&&await act({action:'restore',revisionId:b.dataset.restore}))location.reload()}));
</script>
