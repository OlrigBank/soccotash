---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {isSameOrigin} from '../../../lib/admin/auth';import {getProperties} from '../../../lib/booking/config';import {createAccommodationBundle,listAccommodationEvents,listAccommodationModel,saveAccommodationResource,updateAccommodationBundle} from '../../../lib/accommodation/repository';
export const prerender=false;let notice='',error='';
if(Astro.request.method==='POST'){
 if(!isSameOrigin(Astro.request))return new Response('Cross-site form submission forbidden.',{status:403});const form=await Astro.request.formData();const action=String(form.get('action')||'');
 try{if(action==='save-resource'){await saveAccommodationResource({stableKey:form.get('stableKey'),displayName:form.get('displayName'),sleepingCapacity:form.get('sleepingCapacity'),availabilityPropertyId:form.get('availabilityPropertyId'),practicalNotes:form.get('practicalNotes'),adminUserId:Astro.locals.adminUser!.id});notice='Accommodation resource saved.'}
 else if(action==='create-bundle'){await createAccommodationBundle({stableKey:form.get('stableKey'),displayName:form.get('displayName'),practicalNotes:form.get('practicalNotes'),resourceKeys:form.getAll('resourceKeys'),adminUserId:Astro.locals.adminUser!.id});notice='Host-approved bundle created.'}
 else if(action==='update-bundle'){await updateAccommodationBundle({id:form.get('bundleId'),displayName:form.get('displayName'),practicalNotes:form.get('practicalNotes'),resourceKeys:form.getAll('resourceKeys'),adminUserId:Astro.locals.adminUser!.id});notice='Host-approved bundle saved.'}else error='Unknown accommodation action.'}
 catch(cause){error=cause instanceof Error&&cause.message==='INVALID_BUNDLE_RESOURCE'?'Choose only active accommodation resources.':'Check the stable key, name, capacity and selected resources.'}
}
const model=await listAccommodationModel();const events=await listAccommodationEvents();const properties=getProperties();
---
<AdminLayout title="Accommodation resources"><header class="admin-page-header"><div><p class="eyebrow">Administration</p><h1>Accommodation resources</h1><p>Model spaces that affect sleeping capacity or booking conflicts. This does not change current availability or create a public stay arrangement.</p></div></header>
{notice&&<p class="pricing-message" role="status">{notice}</p>}{error&&<p class="pricing-message is-error" role="alert">{error}</p>}
<section class="admin-panel"><h2>Resources</h2><p>Stable keys are permanent identities. Names, capacities and operational notes may be updated.</p><div class="accommodation-resource-grid">{model.resources.map(resource=><form method="post" class="admin-form admin-panel"><input type="hidden" name="action" value="save-resource"/><input type="hidden" name="stableKey" value={resource.stableKey}/><h3>{resource.displayName}</h3><code>{resource.stableKey}</code><label>Display name<input name="displayName" value={resource.displayName} maxlength="160" required/></label><label>Adult sleeping capacity<input name="sleepingCapacity" type="number" min="0" value={resource.sleepingCapacity} required/></label><label>Current availability calendar<select name="availabilityPropertyId"><option value="">No direct mapping</option>{properties.filter(property=>property.id!=='bespoke-arrangement').map(property=><option value={property.id} selected={resource.availabilityPropertyId===property.id}>{property.name}</option>)}</select></label><label>Practical notes<textarea name="practicalNotes" rows="3" maxlength="2000">{resource.practicalNotes}</textarea></label><button class="admin-button" type="submit">Save resource</button></form>)}</div></section>
<section class="admin-panel"><h2>Arrangement bundles</h2><p>Capacity is the sum of selected sleeping resources; it is descriptive, not an automatic promise of suitability or availability.</p><div class="accommodation-bundle-grid">{model.bundles.map(bundle=>bundle.standardArrangement?<article class="admin-panel"><p class="eyebrow">Standard arrangement · read only</p><h3>{bundle.displayName}</h3><code>{bundle.stableKey}</code><p><strong>Sleeps {bundle.sleepingCapacity} adults</strong></p><p>{bundle.resources.map(resource=>resource.displayName).join(' · ')||'No resources selected'}</p>{bundle.propertyIds.length>0&&<p>Current property mapping: {bundle.propertyIds.join(', ')}</p>}<p>{bundle.practicalNotes}</p></article>:<form method="post" class="admin-form admin-panel"><input type="hidden" name="action" value="update-bundle"/><input type="hidden" name="bundleId" value={bundle.id}/><p class="eyebrow">Host-approved bundle</p><code>{bundle.stableKey}</code><label>Display name<input name="displayName" value={bundle.displayName} maxlength="160" required/></label><fieldset><legend>Resources</legend>{model.resources.filter(resource=>resource.active).map(resource=><label class="pricing-check"><input type="checkbox" name="resourceKeys" value={resource.stableKey} checked={bundle.resources.some(selected=>selected.stableKey===resource.stableKey)}/>{resource.displayName} · capacity {resource.sleepingCapacity}</label>)}</fieldset><label>Practical notes<textarea name="practicalNotes" rows="3" maxlength="2000">{bundle.practicalNotes}</textarea></label><p><strong>Current capacity: {bundle.sleepingCapacity} adults</strong></p><button class="admin-button" type="submit">Save bundle</button></form>)}</div></section>
<section class="admin-panel"><h2>Create a host-approved bundle</h2><form method="post" class="admin-form"><input type="hidden" name="action" value="create-bundle"/><label>Permanent stable key<input name="stableKey" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="example-host-arrangement" required/></label><label>Display name<input name="displayName" maxlength="160" required/></label><fieldset><legend>Resources</legend>{model.resources.filter(resource=>resource.active).map(resource=><label class="pricing-check"><input type="checkbox" name="resourceKeys" value={resource.stableKey}/>{resource.displayName} · capacity {resource.sleepingCapacity}</label>)}</fieldset><label>Practical notes<textarea name="practicalNotes" rows="4" maxlength="2000"></textarea></label><button class="admin-button" type="submit">Create bundle</button></form></section>
<section class="admin-panel"><h2>Audit history</h2>{events.length?<div class="admin-table-wrap"><table><thead><tr><th>When</th><th>Administrator</th><th>Action</th><th>Details</th></tr></thead><tbody>{events.map(event=><tr><td>{new Date(event.createdAt).toLocaleString('en-GB')}</td><td>{event.adminName||'Unknown'}</td><td>{event.action.replaceAll('_',' ')}</td><td><code>{JSON.stringify(event.details)}</code></td></tr>)}</tbody></table></div>:<p>No resource changes have been recorded.</p>}</section>
</AdminLayout>
