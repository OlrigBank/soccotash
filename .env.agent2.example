# Copy to .env.agent2. The real file is ignored by Git.
COMPOSE_PROJECT_NAME=olrigbank2
OLRIGBANK_IMAGE=olrigbank-web:local-2

POSTGRES_DB=soccotash
POSTGRES_USER=soccotash
POSTGRES_PASSWORD=replace-with-a-strong-and-unique-local-password
POSTGRES_PORT=5434

OLRIGBANK_PORT=8082
OLRIGBANK_HTTPS_HOST=192.168.68.56
OLRIGBANK_HTTPS_PORT=8444
SOCCOTASH_DOCKER_NETWORK=olrigbank2_default
SOCCOTASH_DATABASE_CONTAINER=olrigbank2-database-1
CALENDAR_SYNC_TOKEN=replace-with-a-long-random-value
# 32-byte AES key encoded as 64 hexadecimal characters; used only for private
# imported access-code material. Generate with: openssl rand -hex 32
AIRBNB_IMPORT_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
AIRBNB_IMPORT_ENCRYPTION_KEY_VERSION=1

# Keep outbound integrations inert in an isolated development instance.
AIRBNB_MAIN_HOUSE_ICAL_URLS=
AIRBNB_COTTAGE_ICAL_URLS=
EMAIL_PROVIDER=
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_INBOUND_AUTO_REPLY_ENABLED=false
WHATSAPP_RECIPIENT_ALLOWLIST_REQUIRED=true
